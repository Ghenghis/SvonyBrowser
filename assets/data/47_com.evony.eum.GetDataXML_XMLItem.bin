  <itemEum id="player.box.present.money.56" name="Rudolph's Battle Gear" itemType="宝箱" dayLimit="0" userLimit="1" desc="Chest D(Rudolph's Battle Gear) 1 x Holy Helm of Mars,1 x Vesta' Blessing,2 x On Wars,3 x Random Medal,1 x Ivory Horn,2 x Ultra Corselet,1 x Adv City Teleporter. " itemDesc="Chest D(Rudolph's Battle Gear) 1 x Holy Helm of Mars,1 x Vesta' Blessing,2 x On Wars,3 x Random Medal,1 x Ivory Horn,2 x Ultra Corselet,1 x Adv City Teleporter. " iconUrl="images/icon/shop/battlechest_of_christmas.png" price="0" playerItem="true"/>
