  <itemEum id="player.box.present.money.52" name="Warmaster's Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="This Warmaster's Package is filled with a bounty of items that will make you more effective in battle immediately. You'll be able to send more troops, acquire resources faster ,and even teleport your war city to freshest battle grounds. Go forth and fight!" itemDesc="When this Warmaster's package is opened it will give you:2 x Merchant Fleet,1 x Ivory Horn,2 x War Ensign,1 x Ultra Corselet,2 x Random Medal,1 x City Teleporter,1 x War Horn." iconUrl="images/icon/shop/warmasters_package.jpg" price="0" playerItem="true"/>
