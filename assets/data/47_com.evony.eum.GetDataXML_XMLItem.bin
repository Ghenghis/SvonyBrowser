  <itemEum id="player.box.present.money.364" name="Frostmas Gift" itemType="宝箱" dayLimit="0" userLimit="0" desc="Open me up and find out what I hold!." itemDesc="Merry Frostmas! This gift is for the 2016 Christmas Celebration." iconUrl="images/icon/shop/frostmasgift.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.365" name="Christmas gift 2016" itemType="宝箱" dayLimit="0" userLimit="0" desc="Merry Christmas from the Evony team! Hope you have a happy holidays and a wonderful New Year!" itemDesc="Opening this gift will give you the following items:125 Cents,1x 50% upkeep item,2x Stone of Finding." iconUrl="images/icon/shop/christmasgift2016.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.366" name="Frostmas Delivery" itemType="宝箱" dayLimit="0" userLimit="0" desc="The Frostmas Delivery was left on your porch during the day. Thankfully, the porch pirates didn’t steal them before you picked them up! These gifts let you rest in the night and adventure in the waning light of winter." itemDesc="Opening the Frostmas Delivery will grant you the following:1 x Adv Teleporter,3 x War Teleporter,5 x War Ensign,1x Mechanic Battalion,1x Truce Agreement,1x Stone of Finding,1x On War,1x Gold Holly Key." iconUrl="images/icon/shop/frostmasdelivery.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.367" name="Holly King’s Favors" itemType="宝箱" dayLimit="0" userLimit="0" desc="The Holly King’s Favors appeared in the middle of the night, sparkling and attracting you in the weak light of the morning. What can be contained within the wrapping?." itemDesc="Once opened, the Holly King’s Favors will randomly provide you with one of the following groups of items:Jeweled Robin’s Egg Box,Emblazoned Gift Chest,Velveteen Box,Plainly Wrapped Box,Stuffed Stocking." iconUrl="images/icon/shop/hollykingsfavors.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.368" name="Offering of Thanks" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.369" name="Harvester’s Great Bounty" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.37" name="Secret Santa Chest" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes: Chest A (Freedom Medal, Justice Medal, Nation Medal, Michelangelo's Script, Plowshares, Arch Saw, Quarrying Tools, Blower, War Ensign, Excalibur, The Wealth of Nations, Amulet) or Chest B (Primary Guidelines, Intermediate Guidelines, Hero Hunting, Merchant Fleet, Plowshares, Double Saw, Quarrying Tools, Blower, Michelangelo's Script, Tax Policy, The Wealth of Nations) or Chest C (Excalibur, War Horn, Corselet, Truce Agreement, War Ensign, Adv City Teleporter, Michelangelo's Script)" itemDesc="These chests are sent to you as Christmas gifts from your friends in the game. They require a Secret Santa Key to open. You can obtain a Secret Santa Key for every $30 worth of purchases made during Christmas. When opened, you will receive a random assortment of Secret Santa Chests A, B or C." iconUrl="images/icon/shop/Christmas1.jpg" price="300" playerItem="true"/>
  <itemEum id="player.box.present.money.370" name="Heart of the Harvest" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
