  <itemEum id="player.box.present.money.283" name="Skull Chest of Amun Thun" itemType="宝箱" dayLimit="0" userLimit="1" desc="The Skull Chest of Amun Thun is a cache of sacrificial items used by the priests of the Boneslayer Morgun. This cult has invaded the holy site of Amun Thun and often clash with your soldiers. One of your soldiers has taken this package, destined for the sacrificial fires, from one of the dead cultists." itemDesc="Your free gift, included with $30 purchase. Includes:1 x Adv Teleporter,1 x War Teleporter,3 x War Ensign,1 x On War,1 x Stone of Finding,1 x Angel/Devil Token,1 x Excalibur,1 x Corselet." iconUrl="images/icon/shop/skullchestofamunthun.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.284" name="The Feaster’s Bounty" itemType="宝箱" dayLimit="0" userLimit="1" desc="The Feaster’s Bounty contains the best items found throughout the countryside, to aid in your efforts against your neighbors." itemDesc="Opening the Harvester's Bounty will grant you the following:1 x Adv Teleporter,3 x War Teleporter,5 x War Ensign,1 x Senior Medal Box,1 x Stone of Findingm,1x Tom’s Key of the Harvest" iconUrl="images/icon/shop/thefeastersbounty.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.285" name="Tom’s Chest of Bounty" itemType="宝箱" dayLimit="0" userLimit="0" desc="Another year, and the Tom Turkeys are in a panic! Clever hunters have been tracking them down and taking their bounties. Here is what your hunters have brought you!" itemDesc="Once opened, Tom’s Chest of Bounty will randomly provide you with one of the following groups of items:Brace of Jakes,Solstice Stores,Heart of the Harvest,Harvester’s Great Bounty,Offering of Thanks" iconUrl="images/icon/shop/tomschestofbounty.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.286" name="Offering of Thanks" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
