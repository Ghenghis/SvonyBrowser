  <itemEum id="player.box.present.money.341" name="Sommer’s Final Harvest" itemType="宝箱" dayLimit="0" userLimit="0" desc="The sun is waning, and the fall approaches. Sommer’s ended, and the gifts of the harvest await you." itemDesc="Opening Sommer’s Final Harvest will grant you the following:1 x Adv Teleporter,3 x War Teleporter,5 x War Ensign,2 x Stygandr’s Banner of the Horde,2 x Stone of Finding,20 Million of Each Resource,Wheat Sheaf Key" iconUrl="images/icon/shop/sommersgift2016.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.342" name="Sommerdawn’s Chest" itemType="宝箱" dayLimit="0" userLimit="0" desc="The harvest has begun, and the people have brought the finest in grown and gathered things to your court." itemDesc="Once opened, the Sommer’s End Chest will randomly provide you with one of the following sets of items:King’s Harvest,The Fürst Share,The Count’s Taste,The Lord’s Tribute,Sommer’s Harvest" iconUrl="images/icon/shop/sommerdawnschest.png" price="0" playerItem="true"/>
