  <itemEum id="player.box.present.money.321" name="Anniversary Gift 2016" itemType="宝箱" dayLimit="0" userLimit="1" desc="Celebration the 7th Anniversary!" itemDesc="Thank you for your support! My lord and Queens!" iconUrl="images/icon/shop/anniversarygift2015.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.322" name="Daily Gift" itemType="宝箱" dayLimit="0" userLimit="1" desc="This is your daily gift package. Thank you all for your support!" itemDesc="Included in this Anniversary gift is the following:Stygandr’s Banner of the Horde x3,Mechanic Battalion x1,War Teleporter x1,Cents x5" iconUrl="images/icon/shop/anniversarygift.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.323" name="7th Anniversary Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="This heavy package was delivered to your hands along with the cents that you filled your coffers with! It’s our 7th Anniversary, and here is your package of wonders!" itemDesc="Opening this package will grant you:1 x Adv Teleporter,1 x War Teleporter,4 x Stygandr’s Banner of the Horde,3 x War Ensign,1 x Mechanics Battallion,1 x Angel Token,1 x Devil Token,1 x Penicillin,1 x Corselet." iconUrl="images/icon/shop/7thanniversarypackage.png" price="0" playerItem="true"/>
