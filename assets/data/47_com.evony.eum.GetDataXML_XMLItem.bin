  <itemEum id="player.box.present.money.62" name="Casanova's Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="Casanova ensured he was always prepared for intrigue." itemDesc="When opened gives one of Chest A(Writings from Casanova),1 x War Ensign,2 x Adv City Teleporter,1 x War Horn,5 x Amulet,Chest B(Box of Candies),2 x Epitome of Military Science,2 x Adv City Teleporter,3 x City Teleporter,1 x Wealth of Nations,1 x Penicillin,Chest C(Flowers and a Card)2 x Excalibur,3 x On War,1 x Ivory Horn,2 x Ultra Corselet,2 x Justice Medal,1 x Adv City Teleporter,Chest D(Crown of Flowers),1 x Holy Helm of Mars,1x Vesta's Blessing,2 x On Wars,3 x Random Medal,1 x Ivory Horn,2x Ultra Corselet,1 x Adv City Teleporter,Chest E (Gilded Jewelry Box) 750 cents,1 x Holy Helm of Mars,2 x On Wars" iconUrl="images/icon/shop/Casanova_package.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.63" name="Writings from Casanova" itemType="宝箱" dayLimit="0" userLimit="1" desc="1 x War Ensign,2 x Adv CityTeleporter,1 x Warr Horn,5 x Amulet." itemDesc="1 x War Ensign,2 x Adv CityTeleporter,1 x Warr Horn,5 x Amulet." iconUrl="images/icon/shop/battlechest_of_christmas.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.64" name="Box of Candies" itemType="宝箱" dayLimit="0" userLimit="1" desc="2 x Epitome of Military Science,2 x Adv City Teleporter,3 x Ctiy Teleporter,1 x Wealth of Nations,1 x Penicillin" itemDesc="2 x Epitome of Military Science,2 x Adv City Teleporter,3 x Ctiy Teleporter,1 x Wealth of Nations,1 x Penicillin" iconUrl="images/icon/shop/battlechest_of_christmas.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.65" name="Flowers and a Card" itemType="宝箱" dayLimit="0" userLimit="1" desc="2 x Excalibur,3 x On War, 1 x ivory Horn,2 x Ultra Corselet,2 x Justice Medal,1 x Adv City Teleporter" itemDesc="2 x Excalibur,3 x On War, 1 x ivory Horn,2 x Ultra Corselet,2 x Justice Medal,1 x Adv City Teleporter" iconUrl="images/icon/shop/battlechest_of_christmas.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.66" name="Crown of Flowers" itemType="宝箱" dayLimit="0" userLimit="1" desc="1 x Holy Helm of Mars,1 x Vesta' Blessing,2 x On Wars,3 x Random Medal,1 x Ivory Horn,2 x Ultra Corselet,1 x Adv City Teleporter. " itemDesc="1 x Holy Helm of Mars,1 x Vesta' Blessing,2 x On Wars,3 x Random Medal,1 x Ivory Horn,2 x Ultra Corselet,1 x Adv City Teleporter. " iconUrl="images/icon/shop/battlechest_of_christmas.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.67" name="Gilded Jewelry Box" itemType="宝箱" dayLimit="0" userLimit="1" desc="750 cents,1 x Holy Helm of Mars,2 x On Wars" itemDesc="750 cents,1 x Holy Helm of Mars,2 x On Wars" iconUrl="images/icon/shop/battlechest_of_christmas.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.68" name="Evony Valentine's Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="This Evony Valentine's Package is worth 230 cents and contains:1 x Lion Medal,1 x Rose Medal,1 x Cross Medal,1 x Primary Guidelines,1 x Intermediate Guidelines,1 x War Horn,1 x Corselet,1 x Holy Water,1 x Hero Hunting,1 x Truce Agreement,5 x Amulet,1 x City Teleporter,1 x Casanova's Key" itemDesc="This the package you received for your $30 cents purchase during the Valentine's Day promotion! This package is full of items hand-picked to make your more effective in game ! Happy Holidays" iconUrl="images/icon/shop/Valentine_Package.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.69" name="Angel’s Boon" itemType="宝箱" dayLimit="0" userLimit="1" desc="This item gives one of the following types of items randomly: • Fleet Feet – 30% Reduced Troop Marching Time,• Endurance of the Immortals – 5% Increased Troop Hit Points for 12 hours,• Alchemist’s Amplifier – 15% Stat increase to all heroes for 1 hour." itemDesc="The sky above promises to aid you in your upcoming battles." iconUrl="images/icon/shop/angelboon.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.7" name="Pumpkin Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="These packages are delivered as gifts to players who purchased every $30 in Halloween!" itemDesc="These packages are delivered as gifts to players who purchased every $30 in Halloween!" iconUrl="images/icon/shop/Halloween.jpg" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.70" name="Fleet Feet" itemType="宝物" dayLimit="0" userLimit="0" desc="Use of this item on another player will increase the marching speed of their troops by 35% for 4 hours, this item can be stacked a total of 2 times." itemDesc="Speed is an important factor in all military applications; the ability to outmaneuver an enemy will ensure success on the field, and off. Be fast, be strong." iconUrl="images/icon/shop/fleetfeet.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.71" name="Endurance of the Immortals" itemType="宝物" dayLimit="0" userLimit="0" desc="Use of this item on another player will increase their troops’ hit points by 5% for 12 hours, this item can be stacked a total of 3 times." itemDesc="The endurance of a true immortal is unfailing, and they could singlehandedly change the tide of a battle. Through discipline and specialized training with a few helpful draughts, one can imbue their troops temporarily with endurance unmatched by normal man." iconUrl="images/icon/shop/enduranceoftheimmortas.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.72" name="Alchemist’s Amplifier" itemType="宝物" dayLimit="0" userLimit="0" desc="Use of this item on another player will increase the stats of all their heroes by 10% for 2 hour, this item can be stacked a total of 3 times." itemDesc="Alchemical advances have produced a draught that when taken in large doses causes exemplary heroes to become more powerful in all ways, alas… it is only temporary. For now." iconUrl="images/icon/shop/alchemistsamplifier.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.73" name="Devil’s Pact" itemType="宝箱" dayLimit="0" userLimit="1" desc="A pact with the Devil can grant you power over your enemies, but at what price?" itemDesc="This item gives one of the following types of items randomly:• Opportunist’s Plague – Instantly kills the entire population of a target city and reduces repopulation by 10% for 4 hours x2,• Lost in the Wastes – Troops from affected city march 15% slower than normal for 4 hours x3,• Poisoned Feast – All heroes in targeted city lose 10% of all stats, includes energy in Age 2 x3,• Broken Gates – gates are forced open or closed for a period of 1 hour on targeted city, player using the item can define if the gates are to be open or closed when the item is used x3" iconUrl="images/icon/shop/devilspact.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.74" name="Opportunist’s Plague" itemType="宝物" dayLimit="0" userLimit="0" desc="Use of this item on a chosen city will instantly kill the total population of the targeted city, and reduce their repopulation rate by 10% for 4 hours, this item can be used once every 24 hours per city." itemDesc="For ages various plagues have ravaged people, reducing their populations to almost nothing, and creating graveyards where once thriving cities existed." iconUrl="images/icon/shop/opportunistsplague.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.75" name="Lost in the Wastes" itemType="宝物" dayLimit="0" userLimit="0" desc="Use of this item on a targeted city will increase the march time of all troops by 20% for 4 hours, this item can be stacked a total of 3 times." itemDesc="Traveling through the unknown requires good navigation and smart scouts. Sometimes scouts disappear and compasses end up broken. Eventually the force will get home, but their march will be a long tedious trek through the unknown." iconUrl="images/icon/shop/lostinthewastes.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.76" name="Poisoned Feast" itemType="宝物" dayLimit="0" userLimit="0" desc="Use of this item on a targeted city will decrease the stats of all their heroes by 20% for 2 hours, this item can be stacked a total of 3 times." itemDesc="Poison is an effective tool to weaken and demoralize and opposing force. Used strategically it’s hard to detect and impossible to defend against. Weaken those who stand against you with a friendly meal." iconUrl="images/icon/shop/poisonedfeast.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.77" name="Broken Gates" itemType="宝物" dayLimit="0" userLimit="0" desc="Players can apply the item to another player to lock gates open for 1 hour, players can apply item on themselves to unlock gates, this can be used on a city a maximum of 5 times per day." itemDesc="Good gates are important for defense. A smart attacker will learn the best way to ruin a city’s gates prior to attacking." iconUrl="images/icon/shop/brokengates.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.77.2" name="Broken Gates" itemType="宝物" dayLimit="0" userLimit="0" desc="Players can apply the item to another player to lock gates open for 1 hour, players can apply item on themselves to unlock gates, this can be used on a city a maximum of 5 times per day." itemDesc="Good gates are important for defense. A smart attacker will learn the best way to ruin a city’s gates prior to attacking." iconUrl="images/icon/shop/brokengates.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.78" name="Evony Easter Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="Contains Nation Medal, Justice Medal, Adv City Teleporter, City Teleporter (2), War Horn (2), Corselet (2), Amulet (4), Key of Lilies." itemDesc="Full of Easter goodies, including a Key of Lilies to open an Easter Chest!." iconUrl="images/icon/shop/easterpackage.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.79" name="Easter Chest" itemType="宝箱" dayLimit="0" userLimit="1" desc="Open with a Key of Lilies, which you get with a purchase of $30 or more by April 15th." itemDesc="Could be worth over 1000 Cents!" iconUrl="images/icon/shop/chest.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.8" name="Pumpkin Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="These packages are delivered as gifts to players who purchased every $30 in Halloween!" itemDesc="These packages are delivered as gifts to players who purchased every $30 in Halloween!" iconUrl="images/icon/shop/Halloween.jpg" price="0" playerItem="true"/>
