  <itemEum id="player.box.present.money.357" name="The Fatted Feast" itemType="宝箱" dayLimit="0" userLimit="0" desc="The Fatted Feast contains the best items found throughout the countryside, to aid in your efforts against your neighbors." itemDesc="Opening the Fatted Feast will grant you the following:1 x Adv Teleporter,3 x War Teleporter,5 x War Ensign,1 x Senior Medal Box,1 x Stone of Finding,1x Golden Key of the Harvest." iconUrl="images/icon/shop/thefattedfeast.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.358" name="The Chest of Bounty" itemType="宝箱" dayLimit="0" userLimit="0" desc="Another year, and the turkeys are in a panic! Clever hunters have been tracking them down and taking their bounties. Here is what your hunters have brought you!." itemDesc="Once opened, The Chest of Bounty will randomly provide you with one of the following groups of items:Brace of Jakes,Solstice Stores,Heart of the Harvest,Harvester’s Great Bounty,Offering of Thank." iconUrl="images/icon/shop/thechestofbounty.png" price="0" playerItem="true"/>
