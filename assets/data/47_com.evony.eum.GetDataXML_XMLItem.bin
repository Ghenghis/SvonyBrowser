  <itemEum id="player.box.present.money.348" name="500,000,000 of a random resource" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.349" name="Sun’s Gift" itemType="宝箱" dayLimit="0" userLimit="0" desc="The Sun’s End cult has failed and abandoned their shrines. Your troops searched the buildings and found them stocked with supplies. The local landholders took a share, but your soldiers saved the best for you." itemDesc="Opening this gift will give you 1 Silver Key, and 50 cents!" iconUrl="images/icon/shop/sunsgift2016.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.35" name="Special Thanksgiving Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes: Chest A (Freedom Medal, Justice Medal, Nation Medal, Michelangelo's Script, Plowshares, Arch Saw, Quarrying Tools, Blower, War Ensign, Excalibur, The Wealth of Nations, Amulet) or Chest B (Primary Guidelines, Intermediate Guidelines, Hero Hunting, Merchant Fleet, Plowshares, Double Saw, Quarrying Tools, Blower, Michelangelo's Script, Tax Policy, The Wealth of Nations) or Chest C (Excalibur, War Horn, Corselet, Truce Agreement, War Ensign, Adv City Teleporter, Michelangelo's Script)" itemDesc="These chests are sent to you as Thanksgiving gifts from your friends in the game. They require a Special Chest Key to open. You can obtain a Special Chest Key for every $30 worth of purchases made during Thanksgiving. When opened, you will receive a random assortment of Special Thanksgiving Package A, B, or C." iconUrl="images/icon/shop/Christmas1.jpg" price="300" playerItem="true"/>
  <itemEum id="player.box.present.money.350" name="Demon's Satchel" itemType="宝箱" dayLimit="0" userLimit="0" desc="This is a satchel made from the skin of one of Chernabog’s demon minions. The items inside are a bit messy, but wholly useful to help in your future wars." itemDesc="Your free gift, included with $30 purchase. Includes:1 x Adv Teleporter,3 x War Teleporter,5 x Stygandr's Banner of the Horde,2 x Stone of Finding,5 Mil of Each Resource,1 x The witches'key" iconUrl="images/icon/shop/demonssatchel.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.351" name="Chernabog's Mimic" itemType="宝箱" dayLimit="0" userLimit="0" desc="From the top of Chernabog’s mountain, evil and ghoulish fear flows. In the moments before sunrise, when the evil ebbs and light begins to touch the ground, villagers creep up the mountain and gather whatever was left over from the demoniac revelries of the witches on the mountain." itemDesc="Once opened, Chernabog's Mimic will randomly provide you with one of the following sets of items:Chernabog’s Summit Prize,Demon’s Penitence,The Prize,Witches’ Strongbox,A Monstrous Prize." iconUrl="images/icon/shop/chernabogsmimic.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.352" name="Offering of Thanks" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
