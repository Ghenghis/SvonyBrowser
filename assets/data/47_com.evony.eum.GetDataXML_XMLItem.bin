  <itemEum id="player.box.present.money.83" name="Painted Easter Egg (common)" itemType="宝箱" dayLimit="0" userLimit="1" desc="Painted Easter Egg (common) 2 x Epitome of Military Science,2 x Adv City Teleporter,3 x City Teleporter,1 x Wealth of Nations,1 x Penicillin." itemDesc="Painted Easter Egg (common) 2 x Epitome of Military Science,2 x Adv City Teleporter,3 x City Teleporter,1 x Wealth of Nations,1 x Penicillin." iconUrl="images/icon/shop/chest.png" price="0" playerItem="true"/>
