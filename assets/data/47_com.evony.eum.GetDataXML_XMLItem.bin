  <itemEum id="player.item.imperialorder2017" name="Imperial Order" itemType="宝物" dayLimit="0" userLimit="0" desc="This order will reduce troop upkeep by 50% for 24 hours. Multiple Imperial Orders will increase the duration. Buff expires March 18th." itemDesc="Troops eat less when under threat of death." iconUrl="images/icon/shop/imperialorder2017.png" price="0" playerItem="true"/>
  <itemEum id="player.item.lovesong" name="Love Song" itemType="宝物" dayLimit="0" userLimit="0" desc="If music be the food of love, play on." itemDesc="Upon use, your enraptured troops will eat 50% less food for 24 hours. Stacks up to 5 times." iconUrl="images/icon/shop/sinterklaasscookies.png" price="0" playerItem="true"/>
  <itemEum id="player.item.lovesong.2015" name="Love Song 2015" itemType="宝物" dayLimit="0" userLimit="0" desc="If music be the food of love, play on." itemDesc="Upon use, your enraptured troops will eat 50% less food for 24 hours. Item will work from February 9th until February 21st." iconUrl="images/icon/shop/lovesong2015.png" price="0" playerItem="true"/>
  <itemEum id="player.item.lovesong.2016" name="Love Song 2016" itemType="宝物" dayLimit="0" userLimit="0" desc="If music be the food of love, play on." itemDesc="Upon use, your enraptured troops will eat 50% less food for 24 hours. Item will work from February 5th until February 21st. ." iconUrl="images/icon/shop/lovesong2016.png" price="0" playerItem="true"/>
  <itemEum id="player.item.memoryofthesun" name="Memory of the Sun" itemType="宝物" dayLimit="0" userLimit="0" desc="As the days grow shorter, and the harvest is in full swing, farmers enjoy this draught that gives them the strength to finish the day." itemDesc="When used during the End of Summer promotion, this item will provide you with a 50% reduction in upkeep for 24 hours. Using multiple items will increase the timer. The timer will end at the end of the day on September 18th." iconUrl="images/icon/shop/memoryofthesun.png" price="0" playerItem="true"/>
  <itemEum id="player.item.merchantspackage" name="Merchant’s Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="You have received an oddly shaped but altogether non-descript package from a merchant in the caravan." itemDesc="Open this package to see what prize you have received for collecting the requested Gilded Horns." iconUrl="images/icon/shop/merchantspackage.png" price="0" playerItem="true"/>
  <itemEum id="player.item.overflowingcup" name="Overflowing Cup" itemType="宝物" dayLimit="0" userLimit="0" desc="The Overflowing Cup will help reduce the feelings of hunger your troops feel." itemDesc="When used your troops will need 50% less upkeep for 24 hours, and can be used between August 28th and September 8th. After maintenance on October 8th any unused item time will be removed." iconUrl="images/icon/shop/overflowingcup.png" price="0" playerItem="true"/>
  <itemEum id="player.item.pieceofrainbow" name="Piece of Rainbow" itemType="宝物" dayLimit="0" userLimit="1" desc="A fragment of a shattered rainbow. If you had a few more pieces, you could reconstruct the path to riches!" itemDesc="Collect 10 Piece of Rainbow to turn in for the Treasure Hunt quest." iconUrl="images/icon/shop/pieceofrainbow.png" price="0"/>
  <itemEum id="player.item.quest.artifactofthekrampus" name="Artifact of the Krampus" itemType="宝物" dayLimit="0" userLimit="1" desc="" itemDesc="This is an artifact of the Krampus, found in the darkness of winter. On it is inscribed, “Gruss vom Krampus,” and it holds a chill that can’t be explained by nature. These artifacts can be traded for items of value." iconUrl="images/icon/shop/artifactofthekrampus.png" price="0"/>
  <itemEum id="player.item.quest.crestofthetower" name="Crest of the Tower" itemType="宝物" dayLimit="0" userLimit="1" desc="This tattered crest was ripped from a standard bearer of the Tower of Cygnus. It is smeared in the blood and feathers of the creature that carried it." itemDesc="This tattered crest was ripped from a standard bearer of the Tower of Cygnus. It is smeared in the blood and feathers of the creature that carried it." iconUrl="images/icon/shop/crestofthetower.png" price="0"/>
  <itemEum id="player.item.quest.englishhelmet" name="English Helmet" itemType="宝物" dayLimit="0" userLimit="1" desc="A helmet taken as a trophy from one of the fallen English soldiers found in the burn." itemDesc="This crushed helmet is your trophy from the recent battle." iconUrl="images/icon/shop/englishhelmet.png" price="0"/>
  <itemEum id="player.item.quest.englishhelmet.2015" name="English Helmet 2015" itemType="宝物" dayLimit="0" userLimit="1" desc="A helmet taken as a trophy from one of the fallen English soldiers found in the burn." itemDesc=" This crushed helmet is your trophy from the recent battle." iconUrl="images/icon/shop/englishhelmet2015.png" price="0"/>
  <itemEum id="player.item.quest.freezingectoplasm" name="Freezing Ectoplasm" itemType="宝物" dayLimit="0" userLimit="1" desc="This ectoplasm is freezing to the touch, and has been left behind by the ghosts haunting the night." itemDesc="This ectoplasm is freezing to the touch, and has been left behind by the ghosts haunting the night." iconUrl="images/icon/shop/freezingectoplasm.png" price="0"/>
  <itemEum id="player.item.quest.harvesttoken.2014" name="Harvest Token 2014" itemType="宝物" dayLimit="0" userLimit="1" desc="Across the countryside these tokens have been placed, and the local lords are offering rewards in exchange for anyone recovering one." itemDesc="Across the countryside these tokens have been placed, and the local lords are offering rewards in exchange for anyone recovering one." iconUrl="images/icon/shop/harvesttoken2014.png" price="0"/>
  <itemEum id="player.item.quest.harvesttoken.2015" name="Harvest Token 2015" itemType="宝物" dayLimit="0" userLimit="1" desc="Across the countryside these tokens have been placed, and the local lords are offering rewards in exchange for anyone recovering one.." itemDesc="" iconUrl="images/icon/shop/harvesttoken2015.png" price="0"/>
  <itemEum id="player.item.quest.harvesttoken.2016" name="Harvest Token" itemType="宝物" dayLimit="0" userLimit="1" desc="Across the countryside these tokens have been placed, and the local lords are offering rewards in exchange for anyone recovering one." itemDesc="Across the countryside these tokens have been placed, and the local lords are offering rewards in exchange for anyone recovering one." iconUrl="images/icon/shop/harvesttoken2016.png" price="0"/>
  <itemEum id="player.item.quest.shadowofthepunxa" name="Shadow of the Punxa" itemType="宝物" dayLimit="0" userLimit="1" desc="This shadow has escaped from a giant punxa. Until reunited, both will cause destruction in your land." itemDesc="This shadow has escaped from a giant punxa. Until reunited, both will cause destruction in your land." iconUrl="images/icon/shop/shadowofthepunxa.png" price="0"/>
  <itemEum id="player.item.quest.shakespear" name="Shake Spear" itemType="宝物" dayLimit="0" userLimit="1" desc="This unsteady spear is not much good for hunting. Perhaps someone will accept it in trade." itemDesc="A spear of great renown." iconUrl="images/icon/shop/shakespear.png" price="0"/>
  <itemEum id="player.item.quest.trinketoftheorder" name="Trinket of the Order" itemType="宝物" dayLimit="0" userLimit="1" desc="" itemDesc="You’ve found a trinket of the Ovo Renovatur order! As a celebration of the rebirth of nature, the order will give you a gift for finding it!" iconUrl="images/icon/shop/trinketoftheorder.png" price="0"/>
  <itemEum id="player.item.quest.trinketoftheorder.2015" name="Trinket of the Order 2015" itemType="宝物" dayLimit="0" userLimit="1" desc="A trinket of the order taken as a trophy from one of the fallen rabbits." itemDesc="This egg is your trophy from the recent battle." iconUrl="images/icon/shop/trinketoftheorder2015.png" price="0"/>
  <itemEum id="player.item.relicofthekrampus" name="Relic of the Krampus" itemType="宝物" dayLimit="0" userLimit="1" desc="This is a relic of the Krampus, found in the darkness of winter, it holds a chill that can’t be explained by nature. These relics can be traded for items of value." itemDesc="One can gather a maximum of 6 Relic of the Krampus per day." iconUrl="images/icon/shop/relicofthekrampus.png" price="0"/>
  <itemEum id="player.item.resources" name="resources" itemType="宝箱" dayLimit="0" userLimit="1" desc="" itemDesc="" iconUrl="images/icon/shop/chestoftheovorenovatur.png" price="0" playerItem="true"/>
  <itemEum id="player.item.saxon.beer.chest" name="Saxon Beer Chest" itemType="宝箱" dayLimit="0" userLimit="1" desc="These chests are sent to you as Saxon Beer gifts from your friends in the game. They require a Saxony Chest Key to open. You can obtain a Saxony Chest Key for every $30 worth of purchases made during this promotion. When opened, you will receive the contents of Saxon Beer Chest A, B, C, D, or E at random." itemDesc="Opening the Saxon Beer Chest will give the player one of the following, randomly:Saxon’s Boot of Refreshment,The Friar’s Stout Barrel,Brewmaster’s Best Firkin,Dragonstooth Firkin,The Harvester’s Pin" iconUrl="images/icon/shop/saxonbeerchest.png" price="0" playerItem="true"/>
  <itemEum id="player.item.shakespearaward" name="Shake Spear Award" itemType="宝箱" dayLimit="0" userLimit="1" desc="" itemDesc="" iconUrl="images/icon/shop/giftofthewisemystics.png" price="0" playerItem="true"/>
  <itemEum id="player.item.sinterklaascookies.2015" name="Sinterklaas’s Cookies 2015" itemType="宝物" dayLimit="0" userLimit="0" desc="A plate of cookies for enjoyment in the middle of the night while awaiting Sinterklaas.." itemDesc="When used you will receive a 50% bonus to upkeep for 24 hours. This item is stackable, and will be usable between December 22nd, 2015 and January 6th, 2015. Once Jan 7th comes though, this buff will expire if you haven't used it yet." iconUrl="images/icon/shop/sinterklaascookies.png" price="0" playerItem="true"/>
  <itemEum id="player.item.sinterklaasscookies" name="Sinterklaas’s Cookies" itemType="宝物" dayLimit="0" userLimit="0" desc="A plate of cookies for enjoyment in the middle of the night while awaiting Sinterklaas." itemDesc="When used you will receive a 50% bonus to upkeep for 24 hours. This item is stackable, and will be usable between December 23rd, 2014 and January 5th, 2015. Once Jan 6th comes though, this buff will expire if you haven't used it yet." iconUrl="images/icon/shop/sinterklaasscookies.png" price="0" playerItem="true"/>
  <itemEum id="player.item.snowball" name="Snowball" itemType="宝物" dayLimit="0" userLimit="1" desc="Collect 10 Snowballs to turn in for the Snowball Fight quest." itemDesc="You've found a snowball! Collect them so you're always ready for a snowball fight!" iconUrl="images/icon/shop/snowball.png" price="0"/>
  <itemEum id="player.item.sterlingcup" name="Sterling Cup" itemType="宝物" dayLimit="0" userLimit="0" desc=" The Sterling cup is held by the victor, that symbol raises the morale of troops, filling them with pride, and keeping their thoughts only on the upcoming fight. Wine and revelry become a thing of the past, they are ready to arch." itemDesc=" When used your troops will need 50% less upkeep for 24 hours." iconUrl="images/icon/shop/sterlingcup.png" price="0" playerItem="true"/>
  <itemEum id="player.item.stoneoffinding" name="Stone of Finding" itemType="宝物" dayLimit="0" userLimit="1" desc=" Through the dark magic's of the Kronnish clerics, this simple rock has been charged with a magic of finding. When your cherished hero is lost, remembering their name and using this stone will summon them back to you." itemDesc="Using this item will allow you to choose a single hero to return to you if they have been lost within the last 24 hours or less. You can't use the item to restore your hero if it has been dismissed, released, or has fled due to rioting." iconUrl="images/icon/shop/stoneoffinding.png" price="30"/>
  <itemEum id="player.item.stygandrsbannerofthehorde" name="Stygandr’s Banner of the Horde" itemType="宝物" dayLimit="0" userLimit="1" desc="The military and logistical genius of Lord Stygandr has allowed the development of new logistical plans that allow you to field a greater number of troops on the field of battle." itemDesc="When applied you will be able to send an army with up to an additional 650k units." iconUrl="images/icon/shop/stygandrsbannerofthehorde.png" price="0"/>
  <itemEum id="player.item.suppliesoftheemperor" name="Supplies of the Emperor" itemType="宝箱" dayLimit="0" userLimit="1" desc="Following a total defeat, the Emperor’s troops withdrew in such disarray that many of their supplies were left behind. Your soldiers have brought you a large collection of the Emperor’s lost equipment." itemDesc="Includes:2 x Adv Teleporter,1 x War Teleporter,3 x War Ensign,1 x War Horn,1 x Excalibur,1 x Ultra Corselet" iconUrl="images/icon/shop/suppliesoftheemperor.png" price="0" playerItem="true"/>
  <itemEum id="player.item.sweatofthesun" name="Sweat of the Sun" itemType="宝物" dayLimit="0" userLimit="0" desc="This alchemical concoction is traded freely amongst Sommerdawn revelers. The flavorful and golden elixir promises to keep you awake, and slake off hunger down a day!." itemDesc="When used during the promotion, this item will provide you with a 50% reduction in upkeep for 24 hours. Using multiple items will increase the timer. The timer will end at the start of the day on July 8th." iconUrl="images/icon/shop/sweatofthesun.png" price="0" playerItem="true"/>
  <itemEum id="player.item.talismanofthesated" name="Talisman of the Sated" itemType="宝物" dayLimit="0" userLimit="0" desc="The Talisman of the Sated will provide your troops with energy and happiness, resulting in them needing 50% less food for upkeep." itemDesc="When used your troops will need 50% less upkeep for 24 hours." iconUrl="images/icon/shop/talismanofthesated.png" price="0" playerItem="true"/>
  <itemEum id="player.item.talismanofthesated.2015" name="Talisman of the Sated 2015" itemType="宝物" dayLimit="0" userLimit="0" desc="The Talisman of the Sated will provide your troops with energy and happiness, resulting in them needing 50% less food for upkeep." itemDesc="When used your troops will need 50% less upkeep for 24 hours." iconUrl="images/icon/shop/talismanofthesated2015.png" price="0" playerItem="true"/>
  <itemEum id="player.item.talismanofthesated2017" name="Talisman of the Sated" itemType="宝物" dayLimit="0" userLimit="0" desc="The Talisman of the Sated will provide your troops with energy and happiness, resulting in them needing 50% less food for upkeep." itemDesc="When used your troops will need 50% less upkeep for 24 hours." iconUrl="images/icon/shop/talismanofthesated2017.png" price="0" playerItem="true"/>
  <itemEum id="player.item.thenobleharvestreward" name="The Noble Harvest Reward" itemType="宝箱" dayLimit="0" userLimit="1" desc="Opening the Noble Harvest Reward will grant you one random prize from the 2013 Queen's Feast Promotion" itemDesc="The nobility in your lands have created this reward as a bounty for finding a Harvest Token" iconUrl="images/icon/shop/thenobleharvestreward.png" price="0" playerItem="true"/>
  <itemEum id="player.item.thenobleharvestreward.2015" name="The Noble Harvest Reward 2015" itemType="宝箱" dayLimit="0" userLimit="1" desc="The nobility in your lands have created this reward as a bounty for finding a Harvest Token." itemDesc="Opening the Noble Harvest Reward will grant you one random prize from the 2015 Queen's Feast Promotion." iconUrl="images/icon/shop/thenobleharvestreward2015.png" price="0" playerItem="true"/>
  <itemEum id="player.item.thenobleharvestreward2014" name="The Noble Harvest Reward 2014" itemType="宝箱" dayLimit="0" userLimit="1" desc="The nobility in your lands have created this reward as a bounty for finding a Harvest Token." itemDesc="Opening the Noble Harvest Reward will grant you one random prize from the 2014 Queen's Feast Promotion" iconUrl="images/icon/shop/thenobleharvestreward2014.png" price="0" playerItem="true"/>
  <itemEum id="player.item.thequeensharvestreward" name="The Queen’s Harvest Reward" itemType="宝箱" dayLimit="0" userLimit="1" desc="Opening the Queen’s Harvest Reward will grant you one random prize from the 2016 Queen’s Feast Promotion." itemDesc="The nobility in your lands have created this reward as a bounty for finding a Harvest Token." iconUrl="images/icon/shop/thequeensharvestreward.png" price="0" playerItem="true"/>
  <itemEum id="player.item.travellerseffects" name="Traveller’s Effects" itemType="宝箱" dayLimit="0" userLimit="1" desc="Open the Traveller’s Effects to a random item." itemDesc="Unlucky travelers have been disappearing all across the land, for some, this is all that remains." iconUrl="images/icon/shop/travellerseffects.png" price="0" playerItem="true"/>
  <itemEum id="player.item.trophyofthetower" name="Trophy of the Tower" itemType="宝箱" dayLimit="0" userLimit="1" desc="Opening the Trophy of the Tower will grant you one random prize from the Summerdawn 2017 promotion." itemDesc="A bounty for the destruction of the force that carried the Crest of the Tower.." iconUrl="images/icon/shop/trophyofthetower.png" price="0" playerItem="true"/>
  <itemEum id="player.item.turkeyhunt" name="Turkey Feather" itemType="宝物" dayLimit="0" userLimit="1" desc="You’ve found some turkey feather! Gather enough and you can capture a turkey for dinner!" itemDesc="Collect 10 Turkey Feather to turn in for the Turkey Hunt quest." iconUrl="images/icon/shop/turkeyfeather.png" price="0"/>
  <itemEum id="player.item.warmongerspack" name="Warmonger’s Pack " itemType="宝箱" dayLimit="0" userLimit="0" desc="The Warmonger’s Pack is an exclusive pack available to players who have finished in a top slot on their server in the contest. " itemDesc="The Warmonger’s Pack includes the following:10 x War Ensign,3 x Fleet Feet,2 x Endurance of the Immortals,2 x Broken Gates,1 x Opportunist’s Plague,1 x Poisoned Feast,1 x Dream Truce" iconUrl="images/icon/shop/warmongerspack.png" price="0" playerItem="true"/>
  <itemEum id="player.item.warpackage2016" name="War Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/warpackage2016.png" price="0" playerItem="true"/>
  <itemEum id="player.item.wolfpaw" name="Wolf's Paw" itemType="宝物" dayLimit="0" userLimit="1" desc="This wolf paw totem was found in the ruins of your most recent raid. Barbarians have been trading them recently, and may barter with you." itemDesc="This wolf paw totem was found in the ruins of your most recent raid. Barbarians have been trading them recently, and may barter with you." iconUrl="images/icon/shop/wolfpaw.png" price="0"/>
  <itemEum id="player.itish.stew" name="Itish Stew" itemType="宝物" dayLimit="0" userLimit="0" desc="The famous Irish Stew is both tasty and hearty. Eat this and you won’t be hungry for hours!" itemDesc="A gift from your friends during the St Patrick’s Day 2013  promotion. Use it to get 24 hours of 50% upkeep in ALL your cities any time from March 14th through March 19th. Irish Stew is stackable for the period of the promotion. Once maintenance on March 20th comes, this item and its timers will expire." iconUrl="images/icon/shop/itishstew.png" price="0" playerItem="true"/>
  <itemEum id="player.key.beardedkeyoftheharvest" name="Bearded Key of the Harvest" itemType="宝物" dayLimit="0" userLimit="0" desc="This key is decorated by a trophy turkey beard. It open a similarly adorned lock from this year’s Harvest." itemDesc="Using this item will open a Chest from the 2013 Queen's Feast Promotion." iconUrl="images/icon/shop/beardedkeyoftheharvest.png" price="0"/>
  <itemEum id="player.key.birthdaykey" name="Birthday Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key fits the 5th Anniversary Chest." itemDesc=" This key is used to open the 5th Anniversary Chest." iconUrl="images/icon/shop/birthdaykey.png" price="0"/>
  <itemEum id="player.key.birthdaykey.2015" name="Birthday Key 2015" itemType="宝物" dayLimit="0" userLimit="0" desc="This key fits the 6th Anniversary Chest." itemDesc="This key is used to open the 6th Anniversary Chest." iconUrl="images/icon/shop/birthdaykey2015.png" price="0"/>
  <itemEum id="player.key.birthdaykey.2016" name="Birthday Key 2016" itemType="宝物" dayLimit="0" userLimit="0" desc="This key fits the 7th Anniversary Chest." itemDesc="This key is used to open the 7th Anniversary Chest." iconUrl="images/icon/shop/birthdaykey2016.png" price="0"/>
  <itemEum id="player.key.birthdaykey2017" name="Birthday Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key fits the 8th Anniversary Chest." itemDesc="This key is used to open the 8th Anniversary Chest." iconUrl="images/icon/shop/birthdaykey2017.png" price="0"/>
  <itemEum id="player.key.bull" name="Wooden Bull Opener" itemType="宝物" dayLimit="0" userLimit="0" desc="You can use this key to open one Hollow Wooden Bull sent to you by your friends. If you don’t have any Hollow Wooden Bull, you should ask your friends to send you some!" itemDesc="You can open any Hollow Wooden Bull your friends gave you with this key once." iconUrl="images/icon/shop/WoodenBullOpener.png" price="0"/>
  <itemEum id="player.key.casanova" name="Casanova’s Key" itemType="宝物" dayLimit="0" userLimit="0" desc="Casanova’s key will open the chests received during the Valentine’s Day promotion." itemDesc="Casanova’s key will help you get into the most jealously guarded treasures found in the land. " iconUrl="images/icon/shop/playerkeycasanova.png" price="0"/>
  <itemEum id="player.key.churchkey" name="Church Key" itemType="宝物" dayLimit="0" userLimit="0" desc=" This key will open the Field Chest of provisions you received for the upcoming battle." itemDesc="This key is used to open the Field Chest." iconUrl="images/icon/shop/churchkey.png" price="0"/>
  <itemEum id="player.key.easter" name="Special Easter Chest Key" itemType="宝物" dayLimit="0" userLimit="0" desc="You can use this key to open one Special Easter Chest sent to you by your friends. If you don’t have any Special Easter Chests, you should ask your friends to send you some!" itemDesc="You can open any Special Easter Chest your friends gave you with this key once." iconUrl="images/icon/shop/StPatricksDayKey.png" price="0"/>
  <itemEum id="player.key.easterkey" name="Easter Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key fits the 2014 Easter chest, the Gift of the Ovo Renovatur." itemDesc="This key is used to open the Gift of the Ovo Renovatur." iconUrl="images/icon/shop/easterkey.png" price="0"/>
  <itemEum id="player.key.easterkey2015" name="Easter Key 2015" itemType="宝物" dayLimit="0" userLimit="0" desc="This key fits the 2015 Easter chest, the Gift of the Ovo Renovatur." itemDesc="This key is used to open the Gift of the Ovo Renovatur." iconUrl="images/icon/shop/easterkey2015.png" price="0"/>
  <itemEum id="player.key.easterkey2017" name="Easter Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key fits the 2017 Easter chest, the Gift of the Ovo Renovatur." itemDesc="This key is used to open the Gift of the Ovo Renovatur." iconUrl="images/icon/shop/easterkey2017.png" price="0"/>
  <itemEum id="player.key.easter_package" name="Special Easter Chest Key" itemType="宝物" dayLimit="0" userLimit="0" desc="You can open one Special Easter Chest your friends gave you with this key. You can get Chest A (Freedom Medal, Justice Medal, Nation Medal, Michelangelo's Script, Plowshares, Arch Saw, Quarrying Tools, Blower, War Ensign, Excalibur, The Wealth of Nations, Amulet) or Chest B (Primary Guidelines, Intermediate Guidelines, Hero Hunting, Merchant Fleet, Plowshares, Double Saw, Quarrying Tools, Blower, Michelangelo's Script, Tax Policy, The Wealth of Nations) or Chest C (Excalibur, War Horn, Corselet, Truce Agreement, War Ensign, Adv City Teleporter, Michelangelo's Script)." itemDesc="You can open one Special Easter Chest your friends gave you with this key. " iconUrl="images/icon/shop/Christmas5.jpg" price="0"/>
  <itemEum id="player.key.evony_easter_package" name="Key of Lilies" itemType="宝物" dayLimit="0" userLimit="0" desc="This key opens one Evony Easter Chest" itemDesc="A shining key, wrapped in the stems of beautiful Easter Lilies" iconUrl="images/icon/shop/key.png" price="0"/>
  <itemEum id="player.key.faeryringkey" name="Faery Ring Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key was found by one of your gameskeepers. It was seen sitting in the middle of a faery ring, and shaped in the shape of the ring it was found in. Reports from throughout the land suggest this key will open a faery chest." itemDesc="Use this key to open the Iron Banded Faery Chest from the 2015 St. Patrick’s Day promotion." iconUrl="images/icon/shop/faeryringkey.png" price="0"/>
  <itemEum id="player.key.gingerbread" name="Gingerbread Key" itemType="宝物" dayLimit="0" userLimit="0" desc="Use this key to open a gift exchange chest from the Christmas 2012 promotion." itemDesc="This key is made from freshly baked gingerbread. It looks like it opens the lock to the Christmas Chests." iconUrl="images/icon/shop/gingerbreadkey.png" price="0"/>
  <itemEum id="player.key.goldenkeyoftheharvest" name="Golden Key of the Harvest" itemType="宝物" dayLimit="0" userLimit="0" desc=" This key is decorated by a small turkey feather. It opens a similarly adorned lock from this year’s Harvest. Please add a turkey beard to this item." itemDesc="Using this item will open a Chest from the 2016 Queen’s Feast Promotion." iconUrl="images/icon/shop/goldenkeyoftheharvest.png" price="0"/>
  <itemEum id="player.key.goldhollykey" name="Gold Holly Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key is made from the purest gold, and holds the shape of a perfect tree." itemDesc="Using this item will open a Chest from the 2016 Christmas Promotion." iconUrl="images/icon/shop/goldhollykey.png" price="0"/>
  <itemEum id="player.key.halloween" name="Skeleton Key" itemType="宝物" dayLimit="0" userLimit="0" desc="You can use this key to open one Locked Halloween Chest sent to you by your friends. If you don’t have any Locked Halloween Chest, you should ask your friends to send you some!" itemDesc="You can use this key to open one Locked Halloween Chest sent to you by your friends. If you don’t have any Locked Halloween Chest, you should ask your friends to send you some!" iconUrl="images/icon/shop/SkeletonKey.jpg" price="0"/>
  <itemEum id="player.key.halloween.2" name="Skeleton Key 2" itemType="宝物" dayLimit="0" userLimit="0" desc="The skeleton key you liberated from the Baba Yaga will let you open any skeletal lock, but only once before it breaks." itemDesc="The Skeleton Key will allow you to open one chest from the Halloween 2012 promotion." iconUrl="images/icon/shop/skeletonkey2.png" price="0"/>
  <itemEum id="player.key.halloween.2015" name="The Blood Key" itemType="宝物" dayLimit="0" userLimit="0" desc="A key infused with blood spilled on the altar of the Amun Thun, this will open the chests that the Boneslayer Morgun keep their prizes in." itemDesc="This key is used to open the Boneslayer’s Treasure Chest." iconUrl="images/icon/shop/thebloodkey.png" price="0"/>
  <itemEum id="player.key.halloween.3" name="Skeleton Key 3" itemType="宝物" dayLimit="0" userLimit="0" desc="The skeleton key you liberated from the Baba Yaga will let you open any skeletal lock, but only once before it breaks." itemDesc=" The Skeleton Key will allow you to open one chest from the Halloween 2013 promotion." iconUrl="images/icon/shop/skeletonkey2013.png" price="0"/>
  <itemEum id="player.key.jakekeyoftheharvest" name="Jake Key of the Harvest" itemType="宝物" dayLimit="0" userLimit="0" desc=" This key is decorated by a small turkey feather. It opens a similarly adorned lock from this year’s Harvest." itemDesc="Using this item will open a Chest from the 2014 Queen’s Feast Promotion" iconUrl="images/icon/shop/jakekeyoftheharvest.png" price="0"/>
  <itemEum id="player.key.keyofcrossing" name="Key of Crossing" itemType="宝物" dayLimit="0" userLimit="0" desc="Warning: May trigger civil war and/or the fall of the Republic." itemDesc="Opens one Rubicon Chest. Rubicon Chests are given by friends and alliance members when they make a $30 purchase." iconUrl="images/icon/shop/keyofcrossing.png" price="0"/>
  <itemEum id="player.key.keyofdonar" name="Key of Donar" itemType="宝物" dayLimit="0" userLimit="0" desc="This key is made from polished steel, and holds the shape of a perfect tree." itemDesc="Using this item will open a Chest from the 2014Christmas Promotion." iconUrl="images/icon/shop/keyofdonar.png" price="0"/>
  <itemEum id="player.key.malebolgian" name="Malebolgian Key" itemType="宝物" dayLimit="0" userLimit="0" desc="As you hold this key burns to the touch and smells like oil." itemDesc="The Malebolgian Key will open The Malebolge Chest from the 2014 Evoween promotion.." iconUrl="images/icon/shop/malebolgiankey.png" price="0"/>
  <itemEum id="player.key.moonshard" name="The Moon’s Shard" itemType="宝物" dayLimit="0" userLimit="0" desc="This sliver of the moon will open the Sommerdawn’s Chest." itemDesc="Using this item will open a Chest from the Summerdawn’s Festival Promotion." iconUrl="images/icon/shop/moonshard2016.png" price="0"/>
  <itemEum id="player.key.newyear" name="Special New Year Key" itemType="宝物" dayLimit="0" userLimit="0" desc="You can open one Special New Year Chest your friends gave you with this key. You can get Chest A (Freedom Medal, Justice Medal, Nation Medal, Michelangelo's Script, Plowshares, Arch Saw, Quarrying Tools, Blower, War Ensign, Excalibur, The Wealth of Nations, Amulet) or Chest B (Primary Guidelines, Intermediate Guidelines, Hero Hunting, Merchant Fleet, Plowshares, Double Saw, Quarrying Tools, Blower, Michelangelo's Script, Tax Policy, The Wealth of Nations) or Chest C (Excalibur, War Horn, Corselet, Truce Agreement, War Ensign, Adv City Teleporter, Michelangelo's Script)." itemDesc="You can open one Special New Year Chest your friends gave you with this key." iconUrl="images/icon/shop/Christmas5.jpg" price="0"/>
  <itemEum id="player.key.patrick" name="St Patrick's Day Key" itemType="宝物" dayLimit="0" userLimit="0" desc="You can use this key to open one St Patrick's Day Chest sent to you by your friends. If you don't have any St Patrick's Day Chests, you should ask your friends to send you some!" itemDesc="You can open any St Patrick's Day Chest your friends gave you with this key once." iconUrl="images/icon/shop/StPatricksDayKey2.png" price="0"/>
  <itemEum id="player.key.santa" name="Secret Santa Key" itemType="宝物" dayLimit="0" userLimit="0" desc="You can use this key to open one Secret Santa Chest sent to you by your friends. You can get Chest A (Freedom Medal, Justice Medal, Nation Medal, Michelangelo's Script, Plowshares, Arch Saw, Quarrying Tools, Blower, War Ensign, Excalibur, The Wealth of Nations, Amulet) or Chest B (Primary Guidelines, Intermediate Guidelines, Hero Hunting, Merchant Fleet, Plowshares, Double Saw, Quarrying Tools, Blower, Michelangelo's Script, Tax Policy, The Wealth of Nations) or Chest C (Excalibur, War Horn, Corselet, Truce Agreement, War Ensign, Adv City Teleporter, Michelangelo's Script)." itemDesc="You can use this key to open one Secret Santa Chest sent to you by your friends. If you don't have any Secret Santa Chests, you should ask your friends to send you some!" iconUrl="images/icon/shop/Christmas5.jpg" price="0"/>
  <itemEum id="player.key.saxony" name="Saxony Chest Key" itemType="宝物" dayLimit="0" userLimit="0" desc="You can use this key to open one Saxon Beer Chest sent to you by your friends. If you don’t have any Saxon Beer Chests, you should ask your friends to send you some!" itemDesc="You can use this key to open one Saxon Beer Chest sent to you by your friends. If you don’t have any Saxon Beer Chests, you should ask your friends to send you some!" iconUrl="images/icon/shop/saxony.png" price="0"/>
  <itemEum id="player.key.shadowshornkey" name="Shadow’s Horn Key" itemType="宝物" dayLimit="0" userLimit="0" desc="Your mystics kept a small piece of the shadow’s horn from the punxa shadows, as part of the reattachment ceremony. This horn will open the Punxa’s Chest." itemDesc="This key will open the Punxa’s Chest from the 2016 Winter’s Shadow promotion." iconUrl="images/icon/shop/shadowshornkey.png" price="0"/>
  <itemEum id="player.key.silver" name="The Silver Key" itemType="宝物" dayLimit="0" userLimit="0" desc="You can use this key to open ANY chest in your Items inventory. The Silver Key is very fragile, and can only be used to open one chest before it breaks, so choose wisely!" itemDesc="You can use this key to open ANY chest in your Items inventory. The Silver Key is very fragile, and can only be used to open one chest before it breaks, so choose wisely!" iconUrl="images/icon/shop/TheSilverKey.png" price="50"/>
  <itemEum id="player.key.silverhollykey" name="Silver Holly Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key is made from the purest silver, and holds the shape of a perfect tree." itemDesc="Using this item will open a Chest from the 2015 Christmas Promotion." iconUrl="images/icon/shop/silverhollykey.png" price="0"/>
  <itemEum id="player.key.silverthaunkey" name="Festive Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key is made from the purest gold, and holds the sacred holly." itemDesc="Using this item will open a Chest from the 2013 Christmas Promotion." iconUrl="images/icon/shop/silverthaunkey.png" price="0"/>
  <itemEum id="player.key.special.chest" name="Special Chest Key" itemType="宝物" dayLimit="0" userLimit="0" desc="You can open any Special Chest your friends gave you with this key once. " itemDesc="You can open any Special Chest your friends gave you with this key once." iconUrl="images/icon/shop/Christmas5.jpg" price="0"/>
  <itemEum id="player.key.special.chest.keyofwinter" name="Key of Winter" itemType="宝物" dayLimit="0" userLimit="0" desc="You can use this key to open one Chest sent to you by your friends.If you don't have any Chest, you should ask your friends to send you some!" itemDesc="You can use this key to open one Chest sent to you by your friends.If you don't have any Chest, you should ask your friends to send you some!" iconUrl="images/icon/shop/key_of_winter.jpg" price="0"/>
  <itemEum id="player.key.special.chest.silver" name="Casanova's Key" itemType="宝物" dayLimit="0" userLimit="0" desc="You can use this key to open one Chest sent to you by your friends.If you don't have any Chest, you should ask your friends to send you some!" itemDesc="You can use this key to open one Chest sent to you by your friends.If you don't have any Chest, you should ask your friends to send you some!" iconUrl="images/icon/shop/TheSilverKey.png" price="0"/>
  <itemEum id="player.key.st.patrick" name="Emerald Key" itemType="宝物" dayLimit="0" userLimit="0" desc="Use this key to open a gift exchange chest from the 2013 St. Patrick's  promotion." itemDesc="Light passing through this key takes on a rich green glow." iconUrl="images/icon/shop/emeraldkey.png" price="0"/>
  <itemEum id="player.key.starcrossedkey" name="Silver Hearts Key" itemType="宝物" dayLimit="0" userLimit="0" desc="The Silver Hearts Key will open the lock to O’s bounty." itemDesc="Use this key to open O’s Chest of Treats from the 2015 Valentine’s Day promotion." iconUrl="images/icon/shop/silverheartskey.png" price="0"/>
