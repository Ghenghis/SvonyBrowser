  <itemEum id="player.box.present.money.90" name="Silver Set" itemType="宝箱" dayLimit="0" userLimit="0" desc="5% chance, worth 770 cents,1 x Holy Helm of Mars,1x Vesta,2 x On Wars,1x Fleet Feet,1x Endurance of the Immortals,1 x Ivory Horn,1 x Ultra Corselet,1 x Adv. City Teleporter" itemDesc="5% chance, worth 770 cents,1 x Holy Helm of Mars,1x Vesta,2 x On Wars,1x Fleet Feet,1x Endurance of the Immortals,1 x Ivory Horn,1 x Ultra Corselet,1 x Adv City Teleporter" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
