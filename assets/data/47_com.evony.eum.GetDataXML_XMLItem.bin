  <itemEum id="player.box.present.money.58" name="Battlechest of Christmas" itemType="宝箱" dayLimit="0" userLimit="1" desc="This chest was sent to you by one of your friends during the 2011 Christmas Promotion. When opened by a chest key,this special chest will award you one of 5 great sets of items.You can obtain a key by buying $30 worth of cents during the Christmas promotion." itemDesc="When opened gives one of. Chest A(Sleigh-full of Goddies) 1 x War Ensign,2 x Adv CityTeleporter,1 x Warr Horn,5 x Amulet.Chest B(Elf Assault Kit) 2 x Epitome of Military Science,2 x Adv City Teleporter,3 x City Teleporter,1 x Wealth of Nations,1 x Penicillin. Chest C(Kringle's Paired Biades) 2 x Excalibur,3 x On War,1 x Ivory Horn,2 x Ultra Corselet,2 x Justice Medal,1 x Adv City Teleporter. Chest D(Rudolph's Battle Gear) 1 x Holy Helm of Mars,1 x Vesta' Blessing,2 x On Wars,3 x Random Medal,1 x Ivory Horn,2 x Ultra Corselet,1 x Adv City Teleporter. Chest E(Santa's Christmas Eve Showdown) 750 cents,1 x Holy Helm of Mars,2 x On Wars." iconUrl="images/icon/shop/battlechest_of_christmas.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.59" name="Evony Christmas Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="These packages are delivered as gifts to players for every $30 worth of purchases made during Christmas." itemDesc="This Evony Christmas Package is worth 230 cents and contains 1 x Nation Medal,1 x Justice Medal,1 x Adv City Teleporter,2 x City Teleporter,2 x War Horn,2 x Corselet,4 x Amulet,1 x Key of Winnter." iconUrl="images/icon/shop/christmas_package.jpg" price="0" playerItem="true"/>
