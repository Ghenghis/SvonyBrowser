  <itemEum id="player.key.thanks" name="Key of Thanks" itemType="宝物" dayLimit="0" userLimit="0" desc="You can use this key to open one Thanksgiving War Chest sent to you by your friends. If you don't have any Thanksgiving War Chest, you should ask your friends to send you some! " itemDesc="You can use this key to open one Thanksgiving War Chest sent to you by your friends. If you don't have any Thanksgiving War Chest, you should ask your friends to send you some! " iconUrl="images/icon/shop/SkeletonKey.jpg" price="0"/>
