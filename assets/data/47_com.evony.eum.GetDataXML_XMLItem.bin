  <itemEum id="player.box.present.money.232" name="Harvester's Bounty" itemType="宝箱" dayLimit="0" userLimit="0" desc="The Harvester's Bounty contains the best items found throughout the countryside, to aid in your efforts against your neighbors." itemDesc="Opening the Harvester's Bounty will grant you the following:1 x Adv Teleporter,3 x War Teleporter,5 x War Ensign,1x Junior Medal Box,1 x Corselet,1x Stone of Finding,1x Jake Key of the Harvest" iconUrl="images/icon/shop/harvestersbounty.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.233" name="Jake’s Chest of Bounty" itemType="宝箱" dayLimit="0" userLimit="0" desc=" With the coming of winter, the jakes and toms are up in arms. Clever hunters have been tracking the jakes down and taking their bounties. Here is what your hunters have brought you!." itemDesc="Once opened, Jake’s Chest of Bounty will randomly provide you with one of the following groups of items:Brace of Jakes,Solstice Stores,Heart of the Harvest,Harvester’s Great BountymOffering of Thanks" iconUrl="images/icon/shop/jakeschestofbounty.png" price="0" playerItem="true"/>
