  <itemEum id="player.box.present.money.107" name="Baba Yaga’s Chest" itemType="宝箱" dayLimit="0" userLimit="0" desc="These chests are sent to you as Halloween gifts from your friends in the game. They require a Skeleton Key to open. You can obtain a Skeleton Key for every $30 worth of purchases made during this promotion. When opened, you will receive the contents of Baba Yaga’s Chest A,B,C,D,or E at random" itemDesc="These chests are sent to you as Halloween gifts from your friends in the game. They require a Skeleton Key to open. You can obtain a Skeleton Key for every $30 worth of purchases made during this promotion. When opened, you will receive the contents of Baba Yaga’s Chest A,B,C,D,or E at random" iconUrl="images/icon/shop/babayagaschest.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.108" name="Treat Token" itemType="宝箱" dayLimit="0" userLimit="1" desc="Using this item will grant you one of the Treat Tokens." itemDesc="Treats and sweets, little gifts to bring a smile. As you go from house to house and celebrate life and beyond." iconUrl="images/icon/shop/treattoken.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.109" name="Trick Token" itemType="宝箱" dayLimit="0" userLimit="1" desc="Using this item will grant you one of the Trick Tokens." itemDesc="A trick to scare the kids, a trick to take their heads. A trick to awaken the ground and fill it with those that stand against you." iconUrl="images/icon/shop/tricktoken.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.11" name="Premium Warm Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes:Freedom Medals,Justice Medals,Nation Medals,Truce Agreement,Michelangelo's Script,Adv City Teleporter,War Horn,Corselet,War Ensign,The Wealth of Nations,Excalibur." itemDesc="These packages are delivered as gifts to players who purchased every $30 in Winter!" iconUrl="images/items/chongzhidalibao.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.110" name="Thanksgiving War Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes:1 x Nation Medal,1 x Justice Medal,1 x Cross Medal,1 x City Teleporter,1 x Intermediate Guidelines,1 x War Horn,1 x Corselet,1 x Holy Water,5 x Amulet,1 x Adv City Teleporter,1 x Key of Thanks:." itemDesc="These packages are delivered as gifts to players for every $30 worth of purchases made during Thanksgiving." iconUrl="images/icon/shop/thanksgivingwarpackage2.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.111" name="Thanksgiving War Chest" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes: The Whole Bird(Excalibur, On War, Ivory Horn, Ultra Corselet, Justice Medal) or Family Dinner(Epitome of Military Science, Adv City Teleporter, Wealth of Nations, Archimede's Note) or Mash and Grab(War Ensign, Adv City Teleporter , War Horn, Amulet)" itemDesc="These chests are sent to you as Thanksgiving gifts from your friends in the game. They require a Key of Thanks to open. You can obtain a Key of Thanks for every $30 worth of purchases made during Thanksgiving. When opened, you will receive a random assortment of The Whole Bird, Family Dinner or Mash and Grab." iconUrl="images/icon/shop/thanksgivingwarchest2.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.112" name="Blitzen's Flight Kit" itemType="宝箱" dayLimit="0" userLimit="1" desc="Opening Blitzen's Flight Kit will give you the following items:4x Random Medals,2 x Adv City Teleporter,1 x War Horn,1 x Corselet,3x War Ensign,1x Gingerbread Key." itemDesc="Blitzen's Flight Kit is all you need to bring some Christmas Cheer to unsuspecting victims. Appear out of nowhere, and share the gift of destruction." iconUrl="images/icon/shop/blitzensflightkit.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.113" name="Christmas Chest" itemType="宝箱" dayLimit="0" userLimit="0" desc="Krampus’ Sack of Holding (Adv City Teleporter, War Horn, Aries Amulet, War Ensign) or Chest of the Eissturm (Epitome of Military Science, Adv City Teleporter, Random City Teleporter, Excalibur, War Ensign, Penicillin) or Tactical Tannenbaum Storage (Excalibur, On War, Ivory Horn, Ultra Corselet, Random Medals, Adv Teleporter, War Ensign, Merchant Caravan) Or War Chest of the Elves (Holy Helm of Mars, Vesta’s Blessing, On War, Random Medal, Ultra Corselet, Adv City Teleporter, 50 cents) Or Santa’s Trunk (750 cents, Random Medals, Vesta)" itemDesc="These chests are sent to you as Christmas gifts from your friends in the game. They require a Gingerbread Key to open. You can obtain a Gingerbread Key for every $30 worth of purchases made during Christmas. When opened, you will receive a random assortment of Krampus’ Sack of Holding, Chest of the Eissturm, Tactical Tannenbaum, War Chest of the Elves and Santa’s Trunk." iconUrl="images/icon/shop/christmaschest2012.png" price="0" playerItem="true"/>
