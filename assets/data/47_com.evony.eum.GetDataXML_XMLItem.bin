  <itemEum id="player.box.present.money.182" name="Oak King’s Enticement" itemType="宝箱" dayLimit="0" userLimit="0" desc="Opening the Oak King’s Enticement will grant you the following:1 x Adv Teleporter,1 x War Teleporter,3 x War Ensign,1x Mechanic Battalion,1 x Corselet,1x Truce Agreement,1x Coin of the Hunt,1x On War,1x Festive Key" itemDesc="The Oak King’s Enticement was left in your home during the day. These gifts let you rest in the night and adventure in the light the Oak King brings." iconUrl="images/icon/shop/oakKingsenticement.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.183" name="Holly King’s Favors" itemType="宝箱" dayLimit="0" userLimit="0" desc="Once opened, the Holly King’s Favors will randomly provide you with one of the following groups of items:Jeweled Robin’s Egg Box,Emblazoned Gift Chest,Velveteen Box,Plainly Wrapped Box,Stuffed Stocking" itemDesc="The Holly King’s Favors appeared in the middle of the night, sparkling and attracting you in the weak light of the morning. What can be contained within the wrapping?" iconUrl="images/icon/shop/hollykingsfavors.png" price="0" playerItem="true"/>
