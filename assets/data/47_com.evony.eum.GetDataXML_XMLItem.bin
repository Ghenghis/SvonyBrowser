  <itemEum id="equipment.tech.upgrade.book1" name="The Lost Armor Script" itemType="宝物" dayLimit="0" userLimit="0" desc="It is a must of researching the Enhancement technologies over level 3." itemDesc="The script was drawn based on the quintessence of ancient knowledge by a secret group of outstanding and gifted blacksmiths in the medieval time. The sketches inside are hard to understand but they will definitely bring great help to you." iconUrl="images/items/equipmentwarbook.png" price="8"/>
  <itemEum id="hero.compensation.package.lv1" name="Hero Compensation Package Lv1" itemType="宝箱" dayLimit="0" userLimit="0" desc="Includes:Adv city teleporter*1,War horn*1,Corselet*1,Merchant fleet*1,Delicate gem *35,Flawless gem*15,Royal Guard*1" itemDesc="The package includes some materials of the Hero Enhancement and the Advanced Blacksmithing features.It is the compensation package for the post lv100 heroes since the level cap has bean adjusted to lv 100 in Age II for game balance consideration." iconUrl="images/items/chongzhidalibao.png" price="0" playerItem="true"/>
