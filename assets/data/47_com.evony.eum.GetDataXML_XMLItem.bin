  <itemEum id="player.box.present.money.298" name="Christmas Gift 2015" itemType="宝箱" dayLimit="0" userLimit="1" desc="Merry Christmas from the Evony team! Hope you have a happy holidays and a wonderful New Year!" itemDesc="Opening this gift will give you the following items:225 Cents,1x 50% upkeep item,2x Stone of Finding" iconUrl="images/items/christmasgift2015.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.299" name="Yule Gift" itemType="宝箱" dayLimit="0" userLimit="1" desc="Open me up and find out what I hold!" itemDesc="Merry Christmas! This gift is for the 2015 Christmas Celebration" iconUrl="images/items/yulegift2015.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.3" name="$5 for 250 cents worth" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes:Michelangelo's Script,Plowshares,Arch Saw,Querrying Tools,Blower,Cross Medal,Rose Medal,Lion Medal,Honor Medal,Courage Medal,Freedom Medal,Justice Medal,Nation Medal." itemDesc="$5 for 250 cents worth bonus package" iconUrl="images/items/chongzhidalibao.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.30" name="Evony Happiness Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes: Special Chest Key, Lion Medal, Rose Medal, Cross Medal, Primary Guidelines, Intermediate Guidelines, War Horn, Corselet, Holy Water, Hero Hunting, Truce Agreement, City Teleporter, Amulet." itemDesc="These packages are delivered as gifts to players who purchased every $30." iconUrl="images/icon/shop/Christmas4.jpg" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.300" name="Stygandr’s Tools of the Destroyer" itemType="宝箱" dayLimit="0" userLimit="1" desc="Larger armies require greater and greater resources to travel. However, once they arrive, the larger the horde the greater the chance of the complete destruction of their enemy. Crush your enemies, drive them before you, and listen to the lamenting of their women!." itemDesc="Your free gift, included with $30 purchase. Includes:3 x Stygandr’s Banner of the Horde,3 x War Teleporter,1 x On War,1 x Stone of Finding,1 x Angel/Devil Token,1 x Excalibur,1 x Corselet" iconUrl="images/icon/shop/stygandrstoolsofthedestroyer.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.301" name="The Horde’s Storm Chest" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="This chest can be opened with the Horde’s Key. Once opened you will gain one of the following chest packages! A,B,C,D,E" iconUrl="images/icon/shop/hollykingsfavors.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.302" name="Offering of Thanks" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.303" name="Harvester’s Great Bounty" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
