  <itemEum id="player.item.evonytoberfestwarpackage" name="Evonytoberfest War Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="These packages are delivered as gifts to players for every $30 worth of purchases made during our Evonytoberfest promotion." itemDesc="Includes:The Evonytoberfest War Package contains:3x Random Medals,2 x Primary Guidelines,1 x War Horn,1 x Corselet,1 x Fleet Feet,1 x Endurance of the Immortals,1 x Truce Agreement,5 x Amulet,1 x War Teleporter,1 x Saxony Chest Key" iconUrl="images/icon/shop/evonytoberfestwarpackage.png" price="0" playerItem="true"/>
