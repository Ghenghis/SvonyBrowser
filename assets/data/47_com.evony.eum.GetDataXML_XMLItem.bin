  <itemEum id="player.halloween.candy" name="Halloween Candy" itemType="宝物" dayLimit="0" userLimit="0" desc="A gift from your friends during Halloween.Use it to get a 24 hours 50% upkeep buff from Oct 29th to Nov 2nd. Halloween Candy is stackable (meaning if you already have this buff, using it again will add a further 24 hours). Once Nov 3rd comes though, this buff will expire if you haven't used it yet." itemDesc="Get a 24 hours 50% upkeep buff during Oct 29th and Nov 2nd." iconUrl="images/icon/shop/HalloweenGoody.jpg" price="0" playerItem="true"/>
  <itemEum id="player.halloween.castle" name="Haunted Castle" itemType="宝物" dayLimit="0" userLimit="1" desc="This item will change the look of your city and make them stand out on the game map. Once applied, your city will receive a 10% bonus on all resources production, and increase rally spot troops limit by 25%." itemDesc="Effective for one single city. This item can be used at any time and effective for 15 days." iconUrl="images/icon/shop/hauntedcastle.png" price="0" playerItem="true"/>
  <itemEum id="player.halloween.castle.adv" name="Haunted Castle Adv" itemType="宝物" dayLimit="0" userLimit="1" desc="This item will change the look of your city and make them stand out on the game map. Once applied, your city will receive a 10% bonus on all resources production, and increase rally spot troops limit by 25%." itemDesc="Effective for all cities. This item can be used at any time and effective for 15 days." iconUrl="images/icon/shop/hauntedcastleadv.png" price="0" playerItem="true"/>
  <itemEum id="player.halloween.giftofthewisemystics.2015" name="Gift of the Wise Mystics 2015" itemType="宝箱" dayLimit="0" userLimit="1" desc="Opening the Gift of the Wise Mystics will grant you one random prize from the 2015 Yuletide Promotion" itemDesc="The wise mystics have given you this prize in return for the artifact of the Krampus that you have recovered." iconUrl="images/icon/shop/giftofthewisemystics.png" price="0" playerItem="true"/>
  <itemEum id="player.halloween.thetawnyphial.2015" name="The Tawny Phial" itemType="宝箱" dayLimit="0" userLimit="1" desc="Opening the Tawny Phial will grant you one random prize from the 2016 Winter’s Shadow Promotion." itemDesc="This phial contains a small bit of the essence of a Punxa’s shadow. Prior to opening, think of a small item you’d like, and your desire may appear." iconUrl="images/icon/shop/thetawnyphial.png" price="0" playerItem="true"/>
  <itemEum id="player.halloween.treats.2015" name="Traveller’s Effects" itemType="宝箱" dayLimit="0" userLimit="1" desc="Open the Traveller’s Effects to a random item." itemDesc="Unlucky travelers have been disappearing all across the land, for some, this is all that remains." iconUrl="images/icon/shop/travellerseffects.png" price="0" playerItem="true"/>
  <itemEum id="player.halloween.trophyofthetower" name="Trophy of the Tower" itemType="宝箱" dayLimit="0" userLimit="1" desc="Opening the Trophy of the Tower will grant you one random prize from the Sommerdawn 2016 promotion." itemDesc="A bounty for the destruction of the force that carried the Crest of the Tower." iconUrl="images/icon/shop/trophyofthetower.png" price="0" playerItem="true"/>
  <itemEum id="player.haunted.castle" name="Christmas Castle" itemType="宝物" dayLimit="0" userLimit="1" desc="Using the Christmas Castle item will give your city a christmas theme for 15 days. During this time you will also have the additional benefit of 10% bonus on all resource production, and a 25% increase in the amount of troops your rally spot can send." itemDesc="Ho Ho Ho and man the battlements! The Christmas Castle will bring yuletide cheer to your city, and pain to your enemies." iconUrl="images/icon/shop/christmascastle.png" price="0" playerItem="true"/>
  <itemEum id="player.haunted.castle.adv" name="Christmas Castle Adv" itemType="宝物" dayLimit="0" userLimit="1" desc="Using the Christmas Castle Adv item will give all of your cities a Christmas theme for 15 days. During this time you will also have the additional benefit of 10% bonus on all resource production, and a 25% increase in the amount of troops your rally spot can send in each city." itemDesc="Ho Ho Ho and man the battlements! This Christmas Castle Adv will bring yuletide cheer to all of your cities, and pain to your many enemies." iconUrl="images/icon/shop/christmascastleadv.png" price="0" playerItem="true"/>
  <itemEum id="player.heart.1.a" name="Speech Text" itemType="宝物" dayLimit="0" userLimit="0" desc="Instantly increase Loyalty to 100 and decrease Public Grievance to 0." itemDesc="Public Speech can be a powerful tool to use for purposes such as motivation, influence, persuasion, informing, or simply entertaining. Loyalty of your people has reached bottom. You need to do something about. A fabulous speech will dramatically ease this situation." iconUrl="images/items/yanshuogao.png" price="100" playerItem="true"/>
  <itemEum id="player.historical.hero.package" name="Historical Hero Compensation Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="A compensation for the historical hero deleted during server merge." itemDesc="1 x Ancient Ring, 50 x On War, 1 x Excalibur" iconUrl="images/items/playerchristmasgift.png" price="0" playerItem="true"/>
  <itemEum id="player.irish.whiskey" name="Irish Stew" itemType="宝物" dayLimit="0" userLimit="0" desc="A gift from your friends around St Patrick's Day. Use it to get 24 hours of 50% upkeep in ALL your cities any time from March 17th through March 21st. Irish Stew is stackable (meaning if you already have this buff, using it again will add an additional 24 hours). Once March 22th comes, this item will expire if you haven't used it yet." itemDesc="Get a 24 hours 50% upkeep buff during Mar 17th and Mar 21st." iconUrl="images/icon/shop/IrishWhiskey2.png" price="0" playerItem="true"/>
  <itemEum id="player.item.afeastforthepeople" name="A Feast for the People" itemType="宝物" dayLimit="0" userLimit="0" desc="This gift from the local merchants promises that they will feed your troops and people for a short period as a thank you for being a repeat customer." itemDesc="When used during the 2014 Queen's Feast promotion, this item will provide you with a 50% reduction in upkeep for 24 hours. Using multiple items will increase the timer. The timer will end at the end of the day on December 5th." iconUrl="images/icon/shop/afeastforthepeople.png" price="0" playerItem="true"/>
  <itemEum id="player.item.afeastforthepeople2016" name="A Feast for the People 2016" itemType="宝物" dayLimit="0" userLimit="0" desc=" This gift from the local merchants promises that they will feed your troops and people for a short period as a thank you for being a repeat customer." itemDesc="When used during the 2016 Queen’s Feast promotion, this item will provide you with a 50% reduction in upkeep for 24 hours. Using multiple items will increase the timer. The timer will end at the end of the day on December 9th." iconUrl="images/icon/shop/afeastforthepeople2016.png" price="0" playerItem="true"/>
