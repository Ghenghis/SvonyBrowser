  <itemEum id="player.box.present.money.387" name="Solstice Stores" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.388" name="Brace of Jakes" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.389" name="The Elk’s Parchments" itemType="宝箱" dayLimit="0" userLimit="0" desc="And so the Elk and the Squirrel were merged. Within the night the Raven had prepared a tribute to celebrate. The skies darken as the crows and ravens of the land take to wing to play herald. As the calls echo through the hills, the bear comes from his slumber with a special firkin to tap.." itemDesc="Your free gift, included with $30 purchase. Includes:1 x Adv Teleporter,1 x War Teleporter,3 x Stygandr’s Banner of the Horde,3 x War Ensign,1 x Stone of Finding,1 x Excalibur,1 x Corselet" iconUrl="images/icon/shop/theelksparchments.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.39" name="Valentine's Day Chest " itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes: Chest A (Freedom Medal, Justice Medal, Nation Medal, Michelangelo's Script, Plowshares, Arch Saw, Quarrying Tools, Blower, War Ensign, Excalibur, The Wealth of Nations, Amulet) or Chest B (Primary Guidelines, Intermediate Guidelines, Hero Hunting, Merchant Fleet, Plowshares, Double Saw, Quarrying Tools, Blower, Michelangelo's Script, Tax Policy, The Wealth of Nations) or Chest C (Excalibur, War Horn, Corselet, Truce Agreement, War Ensign, Adv City Teleporter, Michelangelo's Script)" itemDesc="These chests are sent to you as Valentine’s Day gifts from your friends in the game. They require a Valentine's Day Key to open. You can obtain a Valentine’s Day Key for every $30 worth of purchases made during Valentine’s Day. When opened, you will receive a random assortment of Valentine’s Day Chests A, B or C." iconUrl="images/icon/shop/heartshape2.png" price="300" playerItem="true"/>
  <itemEum id="player.box.present.money.390" name="Mache Chest of the Elk" itemType="宝箱" dayLimit="0" userLimit="0" desc="Adorned with Elk antlers, this chest is made from paper and woven together with magic. A small silver crest of a Squirrel holding an acorn adorns it, and the chest is heavy with gifts." itemDesc="Requires the Squirrel’s Key to open, which is included with every $30 purchase. Contains a random assortment of items which could be worth more than 2500 cents!" iconUrl="images/icon/shop/macheChestoftheelk.png" price="0" playerItem="true"/>
