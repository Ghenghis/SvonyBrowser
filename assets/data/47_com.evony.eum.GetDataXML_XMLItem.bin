  <itemEum id="player.box.present.money.372" name="Brace of Jakes" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.373" name="Spring Gift" itemType="宝箱" dayLimit="0" userLimit="0" desc="This is your daily gift during January’s promotion." itemDesc="This is your daily gift during January’s promotion." iconUrl="images/icon/shop/springgift.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.374" name="Stygandr’s Tools" itemType="宝箱" dayLimit="0" userLimit="0" desc="Larger armies require greater and greater resources to travel. However, once they arrive, the larger the horde the greater the chance of the complete destruction of their enemy. Crush your enemies, drive them before you, and listen to the lamenting of their women!." itemDesc="Includes:10 x Stygandr’s Banner of the Horde,3 x War Teleporter,1 x On War,1 x Stone of Finding,1 x Angel/Devil Token,1 x Excalibur,1 x Corselet,50 Million of each resource" iconUrl="images/icon/shop/stygandrstools.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.375" name="The Horde’s Chest" itemType="宝箱" dayLimit="0" userLimit="0" desc="The Horde of Stygandr is like a marauding cloud of locusts. It’s important for the army to ensure that it has enough resources to march outwards and crush your foes. Each item withing these chests is a way to make your mighty army even more powerful. Which one will you open this time?" itemDesc="This chest can be opened with the Horned Key. Once opened you will gain one of the following chest packages! Stygandr’s Trophy,The Storm’s Surges,Month’s Cache,Week’s Rations,Day’s Rations" iconUrl="images/icon/shop/thehordeschest.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.376" name="Offering of Thanks" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.377" name="Harvester’s Great Bounty" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.378" name="Heart of the Harvest" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.379" name="Solstice Stores" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.38" name="Evony's Heart-Shaped Box" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes: Valentine's Day Key, Lion Medal, Rose Medal, Cross Medal, Primary Guidelines, Intermediate Guidelines, War Horn, Corselet, Holy Water, Hero Hunting, Truce Agreement, City Teleporter, Amulet." itemDesc="These packages are delivered as gifts to players for every $30 worth of purchases made during Valentine's Day." iconUrl="images/icon/shop/HeartShapedBox.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.380" name="Brace of Jakes" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.381" name="Valentine's Gift" itemType="宝箱" dayLimit="0" userLimit="0" desc="This is your daily gift during February’s promotion." itemDesc="This is your daily gift during February’s promotion." iconUrl="images/icon/shop/springgift.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.382" name="Hallmark’s Gift" itemType="宝箱" dayLimit="0" userLimit="0" desc="A package of resources emblazoned with a hallmark from another land has been delivered to you.  Use what is within to crush your neighbors." itemDesc="Your free gift, included with $30 purchase. Includes:10 x Stygandr’s Banner of the Horde,3 x War Teleporter,1 x On War,1 x Stone of Finding,1 x Excalibur,1 x Corselet,50 Million of each Resource" iconUrl="images/icon/shop/hallmarksgift.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.383" name="The Hallmark Chest" itemType="宝箱" dayLimit="0" userLimit="0" desc="Deep within the Hallmark Chest something you yearn for resides. This Hallmark holds a strange power over people, causing otherwise reasonable people to fall to pieces and give gifts of candies, flowers, and young animals to each other. What magic has this manmade Hallmark have hidden within it?" itemDesc="This chest can be opened with the Hallmark Key. Once opened you will gain one of the following chest packages!The Rose,Heart’s Call,The Yearning,A Connection,Gilded Heart" iconUrl="images/icon/shop/thehallmarkchest.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.384" name="Offering of Thanks" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.385" name="Harvester’s Great Bounty" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
