  <itemEum id="player.box.present.money.141" name="Angel / Devil token" itemType="宝箱" dayLimit="0" userLimit="1" desc="Opening this package will grant you one angel or devil token randomly." itemDesc="Open it and find out what goodies are inside!" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.142" name="Devil token" itemType="宝箱" dayLimit="0" userLimit="1" desc="This item gives one of the following types of items randomly: • Broken Gates –  One can apply this item to another player to lock gates open, players can apply item on themselves to unlock gates • Opportunist’s Plague –Instantly kills the entire population of a target city and reduces repopulation by 10% for 4 hours• Lost in the Wastes –Troops from affected city march 20% slower than normal for 4 hours • Poisoned Feast –All heroes in targeted city lose 20% of all stats, includes energy in Age 2" itemDesc="" iconUrl="images/icon/shop/deviltoken.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.143" name="Angel token" itemType="宝箱" dayLimit="0" userLimit="1" desc="This item gives one of the following types of items randomly: Fleet Feet – 35% Reduced Troop Marching Time for 4 hours.  Endurance of the Immortals –  5% Increased Troop Hit Points for 12 hours.Alchemist’s Amplifier – 10% Stat increase to all heroes for 2 hours." itemDesc="" iconUrl="images/icon/shop/angeltoken.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.144" name="Warlord’s Array" itemType="宝箱" dayLimit="0" userLimit="1" desc="Lords and officers on the battlefield wear armor that not only protects them, but is styled to intimidate enemies and inspire allies." itemDesc="Includes:1 x Excalibur, 1 x Ultra Corselet,1 x  Ivory Horn, 1 x War Teleporter, 1 x On War, Key of Thanks." iconUrl="images/icon/shop/warlordsarray.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.145" name="Anniversary Gift 2013" itemType="宝箱" dayLimit="0" userLimit="1" desc="Thank you for being a member of our community! Happy 4th Anniversary!" itemDesc="Included in this Anniversary gift is the following:Excalibur x1,War Ensign x4,Penicillin x1,Cents x10" iconUrl="images/icon/shop/anniversarygift.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.146" name="Chest of the League" itemType="宝箱" dayLimit="0" userLimit="1" desc="These chests are sent to you as Anniversary gifts from your friends in the game. They require a Key of Thanks to open. You can obtain a Key of Thanks for every $30 worth of purchases made during 4th Anniversary." itemDesc="Opening this chest will grant you one of the following:Master Vault,Emperor’s Cache,Box of the Gold Dragon,Warlord’s Hoard,Shiriff’s Strongbox" iconUrl="images/icon/shop/chestoftheleague.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.147" name="Master Vault" itemType="宝箱" dayLimit="0" userLimit="1" desc="Master Vault:750 cents,1 x Holy Helm of Mars,1 x On War,2x War Teleporter,1x Masterwork of the Stone Mason,1x Gundulf’s Compass" itemDesc="Master Vault:750 cents,1 x Holy Helm of Mars,1 x On War,2x War Teleporter,1x Masterwork of the Stone Mason,1x Gundulf’s Compass" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
