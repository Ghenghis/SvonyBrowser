  <itemEum id="player.key.thehallmarkkey" name="The Hallmark Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key opens the Hallmark Chest. Go forth and plunder." itemDesc="This key is used to open the Hallmark Chest." iconUrl="images/icon/shop/thehallmarkkey.png" price="0"/>
  <itemEum id="player.key.thehordeskey" name="The Horde’s Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key is used to open the Horde’s Storm Chest." itemDesc="This key is used to open the Horde’s Storm Chest." iconUrl="images/icon/shop/thehordeskey.png" price="0"/>
  <itemEum id="player.key.thehornedkey" name="The Horned Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key opens the stores needed to properly outfit your new hordes. Go forth and destroy." itemDesc="This key is used to open the Horde’s Chest." iconUrl="images/icon/shop/thehornedkey.png" price="0"/>
  <itemEum id="player.key.themoonsshard" name="The Moon’s Shard" itemType="宝物" dayLimit="0" userLimit="0" desc="This sliver of the moon will open the Summer dawn’s Chest." itemDesc="Using this item will open a Chest from the Summer dawn’s Festival Promotion." iconUrl="images/icon/shop/themoonsshard.png" price="0"/>
  <itemEum id="player.key.thesquirrelskey" name="The Squirrel’s Key" itemType="宝物" dayLimit="0" userLimit="0" desc="The Squirrel’s Key is the only key that pairs with the Crested Chest of the Elk." itemDesc="Use this key to open the TBD Chest from the 2016 St. Patrick’s Day promotion." iconUrl="images/icon/shop/thesquirrelskey.png" price="0"/>
  <itemEum id="player.key.thesquirrelskey2" name="The Squirrel’s Key" itemType="宝物" dayLimit="0" userLimit="0" desc="The Squirrel’s Key is the only key that pairs with the Mâché Chest of the Elk." itemDesc="Use this key to open the Mâché Chest of the Elk from the 2017 St. Patrick’s Day promotion." iconUrl="images/icon/shop/thesquirrelskey2.png" price="0"/>
  <itemEum id="player.key.thewitcheskey" name="The Witches’ Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This bony key is the only way to open Chernabog’s Chest." itemDesc="Using this item will open a Chest from the 2016 Halloween promotion." iconUrl="images/icon/shop/thewitcheskey.png" price="0"/>
  <itemEum id="player.key.tomoftheharvest.2015" name="Tom’s Key of the Harvest" itemType="宝物" dayLimit="0" userLimit="0" desc="This key is decorated by a small turkey feather. It opens a similarly adorned lock from this year’s Harvest." itemDesc="Using this item will open a Chest from the 2015 Queen’s Feast Promotion." iconUrl="images/icon/shop/tomoftheharvest.png" price="0"/>
  <itemEum id="player.key.valentine" name="Valentine's Day Key" itemType="宝物" dayLimit="0" userLimit="0" desc="You can use this key to open one Valentine's Day Chest sent to you by your friends. You can get Chest A (Freedom Medal, Justice Medal, Nation Medal, Michelangelo's Script, Plowshares, Arch Saw, Quarrying Tools, Blower, War Ensign, Excalibur, The Wealth of Nations, Amulet) or Chest B (Primary Guidelines, Intermediate Guidelines, Hero Hunting, Merchant Fleet, Plowshares, Double Saw, Quarrying Tools, Blower, Michelangelo's Script, Tax Policy, The Wealth of Nations) or Chest C (Excalibur, War Horn, Corselet, Truce Agreement, War Ensign, Adv City Teleporter, Michelangelo's Script)." itemDesc="You can use this key to open one Valentine's Day Chest sent to you by your friends. If you don’t have any Valentine’s Day Chests, you should ask your friends to send you some!" iconUrl="images/icon/shop/Christmas5.jpg" price="0"/>
  <itemEum id="player.key.wheatsheafkey" name="Wheat Sheaf Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key imbued with the magic of the harvest will open the Sommer’s End Chest." itemDesc="Using this item will open a Chest from the End of Summer Promotion." iconUrl="images/icon/shop/wheatsheafkey2016.png" price="0"/>
  <itemEum id="player.keyoftheimperator" name="Key of the Imperator" itemType="宝物" dayLimit="0" userLimit="0" desc="This key holds the Emperor’s seal, and should any chests found abandoned in their rout." itemDesc="The Key of the Imperator Key will open the Crested Trunk from the 2013 Rout of the Emperor promotion." iconUrl="images/icon/shop/keyoftheimperator.png" price="0"/>
  <itemEum id="player.knights.gear" name="Knight's Gear" itemType="宝箱" dayLimit="0" userLimit="1" desc="All the weapons and armor a Knight needs to plunge into battle and bring honor to his Queen and his alliance." itemDesc="Includes Excalibur, Corselet, War Horn, and War Ensign." iconUrl="images/icon/shop/knightsgear.png" price="0" playerItem="true"/>
  <itemEum id="player.leafofthetree" name="Leaf of the Tree" itemType="宝物" dayLimit="0" userLimit="1" desc="A leaf from the tree of Liberty, it will refresh your troops and help more of them return to the heat of battle." itemDesc="This item when used will give you a 10% heal for the next 24 hours." iconUrl="images/icon/shop/leafofthetree.png" price="0" playerItem="true"/>
  <itemEum id="player.milk.cookies.dressing" name="Milk and Cookies" itemType="宝物" dayLimit="0" userLimit="0" desc="Get a 24 hours 50% upkeep buff during Dec 21st 2012 and Jan 6th 2013." itemDesc="A gift from your friends during the Christmas 2012 promotion. Use this to receive 50% off upkeep in all of your cities for 24 hours! This item is stackable, and will be usable between January 21st, 2012 and January 6th, 2013. Once Jan 7th comes though, this buff will expire if you haven't used it yet." iconUrl="images/icon/shop/playermilkcookiesdressing.png" price="0" playerItem="true"/>
  <itemEum id="player.more.castle.1.a" name="Adv City Teleporter" itemType="宝物" dayLimit="0" userLimit="0" desc="Teleport your city to a specific location. " itemDesc="Any troops sent or garrison troops in your city is not allowed while teleporting. A city can only use the Adv. City Teleporter once every 12 hours and share cooldown with War Teleporter." iconUrl="images/items/gaojiqianchengling.png" price="90" playerItem="true"/>
  <itemEum id="player.more.castle.1.c" name="War Teleporter" itemType="宝物" dayLimit="0" userLimit="0" desc="Teleport your city to a barbarian city. " itemDesc="Any troops sent or garrison troops in your city is not allowed while teleporting. A city can only use the War Teleporter once every 12 hours and share cooldown with Adv. City Teleporter. " iconUrl="images/items/playermorecastle1c.png" price="140" playerItem="true"/>
  <itemEum id="player.move.castle.1.b" name="Pioneer Express Teleport" itemType="宝物" dayLimit="0" userLimit="0" desc="This special free advanced teleporter dispapears after 7 days. Truce status will end 48 hours after using this teleporter." itemDesc="This special free advanced teleporter dispapears after 7 days. Truce status will end 48 hours after using this teleporter." iconUrl="images/items/gaojiqianchengling.png" price="0" playerItem="true"/>
  <itemEum id="player.name.1.a" name="New ID" itemType="宝物" dayLimit="1" userLimit="0" desc="Change Lord Name in game." itemDesc="New ID enables player to change the name of lord in game. By clicking the lord head icon and select Change button behind Lord bar. Change it and click Confirm." iconUrl="images/items/mingtie.png" price="200"/>
  <itemEum id="player.newyear.stoptoopsupkeep" name="New Year's Eve Party Spirit" itemType="宝物" dayLimit="0" userLimit="0" desc="A gift from your friends during New Year.Use it to get a 24 hours no upkeep buff during Jan 1st and Jan 3rd.It can not be used at other time.All buffs and all unused New Year's Eve Party Spirit items will be removed when Jan 4th comes.Could at most have THREE DAYS ZERO UPKEEP by using three such items." itemDesc="Get a 24 hours no upkeep buff during Jan 1st and Jan 3rd." iconUrl="images/icon/shop/Christmas6.jpg" price="0" playerItem="true"/>
  <itemEum id="player.peace.1" name="Truce Agreement" itemType="宝物" dayLimit="0" userLimit="0" desc="Once applied, your city will have 12 hours peacetime. In this period, you can neither perform attack nor be attacked by others. If troops marching to city or you have dispatched troops, you can't use this item." itemDesc="In ancient war time, some countries, for the purpose of peace, would sent out envoys to negotiate with neighboring states. If peace agreement reached, they will have a safe and stable living atmosphere for its development. This is the most effective way that survive this chaotic world. " iconUrl="images/items/stopwar.png" price="30" playerItem="true"/>
  <itemEum id="player.pop.1.a" name="Civil Code" itemType="宝物" dayLimit="0" userLimit="0" desc="Instantly add 20% of the Population Limit (or 100, whichever's greater) to the Current Population. Does not work if the Current Population reaches the Population Limit." itemDesc="A civil code is a systematic compilation of laws designed to comprehensively deal with the core areas of private law. A jurisdiction that has a civil code generally also has a code of civil procedure. In some jurisdictions with a civil code, a number of the core areas of private law that would otherwise typically be codified in a civil code may instead be codified in a commercial code." iconUrl="images/items/minfadian.png" price="50" playerItem="true"/>
  <itemEum id="player.pot.gold" name="Pot o' Gold" itemType="宝箱" dayLimit="0" userLimit="1" desc="The legends were true. There really is a pot of gold at the end of the rainbow!" itemDesc="Opening the Pot o’ Gold will grant you one of the Treasure Hunt prizes, randomly." iconUrl="images/icon/shop/playerpotgold.png" price="0" playerItem="true"/>
  <itemEum id="player.queue.building" name="Bernini's Hammer" itemType="宝物" dayLimit="0" userLimit="1" desc="Allows the queuing of 1 or more buildings for construction per Title, up to a maximum of 10. For example, Barons may queue up to 4 buildings for construcion. Each building added to the queue consumes 1 Bernini's Hammer." itemDesc="Gian Lorenzo Bernini was an Italian artist, sculptor, playwright and architect. Working mainly in Rome, he was a successor to Michelangelo. Bernini was able to secure the most important commission of his day: work on the Piazza San Pietro in front of St. Peter's Basilica in Rome. The origins of this stonemason's hammer are indisputable. It is lighter and stronger than similar tools and bears an almost mystical energy that allows even an apprentice to work more efficiently than a master craftsman." iconUrl="images/items/berninishammer.jpg" price="5"/>
  <itemEum id="player.queue.building.luban" name="Gundulf's Compass" itemType="宝物" dayLimit="0" userLimit="1" desc="Gives 72 hours of double building time." itemDesc="Gives an extra build slot in the building queue for 72 hours. This will allow you to ready the next project for construction." iconUrl="images/items/playerqueuebuildingluban.png" price="125" playerItem="true"/>
  <itemEum id="player.reduce.troops.upkeep.1" name="Vesta's Blessing" itemType="宝物" dayLimit="0" userLimit="0" desc="Reduce troops upkeep by 50%, lasts for 24 hours." itemDesc="Vesta, the sister of Zeus, was the Goddess of the hearth in Greek mythology. With her blessing, we can produce much more food with the limited resource." iconUrl="images/icon/gold1.jpg" price="0" playerItem="true"/>
  <itemEum id="player.relive.1" name="Penicillin " itemType="宝物" dayLimit="0" userLimit="0" desc="Decrease personnel loss up by 30% during battles. Effective for 7 days." itemDesc="The application of penicillin to war medic greatly decreases the casualties in war field. Immediate medical treatment enables them survive the battles." iconUrl="images/items/qingmeisu.png" price="120" playerItem="true"/>
  <itemEum id="player.resinc.1" name="Plowshares" itemType="生产" dayLimit="0" userLimit="0" desc="Increase production of food by 25%. Effective for 24 hours." itemDesc="Plowshares are used to turn over soil to plant seeds. This was a metal agricultural piece of equipment used worldwide. This bronze-made tool gives a great boost to agricultural production." iconUrl="images/items/ligeng.png" price="8" playerItem="true"/>
  <itemEum id="player.resinc.1.b" name="Iron Rake" itemType="生产" dayLimit="0" userLimit="0" desc="Increase production of food 25%. Effective for 7 days." itemDesc="Plowshares are used to turn over soil to plant seeds. This was a metal agricultural piece of equipment used worldwide. The evolution from plowshares to an iron rake gives a great boost to agricultural production." iconUrl="images/items/zhongxingligeng.png" price="50" playerItem="true"/>
  <itemEum id="player.resinc.2" name="Arch Saw" itemType="生产" dayLimit="0" userLimit="0" desc="Increase production of lumber by 25%. Effective for 24 hours." itemDesc="The saw is said to have been invented by Chinese craftsman Lu Ban. With the development of material and design, the saw has been greatly improved. Metal saws became commonplace in lumber trade. The employment of the saw will enhance lumber production significantly." iconUrl="images/items/gongxingju.png" price="8" playerItem="true"/>
  <itemEum id="player.resinc.2.b" name="Double Saw" itemType="生产" dayLimit="0" userLimit="0" desc="Increase production of lumber by 25%. Effective for 7 days." itemDesc="In the process of the lumber trade, some trees are too big to bring down with a single handed saw and would not be suitable for these trees. People began to design a longer saw which is was held by two ends with two men. This double saw widened the sawing range in the lumber trade, and contributes significantly to lumber production." iconUrl="images/items/shuangrenju.png" price="50" playerItem="true"/>
  <itemEum id="player.resinc.3" name="Quarrying Tools" itemType="生产" dayLimit="0" userLimit="0" desc="Increase production of stone by 25%. Effective for 24 hours." itemDesc="Town construction demands a huge sum of stone. Raw stone is buried underground which makes quarrying difficult work. People began to use levers, ropes and logs to deliver stone. The employment of this equipment increases stone production significantly." iconUrl="images/items/caishizhuangzhi.png" price="8" playerItem="true"/>
  <itemEum id="player.resinc.3.b" name="Adv Quarrying Tools" itemType="生产" dayLimit="0" userLimit="0" desc="Increase production of stone by 25%. Effective for 7 days." itemDesc="As heavy as stone is, the exploitation and quarrying of it is very dangerous to workers however some tools are used to reduce this risk. Levers, pulleys, wheel and axes are employed in the quarry, which increases stone production significantly." iconUrl="images/items/zhongxingcaishizhuangzhi.png" price="50" playerItem="true"/>
  <itemEum id="player.resinc.4" name="Blower" itemType="生产" dayLimit="0" userLimit="0" desc="Increase production of iron by 25%. Effective for 24 hours." itemDesc="Soon after the use of bronze became widespread, metal casting became a critical technology to military maintenance. This invention makes extracting metal out of ore much easier in furnaces and increases iron production significantly." iconUrl="images/items/gufenglu.png" price="8" playerItem="true"/>
  <itemEum id="player.resinc.4.b" name="Blast Furnace" itemType="生产" dayLimit="0" userLimit="0" desc="Increase production of iron by 25%. Effective for 7 days." itemDesc="A blast furnace is a type of metallurgical furnace used for smelting to produce metals, generally iron. In a blast furnace, fuel and ore are continuously supplied through the top of the furnace, while air is blown into the bottom of the chamber so that the chemical reactions take place throughout the furnace as the material moves downward. This increases iron production significantly." iconUrl="images/items/zhongxinggufengji.png" price="50" playerItem="true"/>
  <itemEum id="player.return.cents" name="Autumn's Bounty" itemType="宝箱" dayLimit="0" userLimit="1" desc="reserved" itemDesc="reserved" iconUrl="images/items/chongzhidalibao.png" price="0" playerItem="true"/>
  <itemEum id="player.reward.bonus.food" name="Food Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="Includes: Food 250000" itemDesc="This package including resources." iconUrl="images/items/baiwanziyuanbao.png" price="0" playerItem="true"/>
  <itemEum id="player.reward.bonus.gold" name="Gold Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="Includes: Gold 250000" itemDesc="This package including resources." iconUrl="images/items/baiwanziyuanbao.png" price="0" playerItem="true"/>
  <itemEum id="player.reward.bonus.iron" name="Iron Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="Includes: Iron 250000" itemDesc="This package including resources." iconUrl="images/items/baiwanziyuanbao.png" price="0" playerItem="true"/>
  <itemEum id="player.reward.bonus.stone" name="Stone Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="Includes: Stone 250000" itemDesc="This package including resources." iconUrl="images/items/baiwanziyuanbao.png" price="0" playerItem="true"/>
  <itemEum id="player.reward.bonus.wood" name="Wood Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="Includes: Wood 250000" itemDesc="This package including resources." iconUrl="images/items/baiwanziyuanbao.png" price="0" playerItem="true"/>
  <itemEum id="player.running.shoes" name="Extra-Fast Running Shoes" itemType="宝物" dayLimit="0" userLimit="0" desc="A gift from your friends around Run with the Bulls. Use it to get 24 hours of 50% upkeep in ALL your cities any time from July 9th through July 13th. Extra-Fast Running Shoes is stackable (meaning if you already have this buff, using it again will add an additional 24 hours). Once July 14th comes, this item will expire if you haven't used it yet." itemDesc="Get a 24 hours 50% upkeep buff during July 9th and July 13th." iconUrl="images/icon/shop/RunningShoes.png" price="0" playerItem="true"/>
  <itemEum id="player.santa.stoptoopsupkeep" name="Santa's Milk and Cookies" itemType="宝物" dayLimit="0" userLimit="0" desc="A gift from your friends during Christmas. Use it to get a 24 hours NO upkeep buff in ALL your cities from Dec 15th to Jan 4th. Santa’s Milk and Cookies is stackable (meaning if you already have this buff, using it again will add a further 24 hours). Once Jan 5th comes though, this buff will expire if you haven't used it yet." itemDesc="Get a 24 hours NO upkeep buff during Dec 15th and Jan 4th." iconUrl="images/icon/shop/Christmas6.jpg" price="0" playerItem="true"/>
  <itemEum id="player.santa.stoptoopsupkeep.1" name="Milk and Cookies 1" itemType="宝物" dayLimit="0" userLimit="0" desc="A gift from your friends during Christmas. Use it to get a 24 hours NO upkeep buff in ALL your cities from Dec 19th to Jan 6th 2012. Milk and Cookies is stackable (meaning if you already have this buff, using it again will add a further 24 hours). Once Jan 7th comes though, this buff will expire if you haven't used it yet." itemDesc="You can only use this item between Mon Dec 19th 00:00:00 CST 2011 and Sat Jan 7th st 00:00:00 CST 2012." iconUrl="images/icon/shop/cookie_milkbig.png" price="0" playerItem="true"/>
  <itemEum id="player.santa.stoptoopsupkeep.2" name="Valentine's Candies" itemType="宝物" dayLimit="0" userLimit="0" desc="A gift from your friends during Valentine's Day.Use it to get a 24 hours No upkeep buff in All your cities from Feb 9th to Feb 22nd. Valentine's Candy is stackable(meaning if you already have this buff,using it again will add a further 24 hours). Once Feb 23nd comes though,this buff will expire if you haven't used it yet." itemDesc="You can only use this item between Thur.Feb 9th 00:00:00 CST 2012 and Fri.Feb 23rd 00:00:00 CST 2012" iconUrl="images/icon/shop/candy.png" price="0" playerItem="true"/>
  <itemEum id="player.saxony.chest.key" name="Saxony Chest Key" itemType="宝物" dayLimit="0" userLimit="0" desc="You can use this key to open one Saxon Beer Chest sent to you by your friends. If you don’t have any Saxon Beer Chests, you should ask your friends to send you some!" itemDesc="You can use this key to open one Saxon Beer Chest sent to you by your friends. If you don’t have any Saxon Beer Chests, you should ask your friends to send you some!" iconUrl="images/icon/shop/saxonychestkey.png" price="0"/>
  <itemEum id="player.snowball.pile" name="Snowball Pile" itemType="宝箱" dayLimit="0" userLimit="1" desc="Opening the Snowball Pile will grant you one of the Snowball Fight prizes, randomly." itemDesc="A bunch of snowballs piled on top of something shiny, you could move them and see what it is" iconUrl="images/icon/shop/snowballpile.png" price="0" playerItem="true"/>
  <itemEum id="player.speak.bronze_publicity_ambassador.permanent" name="Bronze Publicity Ambassador (Permanent)" itemType="宝物" dayLimit="3650" userLimit="0" desc="Effect of Bronze Publicity Ambassador (Permanent) can only be replaced by Silver Publicity Ambassador (Permanent) or Gold Publicity Ambassador (Permanent)." itemDesc="Once you apply this item, a special bronze icon will be displayed in front of your name when you speak in the chat box. While this item functions permanently, multiple applications make no difference to the duration of the effective period. Its effect can be replaced by Silver Publicity Ambassador (Permanent) or Gold Publicity Ambassador (Permanent)." iconUrl="images/items/Bronze_Publicity_Ambassador_Permanent.png" price="75"/>
  <itemEum id="player.speak.bronze_publicity_ambassador.permanent.15" name="Bronze Publicity Ambassador (15-day)" itemType="宝物" dayLimit="15" userLimit="0" desc="Once you apply this item, a special bronze icon will be displayed in front of your name when you speak in the chat box. It’s effective for 15 days, while multiple applications can lengthen the effective period. Its effect can be replaced by Bronze Publicity Ambassador (Permanent), Silver Publicity Ambassador (15-day), Silver Publicity Ambassador (Permanent), Gold Publicity Ambassador (15-day) or Gold Publicity Ambassador (Permanent)." itemDesc="Once you apply this item, a special bronze icon will be displayed in front of your name when you speak in the chat box. It’s effective for 15 days, while multiple applications can lengthen the effective period. Its effect can be replaced by Bronze Publicity Ambassador (Permanent), Silver Publicity Ambassador (15-day), Silver Publicity Ambassador (Permanent), Gold Publicity Ambassador (15-day) or Gold Publicity Ambassador (Permanent)." iconUrl="images/items/Bronze_Publicity_Ambassador_15.png" price="75"/>
  <itemEum id="player.speak.gold_publicity_ambassador.15" name="Gold Publicity Ambassador (15-day)" itemType="宝物" dayLimit="15" userLimit="0" desc="Once you apply this item, a special gold icon will be displayed in front of your name when you speak in the chat box. It’s effective for 15 days, while multiple applications can lengthen the effective period. Its effect can be replaced by Gold Publicity Ambassador (Permanent)." itemDesc="Effect of Gold Publicity Ambassador (15-day) can only be replaced by Gold Publicity Ambassador (Permanent)." iconUrl="images/items/gold_publicity_ambassador_15.png" price="75"/>
  <itemEum id="player.speak.gold_publicity_ambassador.permanent" name="Gold Publicity Ambassador (Permanent)" itemType="宝物" dayLimit="3650" userLimit="0" desc="Once you apply this item, a special gold icon will be displayed in front of your name when you speak in the chat box. While this item functions permanently, multiple applications make no difference to the duration of the effective period. " itemDesc="You're the highest level Publicity Ambassador now." iconUrl="images/items/Gold_Publicity_Ambassador_Permanent.png" price="75"/>
  <itemEum id="player.speak.silver_publicity_ambassador.15" name="Silver Publicity Ambassador (15-day)" itemType="宝物" dayLimit="15" userLimit="0" desc="Effect of Silver Publicity Ambassador (15-day) can only be replaced by Silver Publicity Ambassador (Permanent),  Gold Publicity Ambassador (15-day) or Gold Publicity Ambassador (Permanent)." itemDesc="Once you apply this item, a special silver icon will be displayed in front of your name when you speak in the chat box. It’s effective for 15 days, while multiple applications can lengthen the effective period. Its effect can be replaced by Silver Publicity Ambassador (Permanent), Gold Publicity Ambassador (15-day) or Gold Publicity Ambassador (Permanent)." iconUrl="images/items/Silver_Publicity_Ambassador_15.png" price="75"/>
  <itemEum id="player.speak.silver_publicity_ambassador.permanent" name="Silver Publicity Ambassador (Permanent)" itemType="宝物" dayLimit="3650" userLimit="0" desc="Once you apply this item, a special silver icon will be displayed in front of your name when you speak in the chat box. While this item functions permanently, multiple applications make no difference to the duration of the effective period. Its effect can be replaced by Silver Publicity Ambassador (Permanent) or Gold Publicity Ambassador (Permanent)." itemDesc="Effect of Silver Publicity Ambassador (Permanent) can only be replaced by Gold Publicity Ambassador (Permanent)." iconUrl="images/items/silver_publicity_ambassador_permanent.png" price="75"/>
  <itemEum id="player.speedup.1" name="Master Work of the Stonecutter" itemType="加速" dayLimit="0" userLimit="0" desc="Shorten construction or research time by 50%." itemDesc="Detailed guidelines of constructions and researches recorded. Great assistance to your city development." iconUrl="images/items/playerspeedup1.png" price="175"/>
  <itemEum id="player.trick.adcc" name="Advance by A Hidden Path" itemType="计谋" dayLimit="0" userLimit="0" desc="This stratagem is the countermeasure against Ambush from All Sides. It allows player's troops to flee out of the city besieged by opponent." itemDesc="Use feinting and mock manoeuvre to distract your adversary. Expose part of your action deliberately, so that you can make a surprise attack somewhere else." iconUrl="images/items/20090630/Advance by A Hidden Path.png" price="10"/>
  <itemEum id="player.trick.bmjs" name="Entrapping" itemType="计谋" dayLimit="0" userLimit="0" desc="Increases opponent's troops marching duration by 30%." itemDesc="Entrapping statagem is applied to delay the incoming troops." iconUrl="images/items/20090630/Entrapping.png" price="30"/>
  <itemEum id="player.trick.bxez" name="Wage War without Declaration" itemType="计谋" dayLimit="0" userLimit="0" desc="Fight with the players without war declaration. It deducts offender's honor by 10%. It's effective for 2 hours and cannot be applied twice  with 6 hours." itemDesc="Initiate the attack without formal declaration of war. This engagement is intended as preventive action to put rival in inferior place. Though it’s beneficial in initial phase, this action is considered infamous and may lead to the boycott from international society. Attack on Pearl Harbor performed by Japanese Imperial Navy is the action of this kind of engagement." iconUrl="images/items/20090630/Wage War without Declaration.png" price="8"/>
  <itemEum id="player.trick.chdj" name="Loot a Burning House" itemType="计谋" dayLimit="0" userLimit="0" desc="Decreases protection ability of opponent's warehouses to half level. It's effective for half a hour and is not interfere with effect of Privateering. Cannot apply twice to a city in 24 hours." itemDesc="This stratagem means when someone’s house is on fire, take advantage of the chaos to steal his valuables. Militarily paraphrased when the enemy falls into severe crisis, exploit his adversity and unleash direct confrontation." iconUrl="images/items/20090630/Loot a Burning House.png" price="80"/>
  <itemEum id="player.trick.cmjb" name="Regard Bushes and Trees as Soldiers" itemType="计谋" dayLimit="0" userLimit="0" desc="Total troops in the city are exaggerated 5 to 10 times of actual number. Effective for 24 hours. Can be extended by multiple applications." itemDesc="It describes that the troops which are panic-stricken regard bushes and trees of the remote hillsides as enemy soldiers. The troops might be formerly defeated by their enemies and emotionally overshadowed by it." iconUrl="images/items/20090630/Regard Bushes and Trees as Soldiers.png" price="5"/>
  <itemEum id="player.trick.fslc" name="Burn the Warehouses" itemType="计谋" dayLimit="0" userLimit="0" desc="Burns 10% to 50% of food stored in opponent's city. Cannot apply this stratagem to the same city again in 6 hours." itemDesc="No matter how grand the troops are, they need food to sustain their existence. Try to avoid fighting with enemy openly and to cut their supply line. Burning their food stock is tricky but effective." iconUrl="images/items/20090630/Burn the Warehouses.png" price="55"/>
  <itemEum id="player.trick.gmdg" name="Bolt the Door to Catch the Thief" itemType="计谋" dayLimit="0" userLimit="0" desc="Troops cannot be recalled until they finish the attack. It can be disabled by applying Cicada Sheds Its Skin." itemDesc="Even there is a slim chance, your enemies will definitely fight to escape. However, if they are hopeless to run away, they are all yours. So the best way to annihilate the enemies is to surround and destroy them. If you let them retreat, you will be at a disadvantage in pursuing him." iconUrl="images/items/20090630/Bolt the Door to Catch the Thief.png" price="25"/>
  <itemEum id="player.trick.jbqy" name="Solid Walls and Empty Fields" itemType="计谋" dayLimit="0" userLimit="0" desc="Resources are understated to 10% to 20% of actual stock. Effective for 24 hours. Can be extended by multiple applications." itemDesc="Fortify the walls, and hide away all the property and food. Enemy finds no way to overcome the fortification, meanwhile can’t loot any resource. The enemy may lose interest and cease the fire." iconUrl="images/items/20090630/Solid Walls and Empty Fields.png" price="5"/>
  <itemEum id="player.trick.jctq" name="Cicada Sheds Its Skin" itemType="计谋" dayLimit="0" userLimit="0" desc="Increases troops' returning speed by 30%. This is the countermeasure against Bolt the Door to Catch the Thief." itemDesc="Cicada sheds its skins and emerge as adult. The abandoned skins remain, still clinging to the bark of trees. This a metaphor for using camouflage to deceive enemy in military maneuver.  This is used to achieve tactic goal that is to retreat or to transfer own troops from the pursuit of adversary." iconUrl="images/items/20090630/Cicada Sheds Its Skin.png" price="40"/>
  <itemEum id="player.trick.kcj" name="Empty City" itemType="计谋" dayLimit="0" userLimit="0" desc="Total troops are understated to 10% to 20% of actual number. Effective for 24 hours. Can be extended by multiple applications." itemDesc="This is trap ploy, used to show enemy outwardly weak in defence to lure them to provoke the attack. But actually, the defenders are well prepared that ambush is lain to wait for their imprudent invaders. " iconUrl="images/items/20090630/Empty City.png" price="10"/>
  <itemEum id="player.trick.lywh" name="Ears and Eyes in Enemy’s City" itemType="计谋" dayLimit="0" userLimit="0" desc="It allows players to check the detailed information of target cities." itemDesc="Knowing your adversary, this would never be overemphasized in wartime. The more you know about your enemy the less you lose in battle. This is why one leader spending great sum of money on bribing rival officers to buy more information." iconUrl="images/items/20090630/Ears and Eyes in Enemys City.png" price="45"/>
  <itemEum id="player.trick.mrj" name="Beauty Trap" itemType="计谋" dayLimit="0" userLimit="0" desc="Decreases strength 30% to 80% of one of opponent's heroes in the target city. Cannot apply this stratagem twice to the same hero in 24 hours." itemDesc="When faced with a formidable enemy, try to subdue their leader, when dealing with an able and resourceful commander, exploit his indulgence of sensual pleasures in order to weaken his fighting spirit. When the commander becomes inept, his soldiers will be demoralized, and their combat power will be greatly weakened. This stratagem takes advantage of the enemy’s weakness for the sake of self-protection." iconUrl="images/items/20090630/Beauty Trap.png" price="50"/>
  <itemEum id="player.trick.pzyy" name="Cast A Brick to Attract A Gem" itemType="计谋" dayLimit="0" userLimit="0" desc="Resources are exaggerated 5 to 10 times of actual stock. Effective for 24 hours.  Can be extended by multiple applications." itemDesc="Delude your enemy by fake appearance into making wrong judgment, and then try to take them out with single fatal blow." iconUrl="images/items/20090630/Cast A Brick to Attract A Gem.png" price="5"/>
  <itemEum id="player.trick.qlbx" name="Thunder Raid" itemType="计谋" dayLimit="0" userLimit="0" desc="Decreases troops marching duration by 30%." itemDesc="In the point of view of ancient commanders, the most critical point of winning war is the marching efficiency. The faster the troops arrive the destination, the greater harm is caused to the unprepared enemy. It’s essential to gain the dominance of the war." iconUrl="images/items/20090630/Thunder Raid.png" price="60"/>
  <itemEum id="player.trick.smmf" name="Ambush from All Sides" itemType="计谋" dayLimit="0" userLimit="0" desc="Troops in the city which is taken in by this stratagem cannot be deployed in 2 hours. The city would not experience this again within 6 hours, and countermeasure Advance by A Hidden Path is available to disable this strategem." itemDesc="Troops are lying in ambush from all directions to wait for their enemies. Once your adversary enter the plotted trap, he is hardly escape it. " iconUrl="images/items/20090630/Ambush from All Sides.png" price="15"/>
  <itemEum id="player.trick.tblj" name="Alienating and Instigating" itemType="计谋" dayLimit="0" userLimit="0" desc="Successful application can decrease loyalty of one of the opponent's heroes by 10% to 50%. The hero would not experience this twice a day." itemDesc="Alienate and inharmonize your enemies. Distrustfulness and non-solidarity can significantly cripple opponent’s troops fighting ability." iconUrl="images/items/20090630/Alienating and Instigating.png" price="100"/>
  <itemEum id="player.trick.wwjz" name="Besiege Enemy’s Fort to Rescue Ally’s City" itemType="计谋" dayLimit="0" userLimit="0" desc="Troops sent from the city that is taken in by this stratagem will be recalled compulsorily." itemDesc="To save your ally from attacking, it’s more effective to attack invaders’ homeland than dogfight with their grand troops. Once their home is under attack, they abort the action and retreat. Thus your ally is safe." iconUrl="images/items/20090630/Besiege Enemys Fort to Rescue Allys City.png" price="90"/>
  <itemEum id="player.trick.xzxs" name="Bluffing" itemType="计谋" dayLimit="0" userLimit="0" desc="Marching troops are blew up to 5 to 10 times bigger than the actual number. It's effective for 12 hours and can be extended by multiple applications." itemDesc="When you are outnumbered by rival, you can use this stratagem to delude he. Bluffing causes psychological impact to your rival, which may postpone his attack thus earn you time to prepare." iconUrl="images/items/20090630/Bluffing.png" price="15"/>
  <itemEum id="player.trick.ydsr" name="Entice Enemy into Compromising Position" itemType="计谋" dayLimit="0" userLimit="0" desc="Increases opponent's troops marching speed by 50%. It interrupts rival's attacking plan." itemDesc="Deal with your enemy by enticing him into the isolating position, and then find any possible way to take him out." iconUrl="images/items/20090630/Entice Enemy into Compromising Position.png" price="35"/>
  <itemEum id="player.trick.yqxg" name="Cover up Army Maneuvers" itemType="计谋" dayLimit="0" userLimit="0" desc="Marching troops are understated to 10% to 20% of the actual number. It's effective for 12 hours and can be extended by multiple applications." itemDesc="In ancient wars, army hoisted their flag and beat the drum to boost the morale. If an army stops doing these, their adversary may be deceived that there was ambush lain in front of them, therefore, they retreat.  This ploy is metaphor for secret military maneuvers." iconUrl="images/items/20090630/Cover up Army Maneuvers.png" price="20"/>
  <itemEum id="player.trick.yyhz" name="Inundate with Rumors" itemType="计谋" dayLimit="0" userLimit="0" desc="Increases public grievance of rival city by 15. Can only be applied once to a city a day." itemDesc="In ancient time, one party might sent spies or agents to infiltrate into the other party in order to spread rumors in rival city to cause unrest and doubtfulness. This is effective and costs much less than waging war. Trepidation and fears are the greatest forces to break an army." iconUrl="images/items/20090630/Inundate with Rumors.png" price="75"/>
  <itemEum id="player.trick.zsmj" name="Sow Spies in Enemy’s Camp" itemType="计谋" dayLimit="0" userLimit="0" desc="A report is sent to the player showing how many troops are marching to or from the target city." itemDesc="Espionage activity is commonplace in wartime. Ancient countries had developed their systems for the acquisition of intelligence.  They plants their spies in enemies’ cities to obtain different information about rivals’ military maneuver and resources statistics so that they can have a better idea of each other and deploy their own troops." iconUrl="images/items/20090630/Sow Spies in Enemys Camp.png" price="65"/>
  <itemEum id="player.troop.1.a" name="War Ensign" itemType="宝物" dayLimit="0" userLimit="0" desc="Pre-applied in Rally Spot to increase personnel limit 25% while sending out troops." itemDesc="War Ensign is held by hero to lead his troops in battles. Use it before you send your troops, personnel can be increased in your regiment." iconUrl="images/items/junqi.png" price="30" playerItem="true"/>
  <itemEum id="player.troop.1.b" name="Napoleon's Diary" itemType="加速" dayLimit="0" userLimit="0" desc="Shorten remaining time of a training troops 30%. Can be only applied one to a training group." itemDesc="Napoleon is one of the most talented strategists in Europe. His diary recorded summary of troops drilling, which is definitely an accelerator to your army training." iconUrl="images/items/zhinan.png" price="30"/>
  <itemEum id="player.truce.dream" name="Dream Truce" itemType="宝物" dayLimit="0" userLimit="0" desc="Every Dream Truce grants you continuous 10 hours truce time for a day. And you can multi-use Dream Truces to get 10-hour truces for as many days as you want to. Also you can set when the Dream Truce Time starts. For multi-use,you can change the Dream Truce Starting Time once for every 72 hours. Be aware that it is considered to be multi-use if you use another Dream Truce before the current Dream Truce Time runs out." itemDesc="You can appoint a time frame of 10 hours to apply for truce for one day." iconUrl="images/icon/gold1.jpg" price="0" playerItem="true"/>
  <itemEum id="player.turkey.dressing" name="Turkey and Dressing" itemType="宝物" dayLimit="0" userLimit="0" desc="A gift from your friends during Thanksgiving Day. Use it to get a 24 hours 50% upkeep buff in ALL your cities from Nov 26th to Nov 30th. Turkey and Dressing is stackable (meaning if you already have this buff, using it again will add a further 24 hours). Once December 1st comes though, this buff will expire if you haven't used it yet." itemDesc="Get a 24 hours 50% upkeep buff during Nov 26th and Nov 30th." iconUrl="images/icon/shop/TurkeyandDressing.jpg" price="0" playerItem="true"/>
  <itemEum id="player.turkey.dressing.1" name="Turkey and Dressing 1" itemType="宝物" dayLimit="0" userLimit="0" desc="A gift from your friends during Thanksgiving Day. Use it to get a 24 hours 50% upkeep buff in ALL your cities from Nov 21th to Nov 26th. Turkey and Dressing is stackable (meaning if you already have this buff, using it again will add a further 24 hours). Once November 27th comes though, this buff will expire if you haven't used it yet." itemDesc="Get a 24 hours 50% upkeep buff during Nov 21th and Nov 26th." iconUrl="images/icon/shop/turkeyanddressing2.png" price="0" playerItem="true"/>
  <itemEum id="player.turkey.hunt" name="Turkey Bounty" itemType="宝箱" dayLimit="0" userLimit="1" desc="Open the bounty and find out what you found in the Turkey Hunt!" itemDesc="Opening the Turkey Bounty will grant you one of the Turkey Hunt prizes, randomly." iconUrl="images/icon/shop/turkeybounty.png" price="0" playerItem="true"/>
  <itemEum id="player.warcharmoftheindomitable" name="War Charm of the Indomitable" itemType="宝物" dayLimit="0" userLimit="1" desc="This war charm pulses with power, and tingles to the touch. It promises to make you stronger." itemDesc="Using this item will provide a 15% bonus to Attack when attacking another player. This item is available from August 29th until September 8th." iconUrl="images/icon/shop/warcharmoftheindomitable.png" price="0" playerItem="true"/>
  <itemEum id="primary.truce.agreement.12" name="Primary 12-Hour Truce Agreement" itemType="宝物" dayLimit="0" userLimit="0" desc="Once applied, you can appoint a timeframe of 12 hours in a day for truce, lasting for 7 days." itemDesc="You can appoint a timeframe of 12 hours in a day to apply for truce, the effect will last for 7 days. Once the timeframe is set, it can not be changed. This effect can be canceled." iconUrl="images/items/Silver1.jpg" price="175"/>
  <itemEum id="primary.truce.agreement.16" name="Primary 16-Hour Truce Agreement" itemType="宝物" dayLimit="0" userLimit="0" desc="Once applied, you can appoint a timeframe of 16 hours in a day for truce, lasting for 7 days." itemDesc="You can appoint a timeframe of 16 hours in a day to apply for truce, the effect will last for 7 days. Once the timeframe is set, it can not be changed. This effect can be canceled." iconUrl="images/items/gold1.jpg" price="210"/>
  <itemEum id="primary.truce.agreement.8" name="Primary 8-Hour Truce Agreement" itemType="宝物" dayLimit="0" userLimit="0" desc="Once applied, you can appoint a timeframe of 8 hours in a day for truce, lasting for 7 days." itemDesc="You can appoint a timeframe of 8 hours in a day to apply for truce, the effect will last for 7 days. Once the timeframe is set, it can not be changed. This effect can be canceled." iconUrl="images/items/Copper1.jpg" price="140"/>
  <itemEum id="senior.truce.agreement.12" name="Senior 12-Hour Truce Agreement" itemType="宝物" dayLimit="0" userLimit="0" desc="Once applied, you can appoint a timeframe of 12 hours in a day for truce, lasting for 30 days." itemDesc="You can appoint a timeframe of 12 hours in a day to apply for truce, the effect will last for 30 days. Once the timeframe is set, it can not be changed. This effect can be canceled." iconUrl="images/items/Silver2.jpg" price="675"/>
  <itemEum id="senior.truce.agreement.16" name="Senior 16-Hour Truce Agreement" itemType="宝物" dayLimit="0" userLimit="0" desc="Once applied, you can appoint a timeframe of 16 hours in a day for truce, lasting for 30 days." itemDesc="You can appoint a timeframe of 16 hours in a day to apply for truce, the effect will last for 30 days. Once the timeframe is set, it can not be changed. This effect can be canceled." iconUrl="images/items/gold2.jpg" price="810"/>
  <itemEum id="senior.truce.agreement.8" name="Senior 8-Hour Truce Agreement" itemType="宝物" dayLimit="0" userLimit="0" desc="You can appoint a timeframe of 8 hours in a day to apply for truce, the effect will last for 30 days. Once the timeframe is set, it can not be changed. This effect can be canceled." itemDesc="Once applied, you can appoint a timeframe of 8 hours in a day for truce, lasting for 30 days." iconUrl="images/items/Copper2.jpg" price="540"/>
</itemDefineI18n>