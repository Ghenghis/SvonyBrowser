  <itemEum id="player.box.present.money.33" name="Halloween Chest O'Treats" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes: Chest A (Freedom Medal, Justice Medal, Nation Medal, Michelangelo's Script, Plowshares, Arch Saw, Quarrying Tools, Blower, War Ensign, Excalibur, The Wealth of Nations, Amulet) or Chest B (Primary Guidelines, Intermediate Guidelines, Hero Hunting, Merchant Fleet, Plowshares, Double Saw, Quarrying Tools, Blower, Michelangelo's Script, Tax Policy, The Wealth of Nations) or Chest C (Excalibur, War Horn, Corselet, Truce Agreement, War Ensign, Adv City Teleporter, Michelangelo's Script)" itemDesc="These chests are sent to you as Halloween gifts from your friends in the game. They require a Halloween Skeleton Key to open. You can obtain a Halloween Skeleton Key for every $30 worth of purchases made during Halloween. When opened, you will receive a random assortment of Halloween Chest O'Treats A, B, or C." iconUrl="images/icon/shop/hallow2.jpg" price="300" playerItem="true"/>
  <itemEum id="player.box.present.money.330" name="Crystal of Memories" itemType="宝箱" dayLimit="0" userLimit="0" desc="Using the crystal will grant you: 10 cents, 1 x Stygandr’s Banner of the Horde, 10,000,000 units of a resource." itemDesc="Memories have coalesced into this small crystal shard. Concentrate hard enough, and you’ll be rewarded." iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.331" name="10,000,000 of a random resource" itemType="宝箱" dayLimit="0" userLimit="0" desc="Opening this item will grant you 10,000,000 of a random resource." itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.332" name="Sommer’s Gift" itemType="宝箱" dayLimit="0" userLimit="0" desc="The sun rises to its zenith and holds court about the world. Sommer’s dawned, and the gifts of the sun await you." itemDesc="Opening the Sommer’s Gift will grant you the following:1 x Adv Teleporter,3 x War Teleporter,5 x War Ensign,2 x Stygandr’s Banner of the Horde,2 x Stone of Finding,1 x The Moon’s Shard." iconUrl="images/icon/shop/sommersgift2016.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.333" name="Sommerdawn’s Chest" itemType="宝箱" dayLimit="0" userLimit="0" desc="This chest of helpful items were gathered during the festival of the Summerdawn." itemDesc="Once opened, Sommerdawn’s Chest will randomly provide you with one of the following sets of items:The Golden Sun,The Silver Moon,The Sky’s Court,Cygnus’ Wing" iconUrl="images/icon/shop/sommerdawnschest.png" price="0" playerItem="true"/>
