  <itemEum id="player.box.present.money.85" name="Summer of Gold Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="The Summer of Gold package is our gift to you for a purchase during the Summer of Gold package during July and August of 2012!" itemDesc="Opening the Summer of Gold Package will give you:2 x Amulets 1 x Adv City Teleporter,2 x City Teleporter,1 x Ivory Horn,1 x War Ensign" iconUrl="images/icon/shop/olympic.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.86" name="Summer of Gold Chest" itemType="宝箱" dayLimit="0" userLimit="1" desc="This chest is for the Summer of Gold Promotion for July and August of 2012! You will receive a random chest filled with great items!" itemDesc="Opening this chest will give you one of the following sets:\r\nFan Set\r\nCompetitor Set\r\nBronze Set\r\nSilver Set\r\nGold Set" iconUrl="images/icon/shop/chestpackage.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.87" name="Fan Set" itemType="宝箱" dayLimit="0" userLimit="0" desc="65% chance, worth 255 cents,1 x Excalibur,2x Adv City Teleporter,1 x War Horn - 20% increase to troop str 24 hours ,1 x Fleet Feet" itemDesc="65% chance, worth 255 cents,1 x Excalibur,2x Adv City Teleporter,1 x War Horn - 20% increase to troop str 24 hours ,1 x Fleet Feet" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.88" name="Competitor Set" itemType="宝箱" dayLimit="0" userLimit="0" desc="20% chance, worth 510 cents,2 x Excalibur,2 x Adv City Teleporter,2x Random City Teleporter,1 x Wealth of Nations,1 x Penicillin ,1x Endurance of the Immortals" itemDesc="20% chance, worth 510 cents,2 x Excalibur,2 x Adv City Teleporter,2x Random City Teleporter,1 x Wealth of Nations,1 x Penicillin,1x Endurance of the Immortals" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.89" name="Bronze Set" itemType="宝箱" dayLimit="0" userLimit="0" desc="8% chance, worth 690 cents,2 x Excalibur,2 x On War,1 x Ivory Horn,1x Penicillin,2 x Ultra Corselet - Increase Army defense by 20% for 7 days,2 x Justice Medal - Awards one Justice medal,1x Adv Teleporter,1x Alchemist’s Amplifier" itemDesc="8% chance, worth 690 cents,2 x Excalibur,2 x On War,1 x Ivory Horn,1x Penicillin,2 x Ultra Corselet - Increase Army defense by 20% for 7 days,2 x Justice Medal - Awards one Justice medal,1x AdvTeleporter,1x Alchemist’s Amplifier" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
