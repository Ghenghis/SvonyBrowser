  <itemEum id="player.box.present.money.396" name="Basket of Ovo Renovatur" itemType="宝箱" dayLimit="0" userLimit="0" desc="This basket was delivered to you by a rather large rabbit, and bears the symbol of the Ovo Renovatur. As you look into it, you see wonders and treasures!" itemDesc="Opening this basket will grant you:1 x Adv Teleporter,1 x War Teleporter,3 x War Ensign,1 x On War,1 x Stone of Finding,1 x Excalibur,1 x Corselet" iconUrl="images/icon/shop/basketofovorenovatur.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.397" name="Gift of the Ovo Renovatur" itemType="宝箱" dayLimit="0" userLimit="0" desc="This golden gift from the Ovo Renovatur showed up quietly, and promises true riches within! If you can find the key, the contents are yours!" itemDesc="This chest can be opened with the Easter Key from the 2017 Easter promotion. Once opened you will gain one of the following chest packages!" iconUrl="images/icon/shop/giftoftheovorenovatur.png" price="0" playerItem="true"/>
