  <itemEum id="player.box.present.money.120" name="Valentine’s Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="Opening Valentine’s Package will give you the following items:2 x Random Medal,1 x Adv City Teleporter,1 x WarTeleporter,2 x War Horn,2 x Corselet ,4 x Amulet ,1 x Casanova’s Key" itemDesc="St. Valentine’s festival spreads the love to all, this package will help you meet new people, take long walks on the beach, and then crush them with your might." iconUrl="images/icon/shop/valentinespackage.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.121" name="Casanova’s Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="Includes: Writings from Casanova (Adv City Teleporter, War Horn, Aries Amulet, War Ensign, War Teleporter) or Box of Candies (Masterwork of the Stonecutter, Adv City Teleporter, City Teleporter, Excalibur, War Teleporter, Wealth of Nations, Penicillin) or Flowers and a Card (Excalibur, On War, Masterwork of the Stonecutter, Gundulf’s Compass, Adv City Teleporter) Or Crown of Flowers (Holy Helm of Mars, Vesta’s Blessing, On War, War Teleporter, Gundulf’s Compass, Adv City Teleporter) Or Gilded Jewelry Box (750 cents, On War, War Teleporter, Masterwork of the Stone Mason, Gundulf’s Compass)" itemDesc="These chests are sent to you as Valentine gifts from your friends in the game. They require a Casanova’s Key to open. You can obtain a Casanova’s Key for every $30 worth of purchases made during Valentine promotion. When opened, you will receive a random assortment ofGilded Jewelry Box, Crown of Flowers, Flowers and a Card, Box of Candies, Writings from Casanova." iconUrl="images/icon/shop/casanovaspackage.png" price="0" playerItem="true"/>
