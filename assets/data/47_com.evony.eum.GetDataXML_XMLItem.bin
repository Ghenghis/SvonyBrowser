  <itemEum id="player.box.wood.1" name="Wooden Chest" itemType="宝箱" dayLimit="0" userLimit="0" desc="Acquires one item randomly once opened." itemDesc="Wood-made chest, be gained in plunder or conquer valleys. One item offered randomly if opened." iconUrl="images/items/pojiumuhe.png" price="0" playerItem="true"/>
  <itemEum id="player.builders.tools" name="Builder's Tools" itemType="宝箱" dayLimit="0" userLimit="1" desc="Masons and builders in the middle ages constructed palaces, walls and cathedrals with little besides a hammer, chisel and a dream." itemDesc="Gundalf’s Compass (125 Cent value), to let you build twice as much for 2 days!" iconUrl="images/icon/shop/builderstools.png" price="0" playerItem="true"/>
  <itemEum id="player.candy.corn" name="Candy Corn" itemType="宝物" dayLimit="0" userLimit="0" desc="Your troops will consume no food for 24 hours. Stacks up to 5 times." itemDesc="This yummy candy will satisfy the appetite of your troops. That is strange, because it has absolutely no nutritional value!" iconUrl="images/icon/shop/candycorn.png" price="0" playerItem="true"/>
  <itemEum id="player.candy.corn.2013" name="Candy Corn 2013" itemType="宝物" dayLimit="0" userLimit="0" desc="Using this item will grant you 50% free upkeep during the Halloween 2013 promotion!" itemDesc="Trick or treat, candy time! " iconUrl="images/icon/shop/candycorn2013.png" price="0" playerItem="true"/>
  <itemEum id="player.candy.corn.2014" name="Candy Corn 2014" itemType="宝物" dayLimit="0" userLimit="0" desc="Trick or treat, candy time!" itemDesc="Using this item will grant you 50% free upkeep during the Halloween 2014 promotion!" iconUrl="images/icon/shop/candycorn2014.png" price="0" playerItem="true"/>
  <itemEum id="player.chocolate.bunny" name="Chocolate Bunny" itemType="宝物" dayLimit="0" userLimit="1" desc="Happy Easter! This tasty bunny will help you bring home more troops on your next attack." itemDesc="Using this item will increase your heal rate by 10% for the next attack sent." iconUrl="images/icon/shop/chocolatebunny.png" price="0" playerItem="true"/>
  <itemEum id="player.christmas.gift" name="Christmas Gift" itemType="宝物" dayLimit="0" userLimit="1" desc="Opening this gift will give you the following benefits:+15% to Heal for 24 hours,+25% to Resource Production for 24 hours,10% Speed to Recruiting queue for 24 hours." itemDesc="Merry Christmas from the Evony team! Hope you have a happy holidays and a wonderful New Year!" iconUrl="images/items/playerchristmasgift.png" price="0" playerItem="true"/>
  <itemEum id="player.cupid.chocolate" name="Cupid's Chocolates " itemType="宝物" dayLimit="0" userLimit="0" desc="A gift from your friends during Valentine's Day. Use it to get a 24 hours 50% upkeep buff in ALL your cities from Feb 12th to Feb 16th. Cupid's Chocolates are stackable (meaning if you already have this buff, using it again will add a further 24 hours). Once Feb 17th comes though, this buff will expire if you haven't used it yet." itemDesc="Get a 24 hours 50% upkeep buff during Feb 12th and Feb 16th." iconUrl="images/icon/shop/chocolate.png" price="0" playerItem="true"/>
  <itemEum id="player.cupid.chocolates" name="Cupid’s Chocolates" itemType="宝物" dayLimit="0" userLimit="0" desc="Get a 24 hours 100% free upkeep buff during Feb 06th 2013 and Feb 17th 2013." itemDesc="When used, Cupid’s Chocolates will grant 24 hours of zero upkeep. This item can be stacked, and will expire after maintenance on the 17th of February, 2013." iconUrl="images/icon/shop/cupidschocolates.png" price="0" playerItem="true"/>
  <itemEum id="player.defendinc.1" name="Corselet" itemType="宝物" dayLimit="0" userLimit="0" desc="Increase Defence of troops by 20%. Effective for 24 hours." itemDesc="Made of special material, this armor can resist certain strike of rival. Defence of soldiers increased once they put on this armor." iconUrl="images/items/zhandouhujia.png" price="10" playerItem="true"/>
  <itemEum id="player.defendinc.1.b" name="Ultra Corselet" itemType="宝物" dayLimit="0" userLimit="0" desc="Increase Defence of troops by 20%. Effective for 7 days." itemDesc="Made of high-grade sturdy material, this Armor can resist certain strike of rival. Defence of soldiers increased once they put on this armor." iconUrl="images/items/gaojihujia.png" price="60" playerItem="true"/>
  <itemEum id="player.destroy.1.a" name="Dynamite" itemType="宝物" dayLimit="0" userLimit="0" desc="Demolish building immediately. But acquire no resource." itemDesc="Gunpowder was introduced to Europe by Macro Polo from China. Beside it was used in wars, also it was used to demolish building. Buildings destructed by Dynamite leaves no resource to you. Meanwhile, it can't be applied to Town Hall." iconUrl="images/items/huoyaotong.png" price="20"/>
  <itemEum id="player.easter.egg" name="Easter Egg" itemType="宝物" dayLimit="0" userLimit="0" desc="A gift from your friends at Easter. Use it to get 24 hours of 50% upkeep in ALL your cities any time from April 23rd through April 29th. Easter Eggs are stackable (meaning if you already have this buff, using it again will add an additional 24 hours). Once April 30th comes, this item will expire." itemDesc="Get a 24 hours 50% upkeep buff during April 23rd and April 30th." iconUrl="images/icon/shop/EasterEgg.png" price="0" playerItem="true"/>
  <itemEum id="player.easter.key" name="Easter Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This golden key seems heavier than it should be. Looking closer you see it’s a massive foil covered chocolate key!" itemDesc="key will open the 2013 Easter promotional chest." iconUrl="images/icon/shop/easterkey.png" price="0"/>
  <itemEum id="player.easter.stoptoopsupkeep" name="Marshmallow Meep" itemType="宝物" dayLimit="0" userLimit="0" desc="This delicious treat reduces food your troops consume by 50% for 24 hours. Expires April 15th." itemDesc="This delicious treat reduces food your troops consume by 50% for 24 hours. Expires April 15th." iconUrl="images/icon/shop/marshmallowmeep.png" price="0" playerItem="true"/>
  <itemEum id="player.emcard.1" name="EM(Evony Member) Card" itemType="宝物" dayLimit="0" userLimit="0" desc="Evony membership for 30 days." itemDesc="Join Evony official club now to access to all member services. For the moment, members whose cities are attacked will receive prompt reports which will be sent to their registered emails." iconUrl="images/EmbedImages/playInfo/emcard.png" price="100" playerItem="true"/>
  <itemEum id="player.emperors.hallmark" name="Emperor’s Hallmark" itemType="宝箱" dayLimit="0" userLimit="1" desc="The greatest lords wear only the best armor. Painstakingly crafted by master smiths, these accessories and armor are fit for the ruler of a mighty empire." itemDesc="includes 5x Mechanic Battalion,20 x Stygandr’s Banner of the Horde,5 x Dream Truce,5x War Teleporter,5x War Ensign" iconUrl="images/icon/shop/emperorshallmark.png" price="0" playerItem="true"/>
  <itemEum id="player.emperors.hallmark.2014" name="Emperor’s Hallmark 2014" itemType="宝箱" dayLimit="0" userLimit="1" desc="The greatest lords wear only the best armor. Painstakingly crafted by master smiths, these accessories and armor are fit for the ruler of a mighty empire." itemDesc="includes Holy Helm of Mars,5x Mechanic Battalion,Excalibur,Ultra Corselet,Dream Truce,5x War Teleporter,5x War Ensign,Penicillin." iconUrl="images/icon/shop/emperorshallmark2014.png" price="0" playerItem="true"/>
  <itemEum id="player.emperors.hallmark.2015" name="Emperor’s Hallmark 2015" itemType="宝箱" dayLimit="0" userLimit="1" desc="The greatest lords wear only the best armor. Painstakingly crafted by master smiths, these accessories and armor are fit for the ruler of a mighty empire." itemDesc="includes Holy Helm of Mars, 5 x Stone of Finding,20 x Stygandr’s Banner of the Horde,5 x Dream Truce,5 x War Teleporter,5 x War Ensign,500,000,000 of a random resource,20 x Aries Amulet,2 x Vesta's Blessing." iconUrl="images/icon/shop/emperorshallmark2014.png" price="0" playerItem="true"/>
  <itemEum id="player.evoween.treats" name="Evoween Treats Bag" itemType="宝箱" dayLimit="0" userLimit="1" desc="You will receive a random item among Resources,Speaker, Beginner Guidelines, Amulet, City teleport, 10 coins, Haunted Castle" itemDesc="Exchanged with 10 pieces of Evoween Treats. Once opened will provide you with an item randomly." iconUrl="images/icon/shop/evoweentreats.png" price="0" playerItem="true"/>
  <itemEum id="player.evoween.treats.2013" name="Evoween Treats 2013" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes: Resources, Excalibur, Ultra Corselet , Penicillin, War Ensign, Haunted Castle ,Amulet, War teleport, Adv. City Teleport , 10 coins" itemDesc="The Evoween Treats are exchanged with 1 candy. Once opened will provide you with an item randomly." iconUrl="images/icon/shop/evoweentreats2013.png" price="0" playerItem="true"/>
  <itemEum id="player.evoween.treats.2014" name="Evoween Treats 2014" itemType="宝箱" dayLimit="0" userLimit="1" desc="The Evoween Treats are exchanged with 1 candy. Once opened will provide you with an item randomly." itemDesc="Resources, Excalibur, Ultra Corselet , Penicillin, War Ensign, Haunted Castle ,Amulet, War teleport, Adv. City Teleport , 10 coins." iconUrl="images/icon/shop/evoweentreats2014.png" price="0" playerItem="true"/>
  <itemEum id="player.experience.1.a" name="Anabasis" itemType="宝物" dayLimit="0" userLimit="0" desc="Increase hero's experience by 1,000 or 8% of current level cap (whichever's greater)." itemDesc="Anabasis is wrote by ancient Greek writer Xenophone.Anabasis is one of the first unabridged texts studied by students of classical Greek due to its clear and unadorned style. This item used to increase hero's Experience slightly." iconUrl="images/items/changzhengji.png" price="8" heroItem="true"/>
  <itemEum id="player.experience.1.b" name="Epitome of Military Science" itemType="宝物" dayLimit="0" userLimit="0" desc="Increase hero's experience by 10,000 or 30% of current level cap (whichever's greater)." itemDesc="Epitome of Military Science, written by ancient Roman writer Vegetius. Vegetius's epitome mainly focuses on military organization and how to react to certain occasions in war. This item used to increase hero's Experience considerably." iconUrl="images/items/luomajunzhi.png" price="30" heroItem="true"/>
  <itemEum id="player.experience.1.c" name="On War" itemType="宝物" dayLimit="0" userLimit="0" desc="Increase hero's experience by 100,000 or 100% of current level cap (whichever's greater)." itemDesc="Carl von Clausewitz was a Prussian strategist. His masterpiece On War is listed amongst military classic works. This item used to increase hero's Experience massively." iconUrl="images/items/zhangzhengluen.png" price="100" heroItem="true"/>
  <itemEum id="player.fort.1.c" name="Archimedes' Note" itemType="加速" dayLimit="0" userLimit="0" desc="Shorten the remaining time of construction of Fortified units by 30%. Limit to one application for each construction in queue." itemDesc="Archimedes was a Greek mathematician, physicist, engineer, inventor, and astronomer. He is credited with designing innovative machines, including siege engines and the screw pump that bears his name.  Designs of different machinery recorded on this note are definitely beneficial to your fortification." iconUrl="images/items/ajimidebiji.png" price="35"/>
  <itemEum id="player.gen.castle.1" name="Bronze Amulet" itemType="宝物" dayLimit="0" userLimit="1" desc="City token. When applied, generate a city in a random location with Rally Spot and all resource buildings to level 11" itemDesc="You can use this token to build a city instantly. Keep at least one city slot open before you apply this item." iconUrl="images/icon/shop/bronzeamulet.png" price="88" playerItem="true"/>
  <itemEum id="player.gen.castle.2" name="Silver Amulet" itemType="宝物" dayLimit="0" userLimit="1" desc="City token. When applied, generate a city in a random location with Rally Spot and all resource buildings to level 12." itemDesc="You can use this token to build a city instantly. Keep at least one city slot open before you apply this item." iconUrl="images/icon/shop/silveramulet.png" price="88" playerItem="true"/>
  <itemEum id="player.gen.castle.3" name="Gold Amulet" itemType="宝物" dayLimit="0" userLimit="1" desc="City token. When applied, generate a city in a random location with Rally Spot and all resource buildings to level 14." itemDesc="You can use this token to build a city instantly. Keep at least one city slot open before you apply this item." iconUrl="images/icon/shop/goldamulet.png" price="88" playerItem="true"/>
  <itemEum id="player.gold.1.a" name="Tax Policy " itemType="生产" dayLimit="0" userLimit="0" desc="Increase Tax Revenue by 100%. Effective for 24 hours." itemDesc="The right tax policy at the right time will increase your tax income in the immediate short period without upsetting your citizens. This increases gold production significantly." iconUrl="images/items/shuilvling.png" price="45" playerItem="true"/>
