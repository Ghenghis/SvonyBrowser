  <itemEum id="player.box.present.money.305" name="Solstice Stores" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.306" name="Brace of Jakes" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.307" name="The Shadow’s Trappings" itemType="宝箱" dayLimit="0" userLimit="0" desc="The shadows were not only rampaging through the countryside like the punxas they were liberated from, they were also collecting anything shiny they could find. The shinier, the more they coveted it. With the shadow being reattached to the punxa, all their pilfered treasures suddenly appear." itemDesc="Your free gift, included with $30 purchase. Includes:1 x Adv Teleporter,1 x War Teleporter,1 x Stygandr’s Banner of the Horde,2 x War Ensign,1 x On War,1 x Stone of Finding,1 x Excalibur,1 x Corselet" iconUrl="images/icon/shop/theshadowsTrappings.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.308" name="Punxa’s Chest" itemType="宝箱" dayLimit="0" userLimit="0" desc="The Punxa’s Chest was given to you by the thankful farmers that were saved from the punxa’s rampage as it hunted its missing shadow. The people appreciate your protection, and this gift shows it." itemDesc="Requires the Shadow’s Horn Key to open, which is included with every $30 purchase. Contains a random assortment of items which could be worth more than 2500 cents!" iconUrl="images/icon/shop/punxaschest.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.309" name="Offering of Thanks" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.31" name="Special Evony Happiness Chest" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes: Chest A (Freedom Medal, Justice Medal, Nation Medal, Michelangelo's Script, Plowshares, Arch Saw, Quarrying Tools, Blower, War Ensign, Excalibur, The Wealth of Nations, Amulet) or Chest B (Primary Guidelines, Intermediate Guidelines, Hero Hunting, Merchant Fleet, Plowshares, Double Saw, Quarrying Tools, Blower, Michelangelo's Script, Tax Policy, The Wealth of Nations) or Chest C (Excalibur, War Horn, Corselet, Truce Agreement, War Ensign, Adv City Teleporter, Michelangelo's Script)" itemDesc="These Chests are presented to you as FREE gifts when your friends purchase the normal Evony Happiness Package. You will receive a random assortment of chests by open it with a Special Chest Key." iconUrl="images/icon/shop/Christmas1.jpg" price="300" playerItem="true"/>
  <itemEum id="player.box.present.money.310" name="Harvester’s Great Bounty" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
