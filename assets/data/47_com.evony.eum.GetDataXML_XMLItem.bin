  <itemEum id="player.item.chestofhunt" name="Chest of Hunt" itemType="宝箱" dayLimit="0" userLimit="1" desc="Emblazoned with the symbols of the Wild Hunt, this chest promises a boon to any who open it." itemDesc="Opening the Chest of the Hunt will give the player one of the following, randomly:Grand Boom of Llewellyn,Huntmaster’s Share,Huntsman’s Prized Trophy,The Gilded Hide,Tools of the Hunt" iconUrl="images/icon/shop/chestofhunt.png" price="0" playerItem="true"/>
  <itemEum id="player.item.chocolatecoin" name="Chocolate Coin" itemType="宝物" dayLimit="0" userLimit="0" desc="This tasty treat will make your people half as hungry! Happy Halloween!" itemDesc="When used during the Halloween promotion, this item will provide you with a 50% reduction in upkeep for 24 hours. Using multiple items will increase the timer. The timer will end at the end of the day on November 6th." iconUrl="images/icon/shop/chocolatecoin.png" price="0" playerItem="true"/>
  <itemEum id="player.item.christmasgift2013" name="Christmas Gift 2013" itemType="宝箱" dayLimit="0" userLimit="0" desc="Merry Christmas from the Evony team! Hope you have a happy holidays and a wonderful New Year!" itemDesc="Opening this gift will give you the following items:5x War Ensign,1x City Teleporter,1x Excalibur,5x Coin of the Hunt" iconUrl="images/icon/shop/christmasgift2013.png" price="0" playerItem="true"/>
  <itemEum id="player.item.coinofsaturn" name="Coin of the Hunt" itemType="宝物" dayLimit="0" userLimit="1" desc="This rare and precious coin will bestow luck in battle upon its bearer during the Hunt of the Snowbound." itemDesc="Using this item will grant you entry into the Snowbound Hunt competition. Each item used will grant you 1 hour of the “Coin of the Hunt”. During this hour you will be able to gain Hunter’s Stones from successful attacks against your neighbors." iconUrl="images/icon/shop/coinofsaturn.png" price="0" playerItem="true"/>
