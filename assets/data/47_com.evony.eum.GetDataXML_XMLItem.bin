  <itemEum id="player.item.crestedtrunk" name="Crested Trunk" itemType="宝箱" dayLimit="0" userLimit="1" desc="This trunk was brought to you as a gift from one of you allies. It is emblazoned with the crest of the Emperor, and has obviously come from the site where the Emperor’s army was routed." itemDesc="Opening the Crested Trunk will give the player one of the following, randomly:The Spoils of the Victor,Quartermaster’s Trunk,The Scout’s Supplies,Cache of the Fells,Chest of the Dogs" iconUrl="images/icon/shop/crestedtrunk.png" price="0" playerItem="true"/>
