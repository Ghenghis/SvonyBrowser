  <itemEum id="player.box.present.money.246" name="Christmas Gift 2014" itemType="宝箱" dayLimit="0" userLimit="1" desc="Merry Christmas from the Evony team! Hope you have a happy holidays and a wonderful New Year!" itemDesc="Opening this gift will give you the following items:5x War Ensign,100 Cents" iconUrl="images/items/christmasgift2014.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.247" name="X’s Toy Stash" itemType="宝箱" dayLimit="0" userLimit="0" desc="Within this bag you find many small wrapped boxes reading, To: O, From: X. As you open them you find tokens of affection, or evidence of a new Warlord rising?" itemDesc="Your free gift, included with $30 purchase. Includes:1 x Adv Teleporter,1 x War Teleporter,3 x War Ensign,1 x On War,1 x Stone of Finding,1 x Angel/Devil Token,1 x Excalibur,1 x Corselet,1 x Key" iconUrl="images/icon/shop/xstreatstash.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.248" name="O’s Chest of Treats" itemType="宝箱" dayLimit="0" userLimit="0" desc="O’s Chest of Treats, waiting for X to open. Could they be conspiring against you? Your neighbors? Take what you want!" itemDesc="Requires the Silver Hearts Key to open, which is included with every $30 purchase. Contains a random assortment of items which could be worth more than 2500 cents!" iconUrl="images/icon/shop/oschestoftreats.png" price="0" playerItem="true"/>
