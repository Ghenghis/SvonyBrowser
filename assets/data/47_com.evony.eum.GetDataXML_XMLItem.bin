  <itemEum id="player.box.present.money.175" name="Harvester's Bounty" itemType="宝箱" dayLimit="0" userLimit="0" desc="Opening the Harvester’s Bounty will grant you the following:1 x Adv Teleporter,1 x War Teleporter,3 x War Ensign,1x Junior Medal Box,1 x Corselet,1x Bernini’s Hammer,1x Bearded Key of the Harvest" itemDesc="The Harvester’s Bounty contains the best items found throughout the countryside, to aid in your efforts against your neighbors." iconUrl="images/icon/shop/harvesterswages.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.176" name="The Chest of Plymouth" itemType="宝箱" dayLimit="0" userLimit="0" desc="The Chest of Plymouth is a gift from the people to help you survive the dark months of Winter." itemDesc="Once opened, the Chest of Plymouth will randomly provide you with one of the following groups of items:Ever-full Horn of Plenty,Premium Winter Store,Prize of the Harvest,Farmer’s Great Bounty,A Gift of Thanks" iconUrl="images/icon/shop/thechestofplymouth.png" price="0" playerItem="true"/>
