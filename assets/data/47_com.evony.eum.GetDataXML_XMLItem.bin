  <itemEum id="equipment.tech.upgrade.1" name="Iron Ore" itemType="材料" dayLimit="0" userLimit="0" desc="Pure metal ores, which are used to create all kinds of gears, a must-have for weaponry. " itemDesc="Pure metal ores, which are used to create all kinds of gears, a must-have for weaponry." iconUrl="images/items/ironOre.png" price="2"/>
  <itemEum id="equipment.tech.upgrade.2" name="Wood" itemType="材料" dayLimit="0" userLimit="0" desc="Woods that haven't been cut, have variety of usages." itemDesc="Woods that haven't been cut, have variety of usages. " iconUrl="images/items/woodM.png" price="2"/>
  <itemEum id="equipment.tech.upgrade.3" name="Crude Gemstone" itemType="材料" dayLimit="0" userLimit="0" desc="All kinds of gemstones that haven't been cut and polished, can be carve into beautiful jewelries. " itemDesc="All kinds of gemstones that haven't been cut and polished, can be carve into beautiful jewelries." iconUrl="images/items/gemstone.png" price="2"/>
  <itemEum id="equipment.tech.upgrade.4" name="Thoroughbred" itemType="材料" dayLimit="0" userLimit="0" desc="High-blooded colt, can be trained to be a first class steed." itemDesc="High-blooded colt, can be trained to be a first class steed." iconUrl="images/items/thoroughbred.png" price="2"/>
