  <itemEum id="player.box.present.money.92" name="Gold Medal Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="Opening this package will give you 5 Aries Amulets!" itemDesc="This package was given to you during the Summer of Gold promotion and contains 5 Aries Amulets!" iconUrl="images/icon/shop/amuletpackage.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.93" name="Purchase Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="The Summer of Gold package is available for purchase during the Summer of Gold Promotion in July and Auguest of 2012!" itemDesc="Opening the Summer of Gold Package will give you:2 x Amulets 1 x Adv City Teleporter, 2 x City Teleporter, 1 x Ivory Horn,1 x War Ensign" iconUrl="images/icon/shop/olympic.png" price="175" playerItem="true"/>
  <itemEum id="player.box.present.money.94" name="Evonytoberfest War Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="These packages are delivered as gifts to players for every $30 worth of purchases made during our Evonytoberfest promotion." itemDesc="You can use this key to open one Saxon Beer Chest sent to you by your friends. If you don’t have any Saxon Beer Chests, you should ask your friends to send you some!" iconUrl="images/icon/shop/evonytoberfest_war_package.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.95" name="Saxon Beer Chest" itemType="宝箱" dayLimit="0" userLimit="0" desc="These chests are sent to you as Saxon Beer gifts from your friends in the game. They require a Saxony Chest Key to open. You can obtain a Saxony Chest Key for every $30 worth of purchases made during this promotion. When opened, you will receive the contents of Saxon Beer Chest A, B or C at random." itemDesc="These chests are sent to you as Saxon Beer gifts from your friends in the game. They require a Saxony Chest Key to open. You can obtain a Saxony Chest Key for every $30 worth of purchases made during this promotion. When opened, you will receive the contents of Saxon Beer Chest A, B or C at random." iconUrl="images/icon/shop/saxon_beer_chest.png" price="0" playerItem="true"/>
