  <itemEum id="hero.loyalty.5" name="Courage Medal" itemType="奖章" dayLimit="0" userLimit="0" desc="Increase a hero's Loyalty by 25 when rewarded. And it is used for hero Persuasion." itemDesc="Medal Reward is an important encouragement system. A country gives it as award to those who make outstanding contribution to the nation. Beside as award given to heroes, it can also used in the Persuasion of rival heroes." iconUrl="images/items/yongqijiangzhang.png" price="0" heroItem="true"/>
  <itemEum id="hero.loyalty.6" name="Wisdom Medal" itemType="奖章" dayLimit="0" userLimit="0" desc="Increase a hero's Loyalty by 30 when rewarded. And it is used for hero Persuasion." itemDesc="Medal Reward is an important encouragement system. A country gives it as award to those who make outstanding contribution to the nation. Beside as award given to heroes, it can also used in the Persuasion of rival heroes." iconUrl="images/items/zhihuijiangzhang.png" price="0" heroItem="true"/>
  <itemEum id="hero.loyalty.7" name="Freedom Medal" itemType="奖章" dayLimit="0" userLimit="0" desc="Increase a hero's Loyalty by 40 when rewarded. And it is used for hero Persuasion." itemDesc="Medal Reward is an important encouragement system. A country gives it as award to those who make outstanding contribution to the nation. Beside as award given to heroes, it can also used in the Persuasion of rival heroes." iconUrl="images/items/ziyoujiangzhang.png" price="0" heroItem="true"/>
  <itemEum id="hero.loyalty.8" name="Justice Medal" itemType="奖章" dayLimit="0" userLimit="0" desc="Increase a hero's Loyalty by 50 when rewarded. And it is used for hero Persuasion." itemDesc="Medal Reward is an important encouragement system. A country gives it as award to those who make outstanding contribution to the nation. Beside as award given to heroes, it can also used in the Persuasion of rival heroes." iconUrl="images/items/zhengyijiangzhang.png" price="0" heroItem="true"/>
  <itemEum id="hero.loyalty.9" name="Nation Medal" itemType="奖章" dayLimit="0" userLimit="0" desc="Increase a hero's Loyalty by 60 when rewarded. And it is used for hero Persuasion." itemDesc="Medal Reward is an important encouragement system. A country gives it as award to those who make outstanding contribution to the nation. Beside as award given to heroes, it can also used in the Persuasion of rival heroes." iconUrl="images/items/guojiajiangzhang.png" price="0" heroItem="true"/>
  <itemEum id="hero.management.1" name="The Wealth of Nations" itemType="宝物" dayLimit="0" userLimit="0" desc="Increase a hero's Politics by 25% when rewarded. Effective for 7 days." itemDesc="Wealth of Nations is the magnum opus of the Scottish economist Adam Smith. It is a clearly written account of economics at the dawn of the Industrial Revolution, as well as a rhetorical piece written for the generally educated individual of the 18th century - advocating a free market economy as more productive and more beneficial to society." iconUrl="images/items/guofuluen.png" price="40" heroItem="true"/>
  <itemEum id="hero.power.1" name="Excalibur" itemType="宝物" dayLimit="0" userLimit="0" desc="Increase a hero's attack by 25% when rewarded. Effective for 7 days." itemDesc="Excalibur, the legendary sword drawn out by King Arthur in the stone. Knight equipped with it sometimes attributed with magical power. Courageous as he is, triumph is for sure." iconUrl="images/items/wangzhezhijian.png" price="40" heroItem="true"/>
  <itemEum id="hero.reset.1" name="Holy Water" itemType="宝物" dayLimit="0" userLimit="0" desc="Default hero's attributes. One more consumed every 10 levels." itemDesc="Heroes get sprayed by Holy Water will have faith. Default hero's attributes, and redistribute his potential points in order to enable him to focus on specific ability." iconUrl="images/items/shengshui.png" price="20" heroItem="true"/>
  <itemEum id="hero.reset.1.a" name="Holy Water (5 pieces package)" itemType="宝物" dayLimit="0" userLimit="0" desc="Default hero's attributes. One more consumed every 10 levels." itemDesc="Including 5 Holy Water. Unpack automatically when purchased." iconUrl="images/items/xiaobaoshengshui.png" price="90" playerItem="true"/>
  <itemEum id="hero.taskitem.01" name="AlbertusMagnus" itemType="任务" dayLimit="0" userLimit="0" desc="Dominican friar and bishop who achieved fame for his comprehensive knowledge of and advocacy for the peaceful coexistence of science and religion" itemDesc="AlbertusMagnus" iconUrl="images/icon/hero/1.png" price="0"/>
  <itemEum id="hero.taskitem.02" name="Aldus Manutius" itemType="任务" dayLimit="0" userLimit="0" desc="Famous humanist, printer and publisher of Venice Italy" itemDesc="Aldus Manutius" iconUrl="images/icon/hero/2.png" price="0"/>
  <itemEum id="hero.taskitem.03" name="Amerigo Vespucci" itemType="任务" dayLimit="0" userLimit="0" desc="Famous humanist, printer and publisher of Venice Italy. " itemDesc="Amerigo Vespucci" iconUrl="images/icon/hero/3.png" price="0"/>
  <itemEum id="hero.taskitem.04" name="Antonio Pierozzi" itemType="任务" dayLimit="0" userLimit="0" desc="He was consecrated Archbishop of Florence in 1446 on the initiative of Pope Eugene IV, and won the esteem and love of his people.           " itemDesc="Antonio Pierozzi" iconUrl="images/icon/hero/4.png" price="0"/>
  <itemEum id="hero.taskitem.05" name="Arnold von Winkelried" itemType="任务" dayLimit="0" userLimit="0" desc="Legendary hero of Swiss history, who allegedly was sacrificed by throwing himself into enemies pikes, taking them down with his body such that the confederates could attack through the opening.      " itemDesc="Arnold von Winkelried" iconUrl="images/icon/hero/5.png" price="0"/>
  <itemEum id="hero.taskitem.06" name="Bertrand Du Guesclin" itemType="任务" dayLimit="0" userLimit="0" desc="Known as the Eagle of Brittany, was a Breton knight and French military commander during theHundred Years War. He was Constable of France from 1370 to his death.  " itemDesc="Bertrand Du Guesclin" iconUrl="images/icon/hero/6.png" price="0"/>
  <itemEum id="hero.taskitem.07" name="Chevalier de Bayard" itemType="任务" dayLimit="0" userLimit="0" desc="Known as &quot;&quot;the knight without fear and beyond reproach.&quot;&quot; Who can resist a hero like him on his side.   " itemDesc="Chevalier de Bayard" iconUrl="images/icon/hero/7.png" price="0"/>
  <itemEum id="hero.taskitem.08" name="Donatello" itemType="任务" dayLimit="0" userLimit="0" desc="Famous early Renaissance Italian artist and sculptor. His sculptures are considered supreme expressions of the spirit of this era in sculpture, and he exercised a potent influence upon the painters of the age.   " itemDesc="Donatello" iconUrl="images/icon/hero/8.png" price="0"/>
  <itemEum id="hero.taskitem.09" name="Francesco Petrarca" itemType="任务" dayLimit="0" userLimit="0" desc="Italian scholar, poet and one of the earliest Renaissance humanists. Petrarca is often popularly called the &quot;&quot;Father of Humanism&quot;&quot;.         " itemDesc="Francesco Petrarca" iconUrl="images/icon/hero/9.png" price="0"/>
  <itemEum id="hero.taskitem.10" name="Francis of Assisi" itemType="任务" dayLimit="0" userLimit="0" desc="He is known as the patron saint of animals, the environment and Italy.          " itemDesc="Francis of Assisi" iconUrl="images/icon/hero/10.png" price="0"/>
  <itemEum id="hero.taskitem.100" name="Anne of Cleves" itemType="任务" dayLimit="0" userLimit="0" desc="In 1540, Anne became the fourth wife of England's King Henry VIII after being chosen for the job by Thomas Cromwell to seal an alliance with German Protestants. Evidently, Henry thought her not the most attractive of German princesses, and he had their unconsummated marriage annulled after 6 months. Keeping her head may have been her greatest achievement. " itemDesc="Anne of Cleves" iconUrl="images/icon/hero/100.png" price="0"/>
  <itemEum id="hero.taskitem.101" name="Anno von Sangerhausen" itemType="任务" dayLimit="0" userLimit="0" desc="Anno von Sangerhausen was a Master of Livonia (1253–56) and the 10th Grand Master of the Teutonic Knights (1256–73). He was one of the first members of the Order from Thuringia. During his rule, the Castle of of Konigsberg was fortified and the surrounding territories were pacified by his forces. He supported the knights in the Holy Land in a 1266 attack by Sultan Beibars.  " itemDesc="Anno von Sangerhausen" iconUrl="images/icon/hero/101.png" price="0"/>
  <itemEum id="hero.taskitem.102" name="Antipater" itemType="任务" dayLimit="0" userLimit="0" desc="Antipater, also known as Antipatros; (ca. 397 B.C. — 319 B.C.) was a Macedonian general and a supporter of kings Philip II of Macedon and Alexander the Great. In 320 B.C., he became regent of all of Alexander the Great's empire. " itemDesc="Antipater" iconUrl="images/icon/hero/102.png" price="0"/>
  <itemEum id="hero.taskitem.103" name="Antoine de Bourbon" itemType="任务" dayLimit="0" userLimit="0" desc="A member of the great French Bourbon dynasty, Antoine de Bourbon was the Duke of Vend me, King Consort of Navarre, and elder brother to Louis I de Bourbon, Prince de Condé. His son, Henry IV, became the King of France after the death of the last of the Valois kings in 1589. Bourbon heirs ruled France for the next 200 years.  " itemDesc="Antoine de Bourbon" iconUrl="images/icon/hero/103.png" price="0"/>
  <itemEum id="hero.taskitem.104" name="Antonia Minor" itemType="任务" dayLimit="0" userLimit="0" desc="Antonia Minor (Jan 31, 36 BCE - Oct 37 CE) is most famous not for who she was, but rather whom she was related to.  Daughter to Roman politician Mark Antony and niece to Rome's first emperor Augustus, her life in Roman politics began when she took her first breath of air as a newborn.  Famous for her beauty and virtue, she later went on to give birth to a son named Claudius, who eventually took his place among the world rulers of his time by becoming Rome's first non-Senate proclaimed Emperor.   " itemDesc="Antonia Minor" iconUrl="images/icon/hero/104.png" price="0"/>
  <itemEum id="hero.taskitem.107" name="Appius Claudius Caudex" itemType="任务" dayLimit="0" userLimit="0" desc="Appius Claudius Caudex, as chief magistrate of Rome was known for gaining the first Roman victory in two battles against Hiero II of Syracuse and Hanno of Carthage which were considered part of the immediate causes of the First Punic War (264 - 241 B.C..)  The Greek historian Polybius of Megalopolis later wrote that the First Punic War which lasted twenty-two years was 'the longest and most severely contested war in history.'  " itemDesc="Appius Claudius Caudex" iconUrl="images/icon/hero/107.png" price="0"/>
  <itemEum id="hero.taskitem.108" name="Arbella Stuart" itemType="任务" dayLimit="0" userLimit="0" desc="Arbella was 6th in line for the English throne but when Philip III of Spain hatched a plot to have King James I overthrown and her put in his place she betrayed the plan to the King.  She died a prisoner in the Tower of London as she starved herself while being kept from her husband, William Seymour. " itemDesc="Arbella Stuart" iconUrl="images/icon/hero/108.png" price="0"/>
  <itemEum id="hero.taskitem.109" name="Archibald Douglas" itemType="任务" dayLimit="0" userLimit="0" desc="In 1525 Douglas, the 6th Earl of Angus who was married to the influential Margaret Tudor, used the strength of his wife's lineage and his own to establish a powerful political position in Scotland.  His efforts were largely frustrated by the powerful Henry VIII but he proved a worthy adversary for the great King. " itemDesc="Archibald Douglas" iconUrl="images/icon/hero/109.png" price="0"/>
  <itemEum id="hero.taskitem.11" name="Geoffrey Chaucer" itemType="任务" dayLimit="0" userLimit="0" desc="English author, poet, philosopher, bureaucrat, courtier and diplomat.           " itemDesc="Geoffrey Chaucer" iconUrl="images/icon/hero/11.png" price="0"/>
  <itemEum id="hero.taskitem.110" name="Arêtes III, King of the Nabata" itemType="任务" dayLimit="0" userLimit="0" desc="Arêtes III was king of the Nabataean kingdom from 87BCE to 62BCE.  He became king when his father, who was the previous king, passed away.  Arêtes III most impressive accomplishment during his reign as king is the amount of territory he brought under his rule.  In fact, Nabataea experienced its most significant territorial expansion during the kingship of Arêtes III.  Famous for his conquest of Damascus, Arêtes III held control of this powerful trade hub for several years before losing control to the Armenians.  He later retook the city with the assistance of Rome.   " itemDesc="Arêtes III, King of the Nabata" iconUrl="images/icon/hero/110.png" price="0"/>
  <itemEum id="hero.taskitem.111" name="Aristillus" itemType="任务" dayLimit="0" userLimit="0" desc="Aristillus was a Greek philosopher who worked in the Great Library of Alexander and who, along with Timocharis, prepared the first true catalog of star positions in the third century B.C..  He was strongly influenced by astronomical theories and methods that were developed in Mesopotamia (modern-day Iraq), particularly in Babylonia which inherited earlier concepts developed in Sumer.  The lunar crater, Aristillus, is named for him. " itemDesc="Aristillus" iconUrl="images/icon/hero/111.png" price="0"/>
  <itemEum id="hero.taskitem.112" name="Aristobulus II, King of Judea" itemType="任务" dayLimit="0" userLimit="0" desc="Aristobulus II, younger son of Alexander Jannaeus, was the Jewish High Priest and King of Judea from 66 to 63 BCE.  Being the youngest son of his father, he was not entitled to inherit his father's position when he died.  His Elder brother, Hyrcanus, was to rule instead.  Aristobulus II thought he should rule for he believed himself to be the stronger fighter and leader.  He rebelled against his elder brother and bested him on the battlefield.  His victory brought him control of the kingdom.  Later Rome cut his rule short and he was killed when he attempted to revolt. " itemDesc="Aristobulus II, King of Judea" iconUrl="images/icon/hero/112.png" price="0"/>
  <itemEum id="hero.taskitem.113" name="Aristotle" itemType="任务" dayLimit="0" userLimit="0" desc="Aristotle (384-322 B.C.) was born in the city of Stageira, Chalcidice.  Aristotle was one of the most important western philosophers.  He was a student of Plato, teacher of Alexander the Great, Ptolemy, and Cassander and was tremendously influential in the Middle Ages. Aristotle wrote on logic, nature, psychology, ethics, politics, and art.  He is credited with developing deductive reasoning and founded the Lyceum where he lectured for twelve years.  His style of lecturing was to walk about under covered walkways, thus he was referred to as 'Peripatetic' (i.e., walking about). He died of a digestive ailment at the age of 63, in Chalcis, north of Athens. " itemDesc="Aristotle" iconUrl="images/icon/hero/113.png" price="0"/>
  <itemEum id="hero.taskitem.115" name="Artaxerxes II of Persia" itemType="任务" dayLimit="0" userLimit="0" desc="Artaxerxes II, (d. 358 B.C.) was an Achaemenid king of ancient Persia (404–358 B.C.).  He was the son and successor of Darius II and in Greek is often referred to as Artaxerxes Mnemon [the thoughtful].   His reign was marked by numerous rebellions and he ultimately initiated a peace agreement with Sparta.  He affected important changes in Persian religion by restoring the worship of earlier gods, which had long been neglected.  His accession to the throne was contested by his brother Cyrus the Younger who he later defeated and killed at Cunaxa.  Egypt revolted and gained independence from the Persian empire during his reign and in general Achaemenid power declined under Artaxerxes rule.   " itemDesc="Artaxerxes II of Persia" iconUrl="images/icon/hero/115.png" price="0"/>
  <itemEum id="hero.taskitem.116" name="Ashurbanipal" itemType="任务" dayLimit="0" userLimit="0" desc="King of Assyria 669-627 B.C.E, and considered the last great ruler of the country.  His father, Esarhaddon left him a kingdom which stretched from northern Egypt to Persia.  Ashurbanipal is remembered as one of the most cultured rulers in the Mesopotamian region.  He was literate in Sumerian and Akkadian scripts which was unusual for rulers of the epoch.  His greatest legacy was the Library of Ashurbanipal escavated at Nineveh.  The library consists of more than 30,000 clay tablets and an incredible collection of reliefs and carvings portraying ideological scenes of Ashurbanipal " itemDesc="Ashurbanipal" iconUrl="images/icon/hero/116.png" price="0"/>
  <itemEum id="hero.taskitem.117" name="Askia Muhammad I" itemType="任务" dayLimit="0" userLimit="0" desc="Muhammad Turé rose to power as a general in the West African empire of Songhay, usurped the throne in 1493, and took the name Askia. He made Timbuktu the capital of Songhay, had a navy on the River Niger, had excellent political and commercial relationships with Egypt and Morocco, and saw his capital city become an important center of religion and learning. " itemDesc="Askia Muhammad I" iconUrl="images/icon/hero/117.png" price="0"/>
  <itemEum id="hero.taskitem.118" name="Atia Balba Caesonia" itemType="任务" dayLimit="0" userLimit="0" desc="Atia Balba Caesonia (85BCE-43BCE) was one of the most famous women in Roman history.  Niece to Julius Caesar and mother to Roman Emperor Augustus, her life was full of political intrigue and suspense.  Known for both her religious and moral character traits, it is said that no foul word could be uttered in her presence without serious consequences.     " itemDesc="Atia Balba Caesonia" iconUrl="images/icon/hero/118.png" price="0"/>
  <itemEum id="hero.taskitem.119" name="Aulus Gabinius" itemType="任务" dayLimit="0" userLimit="0" desc="Gabinius’s highest title was Consul of the Roman Republic during the year 58 BCE.  Suspected of participating in a many acts of bribery, he was greatly responsible for the exile of Marcus Tullius Cicero.  Cicero later defended Gabinius against charges of bribery, extortion, and treason.  Gabinius was a supporter of Gnaeus Pompeius Magnus and refused to march against him when he revolted against Julius Caesar.  Ironically, he died of illness was under siege of attack from one of Pompey’s generals. " itemDesc="Aulus Gabinius" iconUrl="images/icon/hero/119.png" price="0"/>
  <itemEum id="hero.taskitem.12" name="George of Antioch" itemType="任务" dayLimit="0" userLimit="0" desc="Sicily general and strategist. He have a wide range of knowledge.   " itemDesc="George of Antioch" iconUrl="images/icon/hero/12.png" price="0"/>
  <itemEum id="hero.taskitem.120" name="Aurelia Cotta" itemType="任务" dayLimit="0" userLimit="0" desc="Mother of the great Gaius Julius Caesar, Aurelia Cotta played a major part in the upbringing of Julius Caesar and therefore a major part in world history.  She is renown with having a high degree of intelligence and sensibility.  She once advised her son Julius, in response to attacks against his sexuality, to conquer (romantically) the wives of his naysayers.  The result of this advice helped Caesar change public opinion of him as being a “dandy” and earned him many favorable points in the court gossip. " itemDesc="Aurelia Cotta" iconUrl="images/icon/hero/120.png" price="0"/>
  <itemEum id="hero.taskitem.121" name="Avicenna" itemType="任务" dayLimit="0" userLimit="0" desc="Avicenna was the western name given for Abu Ali Sina, a Persian who was the foremost physician and philosopher of his time. He wrote almost 450 works of which 240 have survived. His two most famous works are 'The Book of Healing' a vast encyclopedia of philosophy and science, and 'The Canon of Medicine'. The latter was a standard text in universities and still used as late as 1650. He is regarded as a father of modern medicine and clinical pharmacology.  " itemDesc="Avicenna" iconUrl="images/icon/hero/121.png" price="0"/>
  <itemEum id="hero.taskitem.122" name="Babur" itemType="任务" dayLimit="0" userLimit="0" desc="Zāhir ud-Dīn Muhammad known as Babur became the first Mogul Emperor of India when he failed to reconquer the Central Asian lands that had been his father's. He sought territory to the southeast, and his attributes of fierce ambition and ruthless warfare and government led to his ruling most of northern India. He defeated the Afghan ruler of Delhi in 1526 beginning the 200-year-long Mogul empire in India.   " itemDesc="Babur" iconUrl="images/icon/hero/122.png" price="0"/>
  <itemEum id="hero.taskitem.123" name="Baeda Maryam" itemType="任务" dayLimit="0" userLimit="0" desc="Emperor of Ethiopia, he spent much of his rule leading military campaigns to keep the empire he had inherited from his father.  In particular, he spent nearly ten years fighting the Dobe'a for the lands of Adal, which he never did bring under his control.  He did not rule with the same iron fist as his father, and as a result some of the centralization of the empire was lost.  " itemDesc="Baeda Maryam" iconUrl="images/icon/hero/123.png" price="0"/>
  <itemEum id="hero.taskitem.124" name="Baldwin I of Constantinople" itemType="任务" dayLimit="0" userLimit="0" desc="Baldwin I of Constantinople was one of the most prominent leaders of the Fourth Crusade.  He had established his reputation during eight years of campaigning against Philip II of France as Count of Flanders.  Soon after signing the Treaty of Peronne with Phillip in January of 1200 Baldwin would begin preparing to embark on the Crusade.  He became the first Emperor of the Latin Empire of Constantinople on May 9, 1204 by virtue of his strict adherence to crusading vows and being the most popular leader among the host of Crusaders.  He would be captured during the Battle of Adrianople in 1205 and died soon after so his opportunity to reign over the new Latin Empire was rather shortlived. " itemDesc="Baldwin I of Constantinople" iconUrl="images/icon/hero/124.png" price="0"/>
  <itemEum id="hero.taskitem.125" name="Baldwin I of Edessa" itemType="任务" dayLimit="0" userLimit="0" desc="Baldwin I of Edessa was a leader of the First Crusade and was an important figure in the capture of Jerusalem in 1099 being named King of Jerusalem  soon after it fell.  He was an aggressive ruler, leading several campaigns between 1101 and 1115 to expand the limits of his kingdom capturing important cities in the region such as Acre and Tripoli.  After his death in 1118 William Tyre described as being 'expert in the use of arms, agile on horseback [as well as] active and diligent whenever the affairs of the realm called him.' " itemDesc="Baldwin I of Edessa" iconUrl="images/icon/hero/125.png" price="0"/>
  <itemEum id="hero.taskitem.126" name="Baldwin I, Count of Hainaut" itemType="任务" dayLimit="0" userLimit="0" desc="At the age of twenty-one, marriage granted Baldwin the countship of Hainaut followed by a countship in Flanders several years later. " itemDesc="Baldwin I, Count of Hainaut" iconUrl="images/icon/hero/126.png" price="0"/>
  <itemEum id="hero.taskitem.127" name="Baldwin Iron Arm" itemType="任务" dayLimit="0" userLimit="0" desc="The first count of Flanders first came into neteriety by eloping secretly with the daughter of the king of West Francia.  After receiving a pardon and confirmation of the marriage from the Pope, Baldwin returned to his duties and was instrumental in the wars against the Vikings. " itemDesc="Baldwin Iron Arm" iconUrl="images/icon/hero/127.png" price="0"/>
  <itemEum id="hero.taskitem.128" name="Barbarossa Hayreddin Pasha" itemType="任务" dayLimit="0" userLimit="0" desc="Hayreddin (or Khayr ad-Din) Barbarossa (meaning Redbeard) and his brother Aruj were Turkish Corsairs who pirated Christian ships in the Mediterranean. After Aruj who had become the Sultan of Algiers was killed, Hayreddin ceded his brother's territory to the Ottoman Sultan. The Sultan appointed him Viceroy in 1519 and Grand Admiral of the Ottoman fleet in 1534. He seized the city of Tunis, but, after the navy of Holy Roman Emperor Charles V recaptured Tunis, Barbarossa retired.  " itemDesc="Barbarossa Hayreddin Pasha" iconUrl="images/icon/hero/128.png" price="0"/>
  <itemEum id="hero.taskitem.129" name="Barnim I, Duke of Pomerania" itemType="任务" dayLimit="0" userLimit="0" desc="Barnim I the Good was the Duke of Pomerania from 1220 to 1278. He shared the rule of Pomerania with his cousin Wartislaw III who resided in Demmin. Barnim I united the whole of Pomerania under his rule. He introduced German settlers and customs into the duchy, founded many towns, and was known for his generous ecclesiastical foundations. " itemDesc="Barnim I, Duke of Pomerania" iconUrl="images/icon/hero/129.png" price="0"/>
  <itemEum id="hero.taskitem.13" name="Gerard de Ridefort" itemType="任务" dayLimit="0" userLimit="0" desc="Grand Master of the Knights Templar. Famous of his intrepidity in war.          " itemDesc="Gerard de Ridefort" iconUrl="images/icon/hero/13.png" price="0"/>
  <itemEum id="hero.taskitem.130" name="Bartholomew Diaz de Novaes" itemType="任务" dayLimit="0" userLimit="0" desc="Diaz de Novaes was the Portuguese discoverer of the southern tip of Africa (the Cape of Good Hope) and the Indian Ocean. While exploring the West African coast in 1488, a storm swept him south to landfall at the Cape he first named the Cape of Storms. The land turned north, and he saw a great ocean--the Indian Ocean--to the east. In 1500, he sailed with Pedro álvares Cabral in an attempt to reach India. Using his vast seafaring experience, Diaz de Novaes turned shipbuilder for Vasco da Gama who successfully sailed to India. " itemDesc="Bartholomew Diaz de Novaes" iconUrl="images/icon/hero/130.png" price="0"/>
  <itemEum id="hero.taskitem.131" name="Bayezid II" itemType="任务" dayLimit="0" userLimit="0" desc="Bayezid II succeeded to his father's throne as Ottoman Sultan in 1481. During his 20-year-long reign, he fruitlessly fought the Mameluke Sultans of Egypt, but he won Greek lands and territory around the Adriatic Sea from the Republic of Venice. " itemDesc="Bayezid II" iconUrl="images/icon/hero/131.png" price="0"/>
  <itemEum id="hero.taskitem.132" name="Benjamin Franklin" itemType="任务" dayLimit="0" userLimit="0" desc="Benjamin Franklin as a signer of the Declaration of Independence and the Constitution is a founding father of the United States of America. As a diplomat he was instrumental in securing French help during the American Revolution. He was also a noted scientist and inventor, some of his most noted inventions include, the lighting rod, bifocals and the Franklin Stove. " itemDesc="Benjamin Franklin" iconUrl="images/icon/hero/132.png" price="0"/>
  <itemEum id="hero.taskitem.133" name="Beowulf" itemType="任务" dayLimit="0" userLimit="0" desc="Beowulf's sword, shield and bravery are a welcomed addition to any army.  A hero from Geatland, Beowulf has slain even the most formidable foes, often times without weapons just to prove his might. " itemDesc="Beowulf" iconUrl="images/icon/hero/133.png" price="0"/>
  <itemEum id="hero.taskitem.135" name="Bess of Hardwick" itemType="任务" dayLimit="0" userLimit="0" desc="An accomplished needlewoman and wife to several influential English men, she had the entirety of her family's art, furnishings and textiles bequeathed to her heirs.  The vast majority of these items remain to the present day and represent the largest catalog of tapestry, embroidery and canvas work to be preserved by a single private family. " itemDesc="Bess of Hardwick" iconUrl="images/icon/hero/135.png" price="0"/>
  <itemEum id="hero.taskitem.136" name="Bishop Hungar" itemType="任务" dayLimit="0" userLimit="0" desc="Bishop Hungar oversaw the diocese of city of Utrecht, which had become the most important Christian centre in the Netherlands by the end of the 8th century.  During a Viking raid on the city in 857 Hungar managed to escape with the charter archive of St. Maarten's Church.  He eventually made his way to Deventer where his successors made copies of the charters, thus preserving the records of the Christian church and its holdings in the area of Utrecht. " itemDesc="Bishop Hungar" iconUrl="images/icon/hero/136.png" price="0"/>
  <itemEum id="hero.taskitem.137" name="Boethius" itemType="任务" dayLimit="0" userLimit="0" desc="Considered to be the first great philosophers in the field of scholastic philosophy, Boethius is considered among the greatest of Western thinkers. " itemDesc="Boethius" iconUrl="images/icon/hero/137.png" price="0"/>
  <itemEum id="hero.taskitem.138" name="Bogislaw IV, Duke of Pomerania" itemType="任务" dayLimit="0" userLimit="0" desc="Bogislaw IV was Duke of Pomerania for thirty years, between 1278 and 1309. In the early 1280s Bogislaw was involved in the war in the neighbouring margraviate of Brandenburg. In the 1300s he was allied with future King of Poland W?adys?aw the Short. He was unsuccessfully involved in the opening stages of the decade-long Brandenburg War. He died in 1309 leaving his share of Pomerania to his son Wartislaw. " itemDesc="Bogislaw IV, Duke of Pomerania" iconUrl="images/icon/hero/138.png" price="0"/>
  <itemEum id="hero.taskitem.139" name="Bohemond I" itemType="任务" dayLimit="0" userLimit="0" desc="The eldest son of Norman warrior Robert Guiscard, Bohemond fought with his father against the Byzantine Emperor Alexius Comnenus. In 1086, he joined the First Crusade and was a key figure in capturing the city of Antioch in Syria. Naming himself Prince of Antioch, Bohemond fought the Byzantines again in 1107 but was defeated by Comnenus.  " itemDesc="Bohemond I" iconUrl="images/icon/hero/139.png" price="0"/>
  <itemEum id="hero.taskitem.14" name="Hildegard von Bingen" itemType="任务" dayLimit="0" userLimit="0" desc="German abbess, author, counselor, linguist, naturalist,scientist, philosopher, physician, herbalist, poet, channeller, visionary and composer.          " itemDesc="Hildegard von Bingen" iconUrl="images/icon/hero/14.png" price="0"/>
  <itemEum id="hero.taskitem.140" name="Boris Godunov" itemType="任务" dayLimit="0" userLimit="0" desc="Boris Godunov was a commoner who joined court service under Ivan IV ('the Terrible') and built a career that culminated in his coronation as Tsar of Russia in 1598. In effect, he was regent of Muscovy during the reign of Ivan's imbecilic son Fyodor and was therefore positioned to assume the tsardom when Fyodor died. Russia thrived under Godunov's reign. He promoted trade throughout Europe, fought and won a war against Sweden, and kept peace within Russia by eliminating the boyars (nobles) who opposed him.  " itemDesc="Boris Godunov" iconUrl="images/icon/hero/140.png" price="0"/>
  <itemEum id="hero.taskitem.141" name="Brian Boru" itemType="任务" dayLimit="0" userLimit="0" desc="Brian mac Cennétig was called Brian Bóruma or Brian Boru. Leader of the Dal Cais dynasty, he made himself king of Munster and subjugated Leinster in Southern Ireland. After overthrowing the Uú Néill dynasty that had reigned over most of Ireland for 300 years, Boru became the last High King of Ireland in 1011. In the 1014 battle of Clontarf when his army fought the armies of Dublin, Leinster, and Norse settlers, Brian Boru was slain although his forces won the day. " itemDesc="Brian Boru" iconUrl="images/icon/hero/141.png" price="0"/>
  <itemEum id="hero.taskitem.142" name="Brunhilde" itemType="任务" dayLimit="0" userLimit="0" desc="The Legend of Brunhilde is probably inspired by the Visigothic princess Brunhilda of Austrasia.  The Brunhilde of legend angered the Norse god Odin when she intervened in a battle and he condemned her to live the life of a mortal woman.  The real Brunhilda was a cunning and ruthless ruler during the 6th and 7th Centuries in Austrasia.  She fought ferociously for the succession of her children but was ultimately defeated by Clotaire who united the Kingdoms of Neustria of Austrasia. " itemDesc="Brunhilde" iconUrl="images/icon/hero/142.png" price="0"/>
  <itemEum id="hero.taskitem.143" name="Brutus" itemType="任务" dayLimit="0" userLimit="0" desc="Marcus Junius Brutus, later known as Quintus Servilius Caepio Brutus, (85BCE – 42BCE) and commonly referred to as Brutus, became infamous around the world for his major role in the assassination of Julius Caesar, Emperor of Rome.  A politician who stood and believed in the goodness of democracy, Caesar’s self-appointment as “dictator for life” and other undemocratic actions of Caesar compelled Brutus to conspire against him.  It is said that when the group of assassins attacked Caesar, he began to fight them off, but when he saw that Brutus was among them he wept at the betrayal and stopped defending himself.   " itemDesc="Brutus" iconUrl="images/icon/hero/143.png" price="0"/>
  <itemEum id="hero.taskitem.144" name="Burchard von Schwanden" itemType="任务" dayLimit="0" userLimit="0" desc="Burchard von Schwanden was the 12th Grand Master of the Teutonic Knights, in position from 1282 or 1283-1290. He came from Berne in Switzerland and started out as a monk. He reached the title of the grand master in 1282. During his term the situation of the Crusaders' Kingdom of Jerusalem worsened considerably, but Burchard was in no hurry to help out in the Middle East because the situation was getting worse in Prussia, Livonia and the Holy Roman Empire.  " itemDesc="Burchard von Schwanden" iconUrl="images/icon/hero/144.png" price="0"/>
  <itemEum id="hero.taskitem.145" name="Burebista (King of Dacia)" itemType="任务" dayLimit="0" userLimit="0" desc="Burebista, known as the King of Kings among the Greek, is considered by many as the greatest king of Dacia (82BCE-44BCE).  He stood up to the powers of the Roman Empire on several occasions and was victorious.  He earned the wrath of Julius Caesar who planned to march against him but was assassinated before he left Rome.    " itemDesc="Burebista (King of Dacia)" iconUrl="images/icon/hero/145.png" price="0"/>
  <itemEum id="hero.taskitem.146" name="Caesar" itemType="任务" dayLimit="0" userLimit="0" desc="Gaius Julius Caesar is the most famous of the Roman Emperors.  He was also the first Roman General to invade Britain.  He significantly expanded the Roman Republic, and because of his great accomplishments on the field of battle, he amassed considerable political power.  When others feared he held too much power, they made an attempt to strip him of his rank and titles, which provoked the Roman Civil War.  Caesar emerged victorious and became the first Emperor.  A group of conspirators led by his close friend, Brutus, eventually assassinated him. " itemDesc="Caesar" iconUrl="images/icon/hero/146.png" price="0"/>
  <itemEum id="hero.taskitem.147" name="Caligula" itemType="任务" dayLimit="0" userLimit="0" desc="Gaius Julius Caesar Augustus Germanicus (12ACE-41ACE), more commonly known as Caligula, was the third Roman Emperor.  He earned his nickname Caligula, which means “little soldier’s boot” because as a youth he would follow his father, who was a general, on his many military campaigns.  He is considered by some sources as a tyrant.  His fate eventually caught up with him in the form of an assassin’s touch.  After his assassination, the Roman Senate tried to restore the Republic but was outmaneuvered by the Praetorian Guard.        " itemDesc="Caligula" iconUrl="images/icon/hero/147.png" price="0"/>
  <itemEum id="hero.taskitem.148" name="Canute the Great" itemType="任务" dayLimit="0" userLimit="0" desc="Canute the Great was a Viking king of England, Denmark, Norway and parts of Sweden. While a prince of Denmark he invaded and decisively defeated the forces in England in 1013 and became king in 1016. Shortly thereafter he would ascend to the throne of Denmark in 1018. He crowned himself king of Norway in 1028 and there have been found coins of him as king of Sweden but no records have been found. He has been thought to have been one of the most successful kings of England. His statesmanship and protection from Viking raiders, rang in an era of stability and economic prosperity while hastening the spread of Christianity in the British Isles.  " itemDesc="Canute the Great" iconUrl="images/icon/hero/148.png" price="0"/>
  <itemEum id="hero.taskitem.149" name="Canute VI of Denmark" itemType="任务" dayLimit="0" userLimit="0" desc="When Canute VI was proclaimed King of Denmark, he immediately faced an anti-tax peasant uprising in Sk?ne. He brutally murdered large numbers of them. Canute ordered two invasions of Pomerania and in 1185 forced Bugislaw to acknowledge Canute as his overlord. From that time until 1972 the Kings and Queens of Denmark used the title 'King of the Wends' as part of a long  list of duchies, counties, and regions ruled by Danish monarchs throughout the centuries. Contemporary sources describe Canute as an earnest, strongly religious man. Canute personally led a crusade against the pagan Estonians in 1197. " itemDesc="Canute VI of Denmark" iconUrl="images/icon/hero/149.png" price="0"/>
  <itemEum id="hero.taskitem.15" name="Ibn Khaldun" itemType="任务" dayLimit="0" userLimit="0" desc="North African Arab polymath, an astronomer, economist,historian, Islamic scholar, Islamic theologian, hafiz, jurist, lawyer, mathematician, military strategist, nutritionist, philosopher, social scientistand statesman.      " itemDesc="Ibn Khaldun" iconUrl="images/icon/hero/15.png" price="0"/>
  <itemEum id="hero.taskitem.150" name="Cardinal Richelieu" itemType="任务" dayLimit="0" userLimit="0" desc="Cardinal Richelieu first was Secretary of State for France in 1616. In 1622 he became a cardinal and chief minister for Louis XIII . He is considered to be the world's first prime minister in the modern sense of the position. " itemDesc="Cardinal Richelieu" iconUrl="images/icon/hero/150.png" price="0"/>
  <itemEum id="hero.taskitem.151" name="Casimir Pulaski" itemType="任务" dayLimit="0" userLimit="0" desc="Casimir Pulaski was Polish solider who became a general for the Americans in the Continental Army. He is known as the father of American Calvary. " itemDesc="Casimir Pulaski" iconUrl="images/icon/hero/151.png" price="0"/>
  <itemEum id="hero.taskitem.152" name="Castiglione Baldassare" itemType="任务" dayLimit="0" userLimit="0" desc="An Italian humanist from a noble family, Baldassare served as a courtier and diplomat as well as publishing several political oriented works of literature. " itemDesc="Castiglione Baldassare" iconUrl="images/icon/hero/152.png" price="0"/>
  <itemEum id="hero.taskitem.153" name="Catherine de Medici" itemType="任务" dayLimit="0" userLimit="0" desc="Catherine, whose sickly fifteen-year-old son inherited the French crown, manipulated him in order to gain her own political power.  She is ruthless and calculating but can lead successfully. " itemDesc="Catherine de Medici" iconUrl="images/icon/hero/153.png" price="0"/>
  <itemEum id="hero.taskitem.154" name="Catherine Howard" itemType="任务" dayLimit="0" userLimit="0" desc="As Henry VIII's 5th wife Howard was Queen Consort from 28 July 1540 until 23 November 1541.  She had relations with two men who were both hanged at Tyburn and she would suffer a similar fate soon afterward. " itemDesc="Catherine Howard" iconUrl="images/icon/hero/154.png" price="0"/>
  <itemEum id="hero.taskitem.155" name="Catherine II" itemType="任务" dayLimit="0" userLimit="0" desc="Catherine II also known as Catherine the Great was empress of Russia from 1762 until 1796. During her reign the Russian Empire expanded and continued to modernize. Her rule enabled Russia to be recognized as one of the great powers. " itemDesc="Catherine II" iconUrl="images/icon/hero/155.png" price="0"/>
  <itemEum id="hero.taskitem.156" name="Catherine of Aragon" itemType="任务" dayLimit="0" userLimit="0" desc="Spanish Princess Catherine of Aragon married Arthur, heir to the English throne in 1501. After Arthur's death, she wed his younger brother Henry VIII and gave birth to their daughter, the future Queen Mary I. No sons survived more than 2 months. The need for a strong alliance with Spain diminished as Henry began a secret affair with Anne Boleyn. Henry hotly contended with the Pope to have his marriage to Catherine annulled. When the Pope refused, Archbishop of Canterbury Thomas Cranmer invalidated the marriage in 1533, allowing Henry to marry Anne and splitting the Anglican Church from Catholic Rome. " itemDesc="Catherine of Aragon" iconUrl="images/icon/hero/156.png" price="0"/>
  <itemEum id="hero.taskitem.157" name="Catherine of Siena" itemType="任务" dayLimit="0" userLimit="0" desc="Catherine was a pious and generous woman who championed the cause of peace among the Italian city-states and dedicated much of her life to helping the ill and destitute.  She would write hundreds of letters encouraging men and women of influence in order to advocate reform of the clergy, an end to the Babylonian Captivity in Avignon and the undertaking of a new Crusade.  300 of these letters have been preserved and are considered one of the great works of early Tuscan literature. " itemDesc="Catherine of Siena" iconUrl="images/icon/hero/157.png" price="0"/>
  <itemEum id="hero.taskitem.158" name="Cesare Borgia" itemType="任务" dayLimit="0" userLimit="0" desc="Son of Pope Alexander VI, Borgia was placed into a position of power at an early age.  He commanded armies in the Italian Wars and is an accomplished general. " itemDesc="Cesare Borgia" iconUrl="images/icon/hero/158.png" price="0"/>
  <itemEum id="hero.taskitem.159" name="Changamire" itemType="任务" dayLimit="0" userLimit="0" desc="Changamire ruled East Africa in the area of present-day Zimbabwe. He succeeded his father after slaying the rightful heir to the Mwene Mutapa clan. He then warred against the Rozvi Empire that held all of Zimbabwe and Mozambique and acquired the gold-rich central and southern provinces except for the coastal ports. Changamire's heirs ruled the Rozvi Kingdom until forced to recognize Portuguese invaders as overlords in 1629. " itemDesc="Changamire" iconUrl="images/icon/hero/159.png" price="0"/>
  <itemEum id="hero.taskitem.16" name="Jan Zizka" itemType="任务" dayLimit="0" userLimit="0" desc="Czech general andHussite leader." itemDesc="Jan Zizka" iconUrl="images/icon/hero/16.png" price="0"/>
  <itemEum id="hero.taskitem.160" name="Charlemagne" itemType="任务" dayLimit="0" userLimit="0" desc="Charlemagne, or Charles the Great, is a figure larger than life. At seven feet tall, he was as large as… He was a devout Christian king and mighty conqueror, whose rule helped define the shape and character of medieval Europe. He subjugated the Saxons and other tribes in Germany, making conquests in Spain and Italy, as well as ruling over France in his quest for the title of Emperor of the West. In Rome, Pope Leo III crowned him with the imperial crown worn by the old emperors of the Roman Empire. Charlemagne is credited with implementing important governmental, fiscal, ecclesiastical and cultural reforms.  " itemDesc="Charlemagne" iconUrl="images/icon/hero/160.png" price="0"/>
  <itemEum id="hero.taskitem.161" name="Charles Cornwallis" itemType="任务" dayLimit="0" userLimit="0" desc="Charles Cornwallis was a British Army officer and colonial administrator. He was one the leading generals in the American Revolution. He is famously known for his surrender to the combined American and French forces at Yorktown. He later served the crown in India and Ireland. " itemDesc="Charles Cornwallis" iconUrl="images/icon/hero/161.png" price="0"/>
  <itemEum id="hero.taskitem.162" name="Charles III" itemType="任务" dayLimit="0" userLimit="0" desc="Charles III was King of Spain from 1759 to 1788. It was with him that Spain started to become a nation, instead of a collection of small kingdoms. His reign saw the creation of the National Anthem, flag and the growth of Madrid as the capital. His best legacies was in improving the services and facilities of the people. " itemDesc="Charles III" iconUrl="images/icon/hero/162.png" price="0"/>
  <itemEum id="hero.taskitem.163" name="Charles IX of France" itemType="任务" dayLimit="0" userLimit="0" desc="Son of Henry II of France and Catherine de' Medici, Charles IX inherited the throne at the age of nine after the death of his sickly brother Frances II.  Most of his political decisions are directly influenced by his strong-willed mother. " itemDesc="Charles IX of France" iconUrl="images/icon/hero/163.png" price="0"/>
  <itemEum id="hero.taskitem.164" name="Charles Martel" itemType="任务" dayLimit="0" userLimit="0" desc="Skilled in both politics and war, Martel has developed an impressive resume.  With only one loss and dozens of wins on the battlefield, Martel's leadership is highly valued. " itemDesc="Charles Martel" iconUrl="images/icon/hero/164.png" price="0"/>
  <itemEum id="hero.taskitem.165" name="Charles of Provence" itemType="任务" dayLimit="0" userLimit="0" desc="After the death of his father Holy Roman Emperor Lothair I, Charles became the ruler of Upper and Lower Burgandy.  Because he was so young when his father died, most of the decisions fell to his regent and eventually his Uncle whom attempted but failed to usurp the  position. " itemDesc="Charles of Provence" iconUrl="images/icon/hero/165.png" price="0"/>
  <itemEum id="hero.taskitem.166" name="Charles the Bald" itemType="任务" dayLimit="0" userLimit="0" desc="Youngest son of Louis the Pious, Charles had difficulty defending the lands given to him by his aging father from his much older brothers.  Eventually and with a little luck and tenacity, he was able to retain power and became the King of West Fracia.  Years later he was crowned Holy Roman Emperor. " itemDesc="Charles the Bald" iconUrl="images/icon/hero/166.png" price="0"/>
  <itemEum id="hero.taskitem.167" name="Charles V" itemType="任务" dayLimit="0" userLimit="0" desc="Holy Roman Emperor Charles V was also King Charles I of Spain. Hampered by having to practice politics on multiple fronts, his accomplishments were still sizeable. He established strong government in Spain that caused papal resistance to his rule in Italy. His war against France wasn't an outright victory but weakened the French threat substantially. Charles strengthened his rule in the Netherlands despite distance and religious conflict. He also fought the Ottoman Empire and kept the Ottomans from making inroads into Christian Europe. His policies failed only in Germany where Charles couldn't stop Protestantism or dominate the many independent states.  " itemDesc="Charles V" iconUrl="images/icon/hero/167.png" price="0"/>
  <itemEum id="hero.taskitem.168" name="Charles VII of France" itemType="任务" dayLimit="0" userLimit="0" desc="Known as 'the Victorious', Charles VII became King of France in 1422, but was not crowned until Joan of Arc did so at the Cathedral in Reims in 1429.  In the following two decades, his armies pushed the English armies back to the port town of Calais.  He spent the rest of his reign attempting to curb the power of the nobles and fighting with his eldest son, who would become Louis XI. " itemDesc="Charles VII of France" iconUrl="images/icon/hero/168.png" price="0"/>
  <itemEum id="hero.taskitem.17" name="Joan of Arc" itemType="任务" dayLimit="0" userLimit="0" desc="National heroine of France and a Catholic saint. she led the French army to several important victories during the Hundred Years War.      " itemDesc="Joan of Arc" iconUrl="images/icon/hero/17.png" price="0"/>
  <itemEum id="hero.taskitem.170" name="Christopher Columbus" itemType="任务" dayLimit="0" userLimit="0" desc="Christopher Columbus led a voyage across the Atlantic Ocean in 1492 that made the existence of land in the Western hemisphere common knowledge in Europe.  Committed to his belief that Asia could be reached by sailing west, he persistently sought funds from investors until he received backing from Spain.  After five weeks at sea, his trip to Asia was cut short when he encountered the islands of the Caribbean Sea.  In the following years, Columbus would make three more voyages to the Americas, and would serve as a governor in some of the first Spanish settlements in the Western Hemisphere. " itemDesc="Christopher Columbus" iconUrl="images/icon/hero/170.png" price="0"/>
  <itemEum id="hero.taskitem.171" name="Christopher I of Denmark" itemType="任务" dayLimit="0" userLimit="0" desc="Christopher I was King of Denmark between 1252 and 1259. He was selected King after the untimely death of his older brother Abel in the summer of 1252. Christopher spent most of his rule fighting off his many opponents. The King died 'unexpectedly' after taking Holy Communion. According to newly discovered sources King Christopher died after drinking poisoned communion wine given to him by Abbot Arnfast of Ryd Abbey in revenge for the king's oppression of the church.  " itemDesc="Christopher I of Denmark" iconUrl="images/icon/hero/171.png" price="0"/>
  <itemEum id="hero.taskitem.172" name="Cicero" itemType="任务" dayLimit="0" userLimit="0" desc="Roman philosopher, statesman, lawyer, political theorist, and Roman constitutionalist. Cicero is widely considered one of Rome's greatest orators and prose stylists. " itemDesc="Cicero" iconUrl="images/icon/hero/172.png" price="0"/>
  <itemEum id="hero.taskitem.173" name="Claudius" itemType="任务" dayLimit="0" userLimit="0" desc="Tiberius Claudius Caesar Augustus Germanicus (10BCE-54CE) known as Claudius, was the fourth Roman Emperor.  The first Roman Emperor to be born outside of Italia, he was afflicted with some unknown disability which kept him out of the public view.  This illness most likely saved his life, for when he was being shielded from the eyes of power, many less fortunate nobles were murdered by their enemies.  Claudius was not seen as a threat, and his survival led to him being the last man standing in the long line of men to be the next Emperor.   " itemDesc="Claudius" iconUrl="images/icon/hero/173.png" price="0"/>
  <itemEum id="hero.taskitem.174" name="Constantine XI" itemType="任务" dayLimit="0" userLimit="0" desc="The last of the Roman Emperors, Constantine XI took the throne in 1449, amidst domestic and foreign turmoil.  He had faced a challenge from his brother for the throne, and after prevailing, set about strengthening the defenses of the cities of Mistra and Constantinople.  When Ottoman forces massed outside Constantinople, Constantine organized the last defenses himself, and asked for help from the West.  He met his end while leading an ill-fated charge to attempt to retake Constantinople after it had fallen to the Ottomans. " itemDesc="Constantine XI" iconUrl="images/icon/hero/174.png" price="0"/>
  <itemEum id="hero.taskitem.175" name="Cosimo de' Medici" itemType="任务" dayLimit="0" userLimit="0" desc="The patriarch and founder of the powerful Italian Medici family, Cosimo uses his vast wealth to influence politics. " itemDesc="Cosimo de' Medici" iconUrl="images/icon/hero/175.png" price="0"/>
  <itemEum id="hero.taskitem.176" name="Cristopher Columbus" itemType="任务" dayLimit="0" userLimit="0" desc="Columbus used his political savvy and charisma to successfully lobby Italian investors and the Spanish monarchs to fund a voyage to find a western route to the far east. " itemDesc="Cristopher Columbus" iconUrl="images/icon/hero/176.png" price="0"/>
  <itemEum id="hero.taskitem.177" name="Cyrus II" itemType="任务" dayLimit="0" userLimit="0" desc="Cyrus, II was the first Zoroastrian Persian Emperor.  He ruled from 576-530 B.C. and was also known as Cyrus the Great or Cyrus the Elder.  Cyrus, II founded the Persian Empire under the Achaemenid dynasty and under his 30 year reign, it expanded vastly, conquering most of Southwest Asia and much of Central Asia.  From Egypt and the Hellespont in the west to the Indus River in the east, Cyrus, II created the largest empire the world had yet seen.  He met his fate in a fierce battle with the Massagetae, a tribe from the deserts of Kharesm and Kizilhoum in the southernmost steppe regions of modern-day Kazakhstan and Uzbekistan. " itemDesc="Cyrus II" iconUrl="images/icon/hero/177.png" price="0"/>
  <itemEum id="hero.taskitem.178" name="David Beaton" itemType="任务" dayLimit="0" userLimit="0" desc="Also known as David Bethune, Beaton was a Scottish Catholic leader opposing the Protestants at the royal courts of James V and Mary, Queen of Scots. He was created Cardinal in 1538 and Archbishop of St. Andrews a year later. As Chancellor, he used political power for religious ends to persecute and execute Protestants. Protestant nobles assassinated him. " itemDesc="David Beaton" iconUrl="images/icon/hero/178.png" price="0"/>
  <itemEum id="hero.taskitem.179" name="David I" itemType="任务" dayLimit="0" userLimit="0" desc="David I inherited the throne of Scotland from his brother Alexander I. He was educated at the English courts of William II and Henry I and, through marriage, became Earl of Huntingdon which gave him a voice in English politics. He brought Norman-style feudalism to Scotland and patronized the Church by building monasteries. Both actions stirred Scottish rebellion. His claim to northern counties in England brought war, but Henry II granted the claims after David's death in 1153. " itemDesc="David I" iconUrl="images/icon/hero/179.png" price="0"/>
  <itemEum id="hero.taskitem.18" name="Johannes Faustes" itemType="任务" dayLimit="0" userLimit="0" desc="Hermit wizard and alchemist. " itemDesc="Johannes Faustes" iconUrl="images/icon/hero/18.png" price="0"/>
  <itemEum id="hero.taskitem.180" name="Demetrius of Pharos" itemType="任务" dayLimit="0" userLimit="0" desc="Demetrius of Pharos was a Greek from the island of Pharos and was best known for his betrayal of Corcyra to Rome, in 229 B.C., during the First Illyrian War.  Afterwards he ruled a portion of the Illyrian Adriatic coast. He was expelled from Illyria by Rome after the Second Illyrian War and became a trusted councilor at the court of Philip V of Macedon, where he remained until his death at Messene in 214 B.C.. " itemDesc="Demetrius of Pharos" iconUrl="images/icon/hero/180.png" price="0"/>
  <itemEum id="hero.taskitem.181" name="Desiderius Erasmus" itemType="任务" dayLimit="0" userLimit="0" desc="The Dutch scholar Erasmus was the first European whose influence reached all of society through the printed word. An Augustinian, he left monastic life to travel. In 1516, he published his own editions of the New Testament in Greek and in Latin, followed by translations of early Christian authors, the Bible, literary classics, and his own works. Erasmus wanted peaceful reform of the Church and was disillusioned with the religious conflict during the Protestant Reformation. He died in seclusion in 1536. All his works were condemned by the Inquisition in 1559. " itemDesc="Desiderius Erasmus" iconUrl="images/icon/hero/181.png" price="0"/>
  <itemEum id="hero.taskitem.182" name="Dhuoda" itemType="任务" dayLimit="0" userLimit="0" desc="Dhuoda was a relatively obscure figure in the 9th Century.  She must have been the recipient of formal education for she is best known for her book, the Liber Manualis, a manual written for her son William.  The book is full of practical advice and is a remarkable document as it sheds light on the standards of education available to women at the time and whole host of 9th Century Frankish social mores. " itemDesc="Dhuoda" iconUrl="images/icon/hero/182.png" price="0"/>
  <itemEum id="hero.taskitem.183" name="Diane de Poitiers" itemType="任务" dayLimit="0" userLimit="0" desc="Diane de Poitiers came to the French court of Francis I. A Renaissance 'cougar', she and Prince Henry, who was 20 years younger, fell in love. When Henry became king in 1547, Diane was queen in all but name. As Duchesse de Valentinois, she patronized the arts and brought culture and beauty to the court. Amassing a fortune for herself and her family, Diane was banished from court when Henry II died in 1559 by Henry's wife, Catherine de Medici. " itemDesc="Diane de Poitiers" iconUrl="images/icon/hero/183.png" price="0"/>
  <itemEum id="hero.taskitem.184" name="Dicaearchus" itemType="任务" dayLimit="0" userLimit="0" desc="Dicaearchus (c. 350 – c. 285 B.C.) was a Greek Peripatetic philosopher of Messina in Sicily, a pupil of Aristotle and a scholar of wide learning who influenced such people as Cicero and Plutarch. He cultivated special branches of knowledge, including the history of literature and music, biography, political science, and geography. He wrote on the history and geography of Greece in his most important work 'Life of Greece,”  and is known for his important contributions to the field of cartography, being among the first to use geographical coordinates. " itemDesc="Dicaearchus" iconUrl="images/icon/hero/184.png" price="0"/>
  <itemEum id="hero.taskitem.185" name="Diogenes" itemType="任务" dayLimit="0" userLimit="0" desc="Diogenes the Cynic (c. 412-323 B.C.) of Sinope was an ascetic Greek philosopher who lived abstemiously, most likely begging and stealing for his livelihood, and thought there was no such thing as an honest man. He was called Kynos (Greek for dog) for his lifestyle and contrary nature.  It is from this word for dog that we derive the word cynic.  He was a student of the philosopher Antisthenes, himself a student of Socrates.  The principles of their philosophy of Cynicism included self-sufficiency, living by personal example, exposing the falsehood of conventional thinking, exposing vice and deceit, and living according to nature.   " itemDesc="Diogenes" iconUrl="images/icon/hero/185.png" price="0"/>
  <itemEum id="hero.taskitem.186" name="Don Quixote" itemType="任务" dayLimit="0" userLimit="0" desc="The fictional creation of Miguel de Cervantes Don Quixote is an enduring hero in literature.  The character Alonso Quixano dubs himself 'Don Quixote de la Mancha' and he embarks on a number of delusional chivalric quests in the Spanish countryside of the 16th century.  While Don Quixote is a whimsical and farcical tale filled with very likeable characters, Quixote, with his sidekick Sancho Panza, may not be the best choice to lead your military expeditions. " itemDesc="Don Quixote" iconUrl="images/icon/hero/186.png" price="0"/>
  <itemEum id="hero.taskitem.188" name="Duncan I" itemType="任务" dayLimit="0" userLimit="0" desc="Duncan I inherited the kingdom of Scotland from his grandfather, Malcolm II. The northern clans despised him. The Earl of Orkney defeated him in battle twice before the Earl of Moray--Macbeth--killed him in battle in 1040. " itemDesc="Duncan I" iconUrl="images/icon/hero/188.png" price="0"/>
  <itemEum id="hero.taskitem.189" name="Duncan II" itemType="任务" dayLimit="0" userLimit="0" desc="Duncan defeated his uncle Donalbane to claim the throne of Scotland in 1094. The army he used was provided by William II of England causing strong dislike amongst the Scots. Donalbane got revenge by plotting the murder of Duncan the same year he became king. " itemDesc="Duncan II" iconUrl="images/icon/hero/189.png" price="0"/>
  <itemEum id="hero.taskitem.19" name="john gutenberg" itemType="任务" dayLimit="0" userLimit="0" desc="German goldsmith and printer who is credited with being the first European to use movable type printing." itemDesc="john gutenberg" iconUrl="images/icon/hero/19.png" price="0"/>
  <itemEum id="hero.taskitem.190" name="Eadred I" itemType="任务" dayLimit="0" userLimit="0" desc="Eadred of England succeeded Edmund I to become King of England in 946.  When Eric 'Bloodaxe' of Norway established himself as King in Northumbria Eadred sent a large force to contest the claim and to launch destructive raids on Northumbria in order to send a message to the population, which had generally supported Eric's rule in the region.  This campaign would prove successful but Eadred's reputation would suffer as a result of his brutal handling of the affair. " itemDesc="Eadred I" iconUrl="images/icon/hero/190.png" price="0"/>
  <itemEum id="hero.taskitem.191" name="Earl of Shrewsbury" itemType="任务" dayLimit="0" userLimit="0" desc="Roger de Montgomerie, one of William the Conqueror's principal counselors, was granted the title of Earl of Shrewsbury in 1071 and was charged with the rule of Shropshire, a region to the West of modern day Birmingham making him one of the most powerful magnates in all of England at the time.  His mandate was to prevent Welsh incursions into English lands. " itemDesc="Earl of Shrewsbury" iconUrl="images/icon/hero/191.png" price="0"/>
  <itemEum id="hero.taskitem.192" name="Edgar the Etheling" itemType="任务" dayLimit="0" userLimit="0" desc="Grandson of Anglo-Saxon King Edmund II, Edgar was heir to the throne of Edward the Confessor, but, in 1066, the Witan (council) chose Harold Godwin instead. Harold was killed in the Battle of Hastings against the Norman William the Conqueror. The Witan elected Edgar king of the Anglo-Saxons, but Edgar, unable to mount effective resistance against William, submitted to him and finally joined his court in 1074. Edgar commanded forces in the First Crusade and died in Scotland in 1126. " itemDesc="Edgar the Etheling" iconUrl="images/icon/hero/192.png" price="0"/>
  <itemEum id="hero.taskitem.193" name="Edith of England" itemType="任务" dayLimit="0" userLimit="0" desc="Edith was the wife of Otto I, Holy Roman Emperor, and sister of King Aethelstan of England.  Aethelstan sent his two sisters to Otto instructing him to choose whichever of the the pleased him.  Little is known of Edith's sister but Edith, as a devotee to the cult of St. Oswald, was instrumental in bringing the cult into Germany. " itemDesc="Edith of England" iconUrl="images/icon/hero/193.png" price="0"/>
  <itemEum id="hero.taskitem.194" name="Edmund I" itemType="任务" dayLimit="0" userLimit="0" desc="Edmund I succeeded his half-brother Aethelstan as King of England in 939 and ruled until his death in 946.  During his relatively brief reign he oversaw a number of important developments including the revival of English monasteries and the establishment of peaceful coexistence with Scotland. " itemDesc="Edmund I" iconUrl="images/icon/hero/194.png" price="0"/>
  <itemEum id="hero.taskitem.195" name="Edmund II" itemType="任务" dayLimit="0" userLimit="0" desc="Styled 'Ironside', Edmund was the son of Ethelred II who lost his throne to Sweyn I (Forkbeard) of Denmark. Reasserting his right to succession after Sweyn's death in 1014, Edmund was challenged by Sweyn's son Canute. The two fought six major battles in 1016 and struck a bargain in which Edmund would rule southern England and Canute the rest with the survivor to become overall ruler. Edmund II was King of Wessex for one month before he died.  " itemDesc="Edmund II" iconUrl="images/icon/hero/195.png" price="0"/>
  <itemEum id="hero.taskitem.196" name="Edward IV of England" itemType="任务" dayLimit="0" userLimit="0" desc="In 1461, at the age of 19, Edward of York won a series of battles against Lancastrian forces, almost wiping out their army, and was crowned King of England.  Subsequently overthrown in 1470, he fled to Burgundy, only to return 1 year later and eliminate all Lancastrian opposition.  His rule would last 12 more years, and he did not face another rebellion.  The focus of his rule was the re-establishment of order, which had fallen in the last days of Henry VI.  In 1483, he fell fatally ill, and died in April, making him one of the few major House of York figures to die of natural causes. " itemDesc="Edward IV of England" iconUrl="images/icon/hero/196.png" price="0"/>
  <itemEum id="hero.taskitem.197" name="Edward Jenner" itemType="任务" dayLimit="0" userLimit="0" desc="Edward Jenner was an English scientist who discovered the Smallpox vaccine. He is  rate called 'The Father of Immunology.' Considering the mortality of Smallpox prior to the advent of the vaccine the number of lives saved by Jenner's work is virtually incalculable. " itemDesc="Edward Jenner" iconUrl="images/icon/hero/197.png" price="0"/>
  <itemEum id="hero.taskitem.198" name="Edward VI" itemType="任务" dayLimit="0" userLimit="0" desc="Son of Henry VIII and Jane Seymour, Edward became king when he was 10 years old in 1547. His uncle Edward Seymour and John Dudley were the powers behind the throne. Know to be studious, Edward endorsed the Protestant religion and Archbishop Cranmer's teachings. He died of tuberculosis at age 16. " itemDesc="Edward VI" iconUrl="images/icon/hero/198.png" price="0"/>
  <itemEum id="hero.taskitem.199" name="El Cid" itemType="任务" dayLimit="0" userLimit="0" desc="Rodrigo Díaz de Vivar was a Castilian nobleman better known as El Cid Campeador (Arabic and Spanish meaning 'the lord of military arts'). Educated at the Castilian court, he first served Ferdinand I then Sancho II, going to battle on his famed warhorse Babieca. After the murder of Sancho II possibly by his brother Alfonso and sister Urraca, Alfonso became King of León and Castile and de Vivar led his troops. A foray in Granada angered Alfonso II, however, and led to de Vivar's exile. He became a mercenary for the Moors, but El Cid captured Valencia as his own principality in 1094 and died there in 1099. Many legends without basis in fact surround El Cid. " itemDesc="El Cid" iconUrl="images/icon/hero/199.png" price="0"/>
  <itemEum id="hero.taskitem.20" name="John Wycliffe" itemType="任务" dayLimit="0" userLimit="0" desc="English theologian, lay preacher, translator and reformist. He completed his translation directly from the Vulgate into vernacular English. " itemDesc="John Wycliffe" iconUrl="images/icon/hero/20.png" price="0"/>
  <itemEum id="hero.taskitem.200" name="Eleanor of Aquitaine" itemType="任务" dayLimit="0" userLimit="0" desc="Eleanor became Queen of the English through marriage her second marriage with Henry II in 1154.  She bore five sons and three daughters and outlived all but two of them.  She had also participated in the ill-fated Second Crusade with her first husband Louis VII.  Her husband was succeeded by her son Richard the Lionheart, a legendary military leader and warrior. " itemDesc="Eleanor of Aquitaine" iconUrl="images/icon/hero/200.png" price="0"/>
  <itemEum id="hero.taskitem.201" name="Elizabeth I" itemType="任务" dayLimit="0" userLimit="0" desc="The daughter of Henry VIII and Anne Boleyn, Elizabeth I served both as the Queen of England and the Queen of Ireland.  Although most consider her weak in military matters, Elizabeth rigorously supported art and literature which led to a golden age in English history. " itemDesc="Elizabeth I" iconUrl="images/icon/hero/201.png" price="0"/>
  <itemEum id="hero.taskitem.202" name="Emma Queen of Franks" itemType="任务" dayLimit="0" userLimit="0" desc="Emma was Queen Consort of Eastern Francia during the 9th Century.  It is said that she had an uncommon courage and demonstrated her military abilities on more than one occasion.  When Adelchis of Benevento rebelled against Emma's husband, Louis the German, she led a force to quell his uprising.  Frightened by the presence of the Queen Adelchis fled from the battle in a testament to the reputation that Emma had earned. " itemDesc="Emma Queen of Franks" iconUrl="images/icon/hero/202.png" price="0"/>
  <itemEum id="hero.taskitem.203" name="Emperor Taizu" itemType="任务" dayLimit="0" userLimit="0" desc="Emperor Taizu was founder of the Song Dynasty of China. He helped reunite most of China after the fall of the Tang dynasty in 907. He personally lead his armies to defeat the northern Han to regain those lands. " itemDesc="Emperor Taizu" iconUrl="images/icon/hero/203.png" price="0"/>
  <itemEum id="hero.taskitem.204" name="Empress Matilda" itemType="任务" dayLimit="0" userLimit="0" desc="Matilda gained the title 'Empress' as a result of her marriage to Henry V, Holy Roman Emperor.  As a result of the death of her second husband, she acquired the throne for a short period of time and spent several years fighting for power. " itemDesc="Empress Matilda" iconUrl="images/icon/hero/204.png" price="0"/>
  <itemEum id="hero.taskitem.206" name="Erastosthenes" itemType="任务" dayLimit="0" userLimit="0" desc="Eratosthenes (276  - 194 B.C.) was a Greek mathemetician born in Cyrene which is now in Libya, North Africa. His teachers included the scholar Lysanias of Cyrene and the philosopher Ariston of Chios who had studied under Zeno, the founder of the Stoic school of philosophy.  Eratosthenes also studied under the poet and scholar Callimachus  then spent some years studying in Athens.  He is best known for his work on prime numbers and for measuring the diameter of the earth but made many other major contributions to the progress of science. " itemDesc="Erastosthenes" iconUrl="images/icon/hero/206.png" price="0"/>
  <itemEum id="hero.taskitem.207" name="Eric IV of Denmark" itemType="任务" dayLimit="0" userLimit="0" desc="Eric IV was king of Denmark from 1241 until his death. His rule is known for bitter conflicts and civil wars against his brothers. At the same time Erik faced trouble from the religious orders who insisted that they were immune from taxes that Erik wanted to assess. Erik wanted the church lands taxed as any other landholder would be. He fought constant wars in an attempt to impose more and more taxes on more and more people.  " itemDesc="Eric IV of Denmark" iconUrl="images/icon/hero/207.png" price="0"/>
  <itemEum id="hero.taskitem.208" name="Eric V of Denmark" itemType="任务" dayLimit="0" userLimit="0" desc="Eric V was King of Denmark between 1259 and 1286. The king’s nickname of  ”Klipping” or ”Glipping” refers to a medieval coin that has become ”clipped” (a 'clipped penny') or cut in order to indicate devaluation. The nickname is a reference to his known lack of trustworthiness. He 'short-changed' his people and the monarchy. Eric had a terrible reputation. He never kept a promise. And on top of that he was a 'seducer', paying no attention to the age or status of the women he pursued. His lack of self-control eventually cost him his life by assassination. " itemDesc="Eric V of Denmark" iconUrl="images/icon/hero/208.png" price="0"/>
  <itemEum id="hero.taskitem.209" name="Eric VI of Denmark" itemType="任务" dayLimit="0" userLimit="0" desc="Eric VI of Denmark was King of Denmark from 1286 to 1319. He became king in 1286 at age 12, because his unfaithful father was murdered by unknown assailants. Since Eric VI was only 12 years old, his mother ruled for him until 1294. Eric's rule was in the middle of the period during the “Age of Decay' in Denmark (1241–1340). His policies began the dissolution of the Danish empire in the Baltic and northern Europe that followed during the next generation. When Erik died in 1319, having survived all his 15 children, Denmark was bankrupt. " itemDesc="Eric VI of Denmark" iconUrl="images/icon/hero/209.png" price="0"/>
  <itemEum id="hero.taskitem.21" name="Machiavelli" itemType="任务" dayLimit="0" userLimit="0" desc="Italian philosopher, writer, and politician and is considered one of the main founders of modern political science. " itemDesc="Machiavelli" iconUrl="images/icon/hero/21.png" price="0"/>
  <itemEum id="hero.taskitem.210" name="Ethan Allen" itemType="任务" dayLimit="0" userLimit="0" desc="Ethan Allen was a American Revolutionary patriot hero and politician. Allen was guerilla leader of the Green Mountain Boys. He is most widely known for the capture of Fort Ticonderoga. Later he was a leader in the formation of the State of Vermont. " itemDesc="Ethan Allen" iconUrl="images/icon/hero/210.png" price="0"/>
  <itemEum id="hero.taskitem.211" name="Ethelbald" itemType="任务" dayLimit="0" userLimit="0" desc="As the second oldest son of Ethelwulf, Ethelbald would be crowned King of Wessex following his father's death in 856.  He was unpopular with the Church for marrying Judith, his father's 16 year old widow as the Church deemed it incestuous.  He was also unpopular with Judith's father, Charles the Bald, who was enraged by this and moved quickly to intervene and have Judith placed in a nunnery.  Ethelbald would, however, become popular with his subjects who greatly mourned his death in 860 after ruling for only 4 years. " itemDesc="Ethelbald" iconUrl="images/icon/hero/211.png" price="0"/>
  <itemEum id="hero.taskitem.212" name="Ethelwulf" itemType="任务" dayLimit="0" userLimit="0" desc="In 825 Ethelwulf conquered Kent in the name of his father, Egbert of Wessex and would eventually succeed his father to become King of Wessex in 839.  Much of his reign was devoted to fending off Danish incursions and at the Battle of Acleah in 851 he defeated a large force of Danish raiders in a victory, which chroniclers dubbed as 'the greatest slaughter of heathen host ever made.' In 856 he skilfully managed to avoid a civil war with his eldest son Ethelbald and would die later that year. " itemDesc="Ethelwulf" iconUrl="images/icon/hero/212.png" price="0"/>
  <itemEum id="hero.taskitem.213" name="Euripedes" itemType="任务" dayLimit="0" userLimit="0" desc="Euripides the youngest of the three great Greek tragedians, was born at Salamis about 480 B.C..  After suffering endless defeats by the judges of Dionysia who consistently favored others, Euripides left Athens in 408 B.C. for the court of King Archelaus of Macedon.  It was there that he wrote, among other works, The Bacchae, at the height of his genius. The Bacchae is a terrifying, powerful, and extremely complex work.   Few plays, from any time or place, can hope to match The Bacchae in its capacity to instill terror and awe into its audience.  It is arguably Euripides' masterpiece, but he never lived to see it performed in Athens.  He died in 406 B.C., bitter and unsure of his place in history. Shortly afterward, his son brought Euripides' last three plays, including The Bacchae, back to Athens for production. There, at the same festival where Euripides had lost to now-forgotten playwrights so many times, The Bacchae and its companion pieces won first prize and today is considered one of the greatest plays ever written. " itemDesc="Euripedes" iconUrl="images/icon/hero/213.png" price="0"/>
  <itemEum id="hero.taskitem.214" name="Ferdinand II" itemType="任务" dayLimit="0" userLimit="0" desc="Ferdinand II of the House of Habsburg was Holy Roman Emperor from 1619 to 1637. His religious intolerance toward Protestants led to a series of rebellions, which escalated into the Thirty Years War in Europe. " itemDesc="Ferdinand II " iconUrl="images/icon/hero/214.png" price="0"/>
  <itemEum id="hero.taskitem.215" name="Ferdinand II of Aragon" itemType="任务" dayLimit="0" userLimit="0" desc="Ferdinand II of Aragon, along with his wife, Isabella of Castille, united Spain as a single political unit for the first time since the 8th Century.  Under their rule, the reconquista of the Iberian peninsula was completed, and Spain's navy became the most powerful in Europe.  With the centralization of government and expansion into the newly discovered Americas, Ferdinand's reign started the Golden Age of Spain. " itemDesc="Ferdinand II of Aragon" iconUrl="images/icon/hero/215.png" price="0"/>
  <itemEum id="hero.taskitem.216" name="Ferdinand Magellan" itemType="任务" dayLimit="0" userLimit="0" desc="One of the great early explorers, Magellan was the first person to lead an expedition across the Pacific Ocean.  Throughout his career he used his influence and political clout to find financing for his voyages. " itemDesc="Ferdinand Magellan" iconUrl="images/icon/hero/216.png" price="0"/>
  <itemEum id="hero.taskitem.217" name="Fernando Alvarez de Toledo, Duke of Alba" itemType="任务" dayLimit="0" userLimit="0" desc="A prominent general in the army of Emperor Charles V of Spain, the Duke of Alba was a master of logistics and strict disciplinarian. Following his defeat of the German Protestants in 1547, he was named governor-general of the Netherlands. His 'Council of Blood' resulted in mass-executions and banishments and sparked Dutch Revolts. Recalled to Spain, the Duke of Alba commanded the army that conquered Portugal in 1580.  " itemDesc="Fernando Alvarez de Toledo, Duke of Alba" iconUrl="images/icon/hero/217.png" price="0"/>
  <itemEum id="hero.taskitem.218" name="Ferrarius" itemType="任务" dayLimit="0" userLimit="0" desc="Faraj ben Sālim, also known as Ferrarius, was a Sicilian-Jewish doctor and translator who lived and worked in the thirteenth century. His primary claim to fame is the translation of major Arabic medical works into Latin, including a 1279 translation of al-Razi's famous medical encyclopedia. Charles of Anjou was so grateful for his work that he ordered that the portrait of Faraj should be drawn beside his own." itemDesc="Ferrarius" iconUrl="images/icon/hero/218.png" price="0"/>
  <itemEum id="hero.taskitem.219" name="Filippo Brunelleschi" itemType="任务" dayLimit="0" userLimit="0" desc="Among Brunelleshi's more important contributions to Western science were his invention of linear perspective in architecture and his works in engineering and architecture. " itemDesc="Filippo Brunelleschi" iconUrl="images/icon/hero/219.png" price="0"/>
  <itemEum id="hero.taskitem.22" name="Marco Polo" itemType="任务" dayLimit="0" userLimit="0" desc="Trader and explorer from the Venetian Republic who gained fame for his worldwide travels. He was one of the first Westerners to travel the Silk Road to China and visit Kublai Khan.        " itemDesc="Marco Polo" iconUrl="images/icon/hero/22.png" price="0"/>
  <itemEum id="hero.taskitem.221" name="Frances II of France" itemType="任务" dayLimit="0" userLimit="0" desc="Although he was sickly and weak, Frances II inherited the French throne at only fifteen-years-old.  Almost all of the political decisions made under his rule were directly influenced by the will of his mother and two uncles. " itemDesc="Frances II of France" iconUrl="images/icon/hero/221.png" price="0"/>
  <itemEum id="hero.taskitem.223" name="Francis Bacon" itemType="任务" dayLimit="0" userLimit="0" desc="A true master of many disciplines, bacon was successful as a politician, a philosopher and a scientist.  His greatest contribution to Western culture was the popularization of the scientific method. " itemDesc="Francis Bacon" iconUrl="images/icon/hero/223.png" price="0"/>
  <itemEum id="hero.taskitem.225" name="Francis Marion" itemType="任务" dayLimit="0" userLimit="0" desc="Francis Marion, nicknamed The Swamp Fox, was a Continental Army officer. He was a constant thorn to the British in South Carolina. He is considered a creator of modern guerrilla warfare. " itemDesc="Francis Marion" iconUrl="images/icon/hero/225.png" price="0"/>
  <itemEum id="hero.taskitem.227" name="Fredegund" itemType="任务" dayLimit="0" userLimit="0" desc="Fredegund had humble beginnings as a servant despite being of noble descent.  Some believe that she may have been the inspiration for the character of Cinderella but if that is the case the similarities go no further as Fredegund was notoriously cruel and murderous.  Contemporary chroniclers declared that very few could rival her monstrousness. " itemDesc="Fredegund" iconUrl="images/icon/hero/227.png" price="0"/>
  <itemEum id="hero.taskitem.228" name="Frederick Barbarossa" itemType="任务" dayLimit="0" userLimit="0" desc="Frederick possesses all of the attributes that makes a great and influential leader including ambition, charisma and skill on the battlefield.  These attributes led to his appointment as Holy roman Emperor under Pope Adrian IV. " itemDesc="Frederick Barbarossa" iconUrl="images/icon/hero/228.png" price="0"/>
  <itemEum id="hero.taskitem.229" name="Frederick I Barbarossa" itemType="任务" dayLimit="0" userLimit="0" desc="As a descendant of Germany's two leading families Frederick inherited the title of Duke of Swabia and was eventually crowned Holy Roman Emperor.  He would spend most of his reign establishing order among the German states but was regularly frustrated by the schemes of ambitious princes.  He is viewed as one of the most charismatic leaders of the age and has been compared favorably to Henry II of England due to his longevity, ambition, logistical skill and success on the battlefield. " itemDesc="Frederick I Barbarossa" iconUrl="images/icon/hero/229.png" price="0"/>
  <itemEum id="hero.taskitem.23" name="Martin Luther" itemType="任务" dayLimit="0" userLimit="0" desc="Ridical theologian, he changed the course of Western civilization by initiating the Protestant Reformation.         " itemDesc="Martin Luther" iconUrl="images/icon/hero/23.png" price="0"/>
  <itemEum id="hero.taskitem.230" name="Frederick II, Duke of Swabia" itemType="任务" dayLimit="0" userLimit="0" desc="Known as the 'One-Eyed', Frederick II was a capable and brave ruler as the Duke of Swabia in the early 12th Century.  He had a long-standing feud with Lothair III and was defeated in major engagements at Nuremburg and Ulm so he failed in his bid to become Holy Roman Emperor.  Nevertheless, Frederick is remembered for his unwavering bravery and honor in battle, never surrendering or fleeing until the engagement had been clearly lost. " itemDesc="Frederick II, Duke of Swabia" iconUrl="images/icon/hero/230.png" price="0"/>
  <itemEum id="hero.taskitem.231" name="Frederick III" itemType="任务" dayLimit="0" userLimit="0" desc="Holy Roman Emperor for the last half of the 1400s, Frederick III was the last Emperor to be crowned in Rome.  He was entirely unsuccessful on the battlefield, and therefore became a diplomat.  Under his leadership, the Habsburg family expanded their inherited lands, and began to rise to prominence in Europe.  During the last 10 years of his life, he ruled jointly with his son, Maximilian I. " itemDesc="Frederick III" iconUrl="images/icon/hero/231.png" price="0"/>
  <itemEum id="hero.taskitem.232" name="Fredrick II" itemType="任务" dayLimit="0" userLimit="0" desc="Fredrick II was king of Prussia from 1740-1786. After becoming king he attacked Austria and claimed Silesia. His military reputation was made during this, the Silesian Wars. Later he reconnected most of his realm with the first partition of Poland. He modernized Prussia, its civil service and championed religious tolerance. " itemDesc="Fredrick II" iconUrl="images/icon/hero/232.png" price="0"/>
  <itemEum id="hero.taskitem.233" name="Fulk III of Anjou" itemType="任务" dayLimit="0" userLimit="0" desc="Fulk III inherited vast swaths of land in humble Angers, France when he was just fifteen years old.  Seeking to expand his power and influence, he fought several battles and eventually established Angers as a dominant force in French politics. " itemDesc="Fulk III of Anjou" iconUrl="images/icon/hero/233.png" price="0"/>
  <itemEum id="hero.taskitem.234" name="Gaius Cilnius Maecenas" itemType="任务" dayLimit="0" userLimit="0" desc="Gaius Cilnius Maecenas (70CBE-8BCE) was a roman political adviser to roman emperor Octavian as well as an important supporter of young poets.  He served as an informal cultural adviser to Octavian.  He is well known for his ability to think clearly during times of stress, and his insight into political intrigue was of great value.  He supported the famous poet Virgil who wrote the Georgics.   " itemDesc="Gaius Cilnius Maecenas" iconUrl="images/icon/hero/234.png" price="0"/>
  <itemEum id="hero.taskitem.236" name="Gaius Duilus" itemType="任务" dayLimit="0" userLimit="0" desc="Gaius Duilius who lived in the 3rd century B.C. was a Roman politician and admiral involved in the First Punic War (264 - 241 B.C..)  He was elected consul at the outbreak of the first war against Carthage, was given command of the rear fleet and later served  as senior commander in the battle of Mylae.  Duilius captured several enemy vessels and was known as the first Roman successful in a naval engagement.  He was awarded with a triumphal parade featuring the prows of apprehended ships that later would adorn a column erected in his honor in the Roman Forum. " itemDesc="Gaius Duilus" iconUrl="images/icon/hero/236.png" price="0"/>
  <itemEum id="hero.taskitem.237" name="Gaius Julius Caesar Augustus" itemType="任务" dayLimit="0" userLimit="0" desc="Gaius Julius Caesar Augustus (63 BCE-14 CE) was the first emperor of Rome.  Famous for joining alliances with Mark Antony and Marcus Aemilius Lepidus and then later defeating them both in battle.  He held such a great deal of power and control over Rome that when he died, the Roman Senate declared him a God and changed the name of a month to August, which is still used.  The names Augustus and Caesar became synonymous with power, and every following roman emperor adopted these names as their own. " itemDesc="Gaius Julius Caesar Augustus" iconUrl="images/icon/hero/237.png" price="0"/>
  <itemEum id="hero.taskitem.238" name="Gaius Marius" itemType="任务" dayLimit="0" userLimit="0" desc="A brilliant military leader and politician, Marius reorganized the nearly defunct Roman army and implement wide spread conscription in the face of Barbarian invasion. " itemDesc="Gaius Marius" iconUrl="images/icon/hero/238.png" price="0"/>
  <itemEum id="hero.taskitem.24" name="Meister Eckhart" itemType="任务" dayLimit="0" userLimit="0" desc="German theologian, philosopher and mystic.  " itemDesc="Meister Eckhart" iconUrl="images/icon/hero/24.png" price="0"/>
  <itemEum id="hero.taskitem.241" name="Galileo Galilei" itemType="任务" dayLimit="0" userLimit="0" desc="A major contributor to the Scientific Revolution, Galileo laid the groundwork for modern astronomy and physics. " itemDesc="Galileo Galilei" iconUrl="images/icon/hero/241.png" price="0"/>
  <itemEum id="hero.taskitem.242" name="Gaspard de Coligny" itemType="任务" dayLimit="0" userLimit="0" desc="Gaspard de Coligny, Seigneur de (Lord of) Chatillon and member of the French noble house of Montmorency, was appointed Admiral of France in 1552. The Spaniards captured him in 1557, and he converted to Calvinism while imprisoned. After his release, his estimable reputation elevated the respectability of the Huguenots. Elected Commander-in-Chief in 1569, de Coligny ended the French Wars of Religion with the Peace of St. Germain. At the royal court, Catherine de Medici, mother of King Charles IX, was suspicious of de Coligny's influence and had him assassinated in 1572. " itemDesc="Gaspard de Coligny" iconUrl="images/icon/hero/242.png" price="0"/>
  <itemEum id="hero.taskitem.243" name="Genghis Khan" itemType="任务" dayLimit="0" userLimit="0" desc="Famous for both his sheer lust for conquest and ability as a military tactician, Khan united small tribes in central Asia to create one of the largest empires ever known. " itemDesc="Genghis Khan" iconUrl="images/icon/hero/243.png" price="0"/>
  <itemEum id="hero.taskitem.245" name="Geoffrey II of Anjou" itemType="任务" dayLimit="0" userLimit="0" desc="Son of Fulk III of Anjou, Geoffrey II sought to expand his power and influence before receiving his eventual inheratance.  By the time his father died, Geoffrey II had extended his power base as far as the coast of France and the region of Saintonge. " itemDesc="Geoffrey II of Anjou" iconUrl="images/icon/hero/245.png" price="0"/>
  <itemEum id="hero.taskitem.246" name="Geoffrey Plantagenet" itemType="任务" dayLimit="0" userLimit="0" desc="Geoffrey inherited small leadership positions early in life but his ambitions were great and eventually led to his sucessful conquest for the position of Duke of Normandy. " itemDesc="Geoffrey Plantagenet" iconUrl="images/icon/hero/246.png" price="0"/>
  <itemEum id="hero.taskitem.248" name="George Villiers, 1st Duke of Buckingham" itemType="任务" dayLimit="0" userLimit="0" desc="With no skills but plenty of charm, George Villiers came to the court of James I in 1615. He quickly became a favorite, acquired wealth and power, and made countless decisions damaging to the already dissolute monarchy. He tried to arrange a marriage between Charles, Prince of Wales, and the Spanish Infanta Maria insulting the Spanish court with his crass negotiations. When Charles became king, Buckingham forced expensive wars against Spain and France. In 1628, Buckingham was murdered by a soldier disgusted with the French war, but not before Buckingham's incompetence had doomed Charles I. " itemDesc="George Villiers, 1st Duke of Buckingham" iconUrl="images/icon/hero/248.png" price="0"/>
  <itemEum id="hero.taskitem.249" name="George Washington" itemType="任务" dayLimit="0" userLimit="0" desc="George Washington was the commander of the Continental Army during the War for Independence and the first President of the United States. Due to these factors he is considered the Father of the country.  Considering his lack of resources and men he had to work with, his victories in the war are impressive, especially at Saratoga and Yorktown. AS President he was a supporter of a strong central government and championed against getting involved in foreign wars. " itemDesc="George Washington" iconUrl="images/icon/hero/249.png" price="0"/>
  <itemEum id="hero.taskitem.25" name="Michaelangelo" itemType="任务" dayLimit="0" userLimit="0" desc="Italian Renaissance painter, sculptor, architect, poet, and engineer. his versatility in the disciplines he took up was of such a high order that he is often considered a contender for the title of the archetypal Renaissance man.       " itemDesc="Michaelangelo" iconUrl="images/icon/hero/25.png" price="0"/>
  <itemEum id="hero.taskitem.251" name="Gerardus Mercator" itemType="任务" dayLimit="0" userLimit="0" desc="Mercator is an accomplished brass engraver and cartographer from the Flemish region of Europe.  His map making methods revolutionized the art and led to many other important navigational advancements. " itemDesc="Gerardus Mercator" iconUrl="images/icon/hero/251.png" price="0"/>
  <itemEum id="hero.taskitem.252" name="Gerhard von Malberg" itemType="任务" dayLimit="0" userLimit="0" desc="Gerhard von Malberg was the sixth Grand Master of the Teutonic Order, serving in this position from 1240 to 1244. When he was forced to resign, he joined the Knights Templar. He joined the Teutonic Knights in Acre in 1217. Von Malberg was selected Grand Master in 1240 or 1241 in order to promote closer ties with the Middle East.  " itemDesc="Gerhard von Malberg" iconUrl="images/icon/hero/252.png" price="0"/>
  <itemEum id="hero.taskitem.253" name="Giordano Bruno" itemType="任务" dayLimit="0" userLimit="0" desc="A Dominican priest ordained in 1572, Bruno was accused of heresy in 1576 because he accepted the astronomical precepts of Nicholaus Copernicus. Bruno logically extended those ideas by contending that the universe was infinite with potentially thousands of worlds like Earth. This unorthodox philosophy earned Bruno the attention of the Inquisition, and he was burned at the stake in 1600. Bruno's ideas influenced other philosophers and astronomers in the next century. " itemDesc="Giordano Bruno" iconUrl="images/icon/hero/253.png" price="0"/>
  <itemEum id="hero.taskitem.254" name="Giovanni Bellini" itemType="任务" dayLimit="0" userLimit="0" desc="Member of a distinguished family of artists, Bellini dominated Venetian painting. He painted a few portraits and mythological scenes but was renowned for emotive religious subjects set in brilliant landscapes. One of the earliest masters of oil-painting technique, Bellini died in 1516. " itemDesc="Giovanni Bellini" iconUrl="images/icon/hero/254.png" price="0"/>
  <itemEum id="hero.taskitem.255" name="Giovanni Bicci de Medici" itemType="任务" dayLimit="0" userLimit="0" desc="Giovanni used his position in the powerful Medici family to gain an appointment as Archbishop of Pisa and eventually a position in the Vatican as a cardinal. " itemDesc="Giovanni Bicci de Medici" iconUrl="images/icon/hero/255.png" price="0"/>
  <itemEum id="hero.taskitem.256" name="Giovanni Paolo" itemType="任务" dayLimit="0" userLimit="0" desc="Son of Italian Duke Ludovico Sforza, Paolo is highly respected and successful as a leader of an Italian mercenary army.  Not bound by the rules of civilized warfare, Paolo and his men often plunder the riches of their defeated enemy. " itemDesc="Giovanni Paolo" iconUrl="images/icon/hero/256.png" price="0"/>
  <itemEum id="hero.taskitem.257" name="Giovanni Sforza" itemType="任务" dayLimit="0" userLimit="0" desc="First husband of Lucrezia Borgia, Sforza was a member of the House of Sforza which ruled Italy. " itemDesc="Giovanni Sforza" iconUrl="images/icon/hero/257.png" price="0"/>
  <itemEum id="hero.taskitem.258" name="Girart de Roussillon" itemType="任务" dayLimit="0" userLimit="0" desc="Girart fought at the Battle of Fontenay as an ally of Lothair I while serving as Count of Paris.  Fifteen years later and upon Lothair's death, Girart ruled on behalf of his infant son whom had inherited large areas of land in Burgandy.  Much of his time spent as regent involved leading defensive campaigns againsts invading Northmen. " itemDesc="Girart de Roussillon" iconUrl="images/icon/hero/258.png" price="0"/>
  <itemEum id="hero.taskitem.259" name="Gjergj Kastrioti Skanderbeg" itemType="任务" dayLimit="0" userLimit="0" desc="Known as the 'Dragon of Albania', Gjergj Kastrioti Skandebeg rebelled against the Sultan in 1463, and spent the next 25 years organizing the Albanian Resistance.  On the fields of Torvioll in 1444, he became one of the first European commanders to defeat the Ottoman army in a set piece battle.  An expert general, he led by consensus, convincing his fellow nobles of his tactics before each battle.  After his death, the Ottoman Empire conquered Albania.  When they found his tomb, they took his bones and made amulets to confer his bravery to their generals. " itemDesc="Gjergj Kastrioti Skanderbeg" iconUrl="images/icon/hero/259.png" price="0"/>
  <itemEum id="hero.taskitem.26" name="Nicolau Copernicus" itemType="任务" dayLimit="0" userLimit="0" desc="Copernicus was a mathematician, astronomer, physician, classical scholar, translator,artist, Catholic cleric, jurist, governor, military leader, diplomat and economist. Among his many responsibilities, astronomy figured as little more than an avocation " itemDesc="Nicolau Copernicus" iconUrl="images/icon/hero/26.png" price="0"/>
  <itemEum id="hero.taskitem.260" name="Godfrid Haraldsson" itemType="任务" dayLimit="0" userLimit="0" desc="Son of Harald 'Klak' Halfdansson, Godfrid was more aggressive than his father but never held much power for extended periods of time.  He joined with his cousin, Rorik, in raiding Dorestad and other parts of Denmark from 850 until 853.  After the death of King Horik I in 855 they attempted to gain power in Denmark but failed.  After regrouping Rorik and Godfrid managed to gain control over a large portion of what is now the Netherlands but Godfird would die shortly thereafter. " itemDesc="Godfrid Haraldsson" iconUrl="images/icon/hero/260.png" price="0"/>
  <itemEum id="hero.taskitem.261" name="Gottfried von Hohenlohe" itemType="任务" dayLimit="0" userLimit="0" desc="Gottfried von Hohenlohe was the 14th Grand Master of the Teutonic Order, starting his service at the end of 13th century. Hohenlohe was regarded as ineffective in his organization of the Teutonic Order in Prussia and Livonia, and was thought to have ignored the requests made by these provinces. He was therefore was voted out of his position by his Knight brothers. Hohenlohe then left Prussia and moved to Germany. " itemDesc="Gottfried von Hohenlohe" iconUrl="images/icon/hero/261.png" price="0"/>
  <itemEum id="hero.taskitem.262" name="Gottschalk of Orbais" itemType="任务" dayLimit="0" userLimit="0" desc="Gottschalk was a Saxon theologian, monk and poet during the 9th century.  A firm believer in St. Augustine's notion of predestination, he took the concept one step further, believing individuals to be predestined for condemnation as well as salvation.  Such extreme theories were common in his works and he developed a reputation for having a violent temperament and was persecuted for espousing controversial ideas, which he refused to recant until his death. " itemDesc="Gottschalk of Orbais" iconUrl="images/icon/hero/262.png" price="0"/>
  <itemEum id="hero.taskitem.263" name="Günther von Wüllersleben" itemType="任务" dayLimit="0" userLimit="0" desc="Günther von Wüllersleben was the eighth Grand Master of the Teutonic Knights, serving from 1249-52. It is not known when he joined the Teutonic Order, although he served with them in Acre until 1215, and took part in secret diplomatic missions for the Order. Von Wüllersleben tried to reconcile the papal and imperial parties which were demoralizing the monastic life within the Order. He was able to overcome the division within the Order's chapter for which the pro-papal fraction was pushing. " itemDesc="Günther von Wüllersleben" iconUrl="images/icon/hero/263.png" price="0"/>
  <itemEum id="hero.taskitem.264" name="Guru Nanak" itemType="任务" dayLimit="0" userLimit="0" desc="Guru Nanak founded the Sikh religion.  A believer that God was inside of each of us, Guru Nanak claimed that introspection, awareness, and selfless dedication to God were the keys to enlightenment.  His followers praticed his teachings by remembering God at all times, by earning an honest living, and by helping those in need.   " itemDesc="Guru Nanak" iconUrl="images/icon/hero/264.png" price="0"/>
  <itemEum id="hero.taskitem.265" name="Hamilcar Barca" itemType="任务" dayLimit="0" userLimit="0" desc="Hamilcar Barca or Barcas (ca. 275 – 228 B.C.) was a Carthaginian general and statesman in the first Punic War.  He served as the commander of the Carthaginian forces in Sicily.  After putting down a rebellion among Carthaginian mercenaries, he gained strong personal power and began the conquest of Spain in 237. He planned an attack on Rome with this as his base. Preparing for this attack for the remainder of his life, he paved the ground for the campaign that his son, Hannibal, carried out 10 years after his death due to drowning during the seige of Helice. " itemDesc="Hamilcar Barca" iconUrl="images/icon/hero/265.png" price="0"/>
  <itemEum id="hero.taskitem.266" name="Hammurabi" itemType="任务" dayLimit="0" userLimit="0" desc="Hammurabi was the sixth of the First Dynasty Kings of the ancient city-state of Babylon.  The first decades of Hammurabi's rule were peaceful and marked by public works such as heightening the city walls for defense, improving irrigation, and expansion of the city temples.  However, he was best known for establishing a system of written laws known as the 'Code of Hammurabi'. After ascending to the throne of only a minor kingdom in the heart of the 'fertile crescent', in a few short years Hammurabi succeeded in unifying all of Babylonia under his rule ultimately claiming the title of 'The First King of the Babylonian Empire.“ " itemDesc="Hammurabi" iconUrl="images/icon/hero/266.png" price="0"/>
  <itemEum id="hero.taskitem.267" name="Hannibal" itemType="任务" dayLimit="0" userLimit="0" desc="Hannibal (247 B.C. - 182 B.C.E) was a Carthaginian general, who led the famous march across the Alps.  Hannibal is primarily known for his efforts in the second Punic war, but was just as important in the role he played in the conquest of southeastern Spain.  He was the son of Hamilcar Barca, and began following his father on campaigns at the age of 9.   From age 18-25, Hannibal acted as a military leader in connection with the extension and consolidation of Carthaginian power in Spain.  When Antiochus was defeated in 190, Hannibal fled to Crete, and later Bithynia (now Izmit) in northern Asia Minor.  Warfare with new allies against Rome resulted in defeat, but Hannibal committed suicide by poison instead of surrendering. " itemDesc="Hannibal" iconUrl="images/icon/hero/267.png" price="0"/>
  <itemEum id="hero.taskitem.268" name="Harald 'Klak' Halfdansson" itemType="任务" dayLimit="0" userLimit="0" desc="Klak was a Danish King who reigned in parts of Friesland and Jutland during the 9th Century.  Louis the Pious, ruler of Franconia, had no fleet to defend against Viking incursions from the north and so he established an alliance with Klak under the terms that Klak's forces would defend the coast of Friesland, a weak point in the defenses of Louis' realm.   " itemDesc="Harald 'Klak' Halfdansson" iconUrl="images/icon/hero/268.png" price="0"/>
  <itemEum id="hero.taskitem.269" name="Hartmann von Heldrungen" itemType="任务" dayLimit="0" userLimit="0" desc="Hartmann von Heldrungen was the 11th Grand Master of the Teutonic Order, serving from 1273-82.Von Heldrungen started his career as an Imperial Knight from Thuringia in the Holy Roman Empire and joined the Teutonic Order between 1234 and 1237. Von Heldrungen became the 11th Grand Master sometime in the summer of 1273. His rule was marked by relative calm, and he accelerated the process of colonization of Prussia and Livonia. He gained more lands in the empire as well as in Pomerania. " itemDesc="Hartmann von Heldrungen" iconUrl="images/icon/hero/269.png" price="0"/>
  <itemEum id="hero.taskitem.27" name="Niels Ebbesen" itemType="任务" dayLimit="0" userLimit="0" desc="Danish squire and national hero, known for his killing of Count Gerhard III.    " itemDesc="Niels Ebbesen" iconUrl="images/icon/hero/27.png" price="0"/>
  <itemEum id="hero.taskitem.270" name="Hasdrubal the Fair" itemType="任务" dayLimit="0" userLimit="0" desc="Hasdrubal the Fair (ca. 270 - 221 B.C.) was a Carthaginian military leader, the brother-in-law of Hannibal and son-in-law of Hamilcar Barca.  He followed Hamilcar in his campaign against the governing aristocracy at Carthage at the close of the First Punic War, and the subsequent  conquest in Hispania.  After Hamilcar's death, Hasdrubal took over command, extended and consolidated the new empire, founding Cartagena as the capital.   He was killed by a Celtic assassin. " itemDesc="Hasdrubal the Fair" iconUrl="images/icon/hero/270.png" price="0"/>
  <itemEum id="hero.taskitem.271" name="Heinrich von Hohenlohe" itemType="任务" dayLimit="0" userLimit="0" desc="Heinrich von Hohenlohe was the seventh Grand Master of the Teutonic Order, in service between 1244-1249. In 1221, von Hohenlohe went on a pilgrimage to the Holy Land. In 1246, von Hohenlohe started a crusade in Prussia and captured Christburg. He signed a highly favorable treaty with the Old Prussians and the Duke of Pomerania, ?wi?tope?k II the Great. " itemDesc="Heinrich von Hohenlohe" iconUrl="images/icon/hero/271.png" price="0"/>
  <itemEum id="hero.taskitem.272" name="Heinrich von Tunna" itemType="任务" dayLimit="0" userLimit="0" desc="Heinrich von Tunna, also  Heinrich Bart, was the third Grand Master of the Teutonic Knights, from 1208 to 1209. He ruled the military order for a very short time, so he didn't accomplish much. But it is known that he continued the policies of his predecessor Otto von Kerpen, aimed at strengthening the independence of the order.  " itemDesc="Heinrich von Tunna" iconUrl="images/icon/hero/272.png" price="0"/>
  <itemEum id="hero.taskitem.273" name="Heinrich Walpot von Bassenheim" itemType="任务" dayLimit="0" userLimit="0" desc="Heinrich Walpot von Bassenheim, also known as Henry Walpot, was the first Grand Master of the Teutonic Knights, serving from 1198 to 1200. Walpot came from a wealthy family from Mainz. He was in favor of turning the Teutonic Knights organization into a military order. In 1199 he received a copy of monastery rules from Gilbert Horal, the Grand Master of the Knights Templars, on behalf of Pope Innocent III. It was based on the rules of the Templars. Walpot died and was buried in Acre. " itemDesc="Heinrich Walpot von Bassenheim" iconUrl="images/icon/hero/273.png" price="0"/>
  <itemEum id="hero.taskitem.274" name="Henri I de Bourbon" itemType="任务" dayLimit="0" userLimit="0" desc="Following in the footsteps of his father Louis I of Bourbon, Henri commanded an army of Hugunots during the Wars of Religion. " itemDesc="Henri I de Bourbon" iconUrl="images/icon/hero/274.png" price="0"/>
  <itemEum id="hero.taskitem.275" name="Henry Hudson" itemType="任务" dayLimit="0" userLimit="0" desc="Henry Hudson was an English explorer. He scouted the Hudson River area for the Dutch West Indies Company. This laid the groundwork for Dutch colonization of New York. Later while looking for the Northwest Passage he discovered the Hudson Strait and Hudson Bay in Canada. " itemDesc="Henry Hudson" iconUrl="images/icon/hero/275.png" price="0"/>
  <itemEum id="hero.taskitem.276" name="Henry II de Bourbon" itemType="任务" dayLimit="0" userLimit="0" desc="Raised in the Catholic faith, Henry II became king when he came of age, ending the regency of Marie de Medici. Henry II is a short, historical footnote compared to his son Louis II de Bourbon who succeeded him and distinguished the family branch with accomplishments earning him the title the Great Condé. " itemDesc="Henry II de Bourbon" iconUrl="images/icon/hero/276.png" price="0"/>
  <itemEum id="hero.taskitem.277" name="Henry II of England" itemType="任务" dayLimit="0" userLimit="0" desc="The first ruler to use the title 'King of England' rather than 'King of English' Henry II was an exceptional leader.  Crowned on December 19, 1154 he would rule until his death on July 6, 1189.  His greatest victory took place in 1174 when he routed an invading force from Scotland led by William I of Scotland.  Henry's troop of seasoned Knights snuck into William's encampment under the cover of fog and his infantry crushed the disorganized and dispersed Scottish force.  He was eventually betrayed by his children but Henry II's reign marked a pivotal era in the expansion of English power in the British Isles. " itemDesc="Henry II of England" iconUrl="images/icon/hero/277.png" price="0"/>
  <itemEum id="hero.taskitem.278" name="Henry III" itemType="任务" dayLimit="0" userLimit="0" desc="Henry II, called the Holy or the Saint, was the fifth and last Holy Roman Emperor of the Ottonian dyansty. He was emperor from 1014 till his death in 1024. He was crowned king of Germany in 1002 and in 1004 king of Italy. He is the only German king to have been canonized.  " itemDesc="Henry III" iconUrl="images/icon/hero/278.png" price="0"/>
  <itemEum id="hero.taskitem.279" name="Henry IV" itemType="任务" dayLimit="0" userLimit="0" desc="Henry IV was king of Germany from 1056  and then Holy Roman Emperor from 1084 until 1105 when he was forced to abdicate. He was a powerful figure in the 11th century whose reign was marked by several civil wars in Italy and Germany and by the Investiture Controversy with the Pope. While gathering an army to fight his son Henry V he fell ill and died. " itemDesc="Henry IV" iconUrl="images/icon/hero/279.png" price="0"/>
  <itemEum id="hero.taskitem.28" name="Paracelsus" itemType="任务" dayLimit="0" userLimit="0" desc="Medieval physician, botanist, alchemist, astrologer, and general occultist.     " itemDesc="Paracelsus" iconUrl="images/icon/hero/28.png" price="0"/>
  <itemEum id="hero.taskitem.280" name="Henry Stuart, Lord Darnley" itemType="任务" dayLimit="0" userLimit="0" desc="Henry Stuart, commonly known as Lord Darnley, was the first husband of Mary I, Queen of Scots, and father to James VI of Scotland.  He was merely the King Consort with no royal powers but the eventual ascension of his son and the circumstances surrounding his death make him a significant character in Scottish history.  He was mysteriously murdered and the Queen's marriage to another man implied that something was amiss.  Darnley's death was a key event in Mary's eventual loss of the Scottish Crown. " itemDesc="Henry Stuart, Lord Darnley" iconUrl="images/icon/hero/280.png" price="0"/>
  <itemEum id="hero.taskitem.281" name="Henry the Lion" itemType="任务" dayLimit="0" userLimit="0" desc="The only son of Henry the Proud, Henry the Lion controlled a vast swath of land in Northeastern Europe.  He gained and held these these lands through military skill, shrewd political maneuvering and the legacy of his four grandparents.  Ruling over large portions of Bavaria and Saxony from 1142 until 1180 his reign was long and prosperous and during its tenure he founded the historic cities of Munich and Lubeck.  His empire was eventually picked apart in 1181 by a large coalition of jealous Germanic princes led by his cousin Frederick I Barbarossa.  Humbled but still proud Henry lived out his days sponsoring art and architecture as the Duke of Brunswick until his death in 1195. " itemDesc="Henry the Lion" iconUrl="images/icon/hero/281.png" price="0"/>
  <itemEum id="hero.taskitem.282" name="Henry the Navigator" itemType="任务" dayLimit="0" userLimit="0" desc="The third son of King John I of Portugal and Philippa of Lancaster, Henry took an interest in Africa at age 21, and sought to expand European knowledge of the African coast.  To facilitate these voyages, he instigated the development of the caravel, a lighter, faster vessel which could handle the long trips.  In addition to his patronage of exploration and cartography, he also donated the land and buildings that would become the University of Lisbon. " itemDesc="Henry the Navigator" iconUrl="images/icon/hero/282.png" price="0"/>
  <itemEum id="hero.taskitem.283" name="Henry the Proud" itemType="任务" dayLimit="0" userLimit="0" desc="Henry the proud ruled over various portions of Bavaria, Saxony and Swabia during the early years of the 12th Century.  In 1136 he embarked on a successful and devastating invasion of southern Italy and was subsequently named Margrave of Tuscany for his exploits.  In 1139 his duchy in Bavaria was taken by a coalition of lesser princes so he established a mighty force in Saxony to retake his lands but died shortly before he could launch the campaign.  If not for this lack of longevity Henry the Proud would have had the wherewithal to become Holy Roman Emperor. " itemDesc="Henry the Proud" iconUrl="images/icon/hero/283.png" price="0"/>
  <itemEum id="hero.taskitem.284" name="Henry the Young King" itemType="任务" dayLimit="0" userLimit="0" desc="Dubbed 'the Young King' to distinguish him from his father of the same name, Henry II of England.  Although Henry is well liked and charasmatic, he doesn't take the job seriously and is considered incompetent in many areas of politics. " itemDesc="Henry the Young King" iconUrl="images/icon/hero/284.png" price="0"/>
  <itemEum id="hero.taskitem.285" name="Henry V of England" itemType="任务" dayLimit="0" userLimit="0" desc="Crowned King of England in 1413, Henry V became the first English King since the Norman Conquest to use English for his personal communication.  He spent the bulk of his rule defending his French holdings, and attempting to conquer the whole of France.  His greatest victory was at the Battle of Agincourt, where he defeated a French force that outnumbered his army four to one. " itemDesc="Henry V of England" iconUrl="images/icon/hero/285.png" price="0"/>
  <itemEum id="hero.taskitem.286" name="Henry VI of England" itemType="任务" dayLimit="0" userLimit="0" desc="A peaceful individual, Henry VI inherited the throne at age 8 months, and regents ruled in his stead until he was 16.  A pious man of learning, he founded both King's College and Eton College at Cambridge.  During his rule, military losses to the French almost removed England from the continent, just holding the coastal port of Calais.  Between the losses on continental Europe and giving substantial lands to favorites who were not generally popular, Henry VI soon faced a challenge to the throne from the House of York.  Eventually, Henry was deposed and imprisoned in the Tower of London, where he later died.   " itemDesc="Henry VI of England" iconUrl="images/icon/hero/286.png" price="0"/>
  <itemEum id="hero.taskitem.287" name="Henry VI, Holy Roman Emperor" itemType="任务" dayLimit="0" userLimit="0" desc="Henry VI ruled over parts of Germany, the Holy Roman Empire and Sicily from 1190 to 1197.  He ransomed Richard I back to the English for the enormous sum of 150,000 silver silver marks and used the money to raise a powerful army, which he used to conquer southern Italy and become the most powerful monarch in the Mediterranean and Europe.  In addition to his immense wealth and power Henry was an accomplished scholar, musician and poet. " itemDesc="Henry VI, Holy Roman Emperor" iconUrl="images/icon/hero/287.png" price="0"/>
  <itemEum id="hero.taskitem.288" name="Henry VII of England" itemType="任务" dayLimit="0" userLimit="0" desc="Henry Tudor was crowned King of England in 1485 after the defeat of Richard III's army at the Battle of Bosworth Field.  His claim to the throne was relatively weak, but almost all potential claimants had died in the War of the Roses.  His rule was solidified when he married Elizabeth of York, creating a new dynasty, the Tudors.  His reign was characterized with peace and economic development.  He restored the fortunes of England's bankrupt treasury, agreed to peace with France, and negotiated for decreased tariffs in Flanders.  His economic policies enriched both the country and himself, as he died with an estate worth $2,500,000, or $750,000,000 in today's dollars. " itemDesc="Henry VII of England" iconUrl="images/icon/hero/288.png" price="0"/>
  <itemEum id="hero.taskitem.289" name="Henry VIII" itemType="任务" dayLimit="0" userLimit="0" desc="Henry VIII reigned from 1509 to 1547 and is among the most influential of English Monarchs.  Notorious for his treatment of his six wives, two of which were beheaded, he also established the Church of England with himself as its head, in direct defiance of papal authority in Rome.  He also oversaw the rapid growth of English naval power through heavy Royal investment in the construction of shipyards and the development of shipbuilding techniques.  These two achievements were monumental in the progress of English history. " itemDesc="Henry VIII" iconUrl="images/icon/hero/289.png" price="0"/>
  <itemEum id="hero.taskitem.29" name="Peter the Hermit" itemType="任务" dayLimit="0" userLimit="0" desc="A priest of Amiens and a key figure during the First Crusade.       " itemDesc="Peter the Hermit" iconUrl="images/icon/hero/29.png" price="0"/>
  <itemEum id="hero.taskitem.290" name="Hermann von Salza" itemType="任务" dayLimit="0" userLimit="0" desc="Hermann von Salza was the fourth Grand Master of the Teutonic Knights, serving from 1209-39. He was an accomplished diplomat with strong ties to the Holy Roman Emperor and the Pope, and oversaw a major expansion of the military order into Prussia, through crusades to Christianize the pagan Prussians.  " itemDesc="Hermann von Salza" iconUrl="images/icon/hero/290.png" price="0"/>
  <itemEum id="hero.taskitem.291" name="Hernán Cortés" itemType="任务" dayLimit="0" userLimit="0" desc="Born to minor nobility in Medellin, Spain, Cortés sailed for Hispaniola at age 19. In 1511, he went to Cuba, but he and the island's Governor, Diego Velázquez de Cuéllar, despised each other. Cortés left to colonize Mexico, and the Aztecs and Emperor Montezuma welcomed him even as the troops of Velázquez pursued him on charges of mutiny. The natives were suspicious of the Spanish and drove them from the Aztec capital of Tenochtitlán. Cortés returned to conquer the Aztec Empire in 1521 for which he was created Marqués del Valle de Oaxaca. After a failed conquest in Honduras in 1524, Cortés spent the rest of his life fighting in Mexico and Spain. " itemDesc="Hernán Cortés" iconUrl="images/icon/hero/291.png" price="0"/>
  <itemEum id="hero.taskitem.292" name="Hernando de Soto" itemType="任务" dayLimit="0" userLimit="0" desc="De Soto, a Spanish Conquistador, joined the conquest of Central America and Francisco Pizarro's assault on the Incas in Peru. Holy Roman Emperor Charles V made him Governor of Cuba, opening the door to conquering the North American mainland. De Soto landed in Florida in 1539 and explored the Carolinas,  Appalachians, Tennessee and Alabama. An expedition west probably made de Soto the first European to see the Mississippi River. He followed the Arkansas River to Oklahoma but returned to Florida without discovering gold or treasure. " itemDesc="Hernando de Soto" iconUrl="images/icon/hero/292.png" price="0"/>
  <itemEum id="hero.taskitem.293" name="Herodotus" itemType="任务" dayLimit="0" userLimit="0" desc="Herodotus was a Greek historian born in Halicarnassus, in Caria in 484 B.C..  He is the oldest known historian and often referred to as the 'Father of History”.  Although the dates and extent of his travels are obscure, from his own statements we find he visited the islands and coast of Asia Minor; and he devoted particular attention to Egypt, which was at that time little known. He traveled to Palestine, Phoenicia and penetrated as far east as Babylon and Susa.   He sailed through the Hellespont into the Black Sea, and visited  the countries situated on its shores.  In his immortal historical work Herodotus describes the war between the Persians and the Greeks and provides  accuracy and impartiality in his observations of the many countries he travelled.  Upon his return, he stayed in Athens for awhile, but soon retired to Thurii, Italy where he died about 418 B.C.. " itemDesc="Herodotus" iconUrl="images/icon/hero/293.png" price="0"/>
  <itemEum id="hero.taskitem.294" name="Hieronymus Bosch" itemType="任务" dayLimit="0" userLimit="0" desc="Flemish painter Hieronymus Bosch  was born Jerome or Jhieronimus van Aken in Brabant, and his father and grandfather were also artists. Bosch married a patrician woman, and the church near her estate was the recipient of many of his paintings. Atypical of the Flemish style and filled with weird images to illustrate religion and morals, Bosch's works were sought by collectors throughout Europe. Bosch died in 1516. " itemDesc="Hieronymus Bosch" iconUrl="images/icon/hero/294.png" price="0"/>
  <itemEum id="hero.taskitem.296" name="Hincmar of Rheims" itemType="任务" dayLimit="0" userLimit="0" desc="Hincmar used the influence of his noble family and intellect to become Archbishop of Reims beofre age thirty.  He wrote several theological tracts and was a fervent opponent of predestinarianism. " itemDesc="Hincmar of Rheims" iconUrl="images/icon/hero/296.png" price="0"/>
  <itemEum id="hero.taskitem.297" name="Hippocrates" itemType="任务" dayLimit="0" userLimit="0" desc="Celebrated as the Father of Medicine, Hippocrates (460–377 B.C.) was born on the Island of Cos, traveled widely throughout classical Greece in the period of its civilization's most intellectual achievements, and died in Thessaly. He is best known for penning the Hippocratic oath, one of the basic texts of medical ethics still taken by modern medical school graduates.  Over eighty treatises have been attributed to him, however, scholars today concede some were written by others who borrowed his name and reputation. His works form ten volumes, an encyclopedia of medicine and surgery as known in his day.  Unlike most physicians of his time, Hippocrates was not superstitious and did not believe in miraculous diseases or cures. He taught that proper diet is a necessity of health, and that climate profoundly influences both the mind and body. " itemDesc="Hippocrates" iconUrl="images/icon/hero/297.png" price="0"/>
  <itemEum id="hero.taskitem.298" name="Horatio Nelson" itemType="任务" dayLimit="0" userLimit="0" desc=" Horatio Nelson was a British flag officer in the Royal Navy. He had an extraordinary career and is considered one of the top ten brits of all history. His main victories were against the French. These include the Battle of Santa Cruz and the Battle of the Nile. His greatest victory was the Battle of Trafalgar but he was also mortally wounded there. He was noted for his ability to inspire and bring out the most in his troops. " itemDesc="Horatio Nelson" iconUrl="images/icon/hero/298.png" price="0"/>
  <itemEum id="hero.taskitem.299" name="Howard of Effingham" itemType="任务" dayLimit="0" userLimit="0" desc="A noble of notable lineage Howard of Effingham became the 1st Earl of Nottingham in 1596.  He was named Commander-in-Chief of the English fleet in 1587 just prior to the sailing of the Spanish Armada.  His tactic of drawing the Spanish ships into small engagements rather than a single decisive battle proved effective at first but the threat of an invasion was finally thwarted after a major engagement near Gravelines.  He was a very close ally of Elizabeth I and was also well liked by James I. " itemDesc="Howard of Effingham" iconUrl="images/icon/hero/299.png" price="0"/>
  <itemEum id="hero.taskitem.30" name="Peter Abelard" itemType="任务" dayLimit="0" userLimit="0" desc="Medieval French scholasticphilosopher, theologian and preeminent logician. The Chambers Biographical Dictionary describes him as &quot;&quot;the keenest thinker and boldest theologian of the 12th Century&quot;&quot;.    " itemDesc="Peter Abelard" iconUrl="images/icon/hero/30.png" price="0"/>
  <itemEum id="hero.taskitem.300" name="Huayna Capac" itemType="任务" dayLimit="0" userLimit="0" desc="Huayna Capac pushed the Inca Empire south into areas now part of Chile and Argentina, and also north into Ecuador.  He established a stronghold at Quito to defend his northern conquests, and spent much of his reign fighting wars in that area.   " itemDesc="Huayna Capac" iconUrl="images/icon/hero/300.png" price="0"/>
  <itemEum id="hero.taskitem.301" name="Humfrid" itemType="任务" dayLimit="0" userLimit="0" desc="Humfrid was the Count of Barcelona, Girona, Empúries, Roussillon, and Narbonne and held several frontier counties. In 858 he negotiated a peace treaty with the Moors of Zaragoza and marched into Gaul to assist Charles. Together they waged war on the Norsemen. The Moors captured attacked Barcelona and Humfrid negotiated a treaty with the consent of Charles, that lasted for three decades. " itemDesc="Humfrid" iconUrl="images/icon/hero/301.png" price="0"/>
  <itemEum id="hero.taskitem.302" name="Huneberc" itemType="任务" dayLimit="0" userLimit="0" desc="Huneberc, also Hygeburg or Hugeburc, was a German nun at the Abbey of Heidenheim during the 8th century.  She authored a number of works on the lives of influential Abbotts in the area of Heidenheim and also a work entitled the 'Hodoeporicon', a dictated account of St. Willibald's travels to Rome, Asia Minor and Jerusalem. " itemDesc="Huneberc" iconUrl="images/icon/hero/302.png" price="0"/>
  <itemEum id="hero.taskitem.305" name="Ibn al-Haythan" itemType="任务" dayLimit="0" userLimit="0" desc="Ibn al-Haythan was an Arab scientist. He is regarded as the father of modern optics due to his influential 'Book of Optics'. He also made significant improvements in physical science aas well as the scientifitic method and is regarded as the greatest scientist of the Middle Ages. " itemDesc="Ibn al-Haythan" iconUrl="images/icon/hero/305.png" price="0"/>
  <itemEum id="hero.taskitem.306" name="Ibn Khaldun" itemType="任务" dayLimit="0" userLimit="0" desc="North African?Arab?polymath, an?astronomer,?economist,historian,?Islamic scholar,?Islamic theologian,?hafiz,?jurist,?lawyer,?mathematician,?military strategist,?nutritionist,?philosopher,?social scientistand?statesman. " itemDesc="Ibn Khaldun" iconUrl="images/icon/hero/306.png" price="0"/>
  <itemEum id="hero.taskitem.307" name="Igor of Kiev" itemType="任务" dayLimit="0" userLimit="0" desc="Igor of Kiev is thought to be the son of Rurik, founder of the Rurik dynasty that ruled Kievian Rus and then Galicia-Volhynia until the 14th century, and Muscovy until the late 16th century. Twice he attacked Constantinople and negotiated a favorable treaty with them. He died a barbaric death while collecting tribute from the Drevlians which lead his wife, Olga of Kiev, to avenge his death and modify the system of tribute collection. " itemDesc="Igor of Kiev" iconUrl="images/icon/hero/307.png" price="0"/>
  <itemEum id="hero.taskitem.308" name="Isaac Israeli ben Solomon" itemType="任务" dayLimit="0" userLimit="0" desc="Isaac Israeli ben Solomon, the father of medieval Jewish Neoplatonism, was a leading mind of his time and was often said to have mastered all the 'seven sciences.' He was a student of natural history, medicine, mathematics, astronomy, and other sciences. He published a number of medical and philosophical works in Arabic, some of which were translated and influential in Europe and the Middle East. His philosophical works greatly influenced Christian, Jewish, and Muslim thinkers. " itemDesc="Isaac Israeli ben Solomon" iconUrl="images/icon/hero/308.png" price="0"/>
  <itemEum id="hero.taskitem.309" name="Isaac Newton" itemType="任务" dayLimit="0" userLimit="0" desc="Newton is one of the most influential and important scientists in history.  His magnum opus, 'Philosophi? Naturalis Principia Mathematica' established scientific laws and theories that are vital to modern science. " itemDesc="Isaac Newton" iconUrl="images/icon/hero/309.png" price="0"/>
  <itemEum id="hero.taskitem.31" name="Raphael" itemType="任务" dayLimit="0" userLimit="0" desc="Italian painter and architect of the High Renaissance, celebrated for the perfection and grace of his paintings and drawings.   " itemDesc="Raphael" iconUrl="images/icon/hero/31.png" price="0"/>
  <itemEum id="hero.taskitem.310" name="Isabella d'Este" itemType="任务" dayLimit="0" userLimit="0" desc="Rumored to be the inspiration for da Vinci's Mona Lisa,  Isabella is a Milanese duchess and influential socialite.  Her beauty and charisma makes her a influential and renown political figure. " itemDesc="Isabella d'Este" iconUrl="images/icon/hero/310.png" price="0"/>
  <itemEum id="hero.taskitem.311" name="Isabella of Castile" itemType="任务" dayLimit="0" userLimit="0" desc="Isabella of Castille, along with her husband, Ferdinand II of Aragon, united Spain as a single political unit for the first time since the 8th Century.  Under their rule, the reconquista of the Iberian peninsula was completed, and Spain's navy became the most powerful in Europe.  With the centralization of government and expansion into the newly discovered Americas, Isabella's reign started the Golden Age of Spain. " itemDesc="Isabella of Castile" iconUrl="images/icon/hero/311.png" price="0"/>
  <itemEum id="hero.taskitem.312" name="Jacobus Arminius" itemType="任务" dayLimit="0" userLimit="0" desc="Ordained in 1588, Arminius (or Harmensen) was a Dutch theologian and professor of theology at Leiden University. He opposed strict Calvinism, and his more liberal belief that free will --not predestination--could lead to salvation became known as Arminianism.  " itemDesc="Jacobus Arminius" iconUrl="images/icon/hero/312.png" price="0"/>
  <itemEum id="hero.taskitem.313" name="Jacques Cartier" itemType="任务" dayLimit="0" userLimit="0" desc="King Fran?ois of France commanded navigator Jacques Cartier to find a Northwest Passage to China and gold in the New World. On his second voyage in 1535-36, he discovered the Saint Lawrence River and named the region Canada. He befriended the Iroquois and renamed one of their settlements Mont Royal, which later became Montreal. The area was to become the center of French power in the New World and the hub of further French exploration of Canada and the Mississippi River Basin. " itemDesc="Jacques Cartier" iconUrl="images/icon/hero/313.png" price="0"/>
  <itemEum id="hero.taskitem.314" name="James Cook" itemType="任务" dayLimit="0" userLimit="0" desc="James Cook was a British explorer and cartographer and had the rank of Captain in the Royal Navy. His biggest achievements were the first European contacts with Australia, Hawaiian Islands and New Zealand. " itemDesc="James Cook" iconUrl="images/icon/hero/314.png" price="0"/>
  <itemEum id="hero.taskitem.315" name="James Hepburn, Earl of Bothwel" itemType="任务" dayLimit="0" userLimit="0" desc="An advisor to Mary, Queen of Scots, Bothwell was a Scottish Protestant nobleman and hereditary Lord High Admiral of Scotland. When Mary's second husband, Lord Darnley, was murdered, Bothwell was tried and acquitted of the deed in 1567. In quick order, Mary named him Duke of Orkney and Shetland, Bothwell divorced his wife, and he and Mary were wed. When the English defeated Mary's army and took her prisoner, Bothwell fled Scotland to raise an army in Scandinavia but was imprisoned on suspicion of Darnley's murder. Bothwell died in a Danish prison. " itemDesc="James Hepburn, Earl of Bothwel" iconUrl="images/icon/hero/315.png" price="0"/>
  <itemEum id="hero.taskitem.316" name="James II" itemType="任务" dayLimit="0" userLimit="0" desc="James II was the last Catholic monarch to rule the kingdoms of England, Scotland and Ireland. Due to his belief in an absolute monarchy he was deposed in the Glorious Revolution. He made an attempt to regain throne but this ended with his defeat at the Battle of the Boyne. " itemDesc="James II" iconUrl="images/icon/hero/316.png" price="0"/>
  <itemEum id="hero.taskitem.317" name="James VI of Scotland" itemType="任务" dayLimit="0" userLimit="0" desc="James VI of Scotland, later James I of England and Ireland, was an influential ruler during a particularly prosperous and peaceful period of England's history.  An enlightened ruler and accomplished scholar James' legacy of a peaceful reign was marred by his ruthless oppression of non-comforming English Catholics and the disastrous reign of his son Charles I.  His literary accomplishments include Daemonologie, an influential text on witchcraft, and the King James Bible, a text that revolutionized the accessibility of Christian texts for the common person. " itemDesc="James VI of Scotland" iconUrl="images/icon/hero/317.png" price="0"/>
  <itemEum id="hero.taskitem.318" name="James Wolfe" itemType="任务" dayLimit="0" userLimit="0" desc="James Wolfe was an important General in the British Army during the 18th century.  He had victories over the French in Canada during the Seven Years War. His victory at Quebec enabled the taking of Montreal and ending French rule in North America. Like Montcalm, Wolfe met his death on the Plains of Abraham. " itemDesc="James Wolfe" iconUrl="images/icon/hero/318.png" price="0"/>
  <itemEum id="hero.taskitem.319" name="Jan Hus" itemType="任务" dayLimit="0" userLimit="0" desc="Jan Hus was a Czech Catholic priest who followed in the footsteps of John Wycliffe.  He rejected the Roman practice of Indulgences and Crusades, on the grounds that neither was justified in the Bible.  His conviction to his beliefs resulted in an arrest and trial by the Papal Courts, and he was eventually burned at the stake.  His teachings laid the foundation for many of the ideas taken up by Martin Luther in the Protestant Reformation. " itemDesc="Jan Hus" iconUrl="images/icon/hero/319.png" price="0"/>
  <itemEum id="hero.taskitem.32" name="Roger Bacon" itemType="任务" dayLimit="0" userLimit="0" desc="English philosopherand Franciscan friar who placed considerable emphasis on empiricism. He is sometimes credited as one of the earliest Europeanadvocates of the modern scientific method.  " itemDesc="Roger Bacon" iconUrl="images/icon/hero/32.png" price="0"/>
  <itemEum id="hero.taskitem.320" name="Jan Karol Chodkiewicz" itemType="任务" dayLimit="0" userLimit="0" desc="Jan Karol Chodkiewicz was a Polish-Lithuanian military commander, obtaining the rank of Grand Hetman, supreme commander. While always outnumbered and plagued by a lack of support, he won many victories against the Swedes and Turks. His most famous victory was at the Battle of Kircholm, against a Swedish army three times the size of his own. " itemDesc="Jan Karol Chodkiewicz" iconUrl="images/icon/hero/320.png" price="0"/>
  <itemEum id="hero.taskitem.321" name="Jan van Eyck" itemType="任务" dayLimit="0" userLimit="0" desc="Jan van Eyck was a very influential painter on the eve of the Renaissance.  He did not invent oil painting but he refiend many of its techniques earning him the moniker of 'father of Oil Painting.'  Employed by a number of powerful and wealthy princes van Eyck would paint several masterpieces in his lifetime. " itemDesc="Jan van Eyck" iconUrl="images/icon/hero/321.png" price="0"/>
  <itemEum id="hero.taskitem.324" name="Jane Austen" itemType="任务" dayLimit="0" userLimit="0" desc="Jane Austen was an English novelist. Her use of realism and social commentary have earned her a place as one of the most read authors in English literature. " itemDesc="Jane Austen" iconUrl="images/icon/hero/324.png" price="0"/>
  <itemEum id="hero.taskitem.325" name="Jean Boudin" itemType="任务" dayLimit="0" userLimit="0" desc="A French economist and political philosopher, Boudin believed government was not imposed by God but arose to meet the needs of people. This concept of limited monarchy influenced political philosophy throughout Europe. His best-known work was published in 1576. " itemDesc="Jean Boudin" iconUrl="images/icon/hero/325.png" price="0"/>
  <itemEum id="hero.taskitem.326" name="Jeanne d'Evreux" itemType="任务" dayLimit="0" userLimit="0" desc="Jeanne D'Evreux was Queen Consort of France, wife of King Charles IV.  She bore no heir so the reign of her husband marked the end of the direct line of the Capetian dynasty.  Her true legacy lies in her book of prayer, 'The Hours of Jeanne d'Evreux', a notewortyh 14th Century illuminated manuscript which contains prayers of the Canonical hour as well as the office dedicated to her great-grandfather St. Louis. " itemDesc="Jeanne d'Evreux" iconUrl="images/icon/hero/326.png" price="0"/>
  <itemEum id="hero.taskitem.328" name="Joan of England, Queen of Sicily" itemType="任务" dayLimit="0" userLimit="0" desc="From a young age, Joan has experienced many difficulties in her life.  Her first husband died prematurely, leading to her encarceration at the hand of a madman and her second husband treated her poorly.  Regardless, Joan has learned hard lessons about how the political world works. " itemDesc="Joan of England, Queen of Sicily" iconUrl="images/icon/hero/328.png" price="0"/>
  <itemEum id="hero.taskitem.329" name="Joan of Kent" itemType="任务" dayLimit="0" userLimit="0" desc="Joan's lineage and beauty guaranteed her marriage into powerful English ruling families at an early age.  Although she has very little experience in an overt leadership position, she holds the ear of England's most powerful monarchs. " itemDesc="Joan of Kent" iconUrl="images/icon/hero/329.png" price="0"/>
  <itemEum id="hero.taskitem.33" name="Roger De Moulins" itemType="任务" dayLimit="0" userLimit="0" desc="Grand Master of the Knights Hospitaller. Excellent both in military and politics.           " itemDesc="Roger De Moulins" iconUrl="images/icon/hero/33.png" price="0"/>
  <itemEum id="hero.taskitem.330" name="Johann Georg Faust" itemType="任务" dayLimit="0" userLimit="0" desc="A 16th century hermit, wizard and alchemist.  He was the inspiration for the popular works 'The Tragical History of Doctor Faustus' and Goethe's 'Faust'. " itemDesc="Johann Georg Faust" iconUrl="images/icon/hero/330.png" price="0"/>
  <itemEum id="hero.taskitem.331" name="Johann Sebastian Bach" itemType="任务" dayLimit="0" userLimit="0" desc="Johann Sebastian Bach was a German composer and organist. He is regarded as the greatest composer of the Baroque and as one of the greatest of all time. " itemDesc="Johann Sebastian Bach" iconUrl="images/icon/hero/331.png" price="0"/>
  <itemEum id="hero.taskitem.332" name="Johannes Gutenberg" itemType="任务" dayLimit="0" userLimit="0" desc="?German?goldsmith?and?printer?who is credited with being the first European to use?movable type?printing. " itemDesc="Johannes Gutenberg" iconUrl="images/icon/hero/332.png" price="0"/>
  <itemEum id="hero.taskitem.334" name="John Cabot" itemType="任务" dayLimit="0" userLimit="0" desc="Born Giovanni Caboto, he was an Italian mariner who was interested in finding a passage to Asia by sailing West, as many explorers tried in the wake of Christopher Columbus.  His idea was to search for a northern route, because at northern latitudes the longitude lines are much closer, shortening the trip.  After being turned away by Portugal and Spain, Cabot received backing from England.  Between 1496 and 1498, he made three voyages west.  The first turned back at Iceland, the second reached somewhere on the coast of North America, and the final one was never heard from again.  Cabot's expedition was the first Europeans since Leif Ericson to land on North America. " itemDesc="John Cabot" iconUrl="images/icon/hero/334.png" price="0"/>
  <itemEum id="hero.taskitem.335" name="John Calvin" itemType="任务" dayLimit="0" userLimit="0" desc="French theologian John Calvin was educated in Paris and Orléans. He converted to Reformed Protestantism and wrote the definitive work on its theology, which minimizes free will. He also wrote a model for church government later adopted by the Presbyterians. For 30 years, Calvin tried to establish Geneva, Switzerland, as a haven for followers of his version of church doctrine and moral living. The Puritans in England and North America and followers in Scotland, the Netherlands, and France were strongly influenced by Calvinist doctrine. " itemDesc="John Calvin" iconUrl="images/icon/hero/335.png" price="0"/>
  <itemEum id="hero.taskitem.336" name="John Carver" itemType="任务" dayLimit="0" userLimit="0" desc="English-born John Carver fled religious persecution and established a separatist church in Leiden, Holland. As deacon, he led the emigration of the Pilgrims on the Mayflowerin 1620. Carver was elected first governor of the Plymouth Plantation but died soon after and was succeeded by William Bradford. " itemDesc="John Carver" iconUrl="images/icon/hero/336.png" price="0"/>
  <itemEum id="hero.taskitem.337" name="John Hancock" itemType="任务" dayLimit="0" userLimit="0" desc="John Hancock was a leading patriot of the American Revolution. He was President of Second Continental Congress and the first governor of Massachusetts. He is famous for his large signature on the Declaration of Independence, he said he wanted the king to be able to read it without his glasses. " itemDesc="John Hancock" iconUrl="images/icon/hero/337.png" price="0"/>
  <itemEum id="hero.taskitem.338" name="John Hunyadi" itemType="任务" dayLimit="0" userLimit="0" desc="Upon taking the title of Voivode of Transylvania in 1441, he found himself on the front lines of conflict with the Ottoman Empire.  He liberated Serbia in the Battle of Semendria later that year, and the next year he defeated a large Ottoman army near Nagyszeben.   He followed this up with a victory at the Iron Gates, after which he launched what King Wladyslaw called, 'the long campaign.'  By its end, Hunyadi's armies had won substantial gains in Bosnia, Herzegovina, Serbia Bulgaria, and Albania.  After the death of the king at the Battle of Varna, John Hunyadi was made Regent, and later Prince, of Hungary.  He joined the siege of Belgrade in 1455 and led an attack on the camp of the Sultan's forces, which ultimate resulted in the siege being lifted.  Within weeks, his army was stricken with plague, and Hunyadi died alongside many of his men.   " itemDesc="John Hunyadi" iconUrl="images/icon/hero/338.png" price="0"/>
  <itemEum id="hero.taskitem.339" name="John Keats" itemType="任务" dayLimit="0" userLimit="0" desc="John Keats was an English Poet, and a key figure in the Romantic Period. " itemDesc="John Keats" iconUrl="images/icon/hero/339.png" price="0"/>
  <itemEum id="hero.taskitem.34" name="Simon De Montfort" itemType="任务" dayLimit="0" userLimit="0" desc="Principal leader of the baronial opposition to King Henry III of England.       " itemDesc="Simon De Montfort" iconUrl="images/icon/hero/34.png" price="0"/>
  <itemEum id="hero.taskitem.340" name="John Kourkouas" itemType="任务" dayLimit="0" userLimit="0" desc="John Kourkouas was an important general in the Byzantine Empire. His war efforts reversed the course of centuries-long Byzantine-Arab wars which lead to Byzantium's 'Age of Conquest' in the 10th century. The Byzantine advances into the depth of Muslim territory extended the empire and control to the upper Euphrates and over western Armenia and encouraged the remaining Iberian and Armenian princes to become Byzantine vassals. He also played a role in the major Rus rain in 941 and recovered a holy relic. Kourkouas descended from an Armenian family that produced several noted warriors. " itemDesc="John Kourkouas" iconUrl="images/icon/hero/340.png" price="0"/>
  <itemEum id="hero.taskitem.341" name="John Milton" itemType="任务" dayLimit="0" userLimit="0" desc="John Milton was an English poet and author. He is best known for his epic poem, 'Paradise Lost' and his 'Areopagitica', which condemned censorship. " itemDesc="John Milton" iconUrl="images/icon/hero/341.png" price="0"/>
  <itemEum id="hero.taskitem.342" name="John of England" itemType="任务" dayLimit="0" userLimit="0" desc="Younger brother of Richard the Lionheart, John often conspired against his several older brothers in his lust for power. His reign, although lengthy, was wrought with public outcry and discontent. " itemDesc="John of England" iconUrl="images/icon/hero/342.png" price="0"/>
  <itemEum id="hero.taskitem.343" name="John Paul Jones" itemType="任务" dayLimit="0" userLimit="0" desc="John Paul Jones was the most famous officer in the United States Navy during the Revolutionary War. 'I  have not yet begun to fight' was his famous response to a surrender request. " itemDesc="John Paul Jones" iconUrl="images/icon/hero/343.png" price="0"/>
  <itemEum id="hero.taskitem.344" name="John Sobieski" itemType="任务" dayLimit="0" userLimit="0" desc="John Sobieski was king of Poland and Duke of Lithuania from 1674 to 1696. Popular with his people and a brilliant military commander. Famous for his victory against the Ottoman Empire at the Battle of Vienna the Turks nicknamed him 'Lion of Lechistan'. " itemDesc="John Sobieski" iconUrl="images/icon/hero/344.png" price="0"/>
  <itemEum id="hero.taskitem.345" name="John Wesley" itemType="任务" dayLimit="0" userLimit="0" desc="John Wesley was an Anglican cleric and theologian. He along with his brother founded the Methodist Movement. This was a highly successful movement based on a personal experience with Jesus Christ. " itemDesc="John Wesley" iconUrl="images/icon/hero/345.png" price="0"/>
  <itemEum id="hero.taskitem.347" name="Joseph Caro" itemType="任务" dayLimit="0" userLimit="0" desc="A Jewish scholar and mystic, Joseph ben Ephraim Caro settled in Palestine around 1537 after years of travel and study following his family's expulsion from Spain in 1492. He wrote the last great codification of Jewish law in 1559. Caro published a condensed version called Prepared Table for everyday use in 1565, and it eventually became the written standard on Judaism. " itemDesc="Joseph Caro" iconUrl="images/icon/hero/347.png" price="0"/>
  <itemEum id="hero.taskitem.348" name="Juan Borgia" itemType="任务" dayLimit="0" userLimit="0" desc="Son of Alexander VI, Borgia was endowed several political positions at an early age including Governor of Saint Peters, Duke of Sessa and Grand Constable of Naples. " itemDesc="Juan Borgia" iconUrl="images/icon/hero/348.png" price="0"/>
  <itemEum id="hero.taskitem.349" name="Kasimir II, Duke of Pomerania" itemType="任务" dayLimit="0" userLimit="0" desc="Kasimir II was the duke of Pomerania-Demmin from 1187 until his death. Since Casimir was still was a minor in 1187, his mother Anastasia ruled in his place until 1194 Despite his predecessors having joined the Holy Roman Empire in 1181, Kasimir had to yield to pressure put on Pomerania by Denmark and eventually became vassals to Canute VI of Denmark. " itemDesc="Kasimir II, Duke of Pomerania" iconUrl="images/icon/hero/349.png" price="0"/>
  <itemEum id="hero.taskitem.35" name="sir william wallace" itemType="任务" dayLimit="0" userLimit="0" desc="Scottish knight and landowner who is known for leading a resistance during the Wars of Scottish Independence.       " itemDesc="sir william wallace" iconUrl="images/icon/hero/35.png" price="0"/>
  <itemEum id="hero.taskitem.350" name="Kassia" itemType="任务" dayLimit="0" userLimit="0" desc="The intelligent and beautiful Kassia was a Byzantine abbess, poet, and composer well know for hymns. Her music is one of the first to be extant and able to be interpreted by modern musicians and scholars. She is the founder of a convent west of Constantinople and served as its abbess, where she worked on re-editing Byzantine liturgical books in the 9th and 10th centuries. The Hymn of Kassiani is chanted once a year during Holy Week at the Matins of Great and Holy Wednesday. " itemDesc="Kassia" iconUrl="images/icon/hero/350.png" price="0"/>
  <itemEum id="hero.taskitem.351" name="Konrad von Feuchtwangen" itemType="任务" dayLimit="0" userLimit="0" desc="Konrad von Feuchtwangen was the 13th Grand Master of the Teutonic Knights, serving in the late 13th century. In the first year of his governance, the Muslims captured Acre, the last fortress controlled by the Crusaders in the Kingdom of Jerusalem. Because the Teutonic Order itself was previously based in Acre, von Feuchtwangen had moved the Order's main headquarters to Venice. " itemDesc="Konrad von Feuchtwangen" iconUrl="images/icon/hero/351.png" price="0"/>
  <itemEum id="hero.taskitem.352" name="Konrad von Thüringen" itemType="任务" dayLimit="0" userLimit="0" desc="Konrad von Thüringen was the fifth Grand Master of the Teutonic Knights, serving from 1239-40. He was the first major noble to join the military order. Conrad engaged in battle a number of times with Siegfried III, Archbishop of Mainz and also made an unsuccessful siege of the city of Fritzlar in 1232. While on a trip to Rome in the early summer of 1240, he fell ill and died. He was buried at the Elisabeth Church of Marburg. " itemDesc="Konrad von Thüringen" iconUrl="images/icon/hero/352.png" price="0"/>
  <itemEum id="hero.taskitem.353" name="Koxinga" itemType="任务" dayLimit="0" userLimit="0" desc="Koxinga was a military leader of the Ming Dynasty during the Southern Ming period. He became the first Chinese leader of Taiwan after defeating the Dutch East India Company in 1662. " itemDesc="Koxinga" iconUrl="images/icon/hero/353.png" price="0"/>
  <itemEum id="hero.taskitem.354" name="Lacydes of Cyrene" itemType="任务" dayLimit="0" userLimit="0" desc="Lacydes of Cyrene was a Greek philosopher who became head of the Platonic Academy at Athens circa 241 B.C.E..  His works did not survive and little is known about his life.  Diogenes credits him as founder of the New Academy, which moved away from Skepticism and returned to the ideas of the Old Academy.  Laertius reports Lacydes learned from Crates,  taught Carneades, and that his associates included Paseas and Thrasys, Aristippus, and Telecles and Evander.  He was the only head of the Academy to voluntarily resign his position before his death. " itemDesc="Lacydes of Cyrene" iconUrl="images/icon/hero/354.png" price="0"/>
  <itemEum id="hero.taskitem.355" name="Lancelot Andrewes" itemType="任务" dayLimit="0" userLimit="0" desc="A noted scholar, preacher, and Anglican Church Bishop, Andrewes was a key prelate at the courts of Elizabeth I and James I. He developed much of the theology of the Anglican Church and was instrumental in producing the English Bible in 1611. " itemDesc="Lancelot Andrewes" iconUrl="images/icon/hero/355.png" price="0"/>
  <itemEum id="hero.taskitem.356" name="Leif Ericson" itemType="任务" dayLimit="0" userLimit="0" desc="Leif Ericson, son of Erik the Red,  was a Norse explorer who arguably was the first European to arrive in North America. He started a settlement called Vinland in present day Newfoundland, Canada. Setting off from Greenland in 1002 or 1003 Leif is first believed to have landed on Baffin Island and then Labrador. Then he arrived and wintered in Vinland. Researchers in the 1950's and 1960's identified a Norse settlement at the Northern tip of Newfoundland believed to be Leif's settlement. He spent the remaining years of his life spreading Christianity in Greenland. " itemDesc="Leif Ericson" iconUrl="images/icon/hero/356.png" price="0"/>
  <itemEum id="hero.taskitem.357" name="Leon Battista Alberti" itemType="任务" dayLimit="0" userLimit="0" desc="Alberti is a polymath from Italy.  His disciplines include science, linguistics, literature and cryptography as well as an important figure in the Renaissance humanism movement. " itemDesc="Leon Battista Alberti" iconUrl="images/icon/hero/357.png" price="0"/>
  <itemEum id="hero.taskitem.358" name="Leonardo da Vinci" itemType="任务" dayLimit="0" userLimit="0" desc="Although Leonardo is best known for his artwork, he is a master of many disciplines including science and engineering, math, botany, music and literature. " itemDesc="Leonardo da Vinci" iconUrl="images/icon/hero/358.png" price="0"/>
  <itemEum id="hero.taskitem.36" name="Taticius" itemType="任务" dayLimit="0" userLimit="0" desc="Scottish knight and landowner who is known for leading a resistance during the Wars of Scottish Independence.       " itemDesc="Taticius" iconUrl="images/icon/hero/36.png" price="0"/>
  <itemEum id="hero.taskitem.360" name="Li Shangyin" itemType="任务" dayLimit="0" userLimit="0" desc="Li Shangyin, also known as Yishan, was a Chinese poet of the late Tang Dynasty who had a moderately successful career in the imperial civil service. He is known for the imagist quality of his work. His poetry is sensual and suggestive of political, biographical or philosophical insinuations, making translation very difficult. " itemDesc="Li Shangyin" iconUrl="images/icon/hero/360.png" price="0"/>
  <itemEum id="hero.taskitem.361" name="Livy" itemType="任务" dayLimit="0" userLimit="0" desc="Roman?historian who wrote a monumental history of Rome,?Ab Urbe Condita, from its founding through the reign of?Augustus?in Livy's own time. " itemDesc="Livy" iconUrl="images/icon/hero/361.png" price="0"/>
  <itemEum id="hero.taskitem.362" name="Lord Thomas Howard" itemType="任务" dayLimit="0" userLimit="0" desc="Fought in a number of engagements for the English including the Battle of Bosworth Field (1485) where he was captured and imprisoned seven years for aligning with the Plantagenets in the War of the Roses.  After his release he would help to fend off a number of Scottish incursions and won a particularly stunning victory at Flodden Field in 1513.  Though he is a relatively obscure figure he fought with distinction in a number of important English battles. " itemDesc="Lord Thomas Howard" iconUrl="images/icon/hero/362.png" price="0"/>
  <itemEum id="hero.taskitem.363" name="Lorenzo de' Medici" itemType="任务" dayLimit="0" userLimit="0" desc="Grandson of Cosimo de' Medici, Lorenzo used his familial influence to launch a relatively successful political career.  He served as a de facto ruler of the Florentine Republic and a diplomat. " itemDesc="Lorenzo de' Medici" iconUrl="images/icon/hero/363.png" price="0"/>
  <itemEum id="hero.taskitem.364" name="Lothair I" itemType="任务" dayLimit="0" userLimit="0" desc="Eldest son of Louis the Pious, while in power as the Holy Roman Emperor he claimed the land his father had divided up between several parties prior to his death as his own.  His bold move was met with swift resistance and he was defeated easily by his brother Louis the German.  Although he failed, he retained some power after the peace negotiations. " itemDesc="Lothair I" iconUrl="images/icon/hero/364.png" price="0"/>
  <itemEum id="hero.taskitem.365" name="Lothair III, Holy Roman Emperor" itemType="任务" dayLimit="0" userLimit="0" desc="Lothair III was a powerful and very successful ruler of Saxon descent.  He gained the title of Holy Roman Emperor,in part through a very amicable and beneficial relationship with Pope Innocent II.  His most important long-term contribution to the history of the Germanic lands was in his maintenance of the neglected areas of Saxony in the Northeast where he appointed a number of capable Dukes and lesser magistrates who governed the region effectively. " itemDesc="Lothair III, Holy Roman Emperor" iconUrl="images/icon/hero/365.png" price="0"/>
  <itemEum id="hero.taskitem.366" name="Louis of Bourbon-Conde" itemType="任务" dayLimit="0" userLimit="0" desc="Although he started his career as a French general, Louis converted to Protestantism and took command of a small faction of rebellious Huguenots who marched in the Wars of Religion. " itemDesc="Louis of Bourbon-Conde" iconUrl="images/icon/hero/366.png" price="0"/>
  <itemEum id="hero.taskitem.367" name="Louis the German" itemType="任务" dayLimit="0" userLimit="0" desc="Although Louis the German was made King of Bavaria as a reward for serving as one of Louis the Pious' lieutenants and local governors, the title was challenged by Lothair I upon the death of Louis the Pious.  Louis the German marched against Lothair I and defeated him with little trouble and eventually expanded his influence and became King of East Francia. " itemDesc="Louis the German" iconUrl="images/icon/hero/367.png" price="0"/>
  <itemEum id="hero.taskitem.368" name="Louis the Pious" itemType="任务" dayLimit="0" userLimit="0" desc="Louis became King of Aquitaine at the age of three and King of the Franks and its associated kingdoms after the death of his father Charlemagne.  He has spent decades on milatary campaigns aimed at both quelling unrest among the Slovic tribes or squashing Civil Wars aimed at usurping his power. " itemDesc="Louis the Pious" iconUrl="images/icon/hero/368.png" price="0"/>
  <itemEum id="hero.taskitem.369" name="Louis the Stammerer" itemType="任务" dayLimit="0" userLimit="0" desc="Louis the Stammerer ruled in Aquitaine and West Francia during the 9th Century.  He had two sons, Louis and Carloman, who would later become Kings of France, but he held the title of King for less than two years.  Louis was said to be physically weak but to his credit we has called 'a simple and sweet man, a lover of peace, jjujstice and religion' by contemporaries.  His political impact was relatively minor but he did launch a campaign against the Vikings before his death in 879 when his Kingdom was split between his two sons. " itemDesc="Louis the Stammerer" iconUrl="images/icon/hero/369.png" price="0"/>
  <itemEum id="hero.taskitem.37" name="Vasco De Gama" itemType="任务" dayLimit="0" userLimit="0" desc="Portuguese explorer, one of the most successful in the European Age of Discovery and the commander of the first ships to sail directly from Europe to India.        " itemDesc="Vasco De Gama" iconUrl="images/icon/hero/37.png" price="0"/>
  <itemEum id="hero.taskitem.370" name="Louis XI of France" itemType="任务" dayLimit="0" userLimit="0" desc="Louis XI, known as the Prudent, was a clever man who used any means to reach his goal of uniting France and strengthening the monarchy.  He ended the Hundred Years' War by paying King Edward IV of England to renounce his claim to Normandy, purchased Picardy from Philip the Good, and conquered Burgundy with Swiss mercenaries.  To foster growth in his kingdom, he supported trade fairs, and built new roads.  This had the added benefit of centralizing power, and curtailed the influence of local nobles.  By the end of his reign, Louis XI was an absolute ruler, and was arguably the first modern King of France. " itemDesc="Louis XI of France" iconUrl="images/icon/hero/370.png" price="0"/>
  <itemEum id="hero.taskitem.371" name="Louis XIV" itemType="任务" dayLimit="0" userLimit="0" desc="Louis XIV, known as the Sun King, was King of France for 72 yrs, making his the longest documented reign of any European monarch. During this period France was the leading European Power, fighting in three major wars and two minor ones. " itemDesc="Louis XIV" iconUrl="images/icon/hero/371.png" price="0"/>
  <itemEum id="hero.taskitem.372" name="Louis XVI" itemType="任务" dayLimit="0" userLimit="0" desc="Louis XVI was ruler of France from 1774 until 1791. He was arrested and tried by the National Convention during the early stages of the French Revolution. He is the only French king to have been executed. He was blamed for many of the conditions that lead to the French Revolution but the situation may have been ultimately beyond his ability to control. " itemDesc="Louis XVI" iconUrl="images/icon/hero/372.png" price="0"/>
  <itemEum id="hero.taskitem.373" name="Louise of Savoy" itemType="任务" dayLimit="0" userLimit="0" desc="Louise had a keen interest in politics and diplomacy.  She ensured that her children were schooled in humanist teachings and that they would have every opportunity open to them.  She wisely moved her family to the court of King Louis XII where her son became a favourite of the King and subsequently married his daughter, securing his claim to the French throne, which he ascended in 1515 to become Francis I.  Louise was almost certainly the most influential woman in all of France at that time and without her keen political acumen Francis may not have become King of France. " itemDesc="Louise of Savoy" iconUrl="images/icon/hero/373.png" price="0"/>
  <itemEum id="hero.taskitem.376" name="Lucius Sergius Catilina" itemType="任务" dayLimit="0" userLimit="0" desc="Lucius Sergius Catilina (108BCE-62BCE) was a famous Roman politician best known for his involvement in the failed Catilinian Conspiracy.  He lived during a time of economic struggle and decline, and he attracted many of the poor to his cause.  He marched to battle with an army of 10,000 troops, mostly made up of impoverished war veterans and displaced farmers.  While his cause may have been noble, he eventually lost support of more than half of his army.  He died with great honor, refusing to surrender and instead hurled himself into the bloodiest of the fighting.   " itemDesc="Lucius Sergius Catilina" iconUrl="images/icon/hero/376.png" price="0"/>
  <itemEum id="hero.taskitem.377" name="Lucreza Borgia 1" itemType="任务" dayLimit="0" userLimit="0" desc="Lucreza is widely regarded as the most renown member of the powerful Italian Borgia family.  Her life is highlighted by her numerous marriages, deceit, affairs and corruption. " itemDesc="Lucreza Borgia 1" iconUrl="images/icon/hero/377.png" price="0"/>
  <itemEum id="hero.taskitem.378" name="Lucrezia Borgia 2" itemType="任务" dayLimit="0" userLimit="0" desc="Lucrezia was the illegitimate daughter of Pope Alexander VI and sister of Cesare Borgia. Used to gain prestige, power, and money by her father and brothers, Lucrezia was married three times to increasingly influential husbands. As Duchess of Ferrara, her court outshone those of royalty. Raising her seven children, charity, and patronage of the arts were her occupations. " itemDesc="Lucrezia Borgia 2" iconUrl="images/icon/hero/378.png" price="0"/>
  <itemEum id="hero.taskitem.379" name="Ludovico Sforza" itemType="任务" dayLimit="0" userLimit="0" desc="Hungry for power, Sforza became the Duke of Milan by seizing power from the rightful heir to the crown after the assassination of his brother Galeazzo.  Although his methods may be less than honorable, Sforza is a firm but able leader.  " itemDesc="Ludovico Sforza" iconUrl="images/icon/hero/379.png" price="0"/>
  <itemEum id="hero.taskitem.38" name="vlad tepes" itemType="任务" dayLimit="0" userLimit="0" desc="Wallachian (present-day southern Romania) voivode. Vlad the Impaler is known for the exceedingly cruel punishments he imposed as ruler of Wallachia.    " itemDesc="vlad tepes" iconUrl="images/icon/hero/38.png" price="0"/>
  <itemEum id="hero.taskitem.380" name="Luigi Pulci" itemType="任务" dayLimit="0" userLimit="0" desc="Although Pulci is primarily a poet with a wide body of influential work, he was a patron of the Medici family who used his oratory skills for diplomatic reasons. " itemDesc="Luigi Pulci" iconUrl="images/icon/hero/380.png" price="0"/>
  <itemEum id="hero.taskitem.381" name="Lupus Servatus" itemType="任务" dayLimit="0" userLimit="0" desc="Servatus was a Carolingian Benedictine abbot of Ferrieres.  Regarded by some as the first humanist of the Early Middle Ages for his love of learning and dedication to scholarly pursuits.  Not known for his military acumen, he was a reluctant officer in the army of Charles the Bald and was captured at the Battle of Toulouse.  His main literary contributions are found in the countless manuscripts he copied and preserved particularly a number of works by Cicero. " itemDesc="Lupus Servatus" iconUrl="images/icon/hero/381.png" price="0"/>
  <itemEum id="hero.taskitem.382" name="MacBeth" itemType="任务" dayLimit="0" userLimit="0" desc="MacBethad mac Findlaich, anglicized as Macbeth and nicknamed the Red King, was king of the Scots from 1040 until his death in 1057. He is best known from William Shakespeare's play, which is in fact historically inaccurate. He became king after killing King Duncan at the battle of Pitgaveny. MacBeth became indirectly involved in the strife in England by receiving a number of Norman exiles from England.  MacBeth was defeated and mortally wounded by the future King Malcolm II in 1057. " itemDesc="MacBeth" iconUrl="images/icon/hero/382.png" price="0"/>
  <itemEum id="hero.taskitem.384" name="Malcolm I of Scotland" itemType="任务" dayLimit="0" userLimit="0" desc="Known as Máel Coluim mac Domnaill (anglicised to Malcolm I) became king of Scots when his cousin abdicated to become a monk. Malcom was known to raid Moray, Northumbria as far south as the Tees, and battle various foreigners. " itemDesc="Malcolm I of Scotland" iconUrl="images/icon/hero/384.png" price="0"/>
  <itemEum id="hero.taskitem.385" name="Manius Curius Dentatus" itemType="任务" dayLimit="0" userLimit="0" desc="Manius Curius Dentatus (d. 270 B.C.) was a Roman general, conqueror of the Samnites and Pyrrhus, and king of Epirus.  He is said to have been called Dentatus because he was born with his teeth already grown. Dentatus was tribune of the plebs sometime between 298 and 291 B.C..  As consul in 290 B.C., in conjunction with his colleague P. Cornelius Rufinus, he gained a decisive victory over the Samnites, which put an end to the war that had lasted fifty years. " itemDesc="Manius Curius Dentatus" iconUrl="images/icon/hero/385.png" price="0"/>
  <itemEum id="hero.taskitem.387" name="Marcus Antonius" itemType="任务" dayLimit="0" userLimit="0" desc="Marc Antony (87BCE-6BCE) distinguished himself early in life while on the field of Roman battles as an adept cavalry commander, yet he is most famous for his skill with politics and intrigue.  Supporter of Julius Caesar, without him Caesar may never have become emperor.  A man of great skills but also of many weaknesses, he remained loyal to Caesar until the very end.  He addressed the public of Rome when Caesar was assassinated and incited the people to riot for justice.  A shrewd master in forming alliances, one of whom was the beautiful pharaoh of Egypt, Cleopatra VII. " itemDesc="Marcus Antonius" iconUrl="images/icon/hero/387.png" price="0"/>
  <itemEum id="hero.taskitem.388" name="Marcus Junious Brutus" itemType="任务" dayLimit="0" userLimit="0" desc="Marcus Junius Brutus (85 B.C. –  42 B.C.), often referred to simply as Brutus, was a politician of the late Roman Republic. He is best known in modern times for taking a leading role in the assassination conspiracy against Julius Caesar in an attempt to take control of the Republic. " itemDesc="Marcus Junious Brutus" iconUrl="images/icon/hero/388.png" price="0"/>
  <itemEum id="hero.taskitem.389" name="Marcus Porcius Cato" itemType="任务" dayLimit="0" userLimit="0" desc="Marcus Porcius Cato (234 B.C. –149 B.C.) was a Roman statesman, surnamed the Censor (Censorius), the Wise (Sapiens), the Ancient (Priscus), or the Elder (Maior), to distinguish him from Cato the Younger, his great-grandson.  He was born of an ancient Plebeian family who all were noted for military service but not for the discharge of the higher civil offices. He was bred, to agriculture, but, having attracted the notice of Lucius Valerius Flaccus, was brought to Rome, and successively held the offices of Cursus Honorum: Tribune, Quaestor, Aedile, Praetor, Consul, and finally Censor. " itemDesc="Marcus Porcius Cato" iconUrl="images/icon/hero/389.png" price="0"/>
  <itemEum id="hero.taskitem.39" name="Flavius Belisarius" itemType="任务" dayLimit="0" userLimit="0" desc="One of the greatest generals of theByzantine Empire. He was instrumental to Emperor Justinian It is ambitious project of reconquering much of the Western Roman Empire.           " itemDesc="Flavius Belisarius" iconUrl="images/icon/hero/39.png" price="0"/>
  <itemEum id="hero.taskitem.391" name="Margaret Beaufort" itemType="任务" dayLimit="0" userLimit="0" desc="A descendant of Plantagenet kings and John of Gaunt, Margaret was the daughter of John, Duke of Somerset, and married Edmund Tudor, Earl of Richmond. Her son was crowned Henry VII in 1485. Margaret spent the remaining 24 years of her life as a patroness of scholarship, the arts, and charity. " itemDesc="Margaret Beaufort" iconUrl="images/icon/hero/391.png" price="0"/>
  <itemEum id="hero.taskitem.392" name="Margaret Douglas" itemType="任务" dayLimit="0" userLimit="0" desc="Margaret Douglas, the Countess of Lennox, was a headstrong woman who had many strong royal ties and was a favourite of her uncle, Henry VIII.  She was sent to the Tower of London on two occasion for for having arranged marriages for both of her sons which were unpopular with Elizabeth I bu Elizabeth nevertheless gave her a lavish funeral at Westminster Abbey.  Her grandson, the fruit born of the marriages she had arranged, would become James VI of Scotland and James I of England cementing her legacy in English history. " itemDesc="Margaret Douglas" iconUrl="images/icon/hero/392.png" price="0"/>
  <itemEum id="hero.taskitem.393" name="Margaret of Anjou" itemType="任务" dayLimit="0" userLimit="0" desc="Queen Consort of Henry VI, she saw it as her mission to defend the interests of the crown, a lesson learned from her paternal grandmother, Yolande of Aragon, who governed that land.  Her alliances with the Earl of Suffolk and the Duke of Somerset made her unpopular, and when she failed to invite the Duke of York to a meeting of the king's closest advisors in 1455, the War of the Roses began.  After Henry was captured, she escaped with her son to Wales and Scotland, and attempted to raise an army to fight Edward IV.  Her final defeat came at the Battle of Tewksbury in 1471, where her son was killed.  Afterwards, she was taken prisoner until the French king ransomed her. " itemDesc="Margaret of Anjou" iconUrl="images/icon/hero/393.png" price="0"/>
  <itemEum id="hero.taskitem.394" name="Margaret Tudor" itemType="任务" dayLimit="0" userLimit="0" desc="Margaret Tudor was a secondary figure in British politics but had ties, through blood, to such influential figures as Elizabeth I, James VI and Henry VIII.  After the Scottish military disaster at Flodden in 1513 Margaret became Regent of Scotland but was quickly ousted by a pro-French coalition among the nobility.  She was eager to see reconciliation between Scotland and England, which took place when her great-grandson James VI became James I of England in 1603, but died more than half a century too soon to witness the occasion. " itemDesc="Margaret Tudor" iconUrl="images/icon/hero/394.png" price="0"/>
  <itemEum id="hero.taskitem.395" name="Marguerite of Navarre" itemType="任务" dayLimit="0" userLimit="0" desc="Sister to King Francis I of France, Marguerite was an influential princess who became a very generous patron of the arts.  She was a mediator between Catholics and Reformers, protecting many Protestants by dissuading her brother from enacting intolerant measures against them.  After her death in 1550 the Reformation began a swift descent into widespread intolerance and bloodshed leading many to remark that 'In Marguerite the Renaissance and the Reformation were for a moment one.' " itemDesc="Marguerite of Navarre" iconUrl="images/icon/hero/395.png" price="0"/>
  <itemEum id="hero.taskitem.396" name="Marquis de Lafayette" itemType="任务" dayLimit="0" userLimit="0" desc="Lafayette, a French aristocrat and military officer, was a general for the Continental Army during the Revolutionary War. He was chiefly responsible for securing a greater French commitment , which led to the defeat of British at Yorktown. " itemDesc="Marquis de Lafayette" iconUrl="images/icon/hero/396.png" price="0"/>
  <itemEum id="hero.taskitem.398" name="Mary I of Scotland" itemType="任务" dayLimit="0" userLimit="0" desc="Mary I became Queen of Scots when she was six days old after the death of her father.  Much of Mary's  reign was clouded by religious disputes based on her devout Catholicism in a land dominated by protestants. " itemDesc="Mary I of Scotland" iconUrl="images/icon/hero/398.png" price="0"/>
  <itemEum id="hero.taskitem.399" name="Matthew Stewart, 4th Earl of Lennox" itemType="任务" dayLimit="0" userLimit="0" desc="Father of Lord Darnley, Stewart played a pivotal and perhaps intentional role in ensuring that Mary I of Scotland fell in love with his son Lord Darnley, a relationship that would eventually lead to Mary's downfall. " itemDesc="Matthew Stewart, 4th Earl of Lennox" iconUrl="images/icon/hero/399.png" price="0"/>
  <itemEum id="hero.taskitem.40" name="Gaius Terentius Varro" itemType="任务" dayLimit="0" userLimit="0" desc="Roman consul and commander. He commanded at the Battle of Cannae against the Carthaginian general Hannibal, which was proved to be a decisive Roman defeat.         " itemDesc="Gaius Terentius Varro" iconUrl="images/icon/hero/40.png" price="0"/>
  <itemEum id="hero.taskitem.400" name="Matthias Corvinus of Hungary" itemType="任务" dayLimit="0" userLimit="0" desc="Matthias Corvinus was elected King of Hungary by the Diet of Barons in 1458, when the nation faced simultaneous challenges from Venice, Poland, the Holy Roman Empire, and the Ottomans.  His solution to this was to raise an army known as the Fekete sereg, or Black Army.  With 10,000 regular troops, and the ability to raise 20,000 more during wartime, Matthias Corvinus successfully fought wars on all fronts and greatly expanded the influence of Hungary.  His army is reputed to be the first European army undefeated in combat since Alexander the Great. " itemDesc="Matthias Corvinus of Hungary" iconUrl="images/icon/hero/400.png" price="0"/>
  <itemEum id="hero.taskitem.402" name="Mehmed II" itemType="任务" dayLimit="0" userLimit="0" desc="The conqueror of Constantinople, Mehmed II organized a 53 day siege of the city in the year 1493.  His armies quickly spread into the Balkans, eliminating the last remnants of the Byzantine Empire.  Having advanced his Western boundary, Mehmed II turned East, and his armies spread across Anatolia.  He attacked Italy in 1480, and for a time, it looked as if he would capture Rome, but he died in 1481 before the invasion was complete. " itemDesc="Mehmed II" iconUrl="images/icon/hero/402.png" price="0"/>
  <itemEum id="hero.taskitem.403" name="Meister Eckhart" itemType="任务" dayLimit="0" userLimit="0" desc="German?theologian,?philosopher?and?mystic.  " itemDesc="Meister Eckhart" iconUrl="images/icon/hero/403.png" price="0"/>
  <itemEum id="hero.taskitem.404" name="Mestwin I, Duke of Pomerania" itemType="任务" dayLimit="0" userLimit="0" desc="Mestwin I was a Duke of Pomerania between 1207-1220. Another one of his names was ?pacificus“, the peaceful. His ruled under the Danish hegemony over the southern coast of the Baltic Sea was first conquered by Valdemar II of Denmark.  " itemDesc="Mestwin I, Duke of Pomerania" iconUrl="images/icon/hero/404.png" price="0"/>
  <itemEum id="hero.taskitem.405" name="Mestwin II, Duke of Pomerania" itemType="任务" dayLimit="0" userLimit="0" desc="Mestwin II was a Duke of Pomerelia from 1266 until 1294. He united all the lands of Pomerelia and became the sole ruler of all of Pomerelia by kicking out all of his brothers from his lands. Mestwin concluded the Treaty of K?pno in 1282, which made Duke Przemys? II his successor in all his possessions. The resulting tensions between Brandenburg and Poland led to the Teutonic takeover of Danzig in 1308. " itemDesc="Mestwin II, Duke of Pomerania" iconUrl="images/icon/hero/405.png" price="0"/>
  <itemEum id="hero.taskitem.406" name="Michael Drayton" itemType="任务" dayLimit="0" userLimit="0" desc="A prolific poet and sonneteer, Michael Drayton (1563-1631) experimented with all fashionable styles of poetry--historical, religious, pastoral, patriotic, and lyric. Unlike his contemporary and greatest influence Edmund Spenser who was known for long allegories, Drayton's best works were his lyric sonnets. " itemDesc="Michael Drayton" iconUrl="images/icon/hero/406.png" price="0"/>
  <itemEum id="hero.taskitem.408" name="Michel de Ruyter" itemType="任务" dayLimit="0" userLimit="0" desc="Michel de Ruyter was the best admiral in Dutch history. He fought the English and French in the Anglo-Dutch wars and scored several major victories, with the most famous being the Raid on the Midway. " itemDesc="Michel de Ruyter" iconUrl="images/icon/hero/408.png" price="0"/>
  <itemEum id="hero.taskitem.409" name="Michelangelo" itemType="任务" dayLimit="0" userLimit="0" desc="Like Leonardo da Vinci, Michelangelo is the epitome of the Renaissance man.  He excelled in several disciplines including architecture, sculpting, painting, poetry and engineering. " itemDesc="Michelangelo" iconUrl="images/icon/hero/409.png" price="0"/>
  <itemEum id="hero.taskitem.41" name="Publius Cornelius Scipio" itemType="任务" dayLimit="0" userLimit="0" desc="General and statesman of the Roman Republic. Despite the military defeats, he still retained the confidence of the Roman people." itemDesc="Publius Cornelius Scipio" iconUrl="images/icon/hero/41.png" price="0"/>
  <itemEum id="hero.taskitem.410" name="Mithridates II" itemType="任务" dayLimit="0" userLimit="0" desc="Mithridates II (the Great), was the king of Parthia from c. 124 to 88 B.C..  Parthia reached its greatest extent during his reign.  He saved the kingdom from the Scythians, who had occupied Bactria and eastern Iran and killed his predecessor in battle.  He extended the limits of the empire by defeating King Artavasdes of Armenia, conquering seventy valleys.  He also interfered in the wars of the dynasts of Syria, and was the first Parthian king to enter into negotiations with Rome, then represented by Sulla.  His name invokes the protection of Mithra.  " itemDesc="Mithridates II" iconUrl="images/icon/hero/410.png" price="0"/>
  <itemEum id="hero.taskitem.411" name="Miyamoto Musashi" itemType="任务" dayLimit="0" userLimit="0" desc="Migamoto was a Japanese swordsman and Samurai. He is known for his many duels and distinctive style. He founded the technique known as Nitōichi, or 'two swords as one'. He authored the Book of Five Rings, a book of strategy that is still studied today. " itemDesc="Miyamoto Musashi" iconUrl="images/icon/hero/411.png" price="0"/>
  <itemEum id="hero.taskitem.412" name="Moliere" itemType="任务" dayLimit="0" userLimit="0" desc="John-Baptiste Poquelin, known by his stage name of Moliere was a French actor and Playwright. He was a master of comedy and considered one of the best in Western  literature. " itemDesc="Moliere" iconUrl="images/icon/hero/412.png" price="0"/>
  <itemEum id="hero.taskitem.413" name="Montcalm" itemType="任务" dayLimit="0" userLimit="0" desc="Louis Joseph de Montcalm was commander of France forces in North America during the French and Indian war or the Seven Years War. After great success in the war of Polish Succession and the war of Austrian Succession he was promoted to brigadier general. In New France he had major success until his defeat and death on the plains of Quebec. " itemDesc="Montcalm" iconUrl="images/icon/hero/413.png" price="0"/>
  <itemEum id="hero.taskitem.414" name="Montezuma I" itemType="任务" dayLimit="0" userLimit="0" desc="He came to power in 1440 following the death of his uncle.  He crafted the Triple Alliance between the Aztects, the Texcoco, and the Tlacopan.  With Nezahualcoyotl of Texcoco, Montezuma oversaw the construction of the fresh water aqueducts that supplied Tenochtitlan.  He also saw expansion of the Empire, leading a campaign against the Mixtecs, which greatly expanded his territory.  It is said that his name was actually Ilhuicamina, and it was changed posthumously to link him with the later Montezuma. " itemDesc="Montezuma I" iconUrl="images/icon/hero/414.png" price="0"/>
  <itemEum id="hero.taskitem.415" name="Muhammad ibn Saud" itemType="任务" dayLimit="0" userLimit="0" desc="Muhammad ibn Saud established the House of Saud among the tribes in the Arabian peninsula. In using religion as a basis he differentiated his House and quickly gathered support. With this he is considered the founder of the First Saudi State. His government is still the model for Saudi Arabia today. " itemDesc="Muhammad ibn Saud" iconUrl="images/icon/hero/415.png" price="0"/>
  <itemEum id="hero.taskitem.416" name="Muncimir of Croatia" itemType="任务" dayLimit="0" userLimit="0" desc="Muncimir was a knez of Dalmatian Croation from 892-910. He was the third son of Trpimir I and brother to Petar and Zdeslav. His reign restored the House of Trpimirovi? to power and took control of Littoral Croatia, ruling independently of both Pope and Byzantium. Prince Petar Gojnikovi? of the Serbian House of Vlastimirovi?, who lived in exile in Dalmatian Croatia returned to Rascia and seized power. Muncimir took the overthrown pretenders under his protection from Petar. Tomislav, the first king of Croatia, followed Muncimir's reign and was likely his son. " itemDesc="Muncimir of Croatia" iconUrl="images/icon/hero/416.png" price="0"/>
  <itemEum id="hero.taskitem.417" name="Murad II" itemType="任务" dayLimit="0" userLimit="0" desc="Murad II became Sultan of the Ottoman Empire in 1421.  His first challenge was that his brother, who was armed and supported by the Byzantines, was attempting to claim the throne.  They fought in battle, resulting in the death of the pretender.  Murad II then spent the majority of his reign at war with the Christian powers in the Balkans.  In the 1430s, he greatly expanded Turkish territory in Europe, annexing Serbia in 1439.  His last great victory came at the Second Battle of Kosovo in 1448.   " itemDesc="Murad II" iconUrl="images/icon/hero/417.png" price="0"/>
  <itemEum id="hero.taskitem.418" name="Myles Coverdale" itemType="任务" dayLimit="0" userLimit="0" desc="Ordained a priest in 1514, Englishman Myles Coverdale began leaning toward the Protestant teachings of William Tyndale. He published a first translation of the Bible in Zurich in 1535. Thomas Cromwell commissioned a translation known as the 'Great Bible' in 1539. Coverdale became Bishop of Exeter but fled England during the reign of Mary I and the resurgence of Roman Catholicism. A Puritan leader during the Age of Elizabeth, Coverdale also lent his scholarship to the Geneva Bible of 1560. " itemDesc="Myles Coverdale" iconUrl="images/icon/hero/418.png" price="0"/>
  <itemEum id="hero.taskitem.419" name="Nadar Shah" itemType="任务" dayLimit="0" userLimit="0" desc="Nadar Shah Afshar the Great was Shah of Iran and founder of the Afsharid dynasty. On basis of his military prowess, some have described him as the Napoleon of Persia or the Second Alexander. " itemDesc="Nadar Shah" iconUrl="images/icon/hero/419.png" price="0"/>
  <itemEum id="hero.taskitem.42" name="Lucius Cornelius Sulla" itemType="任务" dayLimit="0" userLimit="0" desc="Roman general andpolitician, holding the office of consul twice as well as the dictatorship." itemDesc="Lucius Cornelius Sulla" iconUrl="images/icon/hero/42.png" price="0"/>
  <itemEum id="hero.taskitem.420" name="Napoleon Bonaparte" itemType="任务" dayLimit="0" userLimit="0" desc="Napoleon Bonaparte, later known as Napoleon I, was the political and military leader of France. In 1799 he staged a coup d'état to gain control of France. The Napoleonic Wars involved every major power of Europe. He made France the dominant power of his time. His campaigns are still studied in military circles today. " itemDesc="Napoleon Bonaparte" iconUrl="images/icon/hero/420.png" price="0"/>
  <itemEum id="hero.taskitem.421" name="Nennius" itemType="任务" dayLimit="0" userLimit="0" desc="Nennius was a Welsh monk who main claim to fame is as the author of the Historia Brittonum. He lived in rural isolation in the mountains outside the Anglo-Saxon kingdoms in Wales, though he is rumored to have escaped the massacre of Welsh monks by Ethelfrid by fleeing to Scotland. He was a student of the bishop Elfodd, Elvodugus, who championed the adoption of Continental dating for Easter by the British ecclesiastics. The historical basis of many famous legends are recorded in the Historia Brittonum as well as the historical beginnings of the Picts, Scots, St. Germanus and Vortigern. " itemDesc="Nennius" iconUrl="images/icon/hero/421.png" price="0"/>
  <itemEum id="hero.taskitem.422" name="Niccolo de Conti" itemType="任务" dayLimit="0" userLimit="0" desc="Niccolo de Conti was a Venetian merchant who travelled across Asia in the early 1400s.  The first Italian to return from China since Marco Polo, he travelled through Iran, India, and the areas occupied by modern day Myanmar and Vietnam on his way to China.  He described his travels in the book, Les Voyage aux Indes upon his return to Europe in 1444.  Information from his travels affected the Fra Mauro map that was produced later that century, and a copy of his book was carried by Antonio Pigafetta, part of Magellan's crew for his trip around the world. " itemDesc="Niccolo de Conti" iconUrl="images/icon/hero/422.png" price="0"/>
  <itemEum id="hero.taskitem.423" name="Nicholas the Great" itemType="任务" dayLimit="0" userLimit="0" desc="Pope Nicholas I, also known as Nicholas the great and is a saint in the Catholic church.   He is credited with consolidating papal authority and power and influencing the power of the papacy among the nations of Western Europe.  " itemDesc="Nicholas the Great" iconUrl="images/icon/hero/423.png" price="0"/>
  <itemEum id="hero.taskitem.424" name="Nicolaus Copernicus" itemType="任务" dayLimit="0" userLimit="0" desc="Copernicus was a?mathematician,?astronomer,?physician,?classical scholar,?translator,artist,?Catholic cleric,?jurist,?governor,?military leader,?diplomat?and?economist. Among his many responsibilities, astronomy figured as little more than an?avocation?— yet it was in that field that he made his mark upon the world. " itemDesc="Nicolaus Copernicus" iconUrl="images/icon/hero/424.png" price="0"/>
  <itemEum id="hero.taskitem.426" name="Ogier the Dane" itemType="任务" dayLimit="0" userLimit="0" desc="Wielding his fabled sword Curtana, Ogier makes quick work of his enemies and leads his men to the same feats. " itemDesc="Ogier the Dane" iconUrl="images/icon/hero/426.png" price="0"/>
  <itemEum id="hero.taskitem.427" name="Olaudah Equiano" itemType="任务" dayLimit="0" userLimit="0" desc="Olaudah Equiano, also known as Gustavas Vassa, is considered very influential in the British movement to end the slave trade. His autobiography helped bring about the Slave Trade Act which stopped the slave trade in Britain " itemDesc="Olaudah Equiano" iconUrl="images/icon/hero/427.png" price="0"/>
  <itemEum id="hero.taskitem.428" name="Olga Prekrasa of Kiev" itemType="任务" dayLimit="0" userLimit="0" desc="Olga Prekrasa of Kiev, also called Olga the beautiful, became the ruler of Kievian Rus after her husband Igor of Kiev. She established what may be considered Eastern Europe's first legal reform when she changed the system of tribute gathering following her husband's tragic death while collecting from the Drevlians. She avenged her husband's death viciously through slaughter and torture such as scalding captives to death or sending them on burial ships while still alive. In one hostile town she collected all homing birds from the townsfolk and tied burning papers to their legs before releasing them to fly back home razing the town. Ironically, she was the first Rus leader to convert to Christianity and was one of the first Rus to be declared a saint. " itemDesc="Olga Prekrasa of Kiev" iconUrl="images/icon/hero/428.png" price="0"/>
  <itemEum id="hero.taskitem.429" name="Oliver Cromwell" itemType="任务" dayLimit="0" userLimit="0" desc="A key figure in the English Civil War (1642-1649), Cromwell rose to leadership of the Parliamentarians (Roundheads). Also a brilliant general and military tactician, he organized the cavalry and the New Model Army. Resounding victories at Naseby and Preston won the war over the Royalists (Cavaliers). Cromwell ousted royal sympathizers from Parliament and signed the warrant for the execution of King Charles I. For the new Commonwealth of England, he repressed opposition in England, Scotland, and Ireland. In 1653, he dismissed Parliament becoming Lord Protector of the Commonwealth. Cromwell's Protectorate was a military regime that he spent the rest of his life trying to legitimize constitutionally.  " itemDesc="Oliver Cromwell" iconUrl="images/icon/hero/429.png" price="0"/>
  <itemEum id="hero.taskitem.43" name="Marcus Vipsanius Agrippa" itemType="任务" dayLimit="0" userLimit="0" desc="Roman statesman and general, He was responsible for most of Octavian" itemDesc="Marcus Vipsanius Agrippa" iconUrl="images/icon/hero/43.png" price="0"/>
  <itemEum id="hero.taskitem.431" name="Origen" itemType="任务" dayLimit="0" userLimit="0" desc="An?early Christian?scholar,?theologian, and one of the most distinguished of the early?fathers?of the?Christian Church.? " itemDesc="Origen" iconUrl="images/icon/hero/431.png" price="0"/>
  <itemEum id="hero.taskitem.432" name="Otto I" itemType="任务" dayLimit="0" userLimit="0" desc="In 936 Otto I became King of the Germans and was the first emperor since Charlemagne to unite the majority of what would eventually become the Holy Roman Empire.  Using the unifying power of the Church and the rich resources of Saxony to support his hegemony he would routinely have to deal with rebellious princes and dukes who wished to challenge or usurp his throne.  Otto was careful to appoint family members and trusted allies to important positions in his realm thereby strengthening his position.  By the end of his reign in 973 Otto controlled an enormous portion of Europe, which comprised much of the modern Netherlands, Germany, Switzerland, Italy and Hungary. " itemDesc="Otto I" iconUrl="images/icon/hero/432.png" price="0"/>
  <itemEum id="hero.taskitem.433" name="Otto von Kerpen" itemType="任务" dayLimit="0" userLimit="0" desc="Otto von Kerpen was the second Grand Master of the Teutonic Knights, from 1200 to 1208. He came from a poor Rhenish knightly family. While Grand Master, he worked hard to make the Teutonic Knights independent from the older military orders of the Knights Templars and the Knights Hospitaller. He died in 1208 and was buried in Acre. " itemDesc="Otto von Kerpen" iconUrl="images/icon/hero/433.png" price="0"/>
  <itemEum id="hero.taskitem.434" name="Ovid" itemType="任务" dayLimit="0" userLimit="0" desc="Known as?Ovid?in the?English-speaking world, was a?Roman?poet who wrote about love, seduction, and?mythological?transformation. " itemDesc="Ovid" iconUrl="images/icon/hero/434.png" price="0"/>
  <itemEum id="hero.taskitem.435" name="Pachacuti" itemType="任务" dayLimit="0" userLimit="0" desc="The Ninth Sapa Inca, aka 'the Napoleon of the Andes'  Pachacuti began the expansion of the Inca that stretched the Empire across most of western South America.   In addition to conquering much land, he also structured the government, dividing the empire into four large territories.  To prevent any official from exerting too much influence, he created a separate bureaucracy for government administration, military command, and the priesthood.   " itemDesc="Pachacuti" iconUrl="images/icon/hero/435.png" price="0"/>
  <itemEum id="hero.taskitem.436" name="Paolo Uccello" itemType="任务" dayLimit="0" userLimit="0" desc="Both an accomplished mathematician and artist, Uccello used his mathematical abilities to reinforce the visual perspectives represented in his work. " itemDesc="Paolo Uccello" iconUrl="images/icon/hero/436.png" price="0"/>
  <itemEum id="hero.taskitem.438" name="Paul Revere" itemType="任务" dayLimit="0" userLimit="0" desc="Paul Revere was an American patriot best remembered for his midnight ride to warn of the British before the battles of Lexington and Concord. Later he served as an officer in the Revolutionary War. " itemDesc="Paul Revere" iconUrl="images/icon/hero/438.png" price="0"/>
  <itemEum id="hero.taskitem.439" name="Paulina Busa" itemType="任务" dayLimit="0" userLimit="0" desc="Paulina Busa was an Apulian woman of Canasoa who was known for her generosity and endless effort to provide aid to fugitive Italian soldiers escaping Hannibals wrath in the countryside of southern Italy.  As the soldiers were destitute, she took them into her home and provided clothing, weapons and money from her own resources.  She obtained medical supplies and doctor's and helped care for the wounded. " itemDesc="Paulina Busa" iconUrl="images/icon/hero/439.png" price="0"/>
  <itemEum id="hero.taskitem.44" name="Publius Cornelius Lentulus Sura" itemType="任务" dayLimit="0" userLimit="0" desc="Roman consul, he was the chief figure in the Catiline conspiracy.   " itemDesc="Publius Cornelius Lentulus Sura" iconUrl="images/icon/hero/44.png" price="0"/>
  <itemEum id="hero.taskitem.440" name="Pepin the Short" itemType="任务" dayLimit="0" userLimit="0" desc="Son of Charles Martel, Pepin the Short followed in his fathers influential footsteps but chose to focus on politics in lieu of warfare and has served in the capacities of Mayor, Duke and King of the Franks. " itemDesc="Pepin the Short" iconUrl="images/icon/hero/440.png" price="0"/>
  <itemEum id="hero.taskitem.442" name="Peter the Great" itemType="任务" dayLimit="0" userLimit="0" desc="Peter I was also known as Peter the Great. He ruled Russia until 1725 and attempted to modernize, strengthen and reform Russia to a great degree. He won several military victories in the Great Northern War and many regard him as Russia's greatest leader. " itemDesc="Peter the Great" iconUrl="images/icon/hero/442.png" price="0"/>
  <itemEum id="hero.taskitem.445" name="Petronilla of Aquitaine" itemType="任务" dayLimit="0" userLimit="0" desc="Petronilla has spent most of her life as a member of the French court.  At a young age she was excommunicated by the Pope for comitting adultry with and eventually marrying a married man but the excommunication was eventually lifted because of her strong political standing. " itemDesc="Petronilla of Aquitaine" iconUrl="images/icon/hero/445.png" price="0"/>
  <itemEum id="hero.taskitem.446" name="Philaenis of Samos" itemType="任务" dayLimit="0" userLimit="0" desc="Philaenis of Samos was apparently a Greek courtesan of the 4th or 3rd centuries B.C. who was believed to have authored a notorious manual on courtship and sex, circulated widely in the ancient world. The poet Aeschrion of Samos denied she authored the notorious work.  The manual treated the art of love systematically, including descriptions of sexual positions, aphrodisiacs, abortifacients, and cosmetics. The style is simple and the treatment summary and matter of fact.   It is one of the few technical works believed to have been written by a woman.  " itemDesc="Philaenis of Samos" iconUrl="images/icon/hero/446.png" price="0"/>
  <itemEum id="hero.taskitem.447" name="Philip V" itemType="任务" dayLimit="0" userLimit="0" desc="Philip V was king of Spain for 45 yrs and is the longest serving regent in Spain's history. He was the first Bourbon King of Spain. " itemDesc="Philip V" iconUrl="images/icon/hero/447.png" price="0"/>
  <itemEum id="hero.taskitem.448" name="Philippe de Commines" itemType="任务" dayLimit="0" userLimit="0" desc="A historian and son of a noble military commander, de Commines was raised in the Burgundian Court. In 1472, he fled his father's debts, went to France, and joined the military operations of Louis XI  and, later, Charles VIII but was accused of plotting against Charles. He regained royal favor and joined the king's invasion of Italy in 1494. In his retirement, he wrote eight books on the two kings he served before his death in 1511. " itemDesc="Philippe de Commines" iconUrl="images/icon/hero/448.png" price="0"/>
  <itemEum id="hero.taskitem.449" name="Philochorus" itemType="任务" dayLimit="0" userLimit="0" desc="Philochorus was a third century B.C. Greek historian, seer and interpreter of signs, and a man of considerable influence. He wrote extensively on Greek religious customs and was the best known of the many chroniclers of events in Athens and surrounding Attica.  He wrote a 17-volume history of the region from mythological times to 260 B.C., known as Atthis.   Known for his anti-Macedonian politics, in 250 B.C. Philochorus was murdered by political enemies. " itemDesc="Philochorus" iconUrl="images/icon/hero/449.png" price="0"/>
  <itemEum id="hero.taskitem.45" name="Marcus Tullius Cicero" itemType="任务" dayLimit="0" userLimit="0" desc="Roman philosopher, statesman, lawyer, political theorist, and Roman constitutionalist. Cicero is widely considered one of Rome is greatest orators and prose stylists.           " itemDesc="Marcus Tullius Cicero" iconUrl="images/icon/hero/45.png" price="0"/>
  <itemEum id="hero.taskitem.450" name="Photios I of Constantinople" itemType="任务" dayLimit="0" userLimit="0" desc="Photios I was a noted intellectual of his time and was considered the most influential Patriarch of Constantinople since John Chrysostom. He was a key character in the conversion of the Slavs to Christianity and is recognized as a saint by the Eastern Orthodox churches for his staunch support of the independence of the Eastern churches. As a scholar and champion of the great schism, he is one of the most famous figures of the ninth-century and of the entire history of the Byzantine Empire. " itemDesc="Photios I of Constantinople" iconUrl="images/icon/hero/450.png" price="0"/>
  <itemEum id="hero.taskitem.451" name="Pierre Terrail LeVieux Seigneur de Bayard" itemType="任务" dayLimit="0" userLimit="0" desc="Pierre Terrail LeVieux, Seigneur de (Lord of) Bayard was a French knight also known as Chevalier de Bayard celebrated for his heroism. He was part of the invasion forces French kings Charles VIII and Louis XII led into Italy. His greatest renown came during the defence of Mézières in 1521, which stopped the Holy Roman Empire under Charles V from conquering France. Troubadours and chroniclers called Bayard the greatest knight of their time.  " itemDesc="Pierre Terrail LeVieux Seigneur de Bayard" iconUrl="images/icon/hero/451.png" price="0"/>
  <itemEum id="hero.taskitem.452" name="Plato" itemType="任务" dayLimit="0" userLimit="0" desc="Plato lived from about 427-347 B.C..  He was one of the most famous, respected, and influential philosophers of all time. He is known as the father of idealism in philosophy and his ideas were considered elitist, with the philosopher king the ideal ruler.  Disillusioned by what he saw of Athenian politics in his youth, and heavily influenced by Socrates, Plato determined a change in the education of would-be statesmen was desperately needed.  He founded a school for the education of future leaders and named it the Academy, after the park in which it was located. After his death, the Academy continued to function for centuries, albeit under different guises. " itemDesc="Plato" iconUrl="images/icon/hero/452.png" price="0"/>
  <itemEum id="hero.taskitem.453" name="Pliny the Younger" itemType="任务" dayLimit="0" userLimit="0" desc="Lawyer,?author, and?natural philosopher?of?Ancient Rome. " itemDesc="Pliny the Younger" iconUrl="images/icon/hero/453.png" price="0"/>
  <itemEum id="hero.taskitem.455" name="Pope Urban II" itemType="任务" dayLimit="0" userLimit="0" desc="Otto de Lagery became Pope Urban II and was pope from 1088 to 1099. He laid the foundations for the papal monarchy, and he proclaimed the First Crusade on November 27, 1095. By mobilizing Europe's  chivalry to his cause he displaced the German emperor as leader of Europe.  " itemDesc="Pope Urban II" iconUrl="images/icon/hero/455.png" price="0"/>
  <itemEum id="hero.taskitem.456" name="Poppo von Osterna" itemType="任务" dayLimit="0" userLimit="0" desc="Poppo von Osterna was the ninth Grand Master of the Teutonic Knights, holding the position from 1252-56 or 1257. He was one of the first friars to settle in Prussia. He fought in the Battle of Legnica. In 1242 Poppo traveled to Austria with a German delegation to seek money for war with Duke ?wi?tope?k II of Pomerania. After being elected Grand Master, Poppo went to Prussia to start a war against the Sudovians and started the  crusades in Sambia in 1254 and 1255. " itemDesc="Poppo von Osterna" iconUrl="images/icon/hero/456.png" price="0"/>
  <itemEum id="hero.taskitem.457" name="Ptolemy Keraunos" itemType="任务" dayLimit="0" userLimit="0" desc="Ptolemy Keraunos  was king of Macedon (281 B.C. - 279 B.C.) and the oldest legitimate son of Ptolemy I, ruler of Egypt.  He did not inherit the throne, but by the time he died he had fought and murdered his way to the throne of Macedonia.  While soliciting aid in the court of Seleucus, he defeated Lysimachus, the king of Thrace in the battle of Corupedium in 281 B. C. against Seleucus.  After the death of Lysimachus and seizing the throne, he murdered Seleucus I Nicator.  Ptolemy asked his own half-sister Arsinoe II, the widow of Lysimachus, to marry him in order to secure his throne. After the ceremony he killed Arsinoe's two younger sons.  Ptolemy Keraunos was later killed in the wars against the Gauls of Bolgius and Brennus, who were migrating to what became known as Galatia. " itemDesc="Ptolemy Keraunos" iconUrl="images/icon/hero/457.png" price="0"/>
  <itemEum id="hero.taskitem.46" name="Silvius Brabo" itemType="任务" dayLimit="0" userLimit="0" desc="Mythical Roman soldier who is said to have killed a giant Druon Antigoon.       " itemDesc="Silvius Brabo" iconUrl="images/icon/hero/46.png" price="0"/>
  <itemEum id="hero.taskitem.460" name="Qianlong Emperor" itemType="任务" dayLimit="0" userLimit="0" desc="The Qianlong Emperor was the Fourth Qing emperor in China. He was the longest reigning emperor in Chinese history. He was a very successful military leader. He oversaw a large expansion in territory encompassing millions of square miles. " itemDesc="Qianlong Emperor" iconUrl="images/icon/hero/460.png" price="0"/>
  <itemEum id="hero.taskitem.461" name="Queen Anne" itemType="任务" dayLimit="0" userLimit="0" desc="Anne became Queen of England, Scotland and Ireland in 1702. In May of 1707 under the Acts of Union the Kingdom of Great Britain was created. Anne became the first sovereign of this future empire. Her reign marked the decrease in influence of the crown and increased the power of the ministers. The Age of Anne was one of artistic, literary and scientific advancement. " itemDesc="Queen Anne" iconUrl="images/icon/hero/461.png" price="0"/>
  <itemEum id="hero.taskitem.462" name="Quintus Fabius Pictor" itemType="任务" dayLimit="0" userLimit="0" desc="Quintus Fabius Pictor who is known as the 'father of Roman history,' was born about 254 B.C. He was the grandson of Gaius Fabius, who received the surname Pictor for his painting of the temple of Salus (302).  Quintus took an active part in the subjugation of the Gauls in the north of Italy (225), and after the battle of Cannae (216) was employed by the Romans to proceed to Delphi in order to consult the oracle of Apollo.  He was the earliest prose writer of Roman history.  His work begins with the arrival of Aeneas in Italy, and ends with the Hannibalic war. " itemDesc="Quintus Fabius Pictor" iconUrl="images/icon/hero/462.png" price="0"/>
  <itemEum id="hero.taskitem.463" name="Quintus Fulvius Flaccus" itemType="任务" dayLimit="0" userLimit="0" desc="Quintus Fulvius Flaccus, was Roman consul of the Roman Republic four times (237, 224, 212, 209 B.C.), censor in 231 B.C., pontifex maximus (high priest) in 216 B.C., and urban praetor in 215 B.C..  In the Second Punic War he defeated the Carthaginians near Beneventum, captured Capua, and overcame Hannibal's garrisons in Lucania and Bruttium.  Flaccus was known for his severity towards the disloyal citizens of Capua, of whom he had the senior men executed and the rest of the citizenry condemned to slavery for their disloyalty to Rome. " itemDesc="Quintus Fulvius Flaccus" iconUrl="images/icon/hero/463.png" price="0"/>
  <itemEum id="hero.taskitem.464" name="Quintus Servilius Caepio the Younger" itemType="任务" dayLimit="0" userLimit="0" desc="Quintus Servilius Caepio the Younger was a Roman soldier and statesman. He was elected praetor in 91 B.C., and fought for Rome during the Marsic Wars of the Italian Rebellion against Rome. Caepio was made a Legate in the Roman Army, and was captured and executed by the Italians after being tricked into leaving a secure position. " itemDesc="Quintus Servilius Caepio the Younger" iconUrl="images/icon/hero/464.png" price="0"/>
  <itemEum id="hero.taskitem.465" name="Raimondo Montecuccoli" itemType="任务" dayLimit="0" userLimit="0" desc="Raimondo Maontecuccoli was an Italian general who fought for the Austrians. He started as a private under his uncle, eventually obtaining the rank of Field Marshall. He won the Order of the Golden Fleece with his rout of the Turks at St. Gotthard Abbey. This led to a twenty year truce. " itemDesc="Raimondo Montecuccoli" iconUrl="images/icon/hero/465.png" price="0"/>
  <itemEum id="hero.taskitem.466" name="Raja Raja Cholal" itemType="任务" dayLimit="0" userLimit="0" desc="Raja Raja Cholal was a great emperor of the Tamil Chola Empire in India. He conquered southern India as far as Sri Lanka and Kalinga to the North. He divided the country into districts to help the administration and built the Brihadisvara Temple and enabled wealth distribution. " itemDesc="Raja Raja Cholal" iconUrl="images/icon/hero/466.png" price="0"/>
  <itemEum id="hero.taskitem.467" name="Ralpacan" itemType="任务" dayLimit="0" userLimit="0" desc="Ralpacan was the 41st King of Tibet. He's considered one of three 'Dharma' Kings and is responsible for bringing Budhism to Tibet. Under his rule the Tibetan Empire reached its greatest extent including parts of Nepal, India, China, and other lands. He promoted the development of Tibetan literature and culture, standardized weights and measures, and built the magnificent multi-functional nine-storied temple of U-shang-rdo used for political, academic, and religious purposes. " itemDesc="Ralpacan" iconUrl="images/icon/hero/467.png" price="0"/>
  <itemEum id="hero.taskitem.469" name="Rene Descartes" itemType="任务" dayLimit="0" userLimit="0" desc="Descartes played an important role in the Scientific Revolution and his works span several disciplines including science, philosophy and math.  He is considered to be the father of modern Philosophy. " itemDesc="Rene Descartes" iconUrl="images/icon/hero/469.png" price="0"/>
  <itemEum id="hero.taskitem.47" name="Appianus" itemType="任务" dayLimit="0" userLimit="0" desc="Roman historian who flourished during the reigns of Trajan, Hadrian and Antoninus Pius.     " itemDesc="Appianus" iconUrl="images/icon/hero/47.png" price="0"/>
  <itemEum id="hero.taskitem.470" name="Richard III of England" itemType="任务" dayLimit="0" userLimit="0" desc="The last King of the House of York, Richard III seized power after the death of his brother, Edward IV.  He had Edward's two sons, Edward V and Richard, placed in the Tower of London to keep them safe, and they were never seen again.  His reign lasted only two years, ending with his death at the Battle of Bosworth field, making him the second and last English king to die in battle.  Richard is more favorably remembered in the northern parts of England.  Previous to his ascension, he had done much to improve the living conditions of the commoners as Governor of the North. " itemDesc="Richard III of England" iconUrl="images/icon/hero/470.png" price="0"/>
  <itemEum id="hero.taskitem.471" name="Richard Neville, Earl of Warwi" itemType="任务" dayLimit="0" userLimit="0" desc="Called 'the Kingmaker' for his role in bringing Edward IV to power and then in briefly restoring Henry VI, Richard Neville was a key figure in the War of the Roses.  When war broke out between the Lancasters and Yorks, Richard Neville found both sides seeking his support.  Initially, he supported Edward of York, who became Edward IV with his help, and he escorted Henry VI into captivity.  Later, after falling out of favor with Edward IV because of disagreements about the king's marriage, he allied with the Lancasters.  He assisted Margaret of Anjou in restoring Henry VI to power briefly.  When Edward IV returned from France with an army to reclaim his throne, Richard Neville would meet his end at the Battle of Barnet. " itemDesc="Richard Neville, Earl of Warwi" iconUrl="images/icon/hero/471.png" price="0"/>
  <itemEum id="hero.taskitem.472" name="Richard Plantagenet, 3rd Duke of York" itemType="任务" dayLimit="0" userLimit="0" desc="An orphan who inherited the Duchy of York from his paternal uncle and the Earldom of March from his maternal Uncle, Richard Plantagenet was the wealthiest noble in 15th century England.  This wealth and power might be why he spent 10 years appointed as Lieutenant of France, and later Lieutenant of Ireland.  When he returned to England, he was appointed Protector of the Realm during the periods of madness suffered by King Henry VI.  At this time, he claimed that his lineage through Edward II gave his house the right to rule.  In 1460, an accord was signed making Richard the heir to King Henry VI.  Just weeks later, he was killed by an ambush of troops loyal to the House of Lancaster. " itemDesc="Richard Plantagenet, 3rd Duke of York" iconUrl="images/icon/hero/472.png" price="0"/>
  <itemEum id="hero.taskitem.473" name="Richard the Lionheart" itemType="任务" dayLimit="0" userLimit="0" desc="Richard's extensive military experience began at the age of sixteen when he led campaigns against his father for the English throne, which included a large portion of Europe at the time.  After fifteen years he succeeded and became one of the most noteworthy warriors and leaders in English history, having led numerous campains in the Crusades and internally within his own kingdom. " itemDesc="Richard the Lionheart" iconUrl="images/icon/hero/473.png" price="0"/>
  <itemEum id="hero.taskitem.474" name="Robert Blake" itemType="任务" dayLimit="0" userLimit="0" desc="English Admiral Robert Blake was a member of Parliament who supported the Roundheads of Oliver Cromwell in the English Civil War against King Charles I and the Royalists. He won naval battles (1649-1657) against the Royalists, the Dutch, and the Spanish. Blake made lasting impacts on the administration of the Royal Navy. These included building an extensive fleet of large, heavily armed ships, developing professionalism among sailors, and writing instructions for naval warfare.   " itemDesc="Robert Blake" iconUrl="images/icon/hero/474.png" price="0"/>
  <itemEum id="hero.taskitem.475" name="Robert Browne" itemType="任务" dayLimit="0" userLimit="0" desc="A  religious nonconformist, Browne's followers were the first sect to separate from the Anglican Church following the Reformation. The Brownists wanted immediate changes to the Anglican doctrine and urged others to leave the church in protest. Browne reconciled himself to the Anglican Church in 1591, but his ideals of church government were championed later by the Congregationalists. " itemDesc="Robert Browne" iconUrl="images/icon/hero/475.png" price="0"/>
  <itemEum id="hero.taskitem.476" name="Robert Cecil" itemType="任务" dayLimit="0" userLimit="0" desc="Robert Cecil succeeded his father as chief minister to Elizabeth I when William Cecil died in 1598. Responsible for the smooth succession in 1603 of Scottish King James VI to the English throne as James I, the new king named Cecil Viscount Cranborne and Earl of Salisbury. Made Lord Treasurer in 1608, Cecil reduced huge crown debts with customs duties and greater revenues from crown lands. When Parliament refused to ratify some of Cecil's reforms, the sale of titles and other unscrupulous fund-raising methods played into the hands of George Villiers, Duke of Buckingham. " itemDesc="Robert Cecil" iconUrl="images/icon/hero/476.png" price="0"/>
  <itemEum id="hero.taskitem.477" name="Robert Devereux, 2nd Earl of Essex" itemType="任务" dayLimit="0" userLimit="0" desc="A favorite of Elizabeth I, Devereux served in the army during the Dutch Revolt of 1586, the Lisbon Expedition, the French Wars of Religion, and the capture of Cadiz in 1596. Devereux thought William Cecil and his faction advised  the Queen badly, and a rivalry grew. Elizabeth dispatched Devereux to Ireland to serve as Lord Lieutenant and to put down Tyrone's rebellion. He failed and was stripped of office. Devereux attempted a coup against Cecil in 1601 and was tried for treason and executed. " itemDesc="Robert Devereux, 2nd Earl of Essex" iconUrl="images/icon/hero/477.png" price="0"/>
  <itemEum id="hero.taskitem.478" name="Robert Dudley, 1st Earl of Leicester" itemType="任务" dayLimit="0" userLimit="0" desc="Robert Dudley was a close friend of Queen Elizabeth I and after his wife died in a sudden accident rumours of devious plot began to circulate almost immediately.  Despite the coroner's jury's ruling that her death was indeed accidental Dudley's reputation was destroyed and his fall from grace in the Royal court was swift. " itemDesc="Robert Dudley, 1st Earl of Leicester" iconUrl="images/icon/hero/478.png" price="0"/>
  <itemEum id="hero.taskitem.479" name="Robin Hood" itemType="任务" dayLimit="0" userLimit="0" desc="A commoner from humble beginings, Robin Hood rose to fame as a man willing to stand up to the greed and corruption of the ruling classes.  Although the law considers him a thief, he only victimized the wealthy and priveliged and his loot would be distributed to poor peasants in his community.  He possesses legendary skill as with a bow and military planning, especially ambushes. " itemDesc="Robin Hood" iconUrl="images/icon/hero/479.png" price="0"/>
  <itemEum id="hero.taskitem.48" name="Plutarchus" itemType="任务" dayLimit="0" userLimit="0" desc="Greek historian, biographer, essayist, and Middle Platonist known primarily for his Parallel Lives and Moralia.     " itemDesc="Plutarchus" iconUrl="images/icon/hero/48.png" price="0"/>
  <itemEum id="hero.taskitem.480" name="Rodrigo Borgia" itemType="任务" dayLimit="0" userLimit="0" desc="Educated and groomed for the position, Borgia was elected Pope and renamed Pope Alexander VI.  During his papacy he was a controversial and despicable character whom kept mistresses, practiced nepotism in his appointments of officials and squandered the Vatican's treasury on his family and friends. " itemDesc="Rodrigo Borgia" iconUrl="images/icon/hero/480.png" price="0"/>
  <itemEum id="hero.taskitem.481" name="Roger Ascham" itemType="任务" dayLimit="0" userLimit="0" desc="English scholar Roger Ascham taught Greek at Cambridge University, tutored the future Queen Elizabeth I, served both Mary I and Elizabeth I as a diplomat, and wrote a treatise on archery in 1545. His lasting influence was as an advocate of 'New Learning', which proposed teaching new subjects like English language as well as the classics at universities.  " itemDesc="Roger Ascham" iconUrl="images/icon/hero/481.png" price="0"/>
  <itemEum id="hero.taskitem.482" name="Roger Bacon 1" itemType="任务" dayLimit="0" userLimit="0" desc="English?philosopherand?Franciscan?friar who placed considerable emphasis on?empiricism. He is sometimes credited as one of the earliest?Europeanadvocates of the modern?scientific method. " itemDesc="Roger Bacon 1" iconUrl="images/icon/hero/482.png" price="0"/>
  <itemEum id="hero.taskitem.483" name="Roger Bacon 2" itemType="任务" dayLimit="0" userLimit="0" desc="One of the greatest early thinkers in Western Civilization, Bacon helped revolutionize the was science was conducted by promoting the widespread use of the scientific method and the philosophical field of empiricism. " itemDesc="Roger Bacon 2" iconUrl="images/icon/hero/483.png" price="0"/>
  <itemEum id="hero.taskitem.485" name="Rorik of Dorestad" itemType="任务" dayLimit="0" userLimit="0" desc="A ferocious Viking warrior, Rorik has spent over thirty years at war.  Most of his campaigns took place in Friesland where he ruled over several different areas off and on including Dorestad and Utrecht. " itemDesc="Rorik of Dorestad" iconUrl="images/icon/hero/485.png" price="0"/>
  <itemEum id="hero.taskitem.486" name="Rubens" itemType="任务" dayLimit="0" userLimit="0" desc="Sir Peter Paul Rubens was a Flemish painter in the Baroque style of Painting. He is well known for his Counter-Reformation altarpieces and his many works depicting mythological and allegorical subjects.  His fondness for full figure women lead to the term rubenesque to describe them. He was knighted by Philip IV and Charles I. " itemDesc="Rubens" iconUrl="images/icon/hero/486.png" price="0"/>
  <itemEum id="hero.taskitem.487" name="Rudolph of France" itemType="任务" dayLimit="0" userLimit="0" desc="Rudolph became the Duke of Burgundy after the death of his father.  After a few short years, and after the death of his wife's father, Robert I of France, King of Western Francia, he was elected by a commission of nobles to succed him as King. " itemDesc="Rudolph of France" iconUrl="images/icon/hero/487.png" price="0"/>
  <itemEum id="hero.taskitem.488" name="Rurik" itemType="任务" dayLimit="0" userLimit="0" desc="Rurik, whose name means 'famous ruler,' was a varangian chieftain who gained control of Ladoga in 862 and built the Holmgard settlement near Novgorod. He is the founder of Rurik Dyanasty which ruled Kievian Rus and then Galicia-Vohynia until 14th and Muscovy until 16th century. " itemDesc="Rurik" iconUrl="images/icon/hero/488.png" price="0"/>
  <itemEum id="hero.taskitem.489" name="Sa'adiah ben Yosef Gaon" itemType="任务" dayLimit="0" userLimit="0" desc="Sa'adiah ben Yosef Gaon was the first prominent rabbinic figure to write extensively in Arabic and is credited with being the founder of Judeao-Arabic literature. As a philosopher, his writings in Emunoth ve-Deoth attempts to integrate Jewish theology with components of Greek philosophy. Sa'adiah's translation of the Bible into Arabic is also of great importance to civilization. " itemDesc="Sa'adiah ben Yosef Gaon" iconUrl="images/icon/hero/489.png" price="0"/>
  <itemEum id="hero.taskitem.49" name="Gaius Cornelius Tacitus" itemType="任务" dayLimit="0" userLimit="0" desc="Senator and a historian of the Roman Empire. his work is distinguished by a boldness and sharpness of wit.          " itemDesc="Gaius Cornelius Tacitus" iconUrl="images/icon/hero/49.png" price="0"/>
  <itemEum id="hero.taskitem.490" name="Saint Zachary" itemType="任务" dayLimit="0" userLimit="0" desc="Motivated by the catholic church, Zachary developed diplomatic relations between many European countries.  His leadership and ability to navigate successfully in troublesome political quagmires are valuable assets for any kingdom. " itemDesc="Saint Zachary" iconUrl="images/icon/hero/490.png" price="0"/>
  <itemEum id="hero.taskitem.491" name="Saladin" itemType="任务" dayLimit="0" userLimit="0" desc="A Muslim warrior and eventual Sultan of both Egypt and Syria, Saladin led vast armies in campaigns against European forces during the First Crusade.  Instead of being despised in Europe, many great leaders admired his chivalrous values. " itemDesc="Saladin" iconUrl="images/icon/hero/491.png" price="0"/>
  <itemEum id="hero.taskitem.492" name="Salvestro de' Medici" itemType="任务" dayLimit="0" userLimit="0" desc="A member of the powerful Italian Medici family, Salvestro has held numerous political positions in Florence. " itemDesc="Salvestro de' Medici" iconUrl="images/icon/hero/492.png" price="0"/>
  <itemEum id="hero.taskitem.493" name="Samuel Daniel" itemType="任务" dayLimit="0" userLimit="0" desc="After studying at Oxford University and traveling in Italy, Samuel Daniel earned his living as a tutor. Fortunately, his student's mother, the Countess of Pembroke, led a literary circle and was the sister of Sir Philip Sidney, so she encouraged him to write poetry. By age 30, he published a sonnet sequence, and he later wrote masques and pastorals for the court of James I, a volume of epistles, and a poetic history of the Wars of the Roses.  " itemDesc="Samuel Daniel" iconUrl="images/icon/hero/493.png" price="0"/>
  <itemEum id="hero.taskitem.494" name="Samuel de Champlain" itemType="任务" dayLimit="0" userLimit="0" desc="Explorer Samuel de Champlain led 11 French expeditions to Canada in the footsteps of Jacques Cartier. He founded the city of Quebec and used it as a base to explore the Canadian interior and east coast into New England. He discovered Lakes Champlain, Ontario, and Huron and explored the Great Lakes as a possible route to the Pacific. As governor of the colony at Quebec, he defended it against Native American attacks. The English captured Quebec and imprisoned Champlain in London in 1629. When Quebec was restored to French rule in 1633, Champlain returned.   " itemDesc="Samuel de Champlain" iconUrl="images/icon/hero/494.png" price="0"/>
  <itemEum id="hero.taskitem.495" name="Sandro Botticelli 1" itemType="任务" dayLimit="0" userLimit="0" desc="One of the Florentine painters of the early Renaissance, Botticelli is best known for painting 'The Birth of Venus'.  His works were generally painted from the low relief perspective, and his works typify the linear aesthetic preferred by Early Renaissance artists.  Overshadowed by his contemporaries such as Michaelangelo, Botticelli's work became favored by the Aesthetic movement in the late 19th and early 20th centuries. " itemDesc="Sandro Botticelli 1" iconUrl="images/icon/hero/495.png" price="0"/>
  <itemEum id="hero.taskitem.496" name="Sandro Botticelli 2" itemType="任务" dayLimit="0" userLimit="0" desc="Apprenticed first to a goldsmith, Botticelli became a renowned painter in his native Florence. He created religious artwork, including some frescoes completed in 1480-82 in the Sistine Chapel in Rome, and was a gifted portraitist. His secular subjects were painted for cultured clients like Lorenzo de Medici and Duke Cosimo de Medici. His large painting of The Birth of Venus is among his most famous works. " itemDesc="Sandro Botticelli 2" iconUrl="images/icon/hero/496.png" price="0"/>
  <itemEum id="hero.taskitem.497" name="Sargon" itemType="任务" dayLimit="0" userLimit="0" desc="Sargon of Akkad was known regionally as Sarru-kinnu, meaning 'the legitimate king.'  He ruled during the Dynasty of Akkad around 2270-2215 B.C..  His origins and rise to power are found in a Sumerian text known as the 'Sargon Legend.'  The illegitimate son of a priestess, Sargon was appointed cup bearer to Ur-Zababa, king of Kish.  Ultimately, Sargon overthrew the King, embarked upon the conquest of Mesopotamia and founded his own city, a counterpart to Babylon, which he named Agade or Akkad.  During his reign, Akkadian was standardized and adapted for use with the cuneiform script previously used in the Sumerian language. " itemDesc="Sargon" iconUrl="images/icon/hero/497.png" price="0"/>
  <itemEum id="hero.taskitem.498" name="Saxo Grammaticus" itemType="任务" dayLimit="0" userLimit="0" desc="Although he was born into a family of fierce warriors, Grammaticus chose the pen as his weapon.  His prose, poetry and creativity is considered among the best in the world. " itemDesc="Saxo Grammaticus" iconUrl="images/icon/hero/498.png" price="0"/>
  <itemEum id="hero.taskitem.499" name="Sejong the Great" itemType="任务" dayLimit="0" userLimit="0" desc="King Sejong was coronated in 1418, at a time when Korea was facing frequent pirate attacks from Tsushima, Japan.  Sejong organized the Gihae Eastern Exhibition, which killed 243 Japanese pirates and captured 110 more, while only losing 4 of his own soldiers.  The Daimyo of Tsushima capitulated to Sejong, eventually signing the Treaty of Gyehae, which recognized Korean sovereignty.  Despite his military success his greatest contribution may have come off the battlefield, where he introduced hangul, a simplified alphabet for the Korean language still in use today. " itemDesc="Sejong the Great" iconUrl="images/icon/hero/499.png" price="0"/>
  <itemEum id="hero.taskitem.50" name="Titus Livius" itemType="任务" dayLimit="0" userLimit="0" desc="Roman historian who wrote a monumental history of Rome, Ab Urbe Condita, from its founding through the reign of Augustus in Livy is own time." itemDesc="Titus Livius" iconUrl="images/icon/hero/50.png" price="0"/>
  <itemEum id="hero.taskitem.500" name="Sennacherib" itemType="任务" dayLimit="0" userLimit="0" desc="King of Assyria 704-681 B.C. and son of Sargon, II who died while away on campaign.  Sennacherib is known for the destruction of Babylon in 689B.C. and for his siege on Jerusalem ruled by the Hebrew King, Hezekiah in 701B.C..  He spent a good portion of his leadership protecting what his predecessors and namely his father, Sargon, II had established.  His most noteworthy achievement is the building of the palace in Nineveh that was surrounded by parks and irrigated gardens with imported plants and animals from surrounding regions.  Sennacherib was the first ever in history to build aqueducts to supply the huge water demand at Nineveh and provide irrigation for crops.  He was assassinated by two of his sons in 681 B.C. and ultimately succeeded by a third son, Esarhadden. " itemDesc="Sennacherib" iconUrl="images/icon/hero/500.png" price="0"/>
  <itemEum id="hero.taskitem.501" name="Shah Abbas" itemType="任务" dayLimit="0" userLimit="0" desc="Shah Abbas the Great was Shah of Iran and considered the greatest ruler of the Safavid dynasty. He fought the Ottomans and Uzbeks and was able to regain territories lost by his father. He also took back land from the Mughals and Portuguese. He was also known as a builder moving his capital form Qazvin to Isfahan. " itemDesc="Shah Abbas" iconUrl="images/icon/hero/501.png" price="0"/>
  <itemEum id="hero.taskitem.502" name="Shah Jahan" itemType="任务" dayLimit="0" userLimit="0" desc="Shah Jahan was ruler of the Mughal Empire in India. Besides expanding his control with several military conquests, his reign is best known as the golden age of Mughal architecture. The most famous being the Taj Mahal at Agra. " itemDesc="Shah Jahan" iconUrl="images/icon/hero/502.png" price="0"/>
  <itemEum id="hero.taskitem.503" name="Shulgi" itemType="任务" dayLimit="0" userLimit="0" desc="Shulgi of Urim reigned as the second king of the 'Sumerian Renaissance” 2161-2113 B.C..  He built the Great Ziggurat of Ur and is best known for extensive revision of the scribal school's curriculum.  Although he engaged in punitive wars against the Gutians to avenge his father's death and developed a period of expansionism, he ultimately found himself unable to conquer highland raiders and other enemies.  Consequently, he built a large defensive wall to keep them out.  Numerous praise poems are written by and about this ruler who proclaimed himself a god after his 20th regnal year. " itemDesc="Shulgi" iconUrl="images/icon/hero/503.png" price="0"/>
  <itemEum id="hero.taskitem.505" name="Simeon I" itemType="任务" dayLimit="0" userLimit="0" desc="Simeon I the Great ruled over Bulgaria from  893 to  927. He successfully fought the Byzantines, Magyars and Serbs. These conflicts led Bulgaria to it's greatest territorial expansion ever. This made the First Bulgarian Empire one of the most powerful of its time in Eastern Europe. " itemDesc="Simeon I" iconUrl="images/icon/hero/505.png" price="0"/>
  <itemEum id="hero.taskitem.507" name="Sir Agravain" itemType="任务" dayLimit="0" userLimit="0" desc="Born of Arthurian royal blood lines, Agravain is an able bodied fighter and leader of men though most of his more memorial victories were won with cunning and deceit and not the sword. " itemDesc="Sir Agravain" iconUrl="images/icon/hero/507.png" price="0"/>
  <itemEum id="hero.taskitem.508" name="Sir Edward Coke" itemType="任务" dayLimit="0" userLimit="0" desc="English lawyer Sir Edward Coke prosecuted many notable defendants in his career. Robert Deveureux, who instigated a coup against Elizabeth I's chief minister Robert Cecil, was tried by Coke and executed for treason in 1601. In 1606, Coke prosecuted the conspirators in the Gunpowder Plot to blow up Parliament. James I named Coke Lord Chief Justice in 1613, but he was dismissed in 1616 when he stopped supporting rule by royal perogative in favor of rule by common law. As a member of Parliament, Coke drafted the Petition of Right in 1628 to curb the illegal excesses of Charles I.  " itemDesc="Sir Edward Coke" iconUrl="images/icon/hero/508.png" price="0"/>
  <itemEum id="hero.taskitem.509" name="Sir Francis Drake" itemType="任务" dayLimit="0" userLimit="0" desc="Sir Francis Drake spent 30 years as an explorer, privateer, and admiral. Commissioned by Elizabeth I to circumnavigate the globe, Drake's true mission was to plunder Spanish settlements and claim new territory. Sailing the Golden Hind, he was the first European to see the west coast of Canada. Elizabeth I knighted Drake on his return to England in 1580. He began open war against Spain when he sacked Spanish settlements in the New World. He delayed the Spanish Armada by destroying part of the fleet at Cadiz. As Vice-Admiral of the Royal Navy, Drake led the defeat of the Armada in 1588. " itemDesc="Sir Francis Drake" iconUrl="images/icon/hero/509.png" price="0"/>
  <itemEum id="hero.taskitem.51" name="Publius Cornelius Lentulus Sura" itemType="任务" dayLimit="0" userLimit="0" desc="Roman consul, he was the chief figure in the Catiline conspiracy.   " itemDesc="Publius Cornelius Lentulus Sura" iconUrl="images/icon/hero/51.png" price="0"/>
  <itemEum id="hero.taskitem.510" name="Sir Gawain" itemType="任务" dayLimit="0" userLimit="0" desc="Nephew of the fabled King Arthur, Gawain has proved his cunning in combat.  An able bodied knight with romantic chivalrous values, Sir Gawain quickly earns the respect and ear of the men he leads into battle. " itemDesc="Sir Gawain" iconUrl="images/icon/hero/510.png" price="0"/>
  <itemEum id="hero.taskitem.511" name="Socrates" itemType="任务" dayLimit="0" userLimit="0" desc="The Greek philosopher, Socrates was born about 470 B.C., in Athens and died in 399 B.C..   He actively participated in Athenian democracy, including military service during the Peloponnesian War.  He was considered a wise man and a great philosopher and was well known for pithy sayings and his 'Socratic irony'.  He is chiefly remembered as the teacher of Plato.  Athenian Officials charged Socrates with impiety and condemned him to death for his non-belief in the gods of the city and for introducing new gods.  Although he was offered an alternative to death, by paying a fine, he refused.  Following his ideals, Socrates fulfilled his death  sentence by drinking a cup of poison hemlock " itemDesc="Socrates" iconUrl="images/icon/hero/511.png" price="0"/>
  <itemEum id="hero.taskitem.512" name="Sonni Ali" itemType="任务" dayLimit="0" userLimit="0" desc="The first great King of the Songhai Empire, Sonni Ali captured Timbuktu and Jenne.  At its apex, the Songhai Empire was the largest Empire in West Africa during the Middle Ages.  He built a fleet to patrol the Niger River, around which his empire was based.  Many of his victories were attributed to his creative use of calvary as mobile forces to outflank his enemies.   " itemDesc="Sonni Ali" iconUrl="images/icon/hero/512.png" price="0"/>
  <itemEum id="hero.taskitem.513" name="Sophocles" itemType="任务" dayLimit="0" userLimit="0" desc="Sophocles (496 BC - 406 B.C.), an Athenian dramatist and politician, was born at Colonus in the neighbourhood of Athens.. He is known as the second of the three great Greek tragedians, preceded by Aeschylus and followed by Euripides.  He distinguished himself at an early age and many scholars considered him to be the greatest playwright among the ancients.  For around 50 years, he was the most decorated playwright in Athens.  He is most famous for the tragedies written about Oedipus, known collectively, due to their setting, as the three Theban plays: Oedipus the King (also known as Oedipus Rex); Oedipus at Colonus; and Antigone.  Only four others of the 123 plays he wrote have survived intact to this day.  A lesser known but well documented fact about Sophocles was his appointment at the age of fifty-five as one of the generals who served with Pericles in the Samian War (440 - 439 n.c.). " itemDesc="Sophocles" iconUrl="images/icon/hero/513.png" price="0"/>
  <itemEum id="hero.taskitem.514" name="St. Anselm" itemType="任务" dayLimit="0" userLimit="0" desc="A Benedictine monk, St. Anselm attained fame as the 'Father of Scholasticism' at the monastery at Bec in Normandy, France. After the Norman Conquest, he became the Archbishop of Canterbury in 1093. In the war between church and state, he battled continually with William II and Henry I of England over the church's right to elect bishops without the crown's control. St. Anselm's victory was one scene in the tapestry of the politics of religion in English history. " itemDesc="St. Anselm" iconUrl="images/icon/hero/514.png" price="0"/>
  <itemEum id="hero.taskitem.515" name="St. Bernard of Clairvaux" itemType="任务" dayLimit="0" userLimit="0" desc="Born in Burgundy, France, to a wealthy family, Bernard rejected that life to join the Cistercian Order. He founded the monastery at Clairvaux, became its abbot, and attacked heresy in leading the Catholic Church away from increasingly immoral practices and toward reform. The Cistercian Order thrived under his leadership. In 1130, he backed Innocent II in a hard-fought papal election, and his call for a Second Crusade in 1140 attracted believers from all over Europe. " itemDesc="St. Bernard of Clairvaux" iconUrl="images/icon/hero/515.png" price="0"/>
  <itemEum id="hero.taskitem.516" name="St. Bruno of Cologne" itemType="任务" dayLimit="0" userLimit="0" desc="St. Bruno was the founder of the Carthusian Order of monks and first prior of their monastery at La Grande Chartreuse in France. The order demanded strict self-denial and separation of monks from the secular life. Pope Urban II, a former student of St. Bruno, summoned him to Rome in 1090 as a trusted advisor. Resisting the pope's wish to name him Archbishop, St. Bruno returned to solitary retreat and died in 1101. In England, the Carthusian order was wiped out during the Dissolution of the Monasteries in the 16th century. " itemDesc="St. Bruno of Cologne" iconUrl="images/icon/hero/516.png" price="0"/>
  <itemEum id="hero.taskitem.517" name="St. Edmund Campion" itemType="任务" dayLimit="0" userLimit="0" desc="Campion was ordained in the Church of England in 1568. He left England for the Continent, converted to Catholicism, and became a Jesuit in Rome in 1573. An esteemed Jesuit scholar, he joined the first secret Jesuit mission to England in 1580. Disguised as a jewel merchant, he began preaching immediately and publishing his writings opposing the Anglican Church. Campion was arrested, tortured, and executed for treason. " itemDesc="St. Edmund Campion" iconUrl="images/icon/hero/517.png" price="0"/>
  <itemEum id="hero.taskitem.518" name="St. Edward the Confessor" itemType="任务" dayLimit="0" userLimit="0" desc="Edward succeeded the Danish heirs of King Canute in 1042. Raised at the Norman court, he may have promised the crown to Duke William (later William the Conqueror and William I of England). When Edward died, the Witan (council) instead chose Harold Godwin, the son of Edward's father-in-law. The Norman Conquest was the resulting backlash. Although he reigned from 1042 to 1066, Edward's lasting contribution may have come through his piety and founding of Westminster Abbey. Edward was canonized in 1161. " itemDesc="St. Edward the Confessor" iconUrl="images/icon/hero/518.png" price="0"/>
  <itemEum id="hero.taskitem.519" name="Stephen III of Moldavia" itemType="任务" dayLimit="0" userLimit="0" desc="Stephen III of Moldavia, also called Stephen the Great, defeated his uncle in battle to claim the crown six years after his uncle had orchestrated the assassination of Stephen's father, Bogdan II.  He spent most of his 47 year reign in conflict with the Ottomans and Poland.  His greatest military victories came against the Ottomans at the Battle of Vaslui and the Battle of Catlabuga Lake.  After nearly five decades of maintaining Moldavia's independence, Stephen III signed a treaty where Moldavia became a vassal state of the Ottoman Empire, which it remained for over 300 years.  He was also a very pious man, with Pope Sixtus naming him a, 'True Champion of the Christian Faith,' and he was canonized by the Romanian Orthodox Church in 1992. " itemDesc="Stephen III of Moldavia" iconUrl="images/icon/hero/519.png" price="0"/>
  <itemEum id="hero.taskitem.52" name="Origenes Adamantius" itemType="任务" dayLimit="0" userLimit="0" desc="An early Christian scholar, theologian, and one of the most distinguished of the early fathers of the Christian Church.         " itemDesc="Origenes Adamantius" iconUrl="images/icon/hero/52.png" price="0"/>
  <itemEum id="hero.taskitem.520" name="Sviatopolk II of Pomerania" itemType="任务" dayLimit="0" userLimit="0" desc="Sviatopolk II of Pomerania sometimes also called the Great (Polish: ?wi?tope?k II Wielki), was Duke of Pomerelia-Gdańsk (Danzig) from 1215 until his death. Swantopolk had freed himself of Danish and Polish overlordship. In 1238 Swantopolk conquered the Duchy of S?awno, the territories of which connected Pomerania to Gdańsk, Nakel, and Bydgoszcz.  " itemDesc="Sviatopolk II of Pomerania" iconUrl="images/icon/hero/520.png" price="0"/>
  <itemEum id="hero.taskitem.521" name="Tamerlane" itemType="任务" dayLimit="0" userLimit="0" desc="Born on the plains of Central Asia in modern Uzbekistan, Tamerlane rose to power as an innovative military leader, being crowned at his capital of Samarkand in 1370.  He spent the next 35 years waging nearly continuous wars, expanding his empire.  In 1382 his armies sacked Moscow, and from 1383 to 1387 he conquered almost all of Persia.  He died in 1405 while invading China in an attempt to reconstruct the Mongol Empire of the Khans.  An avid chess player, he played while on marches to maintain his tactical prowess. " itemDesc="Tamerlane" iconUrl="images/icon/hero/521.png" price="0"/>
  <itemEum id="hero.taskitem.523" name="Tertullian" itemType="任务" dayLimit="0" userLimit="0" desc="Christian author, and the first to write Christian?Latinliterature. He also was a notable early?Christian apologist?and a polemicist against heresy. " itemDesc="Tertullian" iconUrl="images/icon/hero/523.png" price="0"/>
  <itemEum id="hero.taskitem.524" name="Thaddeus Kosciuszko" itemType="任务" dayLimit="0" userLimit="0" desc="Thaddeus Kosciuszko was a Polish-Lithuanian military leader. He fought in War for Independence with the rank of colonel in the Continental Army. Afterwards he led the 1794 Revolt against Russia and Prussia. " itemDesc="Thaddeus Kosciuszko" iconUrl="images/icon/hero/524.png" price="0"/>
  <itemEum id="hero.taskitem.525" name="Theodora the Armenian" itemType="任务" dayLimit="0" userLimit="0" desc="Originally from Paphlagonia, Theodora was the wife of the Byzantine emperor Theophilus. Following his death she became an astute ruler, overriding his ecclesiastical policies. She established councils that restored the practice of veneration of icons and was sainted for her efforts and zeal. " itemDesc="Theodora the Armenian" iconUrl="images/icon/hero/525.png" price="0"/>
  <itemEum id="hero.taskitem.526" name="Theophilos" itemType="任务" dayLimit="0" userLimit="0" desc="Emperor Theophilos was the second emperor of the Amorian dynasty. He was highly educated and had an appreciation for the arts, issuing an edict in 832 forbidding the veneration of icons. He viewed himself as a champion of justice so much so that he was featured as one of the judges in the Netherworld in a literary composition of the time. His rule was riddled with wars and battles, even upon his ascension where he was forced to wage war against the Arabs on two fronts. He even personally led a large Byzantine army in the Battle of Anzen in Dazimon. " itemDesc="Theophilos" iconUrl="images/icon/hero/526.png" price="0"/>
  <itemEum id="hero.taskitem.527" name="Thomas Campion" itemType="任务" dayLimit="0" userLimit="0" desc="Thomas Campion studied law, medicine, and the classics at Cambridge University choosing medicine as his profession. His spare time was filled with the writing for which history remembers him including poetry, literary criticism, and music. He found music in words and transformed his poems and sonnets into songs, airs, and madrigals by composing music for them himself. He published them as A Book of Airs. Campion also wrote highly popular masques and court pageants. " itemDesc="Thomas Campion" iconUrl="images/icon/hero/527.png" price="0"/>
  <itemEum id="hero.taskitem.528" name="Thomas Cranmer" itemType="任务" dayLimit="0" userLimit="0" desc="Thomas Cranmer was made Archbishop of Canterbury in 1532. He was a chief architect of the Anglican Church and masterminded the annulments of Henry VIII's marriages to Catherine of Aragon, Anne Boleyn, and Anne of Cleves. Cranmer worked on liturgical reform and the First and Second English Book of Common Prayer during the reign of Edward VI. He championed the succession of Lady Jane Grey in 1553, but the accession of Mary I and ascendency of Roman Catholicism led to Cranmer's trial for heresy and high treason. He was burned at the stake in 1556. " itemDesc="Thomas Cranmer" iconUrl="images/icon/hero/528.png" price="0"/>
  <itemEum id="hero.taskitem.529" name="Thomas Cromwell" itemType="任务" dayLimit="0" userLimit="0" desc="Self-taught in languages, law, commerce, and warfare, Cromwell earned the patronage of Cardinal Thomas Wolsey at the court of Henry VIII. After Wolsey's fall from favor, Cromwell became increasingly powerful until he became the king's chief minister in 1533. He managed Henry's divorce from Catherine of Aragon, the break with the Roman Catholic Church and lay organization of the Anglican Church, the Dissolution of the Monasteries, and constant turmoil within the court and council. His choice of the Protestant Anne of Cleves as Henry's fourth wife incurred Henry's displeasure. Cromwell was created Earl of Essex but lost his head to the Catholic Howard family who had plotted to brand him a traitor. " itemDesc="Thomas Cromwell" iconUrl="images/icon/hero/529.png" price="0"/>
  <itemEum id="hero.taskitem.53" name="Maximus of Ephesus" itemType="任务" dayLimit="0" userLimit="0" desc="Greek Neoplatonist, he was a friend and mentor of Emperor Julian and his collaborator in the restoration of paganism.           " itemDesc="Maximus of Ephesus" iconUrl="images/icon/hero/53.png" price="0"/>
  <itemEum id="hero.taskitem.530" name="Thomas Erastus" itemType="任务" dayLimit="0" userLimit="0" desc="Born Thomas Lieber (or Liebler) in Switzerland, Erastus was a professor of medicine at Heidelberg University and a Protestant theologian who followed the teachings of Ulrich Zwingli. When reformed Protestantism was introduced in the German Palatinate states in 1570, he feared the Calvinist system of church government would exclude all others. Erastus was excommunicated for 2 years and returned to Basle where his writings on church government were published and influenced the Reformation. " itemDesc="Thomas Erastus" iconUrl="images/icon/hero/530.png" price="0"/>
  <itemEum id="hero.taskitem.531" name="Thomas Jefferson" itemType="任务" dayLimit="0" userLimit="0" desc="Thomas Jefferson was the third President of the United States. He was a highly influential Founding Father of the United States of America and the primary author of The Declaration of Independence. " itemDesc="Thomas Jefferson" iconUrl="images/icon/hero/531.png" price="0"/>
  <itemEum id="hero.taskitem.532" name="Thomas Malory" itemType="任务" dayLimit="0" userLimit="0" desc="The author of Le Morte d'Arthur, Thomas Malory, is a figure about whom relatively few facts are known.  He was elected to Parliament twice, spent at least some time imprisoned in London, and was specifically excluded from being pardoned by both Henry VI and Edward IV.  He completed the book for which he is known in 1470, and died shortly thereafter, in 1471. " itemDesc="Thomas Malory" iconUrl="images/icon/hero/532.png" price="0"/>
  <itemEum id="hero.taskitem.533" name="Thucidides" itemType="任务" dayLimit="0" userLimit="0" desc="Thucidides was the greatest of ancient Greek historians and author of the History of the Peloponnesian War, which details the struggle between Athens and Sparta in the 5th century B.C..   His detailed account begins with the events which provoked the war and was the first recorded political and moral analysis of a nation’s war policies.  During the war, he was elected general. Due to his connection to the great Athenian statesman and general Miltiades, who had married the daughter of a Thracian prince,  Thucidides was given command of the fleet based at Thasos.  He failed to prevent the capture of Amphipolis by Sparta and due to this blunder,  was sentenced to exile.  His exile ended with the fall of Athens and the peace of 404 B.C.  He is thought to have perished shortly after in the troubled times following the peace. " itemDesc="Thucidides" iconUrl="images/icon/hero/533.png" price="0"/>
  <itemEum id="hero.taskitem.534" name="Tippu Sultan" itemType="任务" dayLimit="0" userLimit="0" desc="Sultan Fateh Ali Tipu also called the Tiger of Mysore, ruled the Islamic kingdom of Mysore . He was one of the first Indian ruler to fight the British. " itemDesc="Tippu Sultan" iconUrl="images/icon/hero/534.png" price="0"/>
  <itemEum id="hero.taskitem.535" name="Titian" itemType="任务" dayLimit="0" userLimit="0" desc="Regarded as one of the most prominent artists in the Renaissance, rivaled only by Raphael, Michelangelo and da Vinci, Titian generally explores religion and mythology in his works. " itemDesc="Titian" iconUrl="images/icon/hero/535.png" price="0"/>
  <itemEum id="hero.taskitem.537" name="Tokugawa Ieyasu" itemType="任务" dayLimit="0" userLimit="0" desc="Tokugawa Ieyasu was founder and first shogun of the Tokugawa shogunate of Japan. They ruled Japan from 1600 until the Meiji Restoration in 1868. He gained power at the Battle of Sekigahaia, which is claimed to be the largest in Japanese history. A total of 160,000 soldiers were involved in the complete Tokugawa victory. " itemDesc="Tokugawa Ieyasu" iconUrl="images/icon/hero/537.png" price="0"/>
  <itemEum id="hero.taskitem.538" name="Tupac Inca Yupanqui" itemType="任务" dayLimit="0" userLimit="0" desc="He continued to build the Inca Empire after taking over from his father, Pachacuti.  He would expand the Incan lands to the West, all the way to the Pacific Coast.  He is also alleged to have taken a long journey into the Pacific, but the details of that expedition cannot be verified. " itemDesc="Tupac Inca Yupanqui" iconUrl="images/icon/hero/538.png" price="0"/>
  <itemEum id="hero.taskitem.539" name="Utu-hengal" itemType="任务" dayLimit="0" userLimit="0" desc="Utu-hengal was one of the first native kings of Sumer after centuries of Akkadian and Gutian rule.  As governor of Uruk, with the aid of other cities, he revolted against Gutian rule in the 22nd century B.C. and established himself as the king of Sumer.  He was unable to maintain power and reigned for only 7 years " itemDesc="Utu-hengal" iconUrl="images/icon/hero/539.png" price="0"/>
  <itemEum id="hero.taskitem.54" name="Lucius Annaeus Seneca" itemType="任务" dayLimit="0" userLimit="0" desc="Roman Stoic philosopher, statesman,dramatist, and in one work humorist, of the Silver Age of Latin literature.      " itemDesc="Lucius Annaeus Seneca" iconUrl="images/icon/hero/54.png" price="0"/>
  <itemEum id="hero.taskitem.540" name="Valdemar I of Denmark" itemType="任务" dayLimit="0" userLimit="0" desc="Valdemar I of Denmark, also known as Valdemar the Great, was King of Denmark from 1157 until 1182. Valdemar's father, Prince Canute, was murdered just days before his birth. His mother, Ingeborg, a daughter of Mstislav I of Kyiv, named him after her grandfather, Volodymyr Monomakh of Kyiv. Valdemar, having outlived all his rival pretenders, became the sole King of Denmark. He reorganized and rebuilt war-torn Denmark. Valdemar declared war upon the Wends (Slavs) who were raiding the Danish coasts. Valdemar's rule caused the rise of Denmark, which reached its zenith under his second son Valdemar. " itemDesc="Valdemar I of Denmark" iconUrl="images/icon/hero/540.png" price="0"/>
  <itemEum id="hero.taskitem.541" name="Valdemar II of Denmark" itemType="任务" dayLimit="0" userLimit="0" desc="Valdemar II of Denmark, called Valdemar the Conqueror or Valdemar the Victorious, was the King of Denmark from 1202 until his death in 1241. He is most famous for his crusades across the Eastern Baltic. Pope Honorius III elevated Valdemar's invasion of Estonia into a crusade. Valdemar raised an army and conquered Estonia, forcibly baptizing Estonians into Christianity. The city he founded, is the capital of Estonia to this day. He is considered one of the greatest Kings of Denmark. " itemDesc="Valdemar II of Denmark" iconUrl="images/icon/hero/541.png" price="0"/>
  <itemEum id="hero.taskitem.543" name="Vasco Nunez de Balboa" itemType="任务" dayLimit="0" userLimit="0" desc="Balboa emigrated from Spain to Hispaniola in 1501, and, after failing as a plantation owner, he led expeditions through Central and South America. He founded the town of Darien, Panama, and--lured by gold--crossed the Peruvian Andes and discovered the Pacific Ocean in 1513. He claimed possession of the Pacific for Ferdinand II of Spain who rewarded the conquistador by making him an Admiral and Governor of Panama.  " itemDesc="Vasco Nunez de Balboa" iconUrl="images/icon/hero/543.png" price="0"/>
  <itemEum id="hero.taskitem.544" name="Viracocha" itemType="任务" dayLimit="0" userLimit="0" desc="Ruler of the Incas near Cuzco during the early 1400s, he expanded his kingdom's lands.  Unlike his predecessors, he chose to rule lands he subjugated instead of just looting them.  He fought many of the battles in the last war between the Inca and the neighboring Chanca. " itemDesc="Viracocha" iconUrl="images/icon/hero/544.png" price="0"/>
  <itemEum id="hero.taskitem.545" name="Vlad Dracula" itemType="任务" dayLimit="0" userLimit="0" desc="With royal Romanian bloodlines and a powerful family, Vlad Dracula proved his sociopathic tendencies early in life when he put tens of thousands of innocent peasants to death by impalement.? Ruthless and blood-thirsty, Dracula demands the respect of foes and allies alike at the tip of a spear; a spear you just might find your head impaled on some day if you cross him. " itemDesc="Vlad Dracula" iconUrl="images/icon/hero/545.png" price="0"/>
  <itemEum id="hero.taskitem.546" name="Vlad the Impaler" itemType="任务" dayLimit="0" userLimit="0" desc="?Wallachian?(present-day southern?Romania)?voivode.?Vlad the Impaler is known for the exceedingly cruel punishments he imposed as ruler of Wallachia. " itemDesc="Vlad the Impaler" iconUrl="images/icon/hero/546.png" price="0"/>
  <itemEum id="hero.taskitem.547" name="Vladimir I" itemType="任务" dayLimit="0" userLimit="0" desc="Vladimir I of Kiev was the grand prince of Kiev who converted to Christianity in 988. He went on to baptize all of Kievan Russia. Churches today celebrate the feast day of Saint Vladimir. " itemDesc="Vladimir I" iconUrl="images/icon/hero/547.png" price="0"/>
  <itemEum id="hero.taskitem.548" name="Vladimir the Great" itemType="任务" dayLimit="0" userLimit="0" desc="Vladimir Svyatoslavich the Great was the grand prince of Kievian Rus, the predecessor of modern Russia. In 987 Prince Vladimir consulted with his boyars and sent envoys to study religions of neighboring regions. After evaluating them and being impressed with the beauty of the Constantinople Churches (not to mention the political advantages he would gain by aligning with Byzantine), in 988 he converted to Christianity and baptized the entire empire. " itemDesc="Vladimir the Great" iconUrl="images/icon/hero/548.png" price="0"/>
  <itemEum id="hero.taskitem.549" name="Voltaire" itemType="任务" dayLimit="0" userLimit="0" desc="Francois-Marie Arouet was a major writer of the French Enlightenment. He was an essayist and philosopher known for his defense of civil liberties especially freedom of religion and free trade. " itemDesc="Voltaire" iconUrl="images/icon/hero/549.png" price="0"/>
  <itemEum id="hero.taskitem.55" name="Iamblichus" itemType="任务" dayLimit="0" userLimit="0" desc="Assyrian Neoplatonist philosopher who determined the direction taken by later Neoplatonic philosophy, and perhaps western Paganismitself. He is perhaps best known for his compendium on Pythagorean philosophy.    " itemDesc="Iamblichus" iconUrl="images/icon/hero/55.png" price="0"/>
  <itemEum id="hero.taskitem.550" name="Walter Raleigh" itemType="任务" dayLimit="0" userLimit="0" desc="Raleigh was born to a wealthy protestant family and rose quickly in the world of English politics.  He was close to Queen Elizabeth I and was knighted at the age of thirty-three.  He was a member of the English court as well as an accomplished explorer, soldier and author. " itemDesc="Walter Raleigh" iconUrl="images/icon/hero/550.png" price="0"/>
  <itemEum id="hero.taskitem.551" name="Wartislaw III, Duke of Pomeran" itemType="任务" dayLimit="0" userLimit="0" desc="Wartislaw III was a Griffin duke of Pomerania-Demmin. Wartislaw successfully stopped a Danish invasion in 1234. In the North, Wartislaw was able to expand his sphere of influence up to the Ryck river into the territory of Hilda. Since he did not produce any children from his marriage, Pomerania-Demmin ceased to exist with his death. " itemDesc="Wartislaw III, Duke of Pomeran" iconUrl="images/icon/hero/551.png" price="0"/>
  <itemEum id="hero.taskitem.552" name="Willem Barentsz" itemType="任务" dayLimit="0" userLimit="0" desc="Barentsz was a Dutch cartographer and explorer who searched the seas between the Artic ice and European landmass for a Northeast Passage to Asia. He discovered the town of Spitzbergen, Norway, and explored the north coast of Russia. He kept detailed navigation charts and recorded meteorological data, forever changing the science of exploration. " itemDesc="Willem Barentsz" iconUrl="images/icon/hero/552.png" price="0"/>
  <itemEum id="hero.taskitem.553" name="William Bradford" itemType="任务" dayLimit="0" userLimit="0" desc="One of the Pilgrim Fathers, William Bradford was born in Yorkshire but fled England for Holland to escape religious persecution. He returned to England to sail to the New World on the Mayflower. In Plymouth, Massachusetts, he was elected governor of the colony (after John Carver's short tenure), which he led until his death in 1657.  Bradford appeased the Native Americans and led the Pilgrims to freedom from English financial interests. He also wrote a history of the Plymouth colony. " itemDesc="William Bradford" iconUrl="images/icon/hero/553.png" price="0"/>
  <itemEum id="hero.taskitem.554" name="William Cecil" itemType="任务" dayLimit="0" userLimit="0" desc="William Cecil, 1st Baron Burghley, was a politically shrewd lawyer who held office under Henry VIII, Edward VI, and Elizabeth I. Named Secretary of State in 1558, he maintained the stability of Elizabeth's reign and devised domestic and foreign policy for 40 years. He introduced financial reforms, promoted new industries, and controlled appointments to Oxford and Cambridge Universities. He strengthened the Anglican Church but also prompted Elizabeth to provide aid to the French Huguenots and Dutch Calvinists. Cecil saw Mary, Queen of Scots, as a threat to realm and ordered her execution in 1587. " itemDesc="William Cecil" iconUrl="images/icon/hero/554.png" price="0"/>
  <itemEum id="hero.taskitem.555" name="William Herschel" itemType="任务" dayLimit="0" userLimit="0" desc="Sir Fredrick William Herschel was a German born English astronomer. He discovered Uranus and infrared radiation. " itemDesc="William Herschel" iconUrl="images/icon/hero/555.png" price="0"/>
  <itemEum id="hero.taskitem.556" name="William III" itemType="任务" dayLimit="0" userLimit="0" desc="William III was a Prince of Orange, who governed the Dutch Republic. Later he reigned with his wife MaryII over England, Scotland and Ireland. He fought in several wars against Louis XIV. " itemDesc="William III" iconUrl="images/icon/hero/556.png" price="0"/>
  <itemEum id="hero.taskitem.557" name="William Pitt the Elder" itemType="任务" dayLimit="0" userLimit="0" desc="William Pitt , first Earl of Chatham, was a British Whig who is known for leading Britain through the Seven Years War. He also lead the nation with the title of Lord Privy Seal from 1766 to 1768. " itemDesc="William Pitt the Elder" iconUrl="images/icon/hero/557.png" price="0"/>
  <itemEum id="hero.taskitem.558" name="William Shakespeare" itemType="任务" dayLimit="0" userLimit="0" desc="Universally regarded as the finest author in the English language, Shakespeare is an English poet, playwright.  Among the themes commonly used in his work are the exploration of the human condition, love, hate, jealousy, religion and race. " itemDesc="William Shakespeare" iconUrl="images/icon/hero/558.png" price="0"/>
  <itemEum id="hero.taskitem.559" name="William Tell" itemType="任务" dayLimit="0" userLimit="0" desc="Defiant of political tyranny, Tell's actions tend to lead to rebellions in the face of oppression.  Travelers speak of Tell's uncanny skill with a crossbow; an ability illustrated when he split an apple atop the head of his son and his performance in the Battle of Morgarten. " itemDesc="William Tell" iconUrl="images/icon/hero/559.png" price="0"/>
  <itemEum id="hero.taskitem.56" name="Epictetus" itemType="任务" dayLimit="0" userLimit="0" desc="Greek stoic philosopher and strategist.     " itemDesc="Epictetus" iconUrl="images/icon/hero/56.png" price="0"/>
  <itemEum id="hero.taskitem.560" name="William the Conqueror" itemType="任务" dayLimit="0" userLimit="0" desc="William the 1st was the Duke of Normandy and later King of England. He invaded England with an army in 1066. At the Battle of Hastings, he defeated Harold Godwinson, this along with other revolts is known as the Norman Conquest. This was the last time England was conquered by a foreign power. As King of England he was responsible for the Doomsday Book, precursor to the modern census.  He died at age of 59 in 1087. " itemDesc="William the Conqueror" iconUrl="images/icon/hero/560.png" price="0"/>
  <itemEum id="hero.taskitem.561" name="William VIII, Duke of Aquitain" itemType="任务" dayLimit="0" userLimit="0" desc="William commanded an army in the first offensive organized by the Catholic church against a Muslim city.  The Siege of Barbastro was highly sucessful and laid the groundwork for the Crusades. " itemDesc="William VIII, Duke of Aquitain" iconUrl="images/icon/hero/561.png" price="0"/>
  <itemEum id="hero.taskitem.562" name="William Wallace" itemType="任务" dayLimit="0" userLimit="0" desc="Scottish?knight?and?landowner?who is known for leading a resistance during the?Wars of Scottish Independence. " itemDesc="William Wallace" iconUrl="images/icon/hero/562.png" price="0"/>
  <itemEum id="hero.taskitem.563" name="Wolfgang Amadeus Mozart" itemType="任务" dayLimit="0" userLimit="0" desc="Wolfgang Amadeus Mozart was the most influential composer of the Classical era. He composed over 600 works in his life. Considering this Austrian died at the age of 35 this was a most impressive feat. " itemDesc="Wolfgang Amadeus Mozart" iconUrl="images/icon/hero/563.png" price="0"/>
  <itemEum id="hero.taskitem.564" name="Xenophon" itemType="任务" dayLimit="0" userLimit="0" desc="Xenophon (c. 431-355 B. C.) was born in Attica and grew up during the war between Athens and Sparta.  He is best known as a Greek historian, essayist, and served as a cavalryman in the war.  His great works include Anabasis Kyrou (The Persian Expedition), a tale of Greek mercenaries who fought their way back from the gates of Babylon to the Euxine (Black Sea). He also authored  Hellenica, a continuation of Thucydides' history of the Greeks from 411 to 362 B.C., the Memorabilia of Socrates, and the Cyropedia (Education of Cyrus), an historical novel about Cyrus the Elder, the founder of the Persian empire.  " itemDesc="Xenophon" iconUrl="images/icon/hero/564.png" price="0"/>
  <itemEum id="hero.taskitem.565" name="Yi Jongmu" itemType="任务" dayLimit="0" userLimit="0" desc="The general who lead the Oei Invasion of Tsushima Island in 1419, he oversaw a coordinated naval assault featuring 227 ships and 17,285 men.  This campaign had the effect of stopping Japanese piracy against Korean ships, recovering over 100 prisoners of the pirates, and putting this strategic island temporarily under the control of Korea. " itemDesc="Yi Jongmu" iconUrl="images/icon/hero/565.png" price="0"/>
  <itemEum id="hero.taskitem.566" name="Zara Yaqob" itemType="任务" dayLimit="0" userLimit="0" desc="Imprisoned by his older brother from age 15 to 35, Zara Yaqob was ill-prepared to take over as Emperor of Ethiopia in 1435.  He instead approached his reign with an iron will and determination.  He was a Christian, and arranged a compromise between Egyptian and Ethiopian bishops regarding observation of the Sabbath.  He wrote three significant theological texts while reigning as emperor.  Last, he sent an expedition to Europe that made contact with the Pope and the King of Aragon. " itemDesc="Zara Yaqob" iconUrl="images/icon/hero/566.png" price="0"/>
  <itemEum id="hero.taskitem.567" name="Zheng He" itemType="任务" dayLimit="0" userLimit="0" desc="A trusted adviser of the Yongle Emperor of the Ming Dynasty, Zheng He was made admiral of a large fleet and sent to expand China's influence into the Indian Ocean.  Between 1405 and 1433, Zheng He made seven voyages west, and is traditionally believed to have sailed as far as Iran.  He brough back novelties such as ostriches, giraffes, zebras, camels, and ivory to China, and also brought emissaries from more than 30 countries, who all paid respects to the emperor.  He is honored with a tomb in mainland China, but he died on his last voyage, and was buried at sea. " itemDesc="Zheng He" iconUrl="images/icon/hero/567.png" price="0"/>
  <itemEum id="hero.taskitem.568" name="Zhu Di" itemType="任务" dayLimit="0" userLimit="0" desc="The Yongle Emperor, Zhu Di had a reign of over 20 years, and is considered to be the greatest Ming Emperor.  As the fourth son of the Emperor, he was awarded a Princedom, which contained Beijing and the surrounding areas.  He fought the Mongols and the remnants of the Yuan Dynasty, and led troops to victory in many battles.  When his father died, Zhu Di engaged in a power struggle with his nephew, emerging victorious four years later.  As the Yongle Emperor, Zhu Di oversaw the re-expansion of China following the Yuan Dynasty.  His greatest achievements were the rebuilding of Grand China Canal between the tributaries of the Yangtze and Yellow rivers, and moving the capital of China to Beijing from Nanjing.  During his reign, the Forbidden city was constructed, which would serve as the hub of Chinese politics for the next 500 years. " itemDesc="Zhu Di" iconUrl="images/icon/hero/568.png" price="0"/>
  <itemEum id="hero.taskitem.569" name="Zhu Gaozhi" itemType="任务" dayLimit="0" userLimit="0" desc="The Hongxi Emperor, he restored Confucian officials to prominent places in the Chinese bureaucracy.  He canceled trading missions to bring gold, ivory, and horses to China, and instead remitted taxes to the peasants.  His reign was short, just over a year, but he set up many of the reforms that would be carried forth by his son, the Xuande Emperor. " itemDesc="Zhu Gaozhi" iconUrl="images/icon/hero/569.png" price="0"/>
  <itemEum id="hero.taskitem.57" name="Hypatia of Alexandria" itemType="任务" dayLimit="0" userLimit="0" desc="Greek scholar from Alexandria in Egypt, considered the first notable woman in mathematics, who also taught philosophy and astronomy.        " itemDesc="Hypatia of Alexandria" iconUrl="images/icon/hero/57.png" price="0"/>
  <itemEum id="hero.taskitem.570" name="Zhu Jianshen" itemType="任务" dayLimit="0" userLimit="0" desc="Known as the Chenghua Emperor, he came to power at age 17.  In the opening years of his reign he sought to strengthen the dynasty, but eventually, he left governing in the hands of  his servants.  He founded the Xi Chang, a form of secret police, that his successors would revive and expand.  He was childless during much of his rule because of a conspiracy of one of his harem to prevent him from having an heir.  Prone to nepotism, by the end of his reign, incompetent government had spent much of the reserve his ancestors had accumulated. " itemDesc="Zhu Jianshen" iconUrl="images/icon/hero/570.png" price="0"/>
  <itemEum id="hero.taskitem.571" name="Zhu Qizhen" itemType="任务" dayLimit="0" userLimit="0" desc="During the Ming Dynasty, he was crowned the Zhengtong Emperor at age 8.  He was advised by respected servants and regents until at age 22, when he commanded the forces in battle against the Mongols, he was captured and held for a year.  He returned home only to be imprisoned by his brother, who had claimed the throne in his absence, for another seven years.  Zhu Qizhen took power back when his brother fell ill, and ruled another 7 years as the Tianshun Emperor.   " itemDesc="Zhu Qizhen" iconUrl="images/icon/hero/571.png" price="0"/>
  <itemEum id="hero.taskitem.572" name="Zhu Youtang" itemType="任务" dayLimit="0" userLimit="0" desc="Like his father, Zhu Youtang became Emperor of China at the age of 17, taking the title of Hongzhi Emperor.  Unlike his father, he was very involved with the policies of China during his reign.  With a cabal of capable advisers, he brought prosperity to his land.  He is also notable in that he had one Empress and no concubines, making him the only monogamous Emperor in Chinese history. " itemDesc="Zhu Youtang" iconUrl="images/icon/hero/572.png" price="0"/>
  <itemEum id="hero.taskitem.573" name="Zhu Zhanji" itemType="任务" dayLimit="0" userLimit="0" desc="Known as the Xuande Emperor, his ten year reign marked the apex of the Ming Dynasty.  His greatest achievement was in 1430, when in response to popular discontent, he reduced taxes on farmers and sent out squads of his personal entourage to travel the Empire, eliminating irregularities and corruption in the taxation system.  His people oversaw the retrial and release of thousands of peasants who had been imprisoned by corrupt officials.   " itemDesc="Zhu Zhanji" iconUrl="images/icon/hero/573.png" price="0"/>
  <itemEum id="hero.taskitem.574" name="Zorayda" itemType="任务" dayLimit="0" userLimit="0" desc="An English Coutess originally dubbed Alys, Countess of the Vexin, her name was changed when she joined Saladin in the Third Crusade in order to get revenge on Richard the Lionheart whom had broken off a marriage agreement with her.  She was knighted and followed the codes of chivalry while under Saladin's command. " itemDesc="Zorayda" iconUrl="images/icon/hero/574.png" price="0"/>
  <itemEum id="hero.taskitem.575" name="Godwin" itemType="任务" dayLimit="0" userLimit="0" desc="The Earl of Wessex, Godwin was the father of Harold II of England and of Edith, wife of Edward I (the Confessor). The power behind the English throne, he arranged for Harold I and Edward I to become kings (in 1040 and 1042, respectively). Godwin's son became Harold II on Edward's death in 1065 only to face William the Conqueror's challenge in 1066. " itemDesc="Godwin" iconUrl="images/icon/hero/575.png" price="0"/>
  <itemEum id="hero.taskitem.576" name="Diego Sarmiento de Acuna. Conde de Gondomar" itemType="任务" dayLimit="0" userLimit="0" desc="Spanish diplomat and ambassador to England, the Conde de Gondomar gained influence and power at the court of James I. He incurred to wrath of English Protestants, tried to tempt the Prince of Wales with royal bride from Spain, and connived the execution of Sir Walter Raleigh. He was recalled to Spain in 1622. " itemDesc="Diego Sarmiento de Acuna. Conde de Gondomar" iconUrl="images/icon/hero/576.png" price="0"/>
  <itemEum id="hero.taskitem.577" name="Pope Gregory XIII" itemType="任务" dayLimit="0" userLimit="0" desc="Pope Gregory XIII altered history from 1582 forward, not through the traditional sphere of papal activities but by introducing the Gregorian calendar.  It incorporated discoveries in astronomy, corrected cumulative errors from the Julian calendar, and added leap years to prevent further error.  " itemDesc="Pope Gregory XIII" iconUrl="images/icon/hero/577.png" price="0"/>
  <itemEum id="hero.taskitem.578" name="St. Hildebrand, Pope Gregory VII" itemType="任务" dayLimit="0" userLimit="0" desc="Pope Gregory VII argued for uniting the Christian churches of the west under the leadership of the Roman Catholic papacy. Many secular rulers opposed him, notably Holy Roman Emperor Henry IV. Gregory VII promoted moral reform of the Church and celibacy of the clergy until his death in 1085. " itemDesc="St. Hildebrand, Pope Gregory VII" iconUrl="images/icon/hero/578.png" price="0"/>
  <itemEum id="hero.taskitem.579" name="Sir Richard Grenville" itemType="任务" dayLimit="0" userLimit="0" desc="Grenville became a Member of Parliament in 1571 and, based on the plans of his cousin, Sir Walter Raleigh, led the failed expedition to colonize the island of Roanoke, Virginia. A noted naval commander, he provided three ships to the English fleet  against the Spanish Armada and died in 1591 in a battle against the Spanish off the Azores. " itemDesc="Sir Richard Grenville" iconUrl="images/icon/hero/579.png" price="0"/>
  <itemEum id="hero.taskitem.58" name="Gaius Plinius Caecilius Secundus" itemType="任务" dayLimit="0" userLimit="0" desc="Lawyer, author, and natural philosopher of Ancient Rome." itemDesc="Gaius Plinius Caecilius Secundus" iconUrl="images/icon/hero/58.png" price="0"/>
  <itemEum id="hero.taskitem.580" name="Sir Thomas Gresham" itemType="任务" dayLimit="0" userLimit="0" desc="A financier and diplomat, Sir Thomas Gresham founded the Royal Exchange. He influenced the economic policy of the court of Elizabeth I of England through his work with William Cecil, founded Gresham College in 1579, and started the series of public lectures that evolved into the Royal Society. " itemDesc="Sir Thomas Gresham" iconUrl="images/icon/hero/580.png" price="0"/>
  <itemEum id="hero.taskitem.581" name="Hugo Grotius" itemType="任务" dayLimit="0" userLimit="0" desc="A Dutch writer, jurist, diplomat, and scholar, Hugo Grotius  was imprisoned following a revolt, escaped to Paris, entered the Swedish diplomatic service, became Sweden's ambassador to France and wrote the first definitive book on international law. " itemDesc="Hugo Grotius" iconUrl="images/icon/hero/581.png" price="0"/>
  <itemEum id="hero.taskitem.582" name="Francesco Guicciardini" itemType="任务" dayLimit="0" userLimit="0" desc="In the service of Florence and the papacy, Francesco Guicciardini was a statesman and political writer. In 1536, he began writing a history of Italy from 1494 to 1534. It was a monumental contemporary history of Italy's wars with France.  " itemDesc="Francesco Guicciardini" iconUrl="images/icon/hero/582.png" price="0"/>
  <itemEum id="hero.taskitem.583" name="Robert Guiscard" itemType="任务" dayLimit="0" userLimit="0" desc="A son of Tancred de Hauteville, the Norman warrior Robert Guiscard and his brother Roger fought the Byzantines. On behalf of Pope Gregory VII, the brothers fought Holy Roman Emperor Henry IV and drove him out of Rome in 1084. " itemDesc="Robert Guiscard" iconUrl="images/icon/hero/583.png" price="0"/>
  <itemEum id="hero.taskitem.584" name="Claude de Lorraine. Duke of Guise" itemType="任务" dayLimit="0" userLimit="0" desc="A member of the prominent Guise branch of the French Royal family, Claude was created Duke of Guise in 1528 after many French military victories. Claude's brother Charles became Cardinal of Guise in 1550 and his sister Mary married James V of Scotland and gave birth to Mary, Queen of Scots. " itemDesc="Claude de Lorraine. Duke of Guise" iconUrl="images/icon/hero/584.png" price="0"/>
  <itemEum id="hero.taskitem.585" name="Francis de Lorraine, 2nd Duke of Guise" itemType="任务" dayLimit="0" userLimit="0" desc="Son of Claude de Lorraine, Francis commanded the armies of Henry II. He won Calais from the English in 1558 and was influential at the court of King Francis II. During the French Wars of Religion, Francis was assassinated in 1563.   " itemDesc="Francis de Lorraine, 2nd Duke of Guise" iconUrl="images/icon/hero/585.png" price="0"/>
  <itemEum id="hero.taskitem.586" name="Henry de Lorraine, 3rd Duke of Guise" itemType="任务" dayLimit="0" userLimit="0" desc="Son of Francis of Lorraine, Henry de Lorraine was the 3rd Duke of Guise.  He fought in the third and fourth French Wars of Religion and was an instigator of the St. Bartholomew's Day Massacre. When his name was put forward in 1588 as possible heir to the French throne, Henry III had him assassinated. " itemDesc="Henry de Lorraine, 3rd Duke of Guise" iconUrl="images/icon/hero/586.png" price="0"/>
  <itemEum id="hero.taskitem.587" name="Charles de Lorraine, 4th Duke of Guise" itemType="任务" dayLimit="0" userLimit="0" desc="Brother to Henry de Lorraine, Charles followed the family's extremist Catholic persuasion and kept their causes alive after the assassination of Henry in 1588. In 1595, he finally suborned to King Henry IV. The de Guise ducal family died out in 1688. " itemDesc="Charles de Lorraine, 4th Duke of Guise" iconUrl="images/icon/hero/587.png" price="0"/>
  <itemEum id="hero.taskitem.588" name="Guru Arjan Dev" itemType="任务" dayLimit="0" userLimit="0" desc="The fifth of the first ten leaders or gurus of the Sikh religion, Arjan Dev compiled the Sikh holy book called the Adi Granth and founded the Golden Temple at Amritsar. He was martyred by the Mogul Emperor Jahangir in 1606. " itemDesc="Guru Arjan Dev" iconUrl="images/icon/hero/588.png" price="0"/>
  <itemEum id="hero.taskitem.589" name="Guru Amar Das" itemType="任务" dayLimit="0" userLimit="0" desc="Amar Das was the third of the first ten great leaders or gurus of the Sikh religion, which was founded in India in the 15th century. Guru Amar Das introduced the concept of the communal kitchen or langar. As one of the ten Sikh gurus, Amar Das is believed to have achieved perfection and spiritual union with God. " itemDesc="Guru Amar Das" iconUrl="images/icon/hero/589.png" price="0"/>
  <itemEum id="hero.taskitem.59" name="Gaius Plinius Secundus" itemType="任务" dayLimit="0" userLimit="0" desc="Better known as Pliny the Elder, was an author, naturalist or natural philosopher as well as naval and army commander of the early Roman Empire and personal friend of the emperor Vespasian.           " itemDesc="Gaius Plinius Secundus" iconUrl="images/icon/hero/59.png" price="0"/>
  <itemEum id="hero.taskitem.590" name="Gustavus I" itemType="任务" dayLimit="0" userLimit="0" desc="Founder of the Vasa dynasty and the kingdom of Sweden, Gustavus fought against the Danes and was elected king of Sweden in 1523, ending his country's subordination to Denmark. He created a national army and navy, modernized Sweden's economy, and, for political reasons, broke from the Roman Catholic Church. " itemDesc="Gustavus I" iconUrl="images/icon/hero/590.png" price="0"/>
  <itemEum id="hero.taskitem.591" name="Gustavus II" itemType="任务" dayLimit="0" userLimit="0" desc="Known as Gustavus Adolphus, Gustavus II is remembered as Sweden's greatest king because of reforms he introduced in the economy, education, the armed forces, religion, and government. He kept the peace between the crown and the aristocracy but inherited conflicts with Denmark, Poland, and Russia. Gustavus II developed imperial designs for dominating the Baltic but was killed in battle in 1632.  " itemDesc="Gustavus II" iconUrl="images/icon/hero/591.png" price="0"/>
  <itemEum id="hero.taskitem.592" name="John Hampden" itemType="任务" dayLimit="0" userLimit="0" desc="John Hampden was an English politician who was a leading opponent of King Charles I. He refused to pay to support foreign wars and the Royal Navy and was imprisoned. As a member of Parliament, he helped organize the English Civil War and died in battle in 1643. " itemDesc="John Hampden" iconUrl="images/icon/hero/592.png" price="0"/>
  <itemEum id="hero.taskitem.593" name="Harold II" itemType="任务" dayLimit="0" userLimit="0" desc="Succeeding Edward I (the Confessor) to the English throne in 1066, Harold was the son of Earl Godwin of Wessex. When Harold's brother Tostig was dispossessed of the earldom of Northumbria, he invaded England with the help of Harald Hardrada of Norway. Harold defeated them at the battle of Stamford Bridge. He then marched to meet the invasion of William of Normandy and died in the Battle of Hastings. " itemDesc="Harold II" iconUrl="images/icon/hero/593.png" price="0"/>
  <itemEum id="hero.taskitem.594" name="Sir John Hawkins" itemType="任务" dayLimit="0" userLimit="0" desc="A premier English seaman, Sir John Hawkins led the first English slave-trading voyage from Africa to the West Indies in 1562. On the third voyage, his ships were attacked by the Spanish as tension between the two countries grew. He created the fleet that defeated the Spanish Armada and was third in command after Lord Howard of Effingham and Sir Francis Drake. He died on an expedition in 1595. " itemDesc="Sir John Hawkins" iconUrl="images/icon/hero/594.png" price="0"/>
  <itemEum id="hero.taskitem.595" name="Sir Richard Hawkins" itemType="任务" dayLimit="0" userLimit="0" desc="Son of Sir John Hawkins, Richard was also a naval commander. He served during the defeat of the Spanish Armada. On a voyage to establish English trade in eastern Asia, he plundered Valparaiso in the Spanish territories in South America, was captured, and ransomed in 1602. " itemDesc="Sir Richard Hawkins" iconUrl="images/icon/hero/595.png" price="0"/>
  <itemEum id="hero.taskitem.596" name="Toyotomi Hideyoshi" itemType="任务" dayLimit="0" userLimit="0" desc="The Japanese warrior Toyotomi Hideyoshi worked to unify the country when it was fragmented by rival families. He disarmed the peasant class, surveyed the land, built castles, and alternately trusted then persecuted Buddhists and Catholics. Planning to conquer China and its vassal state Korea, Hideyoshi captured Seoul. The Chinese Ming army later forced his retreat and defeated him at sea. " itemDesc="Toyotomi Hideyoshi" iconUrl="images/icon/hero/596.png" price="0"/>
  <itemEum id="hero.taskitem.597" name="Thomas Hobbes" itemType="任务" dayLimit="0" userLimit="0" desc="The leading English philosopher and political theorist at the time of the English Civil War, Hobbes was born in 1588 and educated at Oxford University. He was well-traveled and met the great thinkers of the age including Galileo and Descartes. His ideas on the state were published in 1651. Opposed to social contract theories, Hobbes's views seemed to support Oliver Cromwell's absolute rule. " itemDesc="Thomas Hobbes" iconUrl="images/icon/hero/597.png" price="0"/>
  <itemEum id="hero.taskitem.598" name="Richard Hooker" itemType="任务" dayLimit="0" userLimit="0" desc="Achieving early fame as a controversial preacher in London, Richard Hooker's theology later emphasized reason. In 1597, he wrote the first Anglican theology that systemized and justified the Church of England and its practices. Tudor churchmen and statesmen were influenced by Hooker's theology. " itemDesc="Richard Hooker" iconUrl="images/icon/hero/598.png" price="0"/>
  <itemEum id="hero.taskitem.599" name="Filips van Montmorency, Graaf van Hoorn" itemType="任务" dayLimit="0" userLimit="0" desc="A Flemish statesman and soldier, van Hoorn served Holy Roman Emperor Charles V and King Philip II of Spain but later joined the opposition. A colleague of Lamoral Egmont, he joined the Calvinist cause. In 1567, the Duke of Alba had him convicted of treason and van Hoorn was beheaded. " itemDesc="Filips van Montmorency, Graaf van Hoorn" iconUrl="images/icon/hero/599.png" price="0"/>
  <itemEum id="hero.taskitem.60" name="Publius Ovidius Naso" itemType="任务" dayLimit="0" userLimit="0" desc="Known as Ovid in the English-speaking world, was a Roman poet who wrote about love, seduction, and mythological transformation. " itemDesc="Publius Ovidius Naso" iconUrl="images/icon/hero/60.png" price="0"/>
  <itemEum id="hero.taskitem.600" name="Humayun" itemType="任务" dayLimit="0" userLimit="0" desc="The second Mogul emperor of India, Humayun ruled for 10 years before being driven into exile in Persia. When he returned, he brought Persian artists and scholars, Shiite religious influences, and the Persian language to his court. " itemDesc="Humayun" iconUrl="images/icon/hero/600.png" price="0"/>
  <itemEum id="hero.taskitem.601" name="Francisco de Ibarra" itemType="任务" dayLimit="0" userLimit="0" desc="An explorer and conquistador from Spain's Basque country, Ibarra colonized a huge part of Mexico called Nueva Vizcaya that includes the modern states of Chihuahua, Sonora, and Durango. He opened the northern frontier of New Spain in the 1560s. " itemDesc="Francisco de Ibarra" iconUrl="images/icon/hero/601.png" price="0"/>
  <itemEum id="hero.taskitem.602" name="Shah Ismail I Safavi" itemType="任务" dayLimit="0" userLimit="0" desc="Shah Ismail I established the Safavid dynasty in Persia and extended it into Kurdistan. He pushed the Uzbeks out of northeast Persia but was stopped by the Ottomans in the west. Ismail's lasting legacy was converting Persia from Sunni to Shiite Islam. " itemDesc="Shah Ismail I Safavi" iconUrl="images/icon/hero/602.png" price="0"/>
  <itemEum id="hero.taskitem.603" name="Ivan III the Great of Russia" itemType="任务" dayLimit="0" userLimit="0" desc="Known as Ivan the Great, Ivan III was Grand Prince of Muscovy and, in 1497, claimed the title 'Ruler of all Russia'.  He expanded the country's territory, became independent of the Tartars, and subjugated Baltic territories including Lithuania. Ivan introduced a legal code and claimed leadership of the Eastern Orthodox Church before he died in 1505. " itemDesc="Ivan III the Great of Russia" iconUrl="images/icon/hero/603.png" price="0"/>
  <itemEum id="hero.taskitem.604" name="Ivan IV of Russia" itemType="任务" dayLimit="0" userLimit="0" desc="The first to assume the title Tsar of Russia, Ivan IV became known as 'Ivan the Terrible' because of a reign of terror he began in 1564 against the boyars (nobles). He expanded Russia in campaigns against the Mongols and in Siberia and instituted legal and administrative reforms. He left Russia in turmoil by killing his heir in a fit of rage. His son Fyodor succeeded to the throne, but power fell into the hands of the regent, Boris Godunov. " itemDesc="Ivan IV of Russia" iconUrl="images/icon/hero/604.png" price="0"/>
  <itemEum id="hero.taskitem.605" name="Alfgifu of Northampton" itemType="任务" dayLimit="0" userLimit="0" desc="The first wife of King Canuteand mother of Harold I (known as Harefoot), ?lfgifu came from a distinguished English family. She married Canute in 1013, and, although the king later married Emma, ?lfgifu remained a power at court, represented Canute in Norway in 1030, and was probably the force behind Harold during his reign. " itemDesc="?lfgifu of Northampton" iconUrl="images/icon/hero/605.png" price="0"/>
  <itemEum id="hero.taskitem.606" name="Emma of Normandy" itemType="任务" dayLimit="0" userLimit="0" desc="Emma was the daughter of Count Richard I of the Normans. She first married Ethelred II (the Unready) and then Canute, who supplanted Ethelred as King of England. Emma was the mother of Edward I (the Confessor) and of Harthacanute. She established the dynastic links between Normandy and England, which led to the Norman Conquest. She was known for her political savvy and manipulative personality. " itemDesc="Emma of Normandy" iconUrl="images/icon/hero/606.png" price="0"/>
  <itemEum id="hero.taskitem.607" name="Elfthryth" itemType="任务" dayLimit="0" userLimit="0" desc="Elfthryth was the second wife of King Edgar and mother of Ethelred II (the Unready). She may have conspired to have Edward the Martyr (her stepson) murdered so Ethelred could become king. She was influential at court until her death in 1000, but her strength of character was not enough to compensate for the weak will of Ethelred. " itemDesc="Elfthryth" iconUrl="images/icon/hero/607.png" price="0"/>
  <itemEum id="hero.taskitem.608" name="Anne of Denmark" itemType="任务" dayLimit="0" userLimit="0" desc="Daughter of Frederick II of Denmark and Norway, Anne became the wife of James VI of Scotland after a 4-year-long negotiation that was obstructed by Elizabeth I. When her husband became James I of England, Anne indulged in extravagant support of the arts and architecture. " itemDesc="Anne of Denmark" iconUrl="images/icon/hero/608.png" price="0"/>
  <itemEum id="hero.taskitem.609" name="Christina of Markyate" itemType="任务" dayLimit="0" userLimit="0" desc="Born in 1097, Christina was forced into marriage by her wealthy family. She fled, went into hiding, and formally joined a religious community becoming prioress of Markyate and spiritual adviser to the abbot of St. Albans. " itemDesc="Christina of Markyate" iconUrl="images/icon/hero/609.png" price="0"/>
  <itemEum id="hero.taskitem.61" name="Diogenes Laertios" itemType="任务" dayLimit="0" userLimit="0" desc="Biographer of the Greek philosophers, is supposed by some to have received his surname from the town of Laerte in Cilicia, Asia Minor, and by others from the Roman family of the Laertii.  " itemDesc="Diogenes Laertios" iconUrl="images/icon/hero/61.png" price="0"/>
  <itemEum id="hero.taskitem.610" name="Jahangir" itemType="任务" dayLimit="0" userLimit="0" desc="A Mogul emperor of India, Jahangir had little interest in warfare or politics but favored the arts. His Persian wife dominated a quarrelsome court, while he encouraged his court painters in the pursuit of naturalism in their works. English ambassadors visited Jahangir's court during his reign from 1605 t0 1627. " itemDesc="Jahangir" iconUrl="images/icon/hero/610.png" price="0"/>
  <itemEum id="hero.taskitem.611" name="Cornelius Otto Jansen" itemType="任务" dayLimit="0" userLimit="0" desc="A Dutch bishop, Jansen founded a Catholic school of theology called Jansenism. He was named Bishop of Ypres in 1636 and wrote a life of St. Augustine of Hippo that was condemned by Pope Innocent X and the Sorbonne after Jansen's death. " itemDesc="Cornelius Otto Jansen" iconUrl="images/icon/hero/611.png" price="0"/>
  <itemEum id="hero.taskitem.612" name="John Jewel" itemType="任务" dayLimit="0" userLimit="0" desc="John Jewel encountered Protestantism at Oxford University and fled England during the reign of fiercely Catholic Mary I. When Elizabeth I became queen, Jewel returned and was consecrated Bishop of Salisbury in 1560. His writing established his prominence in the early Anglican Church. " itemDesc="John Jewel" iconUrl="images/icon/hero/612.png" price="0"/>
  <itemEum id="hero.taskitem.613" name="John III of Portugal" itemType="任务" dayLimit="0" userLimit="0" desc="A fanatical Catholic who supported the Inquisition, John III (known as John the Pious') established the Hapsburg claim to the Portuguese throne by marrying the sister of Holy Roman Emperor Charles V. John III enhanced Portugal's global status through exploration of Brazil, trade with Siam, and claiming the Moluccas. " itemDesc="John III of Portugal" iconUrl="images/icon/hero/613.png" price="0"/>
  <itemEum id="hero.taskitem.614" name="Don John of Austria" itemType="任务" dayLimit="0" userLimit="0" desc="Illegitimate son of Holy Roman Emperor Charles V and half-brother of Philip II of Spain, John of Austria pursued a military career. In command of the Spanish navy and the Holy League fleet, he defeated the Turks at Lepanto in 1571. He led the Spanish in the conquest of Tunis in 1573, but, as governor-general of the Netherlands, he had no patience with negotiations during the Dutch Revolts, which resumed in 1577. " itemDesc="Don John of Austria" iconUrl="images/icon/hero/614.png" price="0"/>
  <itemEum id="hero.taskitem.615" name="St. John of the Cross" itemType="任务" dayLimit="0" userLimit="0" desc="A Spanish Carmelite monk born Juan de Yepes Alvarez, St. John of the Cross assisted St. Teresa of Avila in founding the Order of the Discalced Carmelites. He wrote mystical poetry respected for its intellectualism. " itemDesc="St. John of the Cross" iconUrl="images/icon/hero/615.png" price="0"/>
  <itemEum id="hero.taskitem.616" name="Guiliano della Rovere, Pope Julius II" itemType="任务" dayLimit="0" userLimit="0" desc="Named Pope in 1503, Julius II established a strong papacy that was independent of Italian nobles, notably Cesare Borgia, and restored and enlarged the Papal States. He established the Holy League in 1510 in opposition to the French who were forced out of Italy in 1512. Julius II also dispatched missionaries to Africa, India, and the Americas and was a patron of the arts and artists including Michelangelo and Raphael. " itemDesc="Guiliano della Rovere, Pope Julius II" iconUrl="images/icon/hero/616.png" price="0"/>
  <itemEum id="hero.taskitem.617" name="Kabir" itemType="任务" dayLimit="0" userLimit="0" desc="The son of a Brahmin Hindu mother, it is believed Kabir was adopted by a Muslim weaver. He became a mystic preacher who believed in the unity of all religions. Kabir rejected caste and embraced oneness with God in his mystical poems. One of his disciples founded the Sikh religion. " itemDesc="Kabir" iconUrl="images/icon/hero/617.png" price="0"/>
  <itemEum id="hero.taskitem.618" name="Bartolome de Las Casas" itemType="任务" dayLimit="0" userLimit="0" desc="A Dominican friar, de Las Casas was a Spanish missionary who gained fame as 'the Apostle of the Indies'. As a settler in Hispaniola in 1502 and member of the expedition to Cuba in 1511-1512, he witnessed the exploitation of the natives by their Spanish conquerors. His writings, travels, and campaigns for humanitarian reform led to the New Laws of 1542. " itemDesc="Bartolome de Las Casas" iconUrl="images/icon/hero/618.png" price="0"/>
  <itemEum id="hero.taskitem.619" name="Hugh Latimer" itemType="任务" dayLimit="0" userLimit="0" desc="A martyr to the Anglican Church, Hugh Latimer was appointed Bishop of Worcester by Henry VIII in 1535. An outspoken Protestant preacher and opponent of social injustice, Latimer found favor with Henry VIII and Edward VI but was denounced as a heretic by Mary I and her followers. He refused exile abroad and, with Thomas Cranmer and Nicholas Ridley, was burned at the stake in 1555. " itemDesc="Hugh Latimer" iconUrl="images/icon/hero/619.png" price="0"/>
  <itemEum id="hero.taskitem.62" name="Lukianos" itemType="任务" dayLimit="0" userLimit="0" desc="One of the advocates of civilized society. He was an excellent city planner.    " itemDesc="Lukianos" iconUrl="images/icon/hero/62.png" price="0"/>
  <itemEum id="hero.taskitem.620" name="William Laud" itemType="任务" dayLimit="0" userLimit="0" desc="Ordained in 1601, William Laud was promoted to the bishopric of St. David's, and, as a familiar of the Duke of Buckingham, found preferment at the court of James I. As Bishop of London, he became a close adviser to Charles I and Archbishop of Canterbury in 1633. Arrested and executed by Parliament, his rigid doctrines, plotting, and court intrigue helped spark the English Civil War. " itemDesc="William Laud" iconUrl="images/icon/hero/620.png" price="0"/>
  <itemEum id="hero.taskitem.621" name="Mahmud of Ghazna" itemType="任务" dayLimit="0" userLimit="0" desc="Leader of the Ghaznavid Dynasty of Afghanistan and Khurasan until 1030, Mahmud raided northern India, Mesopotamia, and Persia to extend Islam. His 17 invasions into India weakened Hindu power opening the subcontinent for Muslim conquest. " itemDesc="Mahmud of Ghazna" iconUrl="images/icon/hero/621.png" price="0"/>
  <itemEum id="hero.taskitem.622" name="St. Leo IX" itemType="任务" dayLimit="0" userLimit="0" desc="As Pope Leo IX from 1048 to 1054, this church reformer enforced celibacy on all clerics and opposed the practice of simony. His military forces tried to control southern Italy , which caused a break between the Byzantine or Eastern branch of the Catholic Church and the Roman or Western portion. Leo was defeated by the Normans and imprisoned. He was named a saint for restoring prestige to the papacy. " itemDesc="St. Leo IX" iconUrl="images/icon/hero/622.png" price="0"/>
  <itemEum id="hero.taskitem.623" name="St. Ignatius Loyola" itemType="任务" dayLimit="0" userLimit="0" desc="Originally a military commander for Ferdinand II of Aragon, Ignatius experienced a spiritual epiphany leading to a pilgrimage to Jerusalem, prayer, penance, and the writing of a set of spiritual exercises. He took vows in 1534 and his 'Society of Jesus' was recognized by Pope Paul II as an order of the Church. By his death in 1556, Jesuits were preaching throughout Europe and in foreign missions. " itemDesc="St. Ignatius Loyola" iconUrl="images/icon/hero/623.png" price="0"/>
  <itemEum id="hero.taskitem.624" name="Malcolm III of Scotland" itemType="任务" dayLimit="0" userLimit="0" desc="After Macbeth murdered Malcolm's father, Duncan I, Malcolm was raised in the English court of Edward the Confessor. Malcolm had English support in defeating Macbeth in battle twice and finally slaying him in 1057 to become King of Scotland. He supported Saxon exiles during the Norman Conquest, prompting William the Conqueror to invade Scotland in 1072. In turn, Malcolm invaded England five times, dying in battle in 1093. " itemDesc="Malcolm III of Scotland" iconUrl="images/icon/hero/624.png" price="0"/>
  <itemEum id="hero.taskitem.625" name="Robert Devereux, 3rd Earl of Essex" itemType="任务" dayLimit="0" userLimit="0" desc="The 3rd Earl of Essex was a soldier in service to Charles I until 1625 when he changed allegiance and joined the Roundheads. In 1642, Devereux was appointed commander of the Roundhead Army at the key Battle of Edgehill. The defeats that followed led to creation of the New Model Army that merged the provincial forces. Devereux resigned his command and retired.  " itemDesc="Robert Devereux, 3rd Earl of Essex" iconUrl="images/icon/hero/625.png" price="0"/>
  <itemEum id="hero.taskitem.626" name="Ethelred II the Unready" itemType="任务" dayLimit="0" userLimit="0" desc="Ethelred's reign began in 978 with murder. His mother Alfrida instigated the murder of St. Edward the Martyr, Ethelred's stepbrother and reigning king of England. Lacking good advisors (and thus 'unready'), Ethelred blundered his way through his early years on the throne while the Danes attacked routinely. Ethelred bought them off in silver with Danegeld, raised by taxing the people. In 1002, he tried to have all the Danes in England massacred. The King of Denmark invaded in 1013 and reigned until his death when Ethelred again became king until his own demise. " itemDesc="Ethelred II the Unready" iconUrl="images/icon/hero/626.png" price="0"/>
  <itemEum id="hero.taskitem.627" name="Edmund Spenser" itemType="任务" dayLimit="0" userLimit="0" desc="Cambridge scholar Edmund Spenser is best known for his long, allegorical poems and sonnets. He spent some years as secretary to the Lord Deputy of Ireland where he wrote his tribute to Queen Elizabeth I, The Faerie Queene. " itemDesc="Edmund Spenser" iconUrl="images/icon/hero/627.png" price="0"/>
  <itemEum id="hero.taskitem.628" name="Christopher Marlowe" itemType="任务" dayLimit="0" userLimit="0" desc="Christopher Marlowe was a man of action and letters whose plays and poems are filled with the drama that characterized his life. His pastoral, lyric poems influenced contemporaries like Sir Walter Raleigh. Marlowe's dramas were innovative in focusing on a central powerful character with a lust for life. Marlowe died in a tavern brawl in 1593 at age 30. " itemDesc="Christopher Marlowe" iconUrl="images/icon/hero/628.png" price="0"/>
  <itemEum id="hero.taskitem.629" name="Sir Philip Sidney" itemType="任务" dayLimit="0" userLimit="0" desc="Sir Philip Sidney embodied the ideal of the complete Renaissance man. Aristocratic, well-educated, and a gallant soldier, he knew all the outstanding thinkers of his day. Sidney wrote poetry and prose fiction. After his death of a war wound in 1586, more than 200 elegies were written by notables like Spenser and the future King James I. " itemDesc="Sir Philip Sidney" iconUrl="images/icon/hero/629.png" price="0"/>
  <itemEum id="hero.taskitem.63" name="Titus Lucretius Carus" itemType="任务" dayLimit="0" userLimit="0" desc="Roman poet and philosopher. Lucretius has also had a marked influence upon modern philosophy.           " itemDesc="Titus Lucretius Carus" iconUrl="images/icon/hero/63.png" price="0"/>
  <itemEum id="hero.taskitem.630" name="Ben Jonson" itemType="任务" dayLimit="0" userLimit="0" desc="Ben Jonson fought the Spaniards in Flanders, returned to England and joined an acting company, and was a member of the Lord Chamberlain's company with William Shakespeare. Human nature fascinated both playwrights, but Jonson specialized in satires like Volpone ('The Fox'). He also wrote masques and poetry, and his fellow writers esteemed him as 'O Rare Ben Jonson'. " itemDesc="Ben Jonson" iconUrl="images/icon/hero/630.png" price="0"/>
  <itemEum id="hero.taskitem.631" name="Pieter Bruegel (the Elder)" itemType="任务" dayLimit="0" userLimit="0" desc="Bruegel studied art in Antwerp as a designer of religious scenes, allegorical etchings, and landscape prints. His first paintings were completed in 1559, and those best known were painted in the court center of Brussels were he moved in1562. " itemDesc="Pieter Bruegel (the Elder)" iconUrl="images/icon/hero/631.png" price="0"/>
  <itemEum id="hero.taskitem.632" name="Michelangelo Merisi da Caravaggio" itemType="任务" dayLimit="0" userLimit="0" desc="After studying in Milan, Caravaggio moved to Rome in 1592 where he painted brilliantly colored portraits, naturalistic religious works for the churches of Rome, and contemporary scenes with amazing lighting contrasts. After killing a man in a brawl, he fled Rome  worked in Sicily, Naples and Malta on tragic religious art. " itemDesc="Michelangelo Merisi da Caravag" iconUrl="images/icon/hero/632.png" price="0"/>
  <itemEum id="hero.taskitem.633" name="Vittore Carpaccio" itemType="任务" dayLimit="0" userLimit="0" desc="Son of a leather merchant, Carpaccio traveled widely, perhaps even to the Orient, and painted works with religious themes set against landscapes drawn from his travels. He died in his native Venice in about 1523. " itemDesc="Vittore Carpaccio" iconUrl="images/icon/hero/633.png" price="0"/>
  <itemEum id="hero.taskitem.634" name="Antonio Allegri Correggio" itemType="任务" dayLimit="0" userLimit="0" desc="Famed across northern Italy, Correggio painted altarpieces and dome frescoes for several churches in Parma. His greatest works, however, were mythological paintings and drawings completed from 1520-34 that influenced other Italian artists. " itemDesc="Antonio Allegri Correggio" iconUrl="images/icon/hero/634.png" price="0"/>
  <itemEum id="hero.taskitem.635" name="Lucas Cranach (the Elder)" itemType="任务" dayLimit="0" userLimit="0" desc="Court painter to Duke Frederick the Wise of Saxony, Cranach's wood cuts and court portraits were eclipsed by his religious subjects and their landscape backgrounds. In 1520, he met court chaplain Martin Luther and created the portraits and engravings of the Reformer and altarpieces for Lutheran churches. " itemDesc="Lucas Cranach (the Elder)" iconUrl="images/icon/hero/635.png" price="0"/>
  <itemEum id="hero.taskitem.636" name="Gerard David" itemType="任务" dayLimit="0" userLimit="0" desc="David was master of the painters' guild in Bruges beginning in 1484. His altarpieces for churches in Bruges are his most recognized artworks. He was later a master in the painters' guild of Antwerp. " itemDesc="Gerard David" iconUrl="images/icon/hero/636.png" price="0"/>
  <itemEum id="hero.taskitem.638" name="Giorgione (Giorgio da Castelfranco)" itemType="任务" dayLimit="0" userLimit="0" desc="A Venetian painter at the court of Caterina Cornaro, the so-called 'Queen of Cyprus', Giorgione was a singer, lutist, and painter. Best known for portraits, altarpieces, and frescoes, Giorgione spent his life in Venice. " itemDesc="Giorgione (Giorgio da Castelfranco)" iconUrl="images/icon/hero/638.png" price="0"/>
  <itemEum id="hero.taskitem.639" name="El Greco (Domenicos Theotocopoulos)" itemType="任务" dayLimit="0" userLimit="0" desc="El Greco was born in Crete in 1541 and trained as an icon painter. Influenced by Titian and Michelangelo, El Greco moved to Toledo, Spain, where he primarily painted religious subjects for churches. His highly recognizable style blended Byzantine iconography with western influences. " itemDesc="El Greco (Domenicos Theotocopoulos)" iconUrl="images/icon/hero/639.png" price="0"/>
  <itemEum id="hero.taskitem.64" name="Abbas I" itemType="任务" dayLimit="0" userLimit="0" desc="Abbas I, Shah of Persia from 1588 to 1629, tamed the Turcoman tribes within Persia in order to drive the Uzbeks from the north-east and the Ottomans from the west in a series of wars over Mesopotamia. Securing territory for Persia and nurturing the arts throughout his reign earned him recognition as 'Abbas the Great'.  " itemDesc="Abbas I" iconUrl="images/icon/hero/64.png" price="0"/>
  <itemEum id="hero.taskitem.640" name="Mathis Grunewald" itemType="任务" dayLimit="0" userLimit="0" desc="Court painter to the prince-bishops of Mainz in Franconia, 'Mathis the painter' also designed many fountains. Caught up in the 1525 Peasants' Revolt in Germany during the Reformation, he moved many times and also worked in Frankfurt and Halle. " itemDesc="Mathis Grunewald" iconUrl="images/icon/hero/640.png" price="0"/>
  <itemEum id="hero.taskitem.641" name="Frans Hals" itemType="任务" dayLimit="0" userLimit="0" desc="Hals was born in Haarlem and spent his lifetime there. Although he painted some scenes with religious themes, Hals's skill was in portraiture, and he completed portraits of the cream of Haarlem society. Five of his sons were also artists. " itemDesc="Frans Hals" iconUrl="images/icon/hero/641.png" price="0"/>
  <itemEum id="hero.taskitem.642" name="Hans Holbein (the Younger)" itemType="任务" dayLimit="0" userLimit="0" desc="Trained by his father, Holbein worked in Basle, Lucerne, and northern Italy. He visited London in 1526 and moved there in 1532. A proponent of religious reform, he came under the protection of Anne Boleyn and his portraits of the Royals document an age. Gifted, versatile, and respected Holbein also designed jewelry, book illustrations, wall paintings, and royal pageants. " itemDesc="Hans Holbein (the Younger)" iconUrl="images/icon/hero/642.png" price="0"/>
  <itemEum id="hero.taskitem.643" name="Georges de La Tour" itemType="任务" dayLimit="0" userLimit="0" desc="Spending his working life in Lunéville in the duchy of Lorraine, La Tour's career was disrupted by disastrous wars in the region. An original, individual style of religious paintings and genre works arose from this conflict. Largely forgotten after his death in 1652, La Tour's paintings enjoyed a rebirth in popularity in the 20th century. " itemDesc="Georges de La Tour" iconUrl="images/icon/hero/643.png" price="0"/>
  <itemEum id="hero.taskitem.644" name="Lorenzo Lotto" itemType="任务" dayLimit="0" userLimit="0" desc="Lotto trained in Venice but worked in cities throughout Italy. Although he painted religious subjects, he was famed for insightful portraits done in a unique style atypical of the Venetian school. " itemDesc="Lorenzo Lotto" iconUrl="images/icon/hero/644.png" price="0"/>
  <itemEum id="hero.taskitem.645" name="Andrea Mantegna" itemType="任务" dayLimit="0" userLimit="0" desc="A great artist of the early Italian Renaissance, Mantegna achieved fame as court painter to Ludovico Gonzaga of Mantua. He glorified the family and the Church through frescoes and portraits in his inventive style. A student of classical antiquity, he was himself a teacher to many other painters including Bellini before his death in 1506. " itemDesc="Andrea Mantegna" iconUrl="images/icon/hero/645.png" price="0"/>
  <itemEum id="hero.taskitem.646" name="Joachim Patinir" itemType="任务" dayLimit="0" userLimit="0" desc="Joachim Patinir may have trained with Gerard David in Bruges. In 1515, he became a master of the Antwerp painters'  guild, and he was a friend of Albrecht  Dürer. " itemDesc="Joachim Patinir" iconUrl="images/icon/hero/646.png" price="0"/>
  <itemEum id="hero.taskitem.647" name="Nicholas Poussin" itemType="任务" dayLimit="0" userLimit="0" desc="Founder of the French classical tradition in painting, Poussin was born in Normandy in 1594 but his career took him to Rome and to Paris to work for Louis XIII. His early style resembled Titian and the Venetian school and his later works more like those of Raphael. He painted a wide range of subjects primarily on private commission. " itemDesc="Nicholas Poussin" iconUrl="images/icon/hero/647.png" price="0"/>
  <itemEum id="hero.taskitem.648" name="Raphael (Raffaello Sanzio)" itemType="任务" dayLimit="0" userLimit="0" desc="Born Raffaello Sanzio in Urbino in 1483, Raphael trained with Perugino in Perugia then worked in Florence. In 1508, Raphael moved to Rome where he served as painter and architect to Pope Julius II and Pope Leo X. Raphael produced frescoes, altarpieces, tapestries and buildings but is best known for his many paintings of the Virgin and Child.  " itemDesc="Raphael (Raffaello Sanzio)" iconUrl="images/icon/hero/648.png" price="0"/>
  <itemEum id="hero.taskitem.649" name="St. Francis Xavier" itemType="任务" dayLimit="0" userLimit="0" desc="A Jesuit missionary who became known as 'the apostle of the Indies', Spanish-born Francis Xavier worked among the lepers in Goa, India. He also made thousands of converts in the Moluccas and Japan. " itemDesc="St. Francis Xavier" iconUrl="images/icon/hero/649.png" price="0"/>
  <itemEum id="hero.taskitem.65" name="Abel of Denmark" itemType="任务" dayLimit="0" userLimit="0" desc="Abel of Denmark was the King of Denmark from 1250 until his death in 1252. He reign was one of the shortest of any Danish ruler. Duke Abel fought against his brother, King Erik Ploughpenny, made peace with him, but eventually murdered Erik while was a guest at Duke Abel's residence at Schleswig. His early death was seen by the people of Denmark as God's judgement on him for the murder of his brother. Abel by name, Cain by his deeds (Danish, Abel af navn, Kain af gavn), was the saying.  " itemDesc="Abel of Denmark" iconUrl="images/icon/hero/65.png" price="0"/>
  <itemEum id="hero.taskitem.650" name="Juan Sanchez Cotan" itemType="任务" dayLimit="0" userLimit="0" desc="Born near Toledo in 1560, Sánchez Cotán was one of the first great painters of still lifes. In 1603, he joined the Carthusians as a lay brother and, at the Charterhouse in Granada, he painted religious subjects and scenes related to the Carthusians. " itemDesc="Juan Sanchez Cotan" iconUrl="images/icon/hero/650.png" price="0"/>
  <itemEum id="hero.taskitem.651" name="Il Sassetta (Stefano di Giovanni)" itemType="任务" dayLimit="0" userLimit="0" desc="Born Stefano di Giovanni in 1423 in Siena, Sassetta spent all of his life in Siena where the prolific artist painted frescoes and wall panels, illustrated manuscripts, designed the inlaid pavement of the cathedral, and produced banners and design art for church ornaments. " itemDesc="Il Sassetta (Stefano di Giovanni)" iconUrl="images/icon/hero/651.png" price="0"/>
  <itemEum id="hero.taskitem.652" name="Tintoretto (Jacopo Comin Robusti)" itemType="任务" dayLimit="0" userLimit="0" desc="Jacopo Comin (nicknamed Robusti and later known as Tintoretto) was born in Venice in 1518. The son of a dyer, he painted cycles of works for religious groups called scuoles and portraits and landscapes for Venetian patrons. He became the leading portrait painter for the Venetian nobility, but the bulk of his work was dramatic, large-scale religious paintings. " itemDesc="Tintoretto (Jacopo Comin Robusti)" iconUrl="images/icon/hero/652.png" price="0"/>
  <itemEum id="hero.taskitem.653" name="Titian (Tiziano Vecellio)" itemType="任务" dayLimit="0" userLimit="0" desc="Tiziano Vecellio who became known as Titian was born near Cortina in about 1488. His career was spent in Venice where he became the city's leading painter and subsequently a key figure in the Italian Renaissance. The  Duke of Ferrara became his patron in 1516 and introduced Titian to nobility throughout Europe. Titian painted artwork for Holy Roman Emperor Charles V and  King Philip II of Spain, among many others. " itemDesc="Titian (Tiziano Vecellio)" iconUrl="images/icon/hero/653.png" price="0"/>
  <itemEum id="hero.taskitem.654" name="Anthony Van Dyck" itemType="任务" dayLimit="0" userLimit="0" desc="Van Dyck was born in 1599 in Antwerp. Though trained by others, he was greatly influenced by Peter Paul Rubens. Visiting England and Italy, he became a leading portraitist of the Genoese. In 1632, he returned to England to become court painter for King Charles I. Known for his portraits, Van Dyck also painted mythological and classical subjects and religious artwork. " itemDesc="Anthony Van Dyck" iconUrl="images/icon/hero/654.png" price="0"/>
  <itemEum id="hero.taskitem.655" name="Diego de Silva Velázquez" itemType="任务" dayLimit="0" userLimit="0" desc="A native of Seville, Velázquez was the court painter to Philip IV of Spain from 1623 until his death in 1660. Influenced by Rubens, Tintoretto, and Titian, he produced still lifes, portraits, historical and classical works, and religious paintings. Velázquez had a unique style featuring loose brushstrokes and great expression that influenced painters for generations. " itemDesc="Diego de Silva Velázquez" iconUrl="images/icon/hero/655.png" price="0"/>
  <itemEum id="hero.taskitem.656" name="Paolo Veronese" itemType="任务" dayLimit="0" userLimit="0" desc="Born Paolo Caliari in Verona in 1528, Veronese relocated to Venice in 1555. Certainly influenced by Titian, Veronese established his own luminous style. He produced large canvases for the Doge's Palace and Venetian churches but may be best known for his portraits and mythological subjects. " itemDesc="Paolo Veronese" iconUrl="images/icon/hero/656.png" price="0"/>
  <itemEum id="hero.taskitem.657" name="Lamoral Egmont, Count of Gavre" itemType="任务" dayLimit="0" userLimit="0" desc="Made governor of Flanders and Artois in 1559, Egmont was a member of the regency council of Philip II of Spain. He opposed the king's plan to impose Spanish government and Roman Catholicism on the Netherlands. His beliefs wavered during the Dutch Revolts, however, and he was seized in 1567 and beheaded for treason. " itemDesc="Lamoral Egmont, Count of Gavre" iconUrl="images/icon/hero/657.png" price="0"/>
  <itemEum id="hero.taskitem.658" name="Pope Paul III (Alessandro Farnese)" itemType="任务" dayLimit="0" userLimit="0" desc="A member of an ancient Italian family, Alessandro Farnese became Pope Paul III in 1534 and created the Duchy of Parma and Piacenza, which his family ruled. He had his grandson, also named Alessandro, created a cardinal when the boy was only 14. " itemDesc="Pope Paul III (Alessandro Farnese)" iconUrl="images/icon/hero/658.png" price="0"/>
  <itemEum id="hero.taskitem.659" name="Alessandro Farnese, Duke of Parma" itemType="任务" dayLimit="0" userLimit="0" desc="Duke of Parma from 1586, Farnese was a statesman, diplomat, and superb military campaigner during the Dutch Revolt, the Spanish Armada, and the French Wars of Religion. He battled the Ottomans at Lepanto in 1571, became governor-general of the Netherlands and commander of the Spanish forces, and was wounded and died in France.. " itemDesc="Alessandro Farnese, Duke of Parma" iconUrl="images/icon/hero/659.png" price="0"/>
  <itemEum id="hero.taskitem.66" name="Abu al-Makarim" itemType="任务" dayLimit="0" userLimit="0" desc="Abu al-Makarim was a priest in the Coptic Orthodox Church in Egypt, who authored a famous work in late 13th century entitled 'The History of Churches and Monasteries'. His writings are considered one of the best sources of information on the Coptic Church and life in Middle East in the 13th century. A photographic copy of the oldest manuscript of his work is stored in the Coptic Museum in Cairo. " itemDesc="Abu al-Makarim" iconUrl="images/icon/hero/66.png" price="0"/>
  <itemEum id="hero.taskitem.660" name="Guy Fawkes" itemType="任务" dayLimit="0" userLimit="0" desc="A conspirator in the Gunpowder Plot to murder James I by blowing up the Houses of Parliament in 1605, Fawkes was a Roman Catholic and member of a group called Recusants who felt violence was the only way to gain attention for and toleration of English Catholics. Of the conspirators, history remembers Fawkes because he was caught 'red-handed' guarding the barrels of gunpowder in the cellar of the House of Lords. Fawkes and seven others were tried and executed in 1606. " itemDesc="Guy Fawkes" iconUrl="images/icon/hero/660.png" price="0"/>
  <itemEum id="hero.taskitem.661" name="Stephen Gardiner" itemType="任务" dayLimit="0" userLimit="0" desc="Bishop of Winchester and protégé of Cardinal Thomas Wolsey, Gardiner helped Henry VIII divorce Catherine of Aragon. In favor of royal oversight of the Church, Gardiner opposed Protestantism and was imprisioned by Edward VI. Mary I restored his bishopric and made him her Lord Chancellor until his death in 1555. " itemDesc="Stephen Gardiner" iconUrl="images/icon/hero/661.png" price="0"/>
  <itemEum id="hero.taskitem.662" name="Ferdinand V of Spain (Ferdinand II of Castile)" itemType="任务" dayLimit="0" userLimit="0" desc="King of Castile and León, Aragon (as Ferdinand II), Sicily, and Naples, Ferdinand's marriage to Isabella helped lead to Spain's unification. An expert in foreign policy, he acquired Naples by outfoxing the French. He modernized Spanish government and won many concessions from the papacy. Known for his wisdom in backing the journeys of Columbus, Ferdinand also sought to control heresy through the Spanish Inquisition. " itemDesc="Ferdinand V of Spain (Ferdinand II of Castile)" iconUrl="images/icon/hero/662.png" price="0"/>
  <itemEum id="hero.taskitem.663" name="John Foxe" itemType="任务" dayLimit="0" userLimit="0" desc="An English clergyman, Foxe wrote a history of the persecution of Christians especially English Protestant martyrs. His 1563 book--illustrated with sensational woodcuts--aroused much interest amongst the clergy and the government. It was banned by William Laud, Anglican Archbishop of Canterbury. " itemDesc="John Foxe" iconUrl="images/icon/hero/663.png" price="0"/>
  <itemEum id="hero.taskitem.664" name="Francis I" itemType="任务" dayLimit="0" userLimit="0" desc="King of France from 1515 to 1547, Francis's personality and reign were characterized by great contrast. A witty patron of the arts and education and true Renaissance Prince, Francis warred with the Hapsburgs and failed to become Holy Roman Emperor. Captured and imprisoned by the Spanish, Francis blamed many of his difficulties on the Protestants whom he persecuted ruthlessly. " itemDesc="Francis I" iconUrl="images/icon/hero/664.png" price="0"/>
  <itemEum id="hero.taskitem.665" name="Geoffrey of Monmouth" itemType="任务" dayLimit="0" userLimit="0" desc="Bishop of St. Asaph in Wales, Geoffrey of Monmouth is best remembered by history as the author of a history of the kings of Britain that was published in 1136. He touted King Arthur as a national hero who drove out Saxon raiders in post-Roman Britain. " itemDesc="Geoffrey of Monmouth" iconUrl="images/icon/hero/665.png" price="0"/>
  <itemEum id="hero.taskitem.666" name="Sir Humphrey Gilbert" itemType="任务" dayLimit="0" userLimit="0" desc="An English soldier and navigator, Sir Humphrey Gilbert established the first English colony in North America in Newfoundland in 1583. Half-brother to Sir Walter Raleigh, he wrote a discourse on his passionate search for the Northwest Passage to China. " itemDesc="Sir Humphrey Gilbert" iconUrl="images/icon/hero/666.png" price="0"/>
  <itemEum id="hero.taskitem.667" name="Godfrey of Bouillon" itemType="任务" dayLimit="0" userLimit="0" desc="A Frenchman and prominent leader of the First Crusade, Godfrey of Bouillon distinguished himself in the siege of Jerusalem and became the city's ruler. He solidified the Crusaders' hold on Palestine by defeating the Muslims in countless battles celebrated in the Chansons de Geste, a medieval song cycle. " itemDesc="Godfrey of Bouillon" iconUrl="images/icon/hero/667.png" price="0"/>
  <itemEum id="hero.taskitem.668" name="Queen Aliquippa" itemType="任务" dayLimit="0" userLimit="0" desc="Queen Aliquippa was a leder of a band of Migon Seneca native Americans living near current day Pittsburgh.  She was a key ally of the British leading up to the French and Indian War and assisted George Washington in battle. " itemDesc="Queen Aliquippa" iconUrl="images/icon/hero/668.png" price="0"/>
  <itemEum id="hero.taskitem.669" name="Nancy Ward" itemType="任务" dayLimit="0" userLimit="0" desc="Nanye-hi was a Cherokee woman of the Wolf Clan who became know in English as Nancy Ward after her marriage to Bryant Ward. She held rank in her tribe as a Ghigau, which gave her the power to spare captives. She learned weaving and raising domesticated cows from a white captive woman and revolutionized Cherokee culture. She warned whites of impending attacks for which she is recognized as a Patriot by the D.A.R. and is considered an important early pioneer woman in American for advocating for a woman's voice in politics. " itemDesc="Nancy Ward" iconUrl="images/icon/hero/669.png" price="0"/>
  <itemEum id="hero.taskitem.67" name="Abu Tammam" itemType="任务" dayLimit="0" userLimit="0" desc="Abu Tammam is a famous Muslim convert and poet born to Christian parents. He is best known for compiling early Arabic poems in the 9th century into what is considered one of the greatest anthologies of Arabic literature ever written, though he himself wrote beautiful poetry often describing historical events.  " itemDesc="Abu Tammam" iconUrl="images/icon/hero/67.png" price="0"/>
  <itemEum id="hero.taskitem.670" name="Punyaslok Rajmata Ahilyadevi" itemType="任务" dayLimit="0" userLimit="0" desc="Known as the Philosopher Queen, Ahilyabi Holkar was Queen of the Malwa kingdom in India. She personally led armies into battle. She was a great builder and patron of many Hindu temples. " itemDesc="Punyaslok Rajmata Ahilyadevi H" iconUrl="images/icon/hero/670.png" price="0"/>
  <itemEum id="hero.taskitem.671" name="Cuhtuhlatah" itemType="任务" dayLimit="0" userLimit="0" desc="Cuhtahlatah was a Cherokee woman who lived during the period of the American Revolutionary War. When her husband was killed she grabbed his tomahaw and attacked the enemy. Her actions inspired her retreating people to rally and they were victorious in the fight. " itemDesc="Cuhtuhlatah" iconUrl="images/icon/hero/671.png" price="0"/>
  <itemEum id="hero.taskitem.672" name="Margaret Corbin" itemType="任务" dayLimit="0" userLimit="0" desc="Margaret Corbin fought beside her husband John Corbin along with 600 American soldiers defending Fort Washington in northern Manhattan from Hessian troops. John and Margaret together manned a cannon. When John was killed, Margaret manned the cannon alone until she was seriously wounded herself. She was included on military rolls until the end of the war and was the first woman to receive a pension from the US Congress. " itemDesc="Margaret Corbin" iconUrl="images/icon/hero/672.png" price="0"/>
  <itemEum id="hero.taskitem.673" name="Sybil Ludington" itemType="任务" dayLimit="0" userLimit="0" desc="At only 16 years old, Sybil Ludington received word that British troops had begun burning Danbury, Connecticut only 25 miles from her home. She rode all night for 40 miles to warn and rally the 400 American troops to 'Muster at the Luddington's' in preparation for battle. She is considered the female Paul Revere. (Her ride was twice the distance of his!) " itemDesc="Sybil Ludington" iconUrl="images/icon/hero/673.png" price="0"/>
  <itemEum id="hero.taskitem.674" name="Ann Bates" itemType="任务" dayLimit="0" userLimit="0" desc="Ann Bates was a school teacher turned Revolutionary War spy. She was a British loyalist. She came in to General George Washington's American headquarters under the pseudonym 'Mrs. Barnes' posing as a peddler. Later she helped other women spies get through safe houses in their return to British territory. " itemDesc="Ann Bates" iconUrl="images/icon/hero/674.png" price="0"/>
  <itemEum id="hero.taskitem.675" name="Manuela Beltran" itemType="任务" dayLimit="0" userLimit="0" desc="Manuela Beltrán was a Colombian woman was unusual for her time in that she was literate and owned her own grocery business. She organized a peasant revolt against the harsh taxation of the Spanish Empire's colonies by reading the edict of the new taxation regimen in the main square of Socorro to the outrage of the crowd. " itemDesc="Manuela Beltran" iconUrl="images/icon/hero/675.png" price="0"/>
  <itemEum id="hero.taskitem.676" name="Deborah Sampson" itemType="任务" dayLimit="0" userLimit="0" desc="The first known American woman to impersonate a man in order to join the Army was Deborah Sampson. She convinced a Massachusetts Sergeant that her name was Robert Hurtliff and joined the Continental Army in the American Revolutionary War. She was tall, educated and strong so she was able to pull off the guise. She fought in many skirmishes with her Light Infantry Company and even took some musket balls in her thigh, which she removed herself fearful the medics would discover her secret. " itemDesc="Deborah Sampson" iconUrl="images/icon/hero/676.png" price="0"/>
  <itemEum id="hero.taskitem.677" name="Anne-Josephe Theroigne de Mericourt" itemType="任务" dayLimit="0" userLimit="0" desc="This quick-witted, handsome, and intensely passionate woman used her charisma and temper to rile the crowds of Paris during the French Revolution.  " itemDesc="Anne-Josephe Theroigne de Mericourt" iconUrl="images/icon/hero/677.png" price="0"/>
  <itemEum id="hero.taskitem.678" name="Angelique Brulon" itemType="任务" dayLimit="0" userLimit="0" desc="Initially fighting disguised as a man, Angelique Brulon was so proficient with sword and dagger in hand-to-hand combat that she was allowed to stay in the defense of Corisca after her true identity was revealed. She fought with such valor in battle, she was promoted to lieutenant and Napoleon III decorated her with the red ribbon of the French Legion of Honor. " itemDesc="Angelique Brulon" iconUrl="images/icon/hero/678.png" price="0"/>
  <itemEum id="hero.taskitem.679" name="Wang Cong'er" itemType="任务" dayLimit="0" userLimit="0" desc="Formerly a circus performer, Wang Cong'er became the leader of the White Lotus sect against China's corrupt Qing regime. She was a master of Kug Fu and acrobatics instilling fear upon her enemies with swords in both hands. To avenge her husband's death, she led an army of peasant men into battle against the greatest empire in Asia, overcoming them with guerrilla war tactics. " itemDesc="Wang Cong'er" iconUrl="images/icon/hero/679.png" price="0"/>
  <itemEum id="hero.taskitem.68" name="Achaeus" itemType="任务" dayLimit="0" userLimit="0" desc="Achaeus was a general and later a separatist ruler of part of the Greek Seleucid kingdom.  He was married to Laodice, the daughter of Mithridates, king of Pontus.  Achaeus accompanied Seleucus Ceraunus, in his expedition across mount Taurus against Attains, and after the assassination of Seleucus revenged his death. Antiochus the Great, the successor of Seleucus, appointed him to the command of Asia in 223 B. C.  Achaeus revolted against Antiochus and assumed the title of king of Asia.  He was later betrayed and delivered into the hands of Antiochus who ordered him put to death in 213 B.C.. " itemDesc="Achaeus" iconUrl="images/icon/hero/68.png" price="0"/>
  <itemEum id="hero.taskitem.680" name="Christina of Saxony" itemType="任务" dayLimit="0" userLimit="0" desc="Christina of Saxony was a Saxon princess who became Queen consort of Denmark, Norway, and Sweden. She ruled Sweden in her husband's absence. " itemDesc="Christina of Saxony" iconUrl="images/icon/hero/680.png" price="0"/>
  <itemEum id="hero.taskitem.681" name="Christina Gyllenstierna" itemType="任务" dayLimit="0" userLimit="0" desc="Christina was the wife of the Swedish regent Sten Sture the Younger. It was likely she was a political advisor to her husband. After her husband's death she became the leader of the resistance to Christian II of Denmark and took command of Swedish forces. Roused by her patriotism, the peasants of central Sweden took up arms and defeated the Danish and valiantly resisted delayed capture of Stockholm. " itemDesc="Christina Gyllenstierna" iconUrl="images/icon/hero/681.png" price="0"/>
  <itemEum id="hero.taskitem.682" name="Anna Rheinholdsdotter Leuhusen" itemType="任务" dayLimit="0" userLimit="0" desc="After the defeat of Stockholm by the Danes, the city again became under siege by the Swedes in the War of Liberation. Anna Lehusen was the Abbess of Saint Clara Abbey in Stockholm and was a Danish loyalist. The Saint Clara Abbey was used as a secret escape channel at night for Swedes to pass in and out of the city. Anna Leuhsen would betray the Swedish refugees to Danish troops who would catch them and execute them for treason. " itemDesc="Anna Rheinholdsdotter Leuhusen" iconUrl="images/icon/hero/682.png" price="0"/>
  <itemEum id="hero.taskitem.683" name="Granuaile (Gráinne Ní Mháille or Grace O'Malley)" itemType="任务" dayLimit="0" userLimit="0" desc="Known as the Sea Queen of Connaught Ireland, Gráinne Ní Mháille was involved in maritime and trade. She ran her business from Bunowen Castle on the most western point of Connaught. She defended a fortress from the Jocyes who renamed it 'Hens Castle' in her honor. She later defended the same castle from the English despite being outnumbered. Later she recruited fighting men from Ireland and Scotland and became the infamous woman pirate that inspired songs, stories, and poems about her. " itemDesc="Granuaile (Gráinne Ní Mháille or Grace O'Malley)" iconUrl="images/icon/hero/683.png" price="0"/>
  <itemEum id="hero.taskitem.684" name="Mary I of Scotland (Mary Queen of Scots)" itemType="任务" dayLimit="0" userLimit="0" desc="Mary was crowned Queen of Scotland as an infant. Through her first marriage she also served as Queen of France for a time. Her return to Scotland after her husband's death was viewed as a threat to England's ruler because of Mary's devout Catholic beliefs and the threat she'd realign Scotland with Continental Catholic powers. She was suspected of involvement in the murder of her husband Darnley which caused her to lose public support and cause her exile in England for the remainder of her life. " itemDesc="Mary I of Scotland (Mary Queen of Scots)" iconUrl="images/icon/hero/684.png" price="0"/>
  <itemEum id="hero.taskitem.685" name="Chand Bibi" itemType="任务" dayLimit="0" userLimit="0" desc="Chand Bibi was an Indian Muslim woman warrior best know for defending Ahmednagar against the Mughal forces of the Emperor Akbar. She took the leadership and defended the Ahmednagar fort successfully preventing Mughal possession of Ahmednagar until after her death. " itemDesc="Chand Bibi" iconUrl="images/icon/hero/685.png" price="0"/>
  <itemEum id="hero.taskitem.686" name="Gao Guiying" itemType="任务" dayLimit="0" userLimit="0" desc="Gao Guiying was one of the most remarkable women in the history of China. She was a revolutionary, rebellion-leader, and served as a commander in the army training and leading female troops of rebels. As a commander of both male and female warriors, she captured Beijing, deposed the Ming dynasty and took control as regent. " itemDesc="Gao Guiying" iconUrl="images/icon/hero/686.png" price="0"/>
  <itemEum id="hero.taskitem.687" name="Hannah Duston" itemType="任务" dayLimit="0" userLimit="0" desc="Hannah Duston was a New England woman who was captured during an Abenaki Indian raid. She escaped from her captors by leading the other captors in killing them in the middle of the night, supposedly scalping them as well, and escaping in their canoe. " itemDesc="Hannah Duston" iconUrl="images/icon/hero/687.png" price="0"/>
  <itemEum id="hero.taskitem.688" name="Charlotte Stanley, Countess of Derby" itemType="任务" dayLimit="0" userLimit="0" desc="Charlotte married the loyal Royalist English nobleman James Stanley, 7th Earl of Derby who was later beheaded at Bolton. Lady Derby gallantly defended Lathom House, the last Royalist stronghold in Lacashire, against Parliamentary forces during the First English Civil War and delayed surrender long beyond the anticipated conquer timeframe. " itemDesc="Charlotte Stanley, Countess of Derby" iconUrl="images/icon/hero/688.png" price="0"/>
  <itemEum id="hero.taskitem.689" name="Mary Read" itemType="任务" dayLimit="0" userLimit="0" desc="Mary Read was born illegitimately to a widow of a sea captain. When her brother died, her mother dressed her up as a boy to continue to receive support for her deceased brother. As a boy, Read found work as a footboy and then on a ship. She joined the British military where she proved herself in battle but fell in love with a Flemish soldier. Upon her husband's death she once again dressed as a man and headed for the West Indies where she became a notorious Pirate. " itemDesc="Mary Read" iconUrl="images/icon/hero/689.png" price="0"/>
  <itemEum id="hero.taskitem.69" name="Adam Smith" itemType="任务" dayLimit="0" userLimit="0" desc="Adam Smith was a Scottish philosopher and a key figure of the Scottish Enlightenment. His volume, The Wealth of Nations, is the first work of modern economics. With this book he is widely considered the father of modern economics. " itemDesc="Adam Smith" iconUrl="images/icon/hero/69.png" price="0"/>
  <itemEum id="hero.taskitem.690" name="Queen Nanny of the Maroons" itemType="任务" dayLimit="0" userLimit="0" desc="Granny Nanny is a national hero of Jamaica for her role as a leader of the Jamaican Maroons in the eighteenth century. Nanny escaped from a plantation with her five brothers. They split up in an attempt to organize the Maroons. Nanny gained control of an area near the Blue Mountains. She was very adept at organizing plans to free slaves and is credited with freeing over 800 of them as well as helping them to remain free and healthy. " itemDesc="Queen Nanny of the Maroons" iconUrl="images/icon/hero/690.png" price="0"/>
  <itemEum id="hero.taskitem.691" name="Anne Hutchinson" itemType="任务" dayLimit="0" userLimit="0" desc="Anne Hutchinson was an American pioneer in Massachusetts, Rhode Island, and New Netherlands (New York). Her religious fervor and theological interpretations led to imprisonment and eventually her banishment. Her heresy was a belief that it was a blessing rather than a curse to be a woman. Her followers left the colony and Roger Williams co-founded the state of Rhode Island with her. She was pardoned by the state of Massachusetts in 1987. " itemDesc="Anne Hutchinson" iconUrl="images/icon/hero/691.png" price="0"/>
  <itemEum id="hero.taskitem.692" name="Rani Rudrama Devi" itemType="任务" dayLimit="0" userLimit="0" desc="Rani Rudrama Devi was one of the most prominent rulers of the Kakatiya Dynasty in India. She succeeded her father at age fourteen. She suppressed uprisings within the Kakatiya territory and incursions by neighboring kingdoms. One of her accomplishments was the construction of the Warangal Fort. She embraced an extinct form of dance known as Shiva Tandavam Perini as an exercise for the soldiers and made it an part of the royal force training. " itemDesc="Rani Rudrama Devi" iconUrl="images/icon/hero/692.png" price="0"/>
  <itemEum id="hero.taskitem.70" name="Adelard of Bath" itemType="任务" dayLimit="0" userLimit="0" desc="Adelard of bath bridged the scientific canon on Europe and the middle east by translating many important Arabic works into Latin. " itemDesc="Adelard of Bath" iconUrl="images/icon/hero/70.png" price="0"/>
  <itemEum id="hero.taskitem.71" name="Aeschylus" itemType="任务" dayLimit="0" userLimit="0" desc="The 'Father of Tragedy,' Aeschylus who is known as the third of the three great Greek tragedians, was born in 525 B.C. in the city of Eleusis.  Immersed early in the mystic rites of the city and the worship of the Earth goddess Demeter, he claimed Dionysus appeared to him in a dream and ordered him to write tragedies. The obedient young Aeschylus began a tragedy the next morning and in his words, 'succeeded very easily'.  Although Aeschylus is said to have written over ninety plays, only seven have survived.  His life laid the groundwork the dramatic arts would need to flourish, and by the time of his death in 456 B. C., there were two notable successors ready to take his place, Sophocles and Euripides.  In addition, Aeschylus left behind two sons who would carry on his dramatic legacy, and one of them, Euphorion, would claim first prize at the City Dionysia competition, defeating both Sophocles and Euripides in 431 B.C. " itemDesc="Aeschylus" iconUrl="images/icon/hero/71.png" price="0"/>
  <itemEum id="hero.taskitem.72" name="Aethelstan" itemType="任务" dayLimit="0" userLimit="0" desc="Often overlooked in favour of his predecessor Alfred the Great the fifteen years of the reign of Aethelstan, dubbed 'The Glorious', were pivotal in the development of English political power.  During the first year of his reign he wrested Northumbria from its Viking overlords, which meant that for the first time in its history all of England was united under a single monarch.  The rest of his reign was spent subduing Scotland and Wales establishing their rulers as 'Subreguli' indicating their subservience to the English King.  Although this was a relatively shortlived arrangement Aethelstan is considered the first true 'King of all Britain'. " itemDesc="Aethelstan" iconUrl="images/icon/hero/72.png" price="0"/>
  <itemEum id="hero.taskitem.73" name="Afonso de Albuquerque" itemType="任务" dayLimit="0" userLimit="0" desc=" An expert military commander and administrator, Afonso de Albuquerque oversaw the projection of Portuguese military strength into the Indian Ocean.  Through a series of conquests, he intended to prevent the spice trade from going through the Middle East, leaving Portuguese ships as the only means for spices to reach Europe.  His greatest victory was the conquest of Goa, and he then established it as the central city of Portugal in India. " itemDesc="Afonso de Albuquerque" iconUrl="images/icon/hero/73.png" price="0"/>
  <itemEum id="hero.taskitem.74" name="Agesilaus II" itemType="任务" dayLimit="0" userLimit="0" desc="(c. 442-360 B.C.) Agesilaus II was king of Sparta during the decline of its supremacy in ancient Greece.   Although small in stature and somewhat lame, he was a successful leader in guerilla warfare and his personal bravery was unquestioned. As a statesman he won   both eager supporters along with ardent enemies, and was known for his staunch patriotrism.  He lived frugally at home and in the field, and though his campaigns were undertaken largely to secure booty, he was content to enrich the state and his friends and often returned home as poor as he started. The worst trait in his character was his hatred of Thebes which led directly to the battle of Leuctra where Cleombrotus was defeated and Spartan's supremacy was overthrown. " itemDesc="Agesilaus II" iconUrl="images/icon/hero/74.png" price="0"/>
  <itemEum id="hero.taskitem.75" name="Akbar" itemType="任务" dayLimit="0" userLimit="0" desc="The third of the Mogul (Moslem) rulers of India, Akbar inherited the throne at age 13 in 1555. Although his military conquests stabilized the empire, Akbar made history through his political systems of land revenue, military and civil service, and statesmanship. By illegalizing discrimination against the Hindu majority and marrying a Hindu princess, he secured Hindu-Moslem relations, the basis for Mogul rule until the 18th century.  " itemDesc="Akbar" iconUrl="images/icon/hero/75.png" price="0"/>
  <itemEum id="hero.taskitem.76" name="Al Hassan Addakhil" itemType="任务" dayLimit="0" userLimit="0" desc="Al Hassan Addakhil was the Imam of Morocco in late 13th century, and is believed to be the direct ancestor of the Alaouite Dynasty, which to this day is the royal family of Morocco. He was invited by the people of Morocco to be their Imam because he was a direct descendant of the prophet Mohammed, and it was believed that his presence in Morocco would bless their date palm crops and improve their yield. " itemDesc="Al Hassan Addakhil" iconUrl="images/icon/hero/76.png" price="0"/>
  <itemEum id="hero.taskitem.78" name="Albrecht Durer" itemType="任务" dayLimit="0" userLimit="0" desc="Aside from his passion for painting, Durer developed mathematic theories of proportions and perspective which were widely used in art. " itemDesc="Albrecht Durer" iconUrl="images/icon/hero/78.png" price="0"/>
  <itemEum id="hero.taskitem.79" name="Albrecht von Wallenstein" itemType="任务" dayLimit="0" userLimit="0" desc="Albrecht von Wallenstein was a Bohemian solider and politician. He fought for the Holy Roman Emperor Ferdinand II in the Thirty Years War. He became Generalissimo and supreme commander of the Habsburg monarchy. " itemDesc="Albrecht von Wallenstein" iconUrl="images/icon/hero/79.png" price="0"/>
  <itemEum id="hero.taskitem.80" name="Aldus Manutius, the Elder" itemType="任务" dayLimit="0" userLimit="0" desc="Manutius is an Italian humanist and scholar.  He founded the Aldine Press in Venice and concentrated his efforts on preserving the Greek classics. " itemDesc="Aldus Manutius, the Elder" iconUrl="images/icon/hero/80.png" price="0"/>
  <itemEum id="hero.taskitem.81" name="Aldus Manutius, the Younger" itemType="任务" dayLimit="0" userLimit="0" desc="Grandson of Aldus Manutius, the Elder, the young Manutius followed in his grandfathers footsteps and ran the Aldine Press in Venice as well as producing several scholarly works of literature.  His work was interrupted when he was summoned by the Pope to operate the Press of the Vatican. " itemDesc="Aldus Manutius, the Younger" iconUrl="images/icon/hero/81.png" price="0"/>
  <itemEum id="hero.taskitem.82" name="Alexander I of Scotland" itemType="任务" dayLimit="0" userLimit="0" desc="Alexander I saw the system of feudalism in action while he was being educated in England and instituted it in Scotland when he became King in 1107. He maintained the delicate balance of peace with England but independence from her rule. Although styled 'the Fierce' after trouncing a Celtic revolt, his piety led him to establish Augustinian monasteries in Scotland. " itemDesc="Alexander I of Scotland" iconUrl="images/icon/hero/82.png" price="0"/>
  <itemEum id="hero.taskitem.83" name="Alexander Suvorov" itemType="任务" dayLimit="0" userLimit="0" desc="Alexander Suvorov was generalissimo of the Russian Empire. He is considered one of history's greatest generals to never lose a battle. " itemDesc="Alexander Suvorov" iconUrl="images/icon/hero/83.png" price="0"/>
  <itemEum id="hero.taskitem.84" name="Alexander the Great" itemType="任务" dayLimit="0" userLimit="0" desc="Alexander III, better known as Alexander the Great, was born in the northern Greek kingdom of Macedonia in 356 B.C.  Against overwhelming odds, he led his army to victories across the Persian territories of Asia Minor, Syria and Egypt without suffering a single defeat. His greatest victory was at the Battle of Gaugamela, in what is now northern Iraq, in 331 B.C.. The young king of Macedonia, leader of the Greeks, overlord of Asia Minor and pharaoh of Egypt became Great King of Persia at the age of 25 and is the most well known figure in antiquity.  He died of a fever in Babylon in 323 B.C. " itemDesc="Alexander the Great" iconUrl="images/icon/hero/84.png" price="0"/>
  <itemEum id="hero.taskitem.85" name="Alexius I Comnenus" itemType="任务" dayLimit="0" userLimit="0" desc="Byzantine emperor for almost 40 years, Alexius mastered the intricate military aristocracy that dominated Byzantine politics. He won the throne for himself by allying his military men with court officials. Constantly harassed by the Seljuk Turks, Alexius asked Pope Urban II for help recruiting mercenaries in 1095, which prompted the Pope to call for the First Crusade. The Crusade helped Alexius keep his empire intact, and it passed to his son John on his death in 1118. " itemDesc="Alexius I Comnenus" iconUrl="images/icon/hero/85.png" price="0"/>
  <itemEum id="hero.taskitem.86" name="Alfonso de Borja" itemType="任务" dayLimit="0" userLimit="0" desc="A member of the powerful Borgia family, Alfonso was elected as Pope Callixtus III at a very advanced age.  Many consider him incompetent because of his age. " itemDesc="Alfonso de Borja" iconUrl="images/icon/hero/86.png" price="0"/>
  <itemEum id="hero.taskitem.87" name="Alix of France" itemType="任务" dayLimit="0" userLimit="0" desc="Alix' gained experience in leadership when she served as regent for her absent huband, Theobald V, Count of Blois until their son was old enough to inherit the position. " itemDesc="Alix of France" iconUrl="images/icon/hero/87.png" price="0"/>
  <itemEum id="hero.taskitem.88" name="Al Shahrazuri" itemType="任务" dayLimit="0" userLimit="0" desc="Al Shahrazuri was a 13th century Kurdish physician and historian and is considered one of the great philosophers of Iran. He lived in the area of today's Iraqi Kurdistan. He is primarily known for composing a major biographical dictionary of both ancient Greek and early Muslim scholars. He also wrote a number of medical books.  " itemDesc="Al Shahrazuri" iconUrl="images/icon/hero/88.png" price="0"/>
  <itemEum id="hero.taskitem.89" name="alvar Nunez Cabeza de Vaca" itemType="任务" dayLimit="0" userLimit="0" desc="A career soldier, Cabeza de Vaca served with the Spanish army in Europe before joining an expedition to Florida with Pánfilo de Narváez in 1527. Disaster struck, and the expedition's four survivors walked 6,000 miles across southern North America and Mexico. Cabeza de Vaca was made Governor of the Río de la Plata. In 1541 and 1542, he led two expeditions up the Río Paraguay. On royal pension, he wrote commentaries of his long marches. " itemDesc="alvar Nunez Cabeza de Vaca" iconUrl="images/icon/hero/89.png" price="0"/>
  <itemEum id="hero.taskitem.90" name="Amanieu de Sescars" itemType="任务" dayLimit="0" userLimit="0" desc="Amanieu de Sescars was a Catalan poet of the late 13th century. He was particularly famous for his love songs, so much so that he was known by the popular name of dieu d'amor, god of love. Some of his poetry survives to this day. In one of his works he writes on how to be the ideal nobleman, who is noble in love, in leisure and in war. Another one of his works was designed to teach young women how to behave in society and gain social respect.  " itemDesc="Amanieu de Sescars" iconUrl="images/icon/hero/90.png" price="0"/>
  <itemEum id="hero.taskitem.92" name="Amin al-Din Rashid" itemType="任务" dayLimit="0" userLimit="0" desc="Amin al-Din Rashid was a 13th century Persian physician, who specialized as a dietician for the Persian court. He composed a large treatise on the proper preparation of food and drink, which was to be used by the servants of the rulers of Persia. " itemDesc="Amin al-Din Rashid" iconUrl="images/icon/hero/92.png" price="0"/>
  <itemEum id="hero.taskitem.93" name="Amy Robsart" itemType="任务" dayLimit="0" userLimit="0" desc="Amy Robsart was the first wife of Lord Robert Dudley.  She died falling down a flight of stairs which raised a storm of suspicion given that Lord Dudley was a favourite of Queen Elizabeth I.  The flames of intrigued were fanned when Dudley failed to attend his own wife's funeral and Amy Robsart became an enduring symbol as a tragic Heroin in English folklore until the Victorian Era. " itemDesc="Amy Robsart" iconUrl="images/icon/hero/93.png" price="0"/>
  <itemEum id="hero.taskitem.94" name="Andrea Doria" itemType="任务" dayLimit="0" userLimit="0" desc="An admiral and soldier, Doria joined the French Army under Francis I to oust the forces of Holy Roman Emperor Charles V from Genoa. In a turnabout play, he made a pact for Genoese independence with Charles in return for driving out the French. Doria seized power himself in 1528 becoming Doge of Genoa until his death in 1560.  " itemDesc="Andrea Doria" iconUrl="images/icon/hero/94.png" price="0"/>
  <itemEum id="hero.taskitem.95" name="Andrea Palladio" itemType="任务" dayLimit="0" userLimit="0" desc="Palladio rose from humble beginnings as a mere stonecutter to eventually become one of the greatest architects in Western history.  His techniques and developments in the science of architecture were strongly influenced by classical Greek architecture. " itemDesc="Andrea Palladio" iconUrl="images/icon/hero/95.png" price="0"/>
  <itemEum id="hero.taskitem.96" name="Andreas Vesalius" itemType="任务" dayLimit="0" userLimit="0" desc="Born into a family of influential physicians, Vesalius was exposed to the science of anatomy at an early age.  Eventually his discoveries in the field led some to consider him the father of modern anatomy. " itemDesc="Andreas Vesalius" iconUrl="images/icon/hero/96.png" price="0"/>
  <itemEum id="hero.taskitem.97" name="Angelo Poliziano" itemType="任务" dayLimit="0" userLimit="0" desc="Both a student and professor of the classics, Poliziano is an esteemed author and scholar as well as an amateur philosopher. " itemDesc="Angelo Poliziano" iconUrl="images/icon/hero/97.png" price="0"/>
  <itemEum id="hero.taskitem.98" name="Anna Comnena" itemType="任务" dayLimit="0" userLimit="0" desc="Daughter of Byzantine Emperor Alexius I Comnenus, Anna Comnena hoped her husband would usurp the throne when her brother John succeeded to it in 1118. Widowed early, she retreated to a convent and wrote a 15-volume history called the Alexiad glorifying her father and his reign. Trained as a scholar, her epic work made her one of the first female historians. " itemDesc="Anna Comnena" iconUrl="images/icon/hero/98.png" price="0"/>
  <itemEum id="hero.taskitem.99" name="Anne Boleyn" itemType="任务" dayLimit="0" userLimit="0" desc="England's King Henry VIII was married to Catherine of Aragon when, in 1527, he began a love affair with Anne Boleyn, daughter of a Protestant, Pro-Reformation family that had risen to prominence at court. After an ugly, protracted battle against Catherine, the Catholic Church, and the Pope, Henry's marriage to Catherine was annulled. He married Anne who was crowned Queen and gave birth to a daughter in 1533. Like Catherine, Anne failed to bear a son, and she was beheaded on trumped-up adultery charges in 1536. The last word was Anne's--her daughter was crowned Elizabeth I in 1558. " itemDesc="Anne Boleyn" iconUrl="images/icon/hero/99.png" price="0"/>
  <itemEum id="instant.handover" name="Instant Handover" itemType="加速" dayLimit="0" userLimit="0" desc="You can use this item to give up your colony and withdraw your troops and staffs instantly." itemDesc="It takes some time to give up the control of a colony.  You need time to pack up, to withdraw your troops and staffs, to prepare and hold the Handover Ceremony before you can hand over the city.  You can now hand over the city instantly by using this item." iconUrl="images/items/giveup.png" price="20"/>
  <itemEum id="player.anniversary.cake" name="Celebration Feast" itemType="宝物" dayLimit="0" userLimit="0" desc="A feast for all! Evony turns 4, and your troops are invited to the birthday feast!" itemDesc="This item will reduce upkeep to 50% of normal for 24 hours. Using multiple items will extend the timer. All timers expire at maintenance on May 14th." iconUrl="images/icon/shop/celebrationfeast.png" price="0" playerItem="true"/>
  <itemEum id="player.attackinc.1" name="War Horn" itemType="宝物" dayLimit="0" userLimit="0" desc="Increase Attack of troops by 20%. Effective for 24 hours." itemDesc="Blew in battlefield to motivate your soldiers. War Horn is a tool to raise the morale of your fighting troops." iconUrl="images/items/zhandouhaojiao.png" price="10" playerItem="true"/>
  <itemEum id="player.attackinc.1.b" name="Ivory Horn" itemType="宝物" dayLimit="0" userLimit="0" desc="Increase Attack of troops by 20%. Effective for 7 days." itemDesc="Blew in battlefield to motivate your soldiers. War Horn is a tool to raise the morale of your fighting troops." iconUrl="images/items/xiangyahaojiao.png" price="60" playerItem="true"/>
  <itemEum id="player.bavarian.brew" name="Bavarian Brew" itemType="宝物" dayLimit="0" userLimit="0" desc="Use this item for 24 hour for a 50% upkeep buff between Sep 27th and Oct 7th." itemDesc="A gift from your friends during the Evonytoberfest promotion! Use this item to get 24 hours of 50% upkeep in ALL of your cities! The Bavarian Brew must be used between Sep 28th and Oct 7th and is stackable for a maximum of 5 days, allowing you to increase the available buff time. On October 8th the buff will expire." iconUrl="images/icon/shop/bavarianbrew.png" price="0" playerItem="true"/>
  <itemEum id="player.bavarian.brew.2013" name="Bavarian Brew 2013" itemType="宝物" dayLimit="0" userLimit="0" desc="Use this item for 24 hour for a 50% upkeep buff between Sep 26th and Oct 12th." itemDesc="A gift from your friends during the Evonytoberfest promotion! Use this item to get 24 hours of 50% upkeep in ALL of your cities! The Bavarian Brew must be used between Sep 26th and Oct 12th and is stackable, allowing you to increase the available buff time. On October 13th the buff will expire." iconUrl="images/icon/shop/bavarianbrew2013.png" price="0" playerItem="true"/>
  <itemEum id="player.bone.key" name="Bone Key" itemType="宝物" dayLimit="0" userLimit="0" desc="This key is made from the leftovers of many hunts. A hunter carved the key to match his lock exactly, and break apart after many uses." itemDesc="The Bone Key will open the Chest of the Hunt from the 2013 Wild Hunt Promotion." iconUrl="images/icon/shop/bonkey.png" price="0"/>
