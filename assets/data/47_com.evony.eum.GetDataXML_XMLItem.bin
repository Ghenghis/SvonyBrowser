  <itemEum id="player.box.present.money.405" name="8th Anniversary Package" itemType="宝箱" dayLimit="0" userLimit="0" desc="This heavy package was delivered to your hands along with the cents that you filled your coffers with! It’s our 8th Anniversary, and here is your package of wonders!" itemDesc="Opening this package will grant you:1 x Adv Teleporter,1 x War Teleporter,4 x Stygandr’s Banner of the Horde,3 x War Ensign,1 x Mechanics Battallion,1 x Angel Token,1 x Devil Token,1 x Penicillin,1 x Corselet" iconUrl="images/icon/shop/8thanniversarypackage.png" price="0" playerItem="true"/>
