  <itemEum id="player.box.present.money.239" name="Lord Yul'sMagic Bag" itemType="宝箱" dayLimit="0" userLimit="0" desc="Lord Yul's Magic Bag seems small, but once opened it's larger on the inside and filled with gifts from the people of the land." itemDesc="Opening Lord Yul’s Magic Bag will grant you the following:1 x Adv Teleporter,1 x War Teleporter,3 x War Ensign,5x Mechanic Battalion,1x Truce Agreement,1x Angel Token,1x Devil Token,1x Key of Donar" iconUrl="images/icon/shop/lordyulsmagicbag.png" price="0" playerItem="true"/>
