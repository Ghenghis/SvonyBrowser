  <itemEum id="player.box.present.money.275" name="Anniversary Gift 2015" itemType="宝箱" dayLimit="0" userLimit="1" desc="Celebration the 6th Anniversary!" itemDesc="Included in this Anniversary gift is the following:1 Silver Key,1 Angel Token,1 Devil Token,1 Dream Truce" iconUrl="images/icon/shop/anniversarygift2015.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.276" name="Sun’s End" itemType="宝箱" dayLimit="0" userLimit="1" desc="The Sun’s End cult has been seen building shrines through the wilds to the sun, in an effort to extend summer for a little longer. Eager to share their message with you, they have sent you this gift." itemDesc="Opening this gift will give you 1 Silver Key, and 50 cents!" iconUrl="images/icon/shop/afeastforthepeople.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.277" name="The Boneslayer’s Treasure Chest" itemType="宝箱" dayLimit="0" userLimit="0" desc="A chest filled with the finest items the Boneslayer cult has taken from the people they have slain in the pursuit of their perverse rites." itemDesc="This chest can be opened with the Blood Key from the 2015 Halloween promotion. Once opened you will gain one of the following chest packages!Prize of the Orrelheim,Store of the Nedan Blood Cult,The Boneslayer Cult’s Prize,The Altar’s Fetishes,The Cultist’s Purse" iconUrl="images/icon/shop/theboneslayerstreasurechest.png" price="0" playerItem="true"/>
