  <itemEum id="player.box.present.money.29" name="Special Easter Chest" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes: Chest A (Freedom Medal, Justice Medal, Nation Medal, Michelangelo's Script, Plowshares, Arch Saw, Quarrying Tools, Blower, War Ensign, Excalibur, The Wealth of Nations, Amulet) or Chest B (Primary Guidelines, Intermediate Guidelines, Hero Hunting, Merchant Fleet, Plowshares, Double Saw, Quarrying Tools, Blower, Michelangelo's Script, Tax Policy, The Wealth of Nations) or Chest C (Excalibur, War Horn, Corselet, Truce Agreement, War Ensign, Adv City Teleporter, Michelangelo's Script)" itemDesc="These Chests are presented to you as FREE gifts when your friends purchase the normal Easter Package. You will receive a random assortment of Chests by open it with a Special Easter Chest Key. " iconUrl="images/icon/shop/Christmas1.jpg" price="300" playerItem="true"/>
  <itemEum id="player.box.present.money.290" name="Brace of Jakes" itemType="宝箱" dayLimit="0" userLimit="0" desc="" itemDesc="" iconUrl="images/icon/shop/huangjingbaoxiang.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.291" name="Oak King’s Enticement" itemType="宝箱" dayLimit="0" userLimit="1" desc="The Oak King’s Enticement was left in your home during the day. These gifts let you rest in the night and adventure in the light the Oak King brings." itemDesc="Opening the Oak King’s Enticement will grant you the following:1 x Adv Teleporter,3 x War Teleporter,5 x War Ensign,1x Mechanic Battalion,1x Truce Agreement,1x Stone of Finding,1x On War,1x Silver Holly Key" iconUrl="images/icon/shop/oakkingsenticement.png" price="0" playerItem="true"/>
  <itemEum id="player.box.present.money.292" name="Holly King’s Favors" itemType="宝箱" dayLimit="0" userLimit="0" desc="The Holly King’s Favors appeared in the middle of the night, sparkling and attracting you in the weak light of the morning. What can be contained within the wrapping?" itemDesc="Once opened, the Holly King’s Favors will randomly provide you with one of the following groups of items:Jeweled Robin’s Egg Box,Emblazoned Gift Chest,Velveteen Box,Plainly Wrapped Box,Stuffed Stocking" iconUrl="images/icon/shop/hollykingsfavors.png" price="0" playerItem="true"/>
