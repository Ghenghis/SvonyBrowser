  <itemEum id="player.box.present.money.47" name="Locked Halloween Chest" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes: Chest A (Freedom Medal, Justice Medal, Nation Medal, Michelangelo's Script, Plowshares, Arch Saw, Quarrying Tools, Blower, War Ensign, Excalibur, The Wealth of Nations, Amulet) or Chest B (Primary Guidelines, Intermediate Guidelines, Hero Hunting, Merchant Fleet, Plowshares, Double Saw, Quarrying Tools, Blower, Michelangelo's Script, Tax Policy, The Wealth of Nations) or Chest C (Excalibur, War Horn, Corselet, Truce Agreement, War Ensign, Adv City Teleporter, Michelangelo's Script)" itemDesc="These chests are sent to you as Halloween gifts from your friends in the game. They require a Skeleton Key to open. You can obtain a Skeleton Key for every $30 worth of purchases made during Halloween. When opened, you will receive a random assortment of Locked Halloween Chest A, B or C." iconUrl="images/icon/shop/LockedHalloweenChest.jpg" price="300" playerItem="true"/>
  <itemEum id="player.box.present.money.48" name="Evony War Package" itemType="宝箱" dayLimit="0" userLimit="1" desc="Includes: Special Chest Key, Lion Medal, Rose Medal, Cross Medal, Primary Guidelines, Intermediate Guidelines, War Horn, Corselet, Holy Water, Hero Hunting, Truce Agreement, City Teleporter, Amulet." itemDesc="These packages are delivered as gifts to players who purchases every $30" iconUrl="images/icon/shop/Christmas4.jpg" price="0" playerItem="true"/>
