  "amfProtocol": {
    "description": "Evony uses AMF3 (Action Message Format) for client-server communication",
    "structure": {
      "header": "AMF3 envelope with command ID",
      "body": "Serialized ActionScript objects",
      "common_types": [
        "Object",
        "Array",
        "String",
