  "combatFormulas": {
    "attack_power": "base_attack * (1 + hero_attack_bonus + research_bonus + buff_bonus)",
    "defense_power": "base_defense * (1 + hero_defense_bonus + research_bonus + wall_bonus)",
    "march_speed": "base_speed * (1 + hero_speed_bonus + research_bonus + items)",
    "load_capacity": "base_load * troop_count * (1 + hero_politics + research_bonus)"
  },
